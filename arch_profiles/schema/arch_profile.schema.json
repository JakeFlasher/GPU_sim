{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "arch_profile.schema.json",
  "title": "ArchProfile card",
  "description": "One per-architecture / per-SKU hardware + policy card. The canonical arch identity is the bare sm_XX arch_id; the sku disambiguates cards sharing a compute capability. Fields that were never captured on local silicon use the research_gap object instead of a value.",
  "type": "object",
  "additionalProperties": true,
  "required": ["arch_id", "sku", "compute_capability", "build_arch_family", "sm_count", "bare_ldg_e_default", "cache_layers", "evidence_status"],
  "allOf": [
    {
      "if": {
        "properties": {"arch_id": {"const": "sm_86"}},
        "required": ["arch_id"]
      },
      "then": {
        "properties": {
          "compute_capability": {"const": [8, 6]},
          "sku": {"const": "rtx_3090_ti"},
          "bare_ldg_e_default": {"const": "ca"},
          "build_arch_family": {
            "items": {"const": "sm_86"}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"arch_id": {"const": "sm_120"}},
        "required": ["arch_id"]
      },
      "then": {
        "properties": {
          "compute_capability": {"const": [12, 0]},
          "sku": {"const": "rtx_5090"},
          "bare_ldg_e_default": {"const": "unknown_typed_unavailable"},
          "build_arch_family": {
            "items": {"enum": ["sm_120", "sm_120a", "sm_120f"]}
          }
        }
      }
    }
  ],
  "properties": {
    "arch_id": {"type": "string", "enum": ["sm_86", "sm_120"], "description": "Canonical bare deploy/label arch token."},
    "sku": {"type": "string", "enum": ["rtx_3090_ti", "rtx_5090"], "description": "Device-tier SKU."},
    "display_name": {"type": "string"},
    "die": {"type": "string"},
    "microarchitecture": {"type": "string"},
    "role": {"type": "string"},
    "compute_capability": {"type": "array", "items": {"type": "integer"}, "minItems": 2, "maxItems": 2},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "device_name_substrings": {"type": "array", "items": {"type": "string"}},
    "build_arch_family": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "enum": ["sm_86", "sm_120", "sm_120a", "sm_120f"]},
      "description": "Nonempty card-local compile-time allowlist. Tokens are closed and constrained to the card's deployment architecture by the root conditionals."
    },
    "gencode": {"type": "string"},
    "sm_count": {"$ref": "#/$defs/intOrGap"},
    "griddim_penalty_alpha": {"$ref": "#/$defs/numOrGap"},
    "bare_ldg_e_default": {"type": "string", "enum": ["ca", "bypass", "unknown_typed_unavailable"], "description": "Closed declaration vocabulary. Architecture conditionals admit only declarations that agree with the current runtime capability; bypass remains vocabulary-known for a future lockstep capability extension."},
    "cache_layers": {"type": "array", "items": {"type": "string", "enum": ["L1", "L2"]}},
    "l2_geometry": {"$ref": "#/$defs/objOrGap"},
    "l1_geometry": {"$ref": "#/$defs/objOrGap"},
    "latencies_cycles": {
      "$ref": "#/$defs/latenciesOrGap",
      "description": "Measured load-to-use latencies in SM cycles from the counter-free tools/pchase harness (clock64-timed, with clock state recorded and no boost invariance assumed). Microbench-derived simulator INPUTS — never NCU counter values (Rule 1). Keys: l1_hit, l2_hit, dram, shared; unresolved probes (e.g. mshr_outstanding_misses) carry research_gap objects. provenance names the pchase static card + driver + host clock-lock state."
    },
    "nvml_reference_operating_point": {"$ref": "#/$defs/objOrGap"},
    "duration_crosswalk": {"$ref": "#/$defs/objOrGap"},
    "dram_bandwidth": {
      "$ref": "#/$defs/objOrGap",
      "description": "Aggregate DRAM read-bandwidth covariate at the LOCKED operating point: peak_bytes_per_second (vendor bus-width x data-rate spec), locked_sm_clock_mhz / locked_mem_clock_mhz (the -lgc/-lmc protocol locks the latencies_cycles table was measured under), provenance. Vendor-documented + protocol-derived simulator INPUT — never an NCU value (Rule 1). Peak is a documented-default service-rate hypothesis until a locked-protocol bandwidth microbench supersedes it; cards without a locked operating point carry research_gap."
    },
    "smsp": {"$ref": "#/$defs/smspResourcesOrGap"},
    "occupancy": {"$ref": "#/$defs/occupancyResourcesOrGap"},
    "runtime_limits": {"$ref": "#/$defs/runtimeLimitsOrGap"},
    "dep_barriers": {"$ref": "#/$defs/depBarrierResourcesOrGap"},
    "barrier_latencies": {"$ref": "#/$defs/barrierLatencyResourcesOrGap"},
    "dual_issue": {"$ref": "#/$defs/dualIssueResourcesOrGap"},
    "evidence_status": {"type": "string"},
    "predictor_state": {"type": "object"}
  },
  "$defs": {
    "researchGap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": {"const": "research_gap"},
        "reason": {"type": "string"},
        "challenge": {"type": "string"}
      }
    },
    "measuredValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": {"type": "number"},
        "dispersion": {"type": "number"},
        "unit": {"type": "string"}
      }
    },
    "measuredScalar": {
      "anyOf": [
        {"$ref": "#/$defs/measuredValue"},
        {"$ref": "#/$defs/researchGap"}
      ]
    },
    "latencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["l1_hit", "l2_hit", "dram", "shared", "mshr_outstanding_misses", "provenance"],
      "properties": {
        "l1_hit": {"$ref": "#/$defs/measuredScalar"},
        "l2_hit": {"$ref": "#/$defs/measuredScalar"},
        "dram": {"$ref": "#/$defs/measuredScalar"},
        "shared": {"$ref": "#/$defs/measuredScalar"},
        "mshr_outstanding_misses": {"$ref": "#/$defs/measuredScalar"},
        "provenance": {"type": "string"}
      }
    },
    "latenciesOrGap": {
      "anyOf": [
        {"$ref": "#/$defs/latencies"},
        {"$ref": "#/$defs/researchGap"},
        {"type": "null"}
      ]
    },
    "positiveU32": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "positiveU64": {
      "description": "Positive u64 carried within the exact cross-language JSON integer range.",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "smspResources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "issue_ports"],
      "properties": {
        "count": {"$ref": "#/$defs/positiveU32"},
        "issue_ports": {"$ref": "#/$defs/positiveU32"}
      }
    },
    "smspResourcesOrGap": {
      "oneOf": [
        {"$ref": "#/$defs/smspResources"},
        {"$ref": "#/$defs/researchGap"}
      ]
    },
    "occupancyResources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_resident_warps_per_sm", "max_blocks"],
      "properties": {
        "max_resident_warps_per_sm": {"$ref": "#/$defs/positiveU32"},
        "max_blocks": {"$ref": "#/$defs/positiveU32"}
      }
    },
    "occupancyResourcesOrGap": {
      "oneOf": [
        {"$ref": "#/$defs/occupancyResources"},
        {"$ref": "#/$defs/researchGap"}
      ]
    },
    "runtimeLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_resident_warps_per_sm",
        "max_blocks_per_sm",
        "max_threads_per_sm", "max_threads_per_block", "sm_id_upper_bound", "warp_id_upper_bound",
        "max_shared_memory_per_sm_bytes",
        "max_shared_memory_per_block_bytes",
        "max_shared_memory_per_block_optin_bytes",
        "shared_memory_carveout_kib",
        "provenance"
      ],
      "properties": {
        "max_resident_warps_per_sm": {"$ref": "#/$defs/positiveU32"},
        "max_blocks_per_sm": {"$ref": "#/$defs/positiveU32"},
        "max_threads_per_sm": {"$ref": "#/$defs/positiveU32"},
        "max_threads_per_block": {"$ref": "#/$defs/positiveU32"},
        "sm_id_upper_bound": {"$ref": "#/$defs/positiveU32"},
        "warp_id_upper_bound": {"$ref": "#/$defs/positiveU32"},
        "max_shared_memory_per_sm_bytes": {"$ref": "#/$defs/positiveU64"},
        "max_shared_memory_per_block_bytes": {"$ref": "#/$defs/positiveU64"},
        "max_shared_memory_per_block_optin_bytes": {"$ref": "#/$defs/positiveU64"},
        "shared_memory_carveout_kib": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 0, "maximum": 4294967295}
        },
        "provenance": {"type": "string", "minLength": 1}
      }
    },
    "runtimeLimitsOrGap": {
      "oneOf": [
        {"$ref": "#/$defs/runtimeLimits"},
        {"$ref": "#/$defs/researchGap"}
      ]
    },
    "depBarrierResources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count"],
      "properties": {
        "count": {"$ref": "#/$defs/positiveU32"}
      }
    },
    "depBarrierResourcesOrGap": {
      "oneOf": [
        {"$ref": "#/$defs/depBarrierResources"},
        {"$ref": "#/$defs/researchGap"}
      ]
    },
    "barrierLatencyResources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "non_memory_write"],
      "properties": {
        "read": {"$ref": "#/$defs/positiveU64"},
        "non_memory_write": {"$ref": "#/$defs/positiveU64"}
      }
    },
    "barrierLatencyResourcesOrGap": {
      "oneOf": [
        {"$ref": "#/$defs/barrierLatencyResources"},
        {"$ref": "#/$defs/researchGap"}
      ]
    },
    "boolOrResearchGap": {
      "oneOf": [
        {"type": "boolean"},
        {"$ref": "#/$defs/researchGap"}
      ]
    },
    "dualIssueResources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported"],
      "properties": {
        "supported": {"$ref": "#/$defs/boolOrResearchGap"}
      }
    },
    "dualIssueResourcesOrGap": {
      "oneOf": [
        {"$ref": "#/$defs/dualIssueResources"},
        {"$ref": "#/$defs/researchGap"}
      ]
    },
    "intOrGap": {"anyOf": [{"type": "integer"}, {"$ref": "#/$defs/researchGap"}]},
    "numOrGap": {"anyOf": [{"type": "number"}, {"$ref": "#/$defs/researchGap"}]},
    "objOrGap": {
      "anyOf": [
        {"type": "object", "not": {"required": ["status"]}},
        {"$ref": "#/$defs/researchGap"},
        {"type": "null"}
      ]
    }
  }
}

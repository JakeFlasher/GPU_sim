{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "simt_program.schema.json",
  "title": "Minimal functional SIMT program",
  "description": "Feasibility input for sim-arch::simt; not a production ISA or timing trace.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "architecture", "isa", "instructions"],
  "properties": {
    "schema_version": {"const": 1},
    "architecture": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "isa": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "initial_memory": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 4294967295}
    },
    "initial_shared_memory": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 4294967295}
    },
    "instructions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "oneOf": [
          {"type": "object", "additionalProperties": false, "required": ["op", "dst"], "properties": {"op": {"const": "set_lane_id"}, "dst": {"type": "integer", "minimum": 0, "maximum": 31}}},
          {"type": "object", "additionalProperties": false, "required": ["op", "dst", "base", "stride"], "properties": {"op": {"const": "load"}, "dst": {"type": "integer", "minimum": 0, "maximum": 31}, "base": {"type": "integer", "minimum": 0, "maximum": 4294967295, "multipleOf": 4}, "stride": {"type": "integer", "minimum": 0, "maximum": 4294967295, "multipleOf": 4}}},
          {"type": "object", "additionalProperties": false, "required": ["op", "dst", "base", "stride"], "properties": {"op": {"const": "load_shared"}, "dst": {"type": "integer", "minimum": 0, "maximum": 31}, "base": {"type": "integer", "minimum": 0, "maximum": 4294967295, "multipleOf": 4}, "stride": {"type": "integer", "minimum": 0, "maximum": 4294967295, "multipleOf": 4}}},
          {"type": "object", "additionalProperties": false, "required": ["op", "dst", "src", "imm"], "properties": {"op": {"const": "add_imm"}, "dst": {"type": "integer", "minimum": 0, "maximum": 31}, "src": {"type": "integer", "minimum": 0, "maximum": 31}, "imm": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647}}},
          {"type": "object", "additionalProperties": false, "required": ["op", "dst", "src"], "properties": {"op": {"const": "broadcast_lane0"}, "dst": {"type": "integer", "minimum": 0, "maximum": 31}, "src": {"type": "integer", "minimum": 0, "maximum": 31}}},
          {"type": "object", "additionalProperties": false, "required": ["op", "dst", "src"], "properties": {"op": {"const": "reduce_add"}, "dst": {"type": "integer", "minimum": 0, "maximum": 31}, "src": {"type": "integer", "minimum": 0, "maximum": 31}}},
          {"type": "object", "additionalProperties": false, "required": ["op", "dst", "lhs", "rhs"], "properties": {"op": {"const": "add"}, "dst": {"type": "integer", "minimum": 0, "maximum": 31}, "lhs": {"type": "integer", "minimum": 0, "maximum": 31}, "rhs": {"type": "integer", "minimum": 0, "maximum": 31}}},
          {"type": "object", "additionalProperties": false, "required": ["op", "base", "stride", "src"], "properties": {"op": {"const": "store"}, "base": {"type": "integer", "minimum": 0, "maximum": 4294967295, "multipleOf": 4}, "stride": {"type": "integer", "minimum": 0, "maximum": 4294967295, "multipleOf": 4}, "src": {"type": "integer", "minimum": 0, "maximum": 31}}},
          {"type": "object", "additionalProperties": false, "required": ["op", "base", "stride", "src"], "properties": {"op": {"const": "store_shared"}, "base": {"type": "integer", "minimum": 0, "maximum": 4294967295, "multipleOf": 4}, "stride": {"type": "integer", "minimum": 0, "maximum": 4294967295, "multipleOf": 4}, "src": {"type": "integer", "minimum": 0, "maximum": 31}}},
          {"type": "object", "additionalProperties": false, "required": ["op", "base", "stride", "src", "dst"], "properties": {"op": {"const": "atomic_add_shared"}, "base": {"type": "integer", "minimum": 0, "maximum": 4294967295, "multipleOf": 4}, "stride": {"type": "integer", "minimum": 0, "maximum": 4294967295, "multipleOf": 4}, "src": {"type": "integer", "minimum": 0, "maximum": 31}, "dst": {"type": "integer", "minimum": 0, "maximum": 31}}},
          {"type": "object", "additionalProperties": false, "required": ["op", "base", "stride", "src", "group"], "properties": {"op": {"const": "async_store"}, "base": {"type": "integer", "minimum": 0, "maximum": 4294967295, "multipleOf": 4}, "stride": {"type": "integer", "minimum": 0, "maximum": 4294967295, "multipleOf": 4}, "src": {"type": "integer", "minimum": 0, "maximum": 31}, "group": {"type": "integer", "minimum": 0, "maximum": 255}}},
          {"type": "object", "additionalProperties": false, "required": ["op", "group"], "properties": {"op": {"const": "wait_group"}, "group": {"type": "integer", "minimum": 0, "maximum": 255}}},
          {"type": "object", "additionalProperties": false, "required": ["op", "id"], "properties": {"op": {"const": "group_barrier"}, "id": {"type": "integer", "minimum": 0, "maximum": 255}}},
          {"type": "object", "additionalProperties": false, "required": ["op"], "properties": {"op": {"const": "halt"}}}
        ]
      }
    }
  }
}

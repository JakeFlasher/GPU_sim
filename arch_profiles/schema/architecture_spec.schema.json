{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "architecture_spec.schema.json",
  "title": "User-defined GPU architecture specification",
  "description": "Experimental, unvalidated architecture shape for the bounded functional/timing backends. This is not an evidence-bound silicon card.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "architecture",
    "isa",
    "execution",
    "resources",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "architecture": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "isa": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "instruction_set": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "simt_width",
        "max_resident_groups"
      ],
      "properties": {
        "simt_width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "max_resident_groups": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "issue_width"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "kind": {
            "enum": [
              "compute",
              "memory",
              "synchronization",
              "custom"
            ]
          },
          "issue_width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "initiation_interval": {
            "type": "integer",
            "minimum": 1,
            "maximum": 18446744073709551615
          },
          "max_in_flight": {
            "type": ["integer", "null"],
            "minimum": 1,
            "maximum": 4294967295
          },
          "latency_cycles": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 18446744073709551615,
            "description": "Absent or null means unknown; a timing backend must not invent a default."
          }
        }
      }
    },
    "operation_resources": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      }
    },
    "evidence": {
      "enum": [
        "documented",
        "measured",
        "inferred",
        "unvalidated"
      ]
    }
  }
}

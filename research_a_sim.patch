+                continue;
+            }
+            active = active.saturating_add(1);
+            if let Some(expected) = first {
+                if expected != (address, access.data_width_bytes) {
+                    uniform = false;
+                }
+            } else {
+                first = Some((address, access.data_width_bytes));
+            }
+        }
+    });

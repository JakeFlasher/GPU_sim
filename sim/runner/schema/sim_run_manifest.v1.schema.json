{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sim_run_manifest.v1.schema.json",
  "title": "Simulator run manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope",
    "architecture",
    "configuration_evidence",
    "launches",
    "replay_mode"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "scope": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[!-~]+$"
    },
    "architecture": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["arch_id", "sku"],
          "properties": {
            "arch_id": { "const": "sm_86" },
            "sku": { "const": "rtx_3090_ti" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["arch_id", "sku"],
          "properties": {
            "arch_id": { "const": "sm_120" },
            "sku": { "const": "rtx_5060_laptop" }
          }
        }
      ]
    },
    "configuration_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arch_card_sha256", "pchase_card_sha256"],
      "properties": {
        "arch_card_sha256": { "$ref": "#/definitions/sha256" },
        "pchase_card_sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "launches": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "launch_evidence_manifest_path",
          "expected_identity_sha256"
        ],
        "properties": {
          "launch_evidence_manifest_path": {
            "$ref": "#/definitions/relativePath"
          },
          "expected_identity_sha256": { "$ref": "#/definitions/sha256" }
        }
      }
    },
    "replay_mode": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": { "mode": { "const": "flat" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": { "mode": { "const": "l1_const" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "dram_bandwidth"],
          "properties": {
            "mode": { "const": "l1_shared_l2" },
            "dram_bandwidth": { "enum": ["carded", "unmodeled"] }
          }
        }
      ]
    }
  },
  "definitions": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._/-]+$",
      "not": {
        "anyOf": [
          { "pattern": "^/" },
          { "pattern": "/$" },
          { "pattern": "//" },
          { "pattern": "[\\r\\n]" },
          { "pattern": "(^|/)\\.\\.?(/|$)" }
        ]
      }
    }
  }
}

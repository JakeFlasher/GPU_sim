{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpu-simulator.local/sim/run/schema/sim_run_manifest.v2.schema.json",
  "title": "Simulator run manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope",
    "architecture",
    "configuration_evidence",
    "launches",
    "replay_mode"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[!-~]+$"
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arch_id",
        "sku"
      ],
      "properties": {
        "arch_id": {
          "const": "sm_86"
        },
        "sku": {
          "const": "rtx_3090_ti"
        }
      },
      "description": "The P1 prototype admits only the RTX 3090 Ti sm_86 architecture card."
    },
    "configuration_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arch_card_sha256",
        "pchase_card_sha256"
      ],
      "properties": {
        "arch_card_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "pchase_card_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "launches": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "launch_evidence_manifest_path",
          "expected_identity_sha256",
          "launch_key"
        ],
        "properties": {
          "launch_evidence_manifest_path": {
            "$ref": "#/$defs/relativePath"
          },
          "expected_identity_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "launch_key": {
            "$ref": "https://gpu-simulator.local/eval/schemas/launch_key.v1.schema.json"
          }
        }
      },
      "description": "Each entry carries the complete nine-field launch key and immutable launch-evidence identity. Admission must compare exactly the six replay-visible fields kernel_mangled_name, grid, block, device_id, stream_id, and binary_architecture against authenticated trace/evidence. workload_id, matched_execution_id, and process_launch_ordinal are cohort assertions that the manifest carries but cannot authenticate; they become claimable only through independently sealed label/crosswalk evidence. Consumers must reject duplicate complete keys."
    },
    "replay_mode": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "flat"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "l1_const"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "dram_bandwidth"
          ],
          "properties": {
            "mode": {
              "const": "l1_shared_l2"
            },
            "dram_bandwidth": {
              "enum": [
                "carded",
                "unmodeled"
              ]
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._/-]+$",
      "not": {
        "anyOf": [
          {
            "pattern": "^/"
          },
          {
            "pattern": "/$"
          },
          {
            "pattern": "//"
          },
          {
            "pattern": "[\\r\\n]"
          },
          {
            "pattern": "(^|/)\\.\\.?(/|$)"
          }
        ]
      }
    },
    "nonemptyString": {
      "type": "string",
      "minLength": 1
    },
    "u64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    }
  },
  "description": "Closed, target-free simulator input contract. It carries artifact evidence, architecture-card evidence, replay configuration, and the complete nine-field launch key. Authenticated trace/evidence governs exactly six replay-visible fields; the three cohort fields are carried assertions requiring independent sealed label/crosswalk authority. NCU values, labels, targets, and baseline runtimes are not inputs and are rejected by closure."
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpu-simulator.local/sim/run/schema/sim_result.v2.schema.json",
  "title": "Canonical simulator result v2",
  "description": "Closed, target-free successful simulator output contract. Metric maps contain exactly the retained 7+1 keys. Early failures use sim_error.v2; NCU labels, target values, baseline runtimes, scientific-authority assertions, and hardware-readiness assertions are not result fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_sha256",
    "build_identity",
    "trace_identity",
    "arch_card_identity",
    "configuration_identity",
    "resolved_configuration",
    "launches",
    "aggregate",
    "diagnostics",
    "exit_status"
  ],
  "properties": {
    "schema_version": {
      "const": "sim_result.v2"
    },
    "result_sha256": {
      "$ref": "#/$defs/sha256",
      "description": "SHA-256 of the repository-canonical JSON serialization of this document with the result_sha256 member omitted."
    },
    "build_identity": {
      "$ref": "#/$defs/buildIdentity"
    },
    "trace_identity": {
      "$ref": "#/$defs/traceIdentity"
    },
    "arch_card_identity": {
      "$ref": "#/$defs/archCardIdentity"
    },
    "configuration_identity": {
      "$ref": "#/$defs/configurationIdentity"
    },
    "resolved_configuration": {
      "$ref": "#/$defs/resolvedConfiguration"
    },
    "launches": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/perLaunch"
      }
    },
    "aggregate": {
      "$ref": "#/$defs/aggregate"
    },
    "diagnostics": {
      "$ref": "#/$defs/diagnostics"
    },
    "exit_status": {
      "$ref": "#/$defs/exitStatus"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "canonicalRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._/-]+$",
      "not": {
        "anyOf": [
          {
            "pattern": "^/"
          },
          {
            "pattern": "/$"
          },
          {
            "pattern": "//"
          },
          {
            "pattern": "[\\r\\n]"
          },
          {
            "pattern": "(^|/)\\.\\.?(/|$)"
          }
        ]
      }
    },
    "nonemptyString": {
      "type": "string",
      "minLength": 1
    },
    "u64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "positiveU64": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "positiveU32": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "replayMode": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "flat"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "l1_const"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "dram_bandwidth"
          ],
          "properties": {
            "mode": {
              "const": "l1_shared_l2"
            },
            "dram_bandwidth": {
              "enum": [
                "carded",
                "unmodeled"
              ]
            }
          }
        }
      ]
    },
    "issueConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arch",
        "l1_hit_latency_cycles",
        "l1_miss_latency_cycles",
        "global_flat_latency_cycles",
        "shared_write_barrier_latency_cycles",
        "non_memory_write_barrier_latency_cycles",
        "read_barrier_latency_cycles",
        "max_resident_warps_per_sm",
        "latency_provenance",
        "issue_hypothesis_provenance"
      ],
      "properties": {
        "arch": {
          "const": "sm_86"
        },
        "l1_hit_latency_cycles": {
          "$ref": "#/$defs/positiveU64"
        },
        "l1_miss_latency_cycles": {
          "$ref": "#/$defs/positiveU64"
        },
        "global_flat_latency_cycles": {
          "$ref": "#/$defs/positiveU64"
        },
        "shared_write_barrier_latency_cycles": {
          "$ref": "#/$defs/positiveU64"
        },
        "non_memory_write_barrier_latency_cycles": {
          "$ref": "#/$defs/positiveU64"
        },
        "read_barrier_latency_cycles": {
          "$ref": "#/$defs/positiveU64"
        },
        "max_resident_warps_per_sm": {
          "$ref": "#/$defs/positiveU32"
        },
        "latency_provenance": {
          "const": "architecture_card"
        },
        "issue_hypothesis_provenance": {
          "const": "architecture_local_reviewed_hypothesis"
        }
      }
    },
    "l1Configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arch",
        "line_capacity",
        "capacity_bytes",
        "mshr_count",
        "hit_latency_cycles",
        "miss_latency_cycles",
        "capacity_provenance",
        "mshr_provenance",
        "replacement_model",
        "replacement_provenance",
        "set_mapping_model",
        "set_mapping_provenance"
      ],
      "properties": {
        "arch": {
          "const": "sm_86"
        },
        "line_capacity": {
          "$ref": "#/$defs/positiveU64"
        },
        "capacity_bytes": {
          "$ref": "#/$defs/positiveU64"
        },
        "mshr_count": {
          "$ref": "#/$defs/positiveU32"
        },
        "hit_latency_cycles": {
          "$ref": "#/$defs/positiveU64"
        },
        "miss_latency_cycles": {
          "$ref": "#/$defs/positiveU64"
        },
        "capacity_provenance": {
          "$ref": "#/$defs/nonemptyString"
        },
        "mshr_provenance": {
          "$ref": "#/$defs/nonemptyString"
        },
        "replacement_model": {
          "$ref": "#/$defs/nonemptyString"
        },
        "replacement_provenance": {
          "$ref": "#/$defs/nonemptyString"
        },
        "set_mapping_model": {
          "$ref": "#/$defs/nonemptyString"
        },
        "set_mapping_provenance": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "l2Configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arch",
        "capacity_bytes",
        "line_bytes",
        "sector_bytes",
        "num_slices",
        "associativity",
        "replacement",
        "slice_hash",
        "geometry_provenance",
        "hypothesis_provenance"
      ],
      "properties": {
        "arch": {
          "const": "sm_86"
        },
        "capacity_bytes": {
          "$ref": "#/$defs/positiveU64"
        },
        "line_bytes": {
          "$ref": "#/$defs/positiveU32"
        },
        "sector_bytes": {
          "$ref": "#/$defs/positiveU32"
        },
        "num_slices": {
          "$ref": "#/$defs/positiveU32"
        },
        "associativity": {
          "$ref": "#/$defs/positiveU32"
        },
        "replacement": {
          "enum": [
            "lru",
            "srrip",
            "bip"
          ]
        },
        "slice_hash": {
          "enum": [
            "line_mod",
            "sector_mod",
            "xor_folded",
            "knuth_mult",
            "shift_mod",
            "bit_reverse"
          ]
        },
        "geometry_provenance": {
          "const": "architecture_card"
        },
        "hypothesis_provenance": {
          "const": "architecture_local_reviewed_default"
        }
      }
    },
    "unmodeledL1Flat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "const": "unmodeled"
        },
        "reason": {
          "const": "replay_mode_flat"
        }
      }
    },
    "unmodeledNoSharedL2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "const": "unmodeled"
        },
        "reason": {
          "const": "replay_mode_without_shared_l2"
        }
      }
    },
    "modeledL1Configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "value"
      ],
      "properties": {
        "status": {
          "const": "modeled"
        },
        "value": {
          "$ref": "#/$defs/l1Configuration"
        }
      }
    },
    "modeledL2Configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "value"
      ],
      "properties": {
        "status": {
          "const": "modeled"
        },
        "value": {
          "$ref": "#/$defs/l2Configuration"
        }
      }
    },
    "dramConfigurationUnmodeled": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "provenance"
      ],
      "properties": {
        "mode": {
          "const": "unmodeled"
        },
        "provenance": {
          "const": "explicit_manifest_ablation"
        }
      }
    },
    "dramConfigurationCarded": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "bytes_per_sec",
        "sm_clock_hz",
        "provenance"
      ],
      "properties": {
        "mode": {
          "const": "carded"
        },
        "bytes_per_sec": {
          "$ref": "#/$defs/positiveU64"
        },
        "sm_clock_hz": {
          "$ref": "#/$defs/positiveU64"
        },
        "provenance": {
          "const": "architecture_card_locked_operating_point"
        }
      }
    },
    "modeledDramUnmodeled": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "value"
      ],
      "properties": {
        "status": {
          "const": "modeled"
        },
        "value": {
          "$ref": "#/$defs/dramConfigurationUnmodeled"
        }
      }
    },
    "modeledDramCarded": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "value"
      ],
      "properties": {
        "status": {
          "const": "modeled"
        },
        "value": {
          "$ref": "#/$defs/dramConfigurationCarded"
        }
      }
    },
    "resolvedConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replay_mode",
        "co_residency",
        "issue",
        "l1",
        "l2",
        "dram"
      ],
      "properties": {
        "replay_mode": {
          "$ref": "#/$defs/replayMode"
        },
        "co_residency": {
          "const": "modeled"
        },
        "issue": {
          "$ref": "#/$defs/issueConfiguration"
        },
        "l1": {
          "oneOf": [
            {
              "$ref": "#/$defs/unmodeledL1Flat"
            },
            {
              "$ref": "#/$defs/modeledL1Configuration"
            }
          ]
        },
        "l2": {
          "oneOf": [
            {
              "$ref": "#/$defs/unmodeledNoSharedL2"
            },
            {
              "$ref": "#/$defs/modeledL2Configuration"
            }
          ]
        },
        "dram": {
          "oneOf": [
            {
              "$ref": "#/$defs/unmodeledNoSharedL2"
            },
            {
              "$ref": "#/$defs/modeledDramUnmodeled"
            },
            {
              "$ref": "#/$defs/modeledDramCarded"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "replay_mode": {
                "properties": {
                  "mode": {
                    "const": "flat"
                  }
                },
                "required": [
                  "mode"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "l1": {
                "$ref": "#/$defs/unmodeledL1Flat"
              },
              "l2": {
                "$ref": "#/$defs/unmodeledNoSharedL2"
              },
              "dram": {
                "$ref": "#/$defs/unmodeledNoSharedL2"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "replay_mode": {
                "properties": {
                  "mode": {
                    "const": "l1_const"
                  }
                },
                "required": [
                  "mode"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "l1": {
                "$ref": "#/$defs/modeledL1Configuration"
              },
              "l2": {
                "$ref": "#/$defs/unmodeledNoSharedL2"
              },
              "dram": {
                "$ref": "#/$defs/unmodeledNoSharedL2"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "replay_mode": {
                "properties": {
                  "mode": {
                    "const": "l1_shared_l2"
                  },
                  "dram_bandwidth": {
                    "const": "unmodeled"
                  }
                },
                "required": [
                  "mode",
                  "dram_bandwidth"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "l1": {
                "$ref": "#/$defs/modeledL1Configuration"
              },
              "l2": {
                "$ref": "#/$defs/modeledL2Configuration"
              },
              "dram": {
                "$ref": "#/$defs/modeledDramUnmodeled"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "replay_mode": {
                "properties": {
                  "mode": {
                    "const": "l1_shared_l2"
                  },
                  "dram_bandwidth": {
                    "const": "carded"
                  }
                },
                "required": [
                  "mode",
                  "dram_bandwidth"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "l1": {
                "$ref": "#/$defs/modeledL1Configuration"
              },
              "l2": {
                "$ref": "#/$defs/modeledL2Configuration"
              },
              "dram": {
                "$ref": "#/$defs/modeledDramCarded"
              }
            }
          }
        }
      ]
    },
    "modeledEventTime": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "value"
          ],
          "properties": {
            "status": {
              "const": "modeled"
            },
            "value": {
              "$ref": "#/$defs/u64"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
              "const": "unavailable"
            },
            "reason": {
              "const": "no_modeled_issue_or_system_event"
            }
          }
        }
      ]
    },
    "exactMetricValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "semantics",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "exact"
        },
        "semantics": {
          "const": "simulator_scope"
        },
        "value": {
          "$ref": "#/$defs/u64"
        }
      }
    },
    "fractionMetricValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "semantics",
        "value",
        "numerator",
        "denominator"
      ],
      "properties": {
        "kind": {
          "const": "fraction"
        },
        "semantics": {
          "const": "simulator_scope"
        },
        "value": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          ]
        },
        "numerator": {
          "$ref": "#/$defs/u64"
        },
        "denominator": {
          "$ref": "#/$defs/u64"
        }
      }
    },
    "predictedExact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "value"
      ],
      "properties": {
        "status": {
          "const": "predicted"
        },
        "value": {
          "$ref": "#/$defs/exactMetricValue"
        }
      }
    },
    "predictedFraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "value"
      ],
      "properties": {
        "status": {
          "const": "predicted"
        },
        "value": {
          "$ref": "#/$defs/fractionMetricValue"
        }
      }
    },
    "unavailableL1Tex": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "detail"
      ],
      "properties": {
        "status": {
          "const": "unavailable"
        },
        "detail": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason",
            "needs"
          ],
          "properties": {
            "reason": {
              "const": "mem_mode_lacks_unit"
            },
            "needs": {
              "const": "l1tex"
            }
          }
        }
      }
    },
    "unavailableLts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "detail"
      ],
      "properties": {
        "status": {
          "const": "unavailable"
        },
        "detail": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason",
            "needs"
          ],
          "properties": {
            "reason": {
              "const": "mem_mode_lacks_unit"
            },
            "needs": {
              "const": "lts"
            }
          }
        }
      }
    },
    "unavailableDram": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "detail"
      ],
      "properties": {
        "status": {
          "const": "unavailable"
        },
        "detail": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason",
            "needs"
          ],
          "properties": {
            "reason": {
              "const": "mem_mode_lacks_unit"
            },
            "needs": {
              "const": "dram"
            }
          }
        }
      }
    },
    "requiredBindingCycles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "blocking"
      ],
      "properties": {
        "status": {
          "const": "required_unimplemented"
        },
        "blocking": {
          "const": "aggregation_semantics_study"
        }
      }
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "buildIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sim_git_commit",
        "sim_git_dirty",
        "binary_sha256",
        "rustc_version",
        "cargo_profile",
        "claimability"
      ],
      "properties": {
        "sim_git_commit": {
          "$ref": "#/$defs/gitCommit"
        },
        "sim_git_dirty": {
          "type": "boolean"
        },
        "binary_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "rustc_version": {
          "$ref": "#/$defs/nonemptyString"
        },
        "cargo_profile": {
          "$ref": "#/$defs/nonemptyString"
        },
        "claimability": {
          "$ref": "#/$defs/buildClaimability"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "sim_git_dirty": {
                "const": false
              }
            },
            "required": [
              "sim_git_dirty"
            ]
          },
          "then": {
            "properties": {
              "claimability": {
                "properties": {
                  "status": {
                    "const": "claimable"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "sim_git_dirty": {
                "const": true
              }
            },
            "required": [
              "sim_git_dirty"
            ]
          },
          "then": {
            "properties": {
              "claimability": {
                "properties": {
                  "status": {
                    "const": "unclaimable"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "traceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_id",
        "bundle_path",
        "bundle_sha256",
        "wire_version",
        "total_size_bytes",
        "record_count",
        "instruction_count",
        "components"
      ],
      "properties": {
        "bundle_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "bundle_path": {
          "$ref": "#/$defs/canonicalRelativePath"
        },
        "bundle_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "wire_version": {
          "$ref": "#/$defs/nonemptyString"
        },
        "total_size_bytes": {
          "$ref": "#/$defs/positiveU64"
        },
        "record_count": {
          "$ref": "#/$defs/positiveU64"
        },
        "instruction_count": {
          "$ref": "#/$defs/positiveU64"
        },
        "components": {
          "$ref": "#/$defs/traceBundleComponents"
        }
      },
      "description": "Canonical replay-consumed trace-bundle identity. bundle_sha256 commits the root trace plus transitive threadblock payloads, execution metadata, control-bit sidecar, and stats. Every result launch must resolve to this same authenticated bundle; mixed bundles fail admission."
    },
    "archCardIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "card_id",
        "card_sha256",
        "sm_arch",
        "sku"
      ],
      "properties": {
        "card_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "card_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sm_arch": {
          "const": "sm_86"
        },
        "sku": {
          "const": "rtx_3090_ti"
        }
      }
    },
    "configurationIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configuration_id",
        "run_manifest_sha256",
        "resolved_configuration_sha256",
        "arch_card_sha256",
        "pchase_card_sha256"
      ],
      "properties": {
        "configuration_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "run_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "resolved_configuration_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "arch_card_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "pchase_card_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "metricMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "smsp_inst_executed_sum",
        "traffic_gmem_ld_sectors",
        "traffic_gmem_st_sectors",
        "traffic_dram_read_sectors",
        "cache_hit_rate_l1tex_read_sector",
        "cache_hit_rate_l1tex_sector",
        "cache_hit_rate_l2_sector",
        "exec_cycles_gpc_max"
      ],
      "properties": {
        "smsp_inst_executed_sum": {
          "$ref": "#/$defs/predictedExact"
        },
        "traffic_gmem_ld_sectors": {
          "oneOf": [
            {
              "$ref": "#/$defs/predictedExact"
            },
            {
              "$ref": "#/$defs/unavailableL1Tex"
            }
          ]
        },
        "traffic_gmem_st_sectors": {
          "oneOf": [
            {
              "$ref": "#/$defs/predictedExact"
            },
            {
              "$ref": "#/$defs/unavailableL1Tex"
            }
          ]
        },
        "traffic_dram_read_sectors": {
          "oneOf": [
            {
              "$ref": "#/$defs/predictedExact"
            },
            {
              "$ref": "#/$defs/unavailableDram"
            }
          ]
        },
        "cache_hit_rate_l1tex_read_sector": {
          "oneOf": [
            {
              "$ref": "#/$defs/predictedFraction"
            },
            {
              "$ref": "#/$defs/unavailableL1Tex"
            }
          ]
        },
        "cache_hit_rate_l1tex_sector": {
          "oneOf": [
            {
              "$ref": "#/$defs/predictedFraction"
            },
            {
              "$ref": "#/$defs/unavailableL1Tex"
            }
          ]
        },
        "cache_hit_rate_l2_sector": {
          "oneOf": [
            {
              "$ref": "#/$defs/predictedFraction"
            },
            {
              "$ref": "#/$defs/unavailableLts"
            }
          ]
        },
        "exec_cycles_gpc_max": {
          "$ref": "#/$defs/requiredBindingCycles"
        }
      },
      "description": "Exactly the seven implemented secondary metrics plus the binding cycles metric. Timing diagnostics cannot appear in this map."
    },
    "perLaunch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "launch_key",
        "metrics"
      ],
      "properties": {
        "launch_key": {
          "$ref": "https://gpu-simulator.local/eval/schemas/launch_key.v1.schema.json"
        },
        "metrics": {
          "$ref": "#/$defs/metricMap"
        }
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "launch_count",
        "metrics"
      ],
      "properties": {
        "scope": {
          "const": "all_launches"
        },
        "launch_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "metrics": {
          "$ref": "#/$defs/metricMap"
        }
      }
    },
    "smActiveObservationFrontier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_lower_bound_cycles",
        "issue_cycles",
        "terminal_lower_bound_cycles",
        "terminal_cycles",
        "envelope_cycles",
        "role"
      ],
      "properties": {
        "issue_lower_bound_cycles": { "$ref": "#/$defs/u64" },
        "issue_cycles": { "$ref": "#/$defs/u64" },
        "terminal_lower_bound_cycles": {
          "oneOf": [
            { "$ref": "#/$defs/u64" },
            { "type": "null" }
          ]
        },
        "terminal_cycles": {
          "oneOf": [
            { "$ref": "#/$defs/u64" },
            { "type": "null" }
          ]
        },
        "envelope_cycles": { "$ref": "#/$defs/u64" },
        "role": {
          "const": "architecture_scoped_sm_active_observation_boundary_not_raw_lower_bound"
        }
      }
    },
    "launchDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "launch_key",
        "diagnostic_last_issue_cycles",
        "terminal_modeled_event_time",
        "binding_cycles_role"
      ],
      "properties": {
        "launch_key": {
          "$ref": "https://gpu-simulator.local/eval/schemas/launch_key.v1.schema.json"
        },
        "diagnostic_last_issue_cycles": {
          "$ref": "#/$defs/u64"
        },
        "terminal_modeled_event_time": {
          "$ref": "#/$defs/modeledEventTime"
        },
        "sm_active_observation_frontier": {
          "$ref": "#/$defs/smActiveObservationFrontier"
        },
        "binding_cycles_role": {
          "const": "diagnostic_only_not_binding_prediction"
        }
      }
    },
    "internalPhaseTimings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace_open_ns",
        "trace_read_decode_ns",
        "initialization_ns",
        "replay_event_memory_ns",
        "emission_ns",
        "result_serialization_ns"
      ],
      "properties": {
        "trace_open_ns": {
          "$ref": "#/$defs/u64"
        },
        "trace_read_decode_ns": {
          "$ref": "#/$defs/u64"
        },
        "initialization_ns": {
          "$ref": "#/$defs/u64"
        },
        "replay_event_memory_ns": {
          "$ref": "#/$defs/u64"
        },
        "emission_ns": {
          "$ref": "#/$defs/u64"
        },
        "result_serialization_ns": {
          "$ref": "#/$defs/u64"
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "admissibility",
        "external_runtime_role",
        "per_launch"
      ],
      "properties": {
        "admissibility": {
          "const": "non_admissible"
        },
        "external_runtime_role": {
          "const": "internal_timings_do_not_replace_spawn_to_exit_wall_time"
        },
        "per_launch": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/launchDiagnostic"
          }
        },
        "internal_phase_timings_ns": {
          "$ref": "#/$defs/internalPhaseTimings"
        }
      }
    },
    "exitStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "exit_code"
      ],
      "properties": {
        "status": {
          "const": "success"
        },
        "exit_code": {
          "const": 0
        }
      }
    },
    "buildClaimability": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "basis"
          ],
          "properties": {
            "status": {
              "const": "claimable"
            },
            "basis": {
              "const": "clean_build"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
              "const": "unclaimable"
            },
            "reason": {
              "const": "dirty_build"
            }
          }
        }
      ]
    },
    "bundleComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "size_bytes": {
          "$ref": "#/$defs/positiveU64"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "threadblockPayloadSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_count",
        "total_size_bytes",
        "manifest_sha256",
        "content_sha256"
      ],
      "properties": {
        "file_count": {
          "$ref": "#/$defs/positiveU64"
        },
        "total_size_bytes": {
          "$ref": "#/$defs/positiveU64"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "traceBundleComponents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_dynamic_trace",
        "threadblock_payloads",
        "execution_metadata",
        "control_bits_sidecar",
        "stats"
      ],
      "properties": {
        "root_dynamic_trace": {
          "$ref": "#/$defs/bundleComponent"
        },
        "threadblock_payloads": {
          "$ref": "#/$defs/threadblockPayloadSet"
        },
        "execution_metadata": {
          "$ref": "#/$defs/bundleComponent"
        },
        "control_bits_sidecar": {
          "$ref": "#/$defs/bundleComponent"
        },
        "stats": {
          "$ref": "#/$defs/bundleComponent"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phasefuse_scale.v1.schema.json",
  "title": "SM86 PhaseFuse descriptor scaling case v1",
  "description": "Synthetic causal-frontier analyzer evidence; not native trace timing or silicon validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "case_key", "seed", "n_records", "program_count", "region_len",
    "residency", "input_order", "build_input_ns", "api_wall_ns", "planner_time_ns",
    "exact_execution_steps", "causal_execution_steps", "exact_final_cycle",
    "causal_final_cycle", "candidate_regions", "collapsed_regions", "reified_regions",
    "candidate_instructions", "collapsed_instructions", "terminal_state_matches",
    "refusal_reasons"
  ],
  "properties": {
    "schema": {"const": "phasefuse_scale_v1"},
    "case_key": {"type": "string", "minLength": 1},
    "seed": {"type": "integer", "minimum": 0},
    "n_records": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "program_count": {"const": 4},
    "region_len": {"enum": [1, 2, 8, 64]},
    "residency": {"enum": ["complete", "unknown"]},
    "input_order": {"enum": ["sorted", "shuffled"]},
    "build_input_ns": {"type": "integer", "minimum": 0},
    "api_wall_ns": {"type": "integer", "minimum": 0},
    "planner_time_ns": {"type": "integer", "minimum": 0},
    "exact_execution_steps": {"type": "integer", "minimum": 0},
    "causal_execution_steps": {"type": "integer", "minimum": 0},
    "exact_final_cycle": {"type": "integer", "minimum": 0},
    "causal_final_cycle": {"type": "integer", "minimum": 0},
    "candidate_regions": {"type": "integer", "minimum": 0},
    "collapsed_regions": {"type": "integer", "minimum": 0},
    "reified_regions": {"type": "integer", "minimum": 0},
    "candidate_instructions": {"type": "integer", "minimum": 0},
    "collapsed_instructions": {"type": "integer", "minimum": 0},
    "terminal_state_matches": {"type": "boolean"},
    "refusal_reasons": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    }
  }
}

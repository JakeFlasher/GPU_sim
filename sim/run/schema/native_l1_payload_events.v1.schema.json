{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "native_l1_payload_events.v1.schema.json",
  "title": "Native L1 payload admission events v1",
  "description": "Producer-supplied simulator-cycle value events; not hardware cache or completion telemetry.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "events"],
  "properties": {
    "schema": {"const": "native_l1_payload_events_v1"},
    "status": {"const": "ok"},
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000000,
      "items": {"$ref": "#/$defs/event"}
    }
  },
  "$defs": {
    "u32": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "u64": {"type": "integer", "minimum": 0},
    "positiveU64": {"type": "integer", "minimum": 1},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["launch_id", "function_unique_id", "cta", "warp", "lane", "pc", "occurrence"],
      "properties": {
        "launch_id": {"$ref": "#/$defs/positiveU64"},
        "function_unique_id": {"type": "integer", "minimum": 1},
        "cta": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/u32"}
        },
        "warp": {"type": "integer", "minimum": 0, "maximum": 31},
        "lane": {"type": "integer", "minimum": 0, "maximum": 31},
        "pc": {"$ref": "#/$defs/u32"},
        "occurrence": {"$ref": "#/$defs/u32"}
      }
    },
    "witness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line_id", "allocation_id", "allocation_generation", "resident_generation", "resident_sector_mask"],
      "properties": {
        "line_id": {"type": "integer"},
        "allocation_id": {"$ref": "#/$defs/positiveU64"},
        "allocation_generation": {"$ref": "#/$defs/positiveU64"},
        "resident_generation": {"$ref": "#/$defs/u32"},
        "resident_sector_mask": {"type": "integer", "minimum": 1, "maximum": 15}
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allocation_id", "generation", "line_id", "sector", "byte_offset", "bytes_hex", "known_mask", "sequence"],
      "properties": {
        "allocation_id": {"$ref": "#/$defs/positiveU64"},
        "generation": {"$ref": "#/$defs/positiveU64"},
        "line_id": {"type": "integer"},
        "sector": {"type": "integer", "minimum": 0, "maximum": 3},
        "byte_offset": {"type": "integer", "minimum": 0, "maximum": 31},
        "bytes_hex": {"type": "string", "pattern": "^(?:[0-9a-fA-F]{2}){1,32}$"},
        "known_mask": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "sequence": {"$ref": "#/$defs/positiveU64"}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cycle", "sm_id", "identity", "witnesses", "payloads"],
      "properties": {
        "cycle": {"$ref": "#/$defs/u64"},
        "sm_id": {"$ref": "#/$defs/u32"},
        "identity": {"$ref": "#/$defs/identity"},
        "witnesses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {"$ref": "#/$defs/witness"}
        },
        "payloads": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {"$ref": "#/$defs/payload"}
        }
      }
    }
  }
}

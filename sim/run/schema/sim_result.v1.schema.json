{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sim_result.v1.schema.json",
  "title": "Canonical simulator result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_sha256",
    "run_manifest_sha256",
    "scope",
    "architecture",
    "configuration_evidence",
    "resolved_configuration",
    "launches",
    "aggregate",
    "emissions",
    "scientific_authority",
    "hardware_readiness"
  ],
  "properties": {
    "schema_version": { "const": "sim_result.v1" },
    "result_sha256": { "$ref": "#/definitions/sha256" },
    "run_manifest_sha256": { "$ref": "#/definitions/sha256" },
    "scope": { "$ref": "#/definitions/scope" },
    "architecture": { "$ref": "#/definitions/architecture" },
    "configuration_evidence": { "$ref": "#/definitions/configurationEvidence" },
    "resolved_configuration": { "$ref": "#/definitions/resolvedConfiguration" },
    "launches": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "$ref": "#/definitions/perLaunch" }
    },
    "aggregate": { "$ref": "#/definitions/aggregate" },
    "emissions": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "additionalItems": false,
      "items": [
        { "$ref": "#/definitions/emissionInstructions" },
        { "$ref": "#/definitions/emissionGlobalLoadSectors" },
        { "$ref": "#/definitions/emissionGlobalStoreSectors" },
        { "$ref": "#/definitions/emissionL1ReadHitRate" },
        { "$ref": "#/definitions/emissionL1HitRate" },
        { "$ref": "#/definitions/emissionL2HitRate" },
        { "$ref": "#/definitions/emissionDramReadSectors" },
        { "$ref": "#/definitions/emissionBindingCycles" }
      ]
    },
    "scientific_authority": { "const": "not_conferred" },
    "hardware_readiness": { "const": "not_asserted" }
  },
  "definitions": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[!-~]+$"
    },
    "canonicalRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._/-]+$",
      "not": {
        "anyOf": [
          { "pattern": "^/" },
          { "pattern": "/$" },
          { "pattern": "//" },
          { "pattern": "[\\r\\n]" },
          { "pattern": "(^|/)\\.\\.?(/|$)" }
        ]
      }
    },
    "nonemptyString": {
      "type": "string",
      "minLength": 1
    },
    "u64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "positiveU64": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "u32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "positiveU32": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "i64Nonnegative": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "i32Nonnegative": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "dim3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/definitions/positiveU32" }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arch_id", "sku"],
      "properties": {
        "arch_id": { "const": "sm_86" },
        "sku": { "const": "rtx_3090_ti" }
      }
    },
    "configurationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arch_card_sha256", "pchase_card_sha256"],
      "properties": {
        "arch_card_sha256": { "$ref": "#/definitions/sha256" },
        "pchase_card_sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "replayMode": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": { "mode": { "const": "flat" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": { "mode": { "const": "l1_const" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "dram_bandwidth"],
          "properties": {
            "mode": { "const": "l1_shared_l2" },
            "dram_bandwidth": { "enum": ["carded", "unmodeled"] }
          }
        }
      ]
    },
    "issueConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arch",
        "l1_hit_latency_cycles",
        "l1_miss_latency_cycles",
        "global_flat_latency_cycles",
        "shared_write_barrier_latency_cycles",
        "non_memory_write_barrier_latency_cycles",
        "read_barrier_latency_cycles",
        "max_resident_warps_per_sm",
        "latency_provenance",
        "issue_hypothesis_provenance"
      ],
      "properties": {
        "arch": { "const": "sm_86" },
        "l1_hit_latency_cycles": { "$ref": "#/definitions/positiveU64" },
        "l1_miss_latency_cycles": { "$ref": "#/definitions/positiveU64" },
        "global_flat_latency_cycles": { "$ref": "#/definitions/positiveU64" },
        "shared_write_barrier_latency_cycles": { "$ref": "#/definitions/positiveU64" },
        "non_memory_write_barrier_latency_cycles": { "$ref": "#/definitions/positiveU64" },
        "read_barrier_latency_cycles": { "$ref": "#/definitions/positiveU64" },
        "max_resident_warps_per_sm": { "$ref": "#/definitions/positiveU32" },
        "issue_ports": { "$ref": "#/definitions/positiveU32" },
        "dual_issue_supported": { "type": "boolean" },
        "latency_provenance": { "const": "architecture_card" },
        "issue_hypothesis_provenance": { "enum": ["architecture_local_reviewed_hypothesis", "architecture_card"] }
      }
    },
    "l1Configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arch",
        "line_capacity",
        "capacity_bytes",
        "mshr_count",
        "hit_latency_cycles",
        "miss_latency_cycles",
        "capacity_provenance",
        "mshr_provenance",
        "replacement_model",
        "replacement_provenance",
        "set_mapping_model",
        "set_mapping_provenance"
      ],
      "properties": {
        "arch": { "const": "sm_86" },
        "line_capacity": { "$ref": "#/definitions/positiveU64" },
        "capacity_bytes": { "$ref": "#/definitions/positiveU64" },
        "mshr_count": { "$ref": "#/definitions/positiveU32" },
        "hit_latency_cycles": { "$ref": "#/definitions/positiveU64" },
        "miss_latency_cycles": { "$ref": "#/definitions/positiveU64" },
        "capacity_provenance": { "$ref": "#/definitions/nonemptyString" },
        "mshr_provenance": { "$ref": "#/definitions/nonemptyString" },
        "replacement_model": { "$ref": "#/definitions/nonemptyString" },
        "replacement_provenance": { "$ref": "#/definitions/nonemptyString" },
        "set_mapping_model": { "$ref": "#/definitions/nonemptyString" },
        "set_mapping_provenance": { "$ref": "#/definitions/nonemptyString" }
      }
    },
    "l2Configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arch",
        "capacity_bytes",
        "line_bytes",
        "sector_bytes",
        "num_slices",
        "associativity",
        "replacement",
        "slice_hash",
        "geometry_provenance",
        "hypothesis_provenance"
      ],
      "properties": {
        "arch": { "const": "sm_86" },
        "capacity_bytes": { "$ref": "#/definitions/positiveU64" },
        "line_bytes": { "$ref": "#/definitions/positiveU32" },
        "sector_bytes": { "$ref": "#/definitions/positiveU32" },
        "num_slices": { "$ref": "#/definitions/positiveU32" },
        "associativity": { "$ref": "#/definitions/positiveU32" },
        "replacement": { "enum": ["lru", "srrip", "bip"] },
        "slice_hash": {
          "enum": [
            "line_mod",
            "sector_mod",
            "xor_folded",
            "knuth_mult",
            "shift_mod",
            "bit_reverse"
          ]
        },
        "geometry_provenance": { "const": "architecture_card" },
        "hypothesis_provenance": { "const": "architecture_local_reviewed_default" }
      }
    },
    "unmodeledL1Flat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": { "const": "unmodeled" },
        "reason": { "const": "replay_mode_flat" }
      }
    },
    "unmodeledNoSharedL2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": { "const": "unmodeled" },
        "reason": { "const": "replay_mode_without_shared_l2" }
      }
    },
    "modeledL1Configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value"],
      "properties": {
        "status": { "const": "modeled" },
        "value": { "$ref": "#/definitions/l1Configuration" }
      }
    },
    "modeledL2Configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value"],
      "properties": {
        "status": { "const": "modeled" },
        "value": { "$ref": "#/definitions/l2Configuration" }
      }
    },
    "dramConfigurationUnmodeled": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "provenance"],
      "properties": {
        "mode": { "const": "unmodeled" },
        "provenance": { "const": "explicit_manifest_ablation" }
      }
    },
    "dramConfigurationCarded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "bytes_per_sec", "sm_clock_hz", "provenance"],
      "properties": {
        "mode": { "const": "carded" },
        "bytes_per_sec": { "$ref": "#/definitions/positiveU64" },
        "sm_clock_hz": { "$ref": "#/definitions/positiveU64" },
        "provenance": { "const": "architecture_card_locked_operating_point" }
      }
    },
    "modeledDramUnmodeled": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value"],
      "properties": {
        "status": { "const": "modeled" },
        "value": { "$ref": "#/definitions/dramConfigurationUnmodeled" }
      }
    },
    "modeledDramCarded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value"],
      "properties": {
        "status": { "const": "modeled" },
        "value": { "$ref": "#/definitions/dramConfigurationCarded" }
      }
    },
    "resolvedConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replay_mode", "co_residency", "issue", "l1", "l2", "dram"],
      "properties": {
        "replay_mode": { "$ref": "#/definitions/replayMode" },
        "co_residency": { "const": "modeled" },
        "issue": { "$ref": "#/definitions/issueConfiguration" },
        "l1": {
          "oneOf": [
            { "$ref": "#/definitions/unmodeledL1Flat" },
            { "$ref": "#/definitions/modeledL1Configuration" }
          ]
        },
        "l2": {
          "oneOf": [
            { "$ref": "#/definitions/unmodeledNoSharedL2" },
            { "$ref": "#/definitions/modeledL2Configuration" }
          ]
        },
        "dram": {
          "oneOf": [
            { "$ref": "#/definitions/unmodeledNoSharedL2" },
            { "$ref": "#/definitions/modeledDramUnmodeled" },
            { "$ref": "#/definitions/modeledDramCarded" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "replay_mode": {
                "properties": { "mode": { "const": "flat" } },
                "required": ["mode"]
              }
            }
          },
          "then": {
            "properties": {
              "l1": { "$ref": "#/definitions/unmodeledL1Flat" },
              "l2": { "$ref": "#/definitions/unmodeledNoSharedL2" },
              "dram": { "$ref": "#/definitions/unmodeledNoSharedL2" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "replay_mode": {
                "properties": { "mode": { "const": "l1_const" } },
                "required": ["mode"]
              }
            }
          },
          "then": {
            "properties": {
              "l1": { "$ref": "#/definitions/modeledL1Configuration" },
              "l2": { "$ref": "#/definitions/unmodeledNoSharedL2" },
              "dram": { "$ref": "#/definitions/unmodeledNoSharedL2" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "replay_mode": {
                "properties": {
                  "mode": { "const": "l1_shared_l2" },
                  "dram_bandwidth": { "const": "unmodeled" }
                },
                "required": ["mode", "dram_bandwidth"]
              }
            }
          },
          "then": {
            "properties": {
              "l1": { "$ref": "#/definitions/modeledL1Configuration" },
              "l2": { "$ref": "#/definitions/modeledL2Configuration" },
              "dram": { "$ref": "#/definitions/modeledDramUnmodeled" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "replay_mode": {
                "properties": {
                  "mode": { "const": "l1_shared_l2" },
                  "dram_bandwidth": { "const": "carded" }
                },
                "required": ["mode", "dram_bandwidth"]
              }
            }
          },
          "then": {
            "properties": {
              "l1": { "$ref": "#/definitions/modeledL1Configuration" },
              "l2": { "$ref": "#/definitions/modeledL2Configuration" },
              "dram": { "$ref": "#/definitions/modeledDramCarded" }
            }
          }
        }
      ]
    },
    "sealedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size_bytes", "sha256"],
      "properties": {
        "size_bytes": { "$ref": "#/definitions/u64" },
        "sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "nullableSealedArtifact": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/definitions/sealedArtifact" }
      ]
    },
    "nullableSha256": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/definitions/sha256" }
      ]
    },
    "admittedKernel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mangled_name", "args_hash"],
      "properties": {
        "mangled_name": { "$ref": "#/definitions/nonemptyString" },
        "args_hash": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/definitions/nonemptyString" }
          ]
        }
      }
    },
    "admittedLaunch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_id", "stream_id", "kernel_id", "function_unique_id"],
      "properties": {
        "device_id": { "$ref": "#/definitions/i64Nonnegative" },
        "stream_id": { "$ref": "#/definitions/i64Nonnegative" },
        "kernel_id": { "$ref": "#/definitions/i32Nonnegative" },
        "function_unique_id": { "$ref": "#/definitions/i32Nonnegative" }
      }
    },
    "admittedGeometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grid_dim", "block_dim", "cluster_dim"],
      "properties": {
        "grid_dim": { "$ref": "#/definitions/dim3" },
        "block_dim": { "$ref": "#/definitions/dim3" },
        "cluster_dim": { "$ref": "#/definitions/dim3" }
      }
    },
    "wireAdmission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validator_contract_id",
        "launch_count",
        "threadblock_count",
        "instruction_count",
        "stats_row_count",
        "stats_expected_record_count",
        "stats_admitted_record_count"
      ],
      "properties": {
        "validator_contract_id": { "const": "sim_trace_wire_v1" },
        "launch_count": { "$ref": "#/definitions/positiveU64" },
        "threadblock_count": { "$ref": "#/definitions/positiveU64" },
        "instruction_count": { "$ref": "#/definitions/u64" },
        "stats_row_count": { "$ref": "#/definitions/positiveU64" },
        "stats_expected_record_count": { "$ref": "#/definitions/u64" },
        "stats_admitted_record_count": { "$ref": "#/definitions/u64" }
      }
    },
    "artifactDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dynamic_trace_pb",
        "threadblock_payload_file_count",
        "threadblock_payload_raw_bytes",
        "threadblock_payload_manifest_sha256",
        "threadblock_payload_sha256",
        "allocations_json",
        "trace_sampling_json",
        "trace_sampling_json_seal",
        "stats_csv",
        "enhanced_execution_info_json",
        "control_bits_sidecar"
      ],
      "properties": {
        "dynamic_trace_pb": { "$ref": "#/definitions/sealedArtifact" },
        "threadblock_payload_file_count": { "$ref": "#/definitions/positiveU64" },
        "threadblock_payload_raw_bytes": { "$ref": "#/definitions/u64" },
        "threadblock_payload_manifest_sha256": { "$ref": "#/definitions/sha256" },
        "threadblock_payload_sha256": { "$ref": "#/definitions/sha256" },
        "allocations_json": { "$ref": "#/definitions/nullableSealedArtifact" },
        "trace_sampling_json": { "$ref": "#/definitions/nullableSealedArtifact" },
        "trace_sampling_json_seal": { "$ref": "#/definitions/nullableSha256" },
        "stats_csv": { "$ref": "#/definitions/sealedArtifact" },
        "enhanced_execution_info_json": { "$ref": "#/definitions/sealedArtifact" },
        "control_bits_sidecar": { "$ref": "#/definitions/sealedArtifact" }
      }
    },
    "admittedArchitecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arch_id", "sku", "arch_card", "pchase_card"],
      "properties": {
        "arch_id": { "const": "sm_86" },
        "sku": { "const": "rtx_3090_ti" },
        "arch_card": { "$ref": "#/definitions/sealedArtifact" },
        "pchase_card": { "$ref": "#/definitions/sealedArtifact" }
      }
    },
    "admittedBinary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "digest"],
      "properties": {
        "name": { "$ref": "#/definitions/nonemptyString" },
        "digest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "gap"],
          "properties": {
            "status": { "const": "typed_gap" },
            "gap": { "const": "trace_contract_does_not_emit_binary_digest" }
          }
        }
      }
    },
    "admittedCoverage": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "blocks_observed"],
          "properties": {
            "type": { "const": "exact_full" },
            "blocks_observed": { "$ref": "#/definitions/positiveU64" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "blocks_observed", "sidecar_sha256"],
          "properties": {
            "type": { "const": "lossless_stored" },
            "blocks_observed": { "$ref": "#/definitions/positiveU64" },
            "sidecar_sha256": { "$ref": "#/definitions/sha256" }
          }
        }
      ]
    },
    "admittedIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "identity_sha256",
        "cell_id",
        "kernel",
        "launch",
        "geometry",
        "trace_contract_id",
        "memory_payload_classes",
        "wire_admission",
        "artifact_digests",
        "arch",
        "binary",
        "coverage"
      ],
      "properties": {
        "schema_version": { "const": 2 },
        "identity_sha256": { "$ref": "#/definitions/sha256" },
        "cell_id": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/definitions/nonemptyString" }
          ]
        },
        "kernel": { "$ref": "#/definitions/admittedKernel" },
        "launch": { "$ref": "#/definitions/admittedLaunch" },
        "geometry": { "$ref": "#/definitions/admittedGeometry" },
        "trace_contract_id": { "$ref": "#/definitions/nonemptyString" },
        "memory_payload_classes": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "additionalItems": false,
          "items": [
            { "const": "async_copy" },
            { "const": "atomic" },
            { "const": "global" },
            { "const": "local" },
            { "const": "shared" }
          ]
        },
        "wire_admission": { "$ref": "#/definitions/wireAdmission" },
        "artifact_digests": { "$ref": "#/definitions/artifactDigests" },
        "arch": { "$ref": "#/definitions/admittedArchitecture" },
        "binary": { "$ref": "#/definitions/admittedBinary" },
        "coverage": { "$ref": "#/definitions/admittedCoverage" }
      }
    },
    "launchBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_id",
        "stream_id",
        "kernel_id",
        "function_unique_id",
        "kernel_mangled_name",
        "grid",
        "block",
        "cluster"
      ],
      "properties": {
        "device_id": { "$ref": "#/definitions/i64Nonnegative" },
        "stream_id": { "$ref": "#/definitions/i64Nonnegative" },
        "kernel_id": { "$ref": "#/definitions/i32Nonnegative" },
        "function_unique_id": { "$ref": "#/definitions/i32Nonnegative" },
        "kernel_mangled_name": { "$ref": "#/definitions/nonemptyString" },
        "grid": { "$ref": "#/definitions/dim3" },
        "block": { "$ref": "#/definitions/dim3" },
        "cluster": { "$ref": "#/definitions/dim3" }
      }
    },
    "fullCoverage": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "blocks_observed"],
          "properties": {
            "type": { "const": "exact_full" },
            "blocks_observed": { "$ref": "#/definitions/positiveU64" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "blocks_observed",
            "selected_block_ids_sha256",
            "sidecar_sha256"
          ],
          "properties": {
            "type": { "const": "lossless_stored" },
            "blocks_observed": { "$ref": "#/definitions/positiveU64" },
            "selected_block_ids_sha256": { "$ref": "#/definitions/sha256" },
            "sidecar_sha256": { "$ref": "#/definitions/sha256" }
          }
        }
      ]
    },
    "modeledEventTime": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value"],
          "properties": {
            "status": { "const": "modeled" },
            "value": { "$ref": "#/definitions/u64" }
          }
        },
        {
          "type": "object",

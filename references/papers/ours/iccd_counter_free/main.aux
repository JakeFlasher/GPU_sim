\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Counter-free observability under the privilege wall.} Counter-bearing profiler surfaces and clock controls are unavailable when the host keeps the post-CVE-2018-6260 default restriction in place. The pipeline uses only permission-free signals from the tenant process, accepts recoverable metrics only after predefined checks, and reports non-identifiable metrics as mechanism-level certificates rather than unsupported point predictions.}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:overview}{{1}{2}{\textbf {Counter-free observability under the privilege wall.} Counter-bearing profiler surfaces and clock controls are unavailable when the host keeps the post-CVE-2018-6260 default restriction in place. The pipeline uses only permission-free signals from the tenant process, accepts recoverable metrics only after predefined checks, and reports non-identifiable metrics as mechanism-level certificates rather than unsupported point predictions}{figure.1}{}}

\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Microbenchmark validation against local Nsight Compute references.} Panels show Blackwell read-sector recovery, Ampere read/write traffic, Ampere L1 hit-rate boundary, and Blackwell L2 hit ratio by family. Accepted estimates follow the diagonal; unsupported estimates and certified families show the per-cell failure modes that suite averages would hide.}}{6}{figure.3}\protected@file@percent }
\newlabel{fig:microbench}{{3}{6}{\textbf {Microbenchmark validation against local Nsight Compute references.} Panels show Blackwell read-sector recovery, Ampere read/write traffic, Ampere L1 hit-rate boundary, and Blackwell L2 hit ratio by family. Accepted estimates follow the diagonal; unsupported estimates and certified families show the per-cell failure modes that suite averages would hide}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Benchmark-scale framework evidence.} Panel (a) reports SOL-ExecBench availability by genre on both GPUs. Panels (b)--(c) compare calibrated L1 and L2 hit-rate predictions with local Nsight Compute references on the RTX 3090 Ti cohort. Panel (d) summarizes cohort mean absolute errors against the thresholds shown in the panel; L1 points are circles and L2 points are diamonds.}}{6}{figure.4}\protected@file@percent }
\newlabel{fig:framework}{{4}{6}{\textbf {Benchmark-scale framework evidence.} Panel (a) reports SOL-ExecBench availability by genre on both GPUs. Panels (b)--(c) compare calibrated L1 and L2 hit-rate predictions with local Nsight Compute references on the RTX 3090 Ti cohort. Panel (d) summarizes cohort mean absolute errors against the thresholds shown in the panel; L1 points are circles and L2 points are diamonds}{figure.4}{}}

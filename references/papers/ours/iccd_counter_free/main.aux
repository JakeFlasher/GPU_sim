\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Why a reuse-distance trace succeeds and fails.} Visible reuse creates finite reuse distances that can be replayed. Reuse staged in scratchpad or registers can change hardware hit behavior without producing additional global-address observations, creating a structural erasure mechanism.}}{4}{figure.2}\protected@file@percent }
\newlabel{fig:reuse}{{2}{4}{\textbf {Why a reuse-distance trace succeeds and fails.} Visible reuse creates finite reuse distances that can be replayed. Reuse staged in scratchpad or registers can change hardware hit behavior without producing additional global-address observations, creating a structural erasure mechanism}{figure.2}{}}

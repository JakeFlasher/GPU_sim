  "reduction": {
    "primary": "dI = issue_on - issue_off",
    "secondary": "dC = (drain_on - issue_on) - (drain_off - issue_off)",
    "independent_unit": "process repetition; retain seven paired repetitions",
    "route_admission": "use NCU L1 lookup, LTS hit/miss, and DRAM sectors only as labels; do not infer route from cache operator",
    "retirement_frontier": "report issue endpoint and drain endpoint separately; never replace them with issue-plus-drain scalar timing"
  },
  "decision_rule": {
    "pass_or_identify": [
      "all correctness outputs are true and all seven process repetitions retain smid_before == smid_after",
      "issue and drain endpoints decode with no wait mask in the static report",
      "W1 L1/DRAM depth response is repeat-stable (MAD <= 0.5) and materially changes at the predeclared boundary",
      "route and placement effects remain consistent in the declared independent NCU labels",
      "the issue and post-issue completion effects point to one mechanism-local frontier without fitting a per-workload constant"
    ],
    "falsify_or_no_go": [
      "no material issue response (median <= 2 cycles) or no repeat-stable depth knee",
      "issue and drain effects disagree across repetitions or route order cannot be established",
      "SMID migration, incomplete trace/control/static evidence, or an unresolved output-store confound",
      "the observed effect cannot distinguish route-invariant acceptance from route-sensitive completion"
    ],
    "unknown_gate": "mixed or missing attribution, unavailable clock lock, or any failed bounded stage is reported as unknown and is not promoted into simulator timing"
  },
  "evidence_boundary": {
    "ncu_values_used_as_simulator_inputs": false,
    "simulator_inputs": ["NVBit trace", "static control sidecar", "sm_86 architecture card", "sm_86 pchase card"],
    "claim_limits": [
      "This is a GA102 burst issue/completion discriminator, not a queue-size or physical-stage proof.",
      "A negative or unknown result leaves current simulator timing unchanged.",
      "No JADE/HETR, CPU-GPU co-simulation, sm_120, or rejected-candidate scope is changed."
    ]
  }

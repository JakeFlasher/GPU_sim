{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpu-simulator.invalid/eval/schemas/model_seal.v1.schema.json",
  "title": "Target-free evaluator detached model seal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "schema_sha256",
    "sealed_schema_version",
    "sealed_artifact_kind",
    "sealed_schema_sha256",
    "sealed_model_sha256",
    "model_seal_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_kind": {"const": "EVALUATOR_MODEL_SEAL"},
    "schema_sha256": {"$ref": "#/$defs/sha256"},
    "sealed_schema_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "sealed_artifact_kind": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,127}(?![\\s\\S])"
    },
    "sealed_schema_sha256": {"$ref": "#/$defs/sha256"},
    "sealed_model_sha256": {"$ref": "#/$defs/sha256"},
    "model_seal_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    }
  }
}

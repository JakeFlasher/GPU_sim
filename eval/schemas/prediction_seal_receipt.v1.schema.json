{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpu-simulator.invalid/eval/schemas/prediction_seal_receipt.v1.schema.json",
  "title": "Explicitly fixture-only prediction-seal blocker v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "schema_sha256",
    "contract_mode",
    "production_eligibility",
    "evaluation_boundary",
    "phase_chain",
    "canonical_crosswalk_inventory",
    "cohort_candidate_inventory",
    "simulator_artifacts",
    "fixture_simulator_output_manifest",
    "expected_row_inventory",
    "cycles_prediction",
    "model_seal_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact_kind": {
      "const": "EVALUATOR_PREDICTION_SEAL_FIXTURE"
    },
    "schema_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "evaluation_boundary": {
      "$ref": "#/$defs/evaluation_boundary"
    },
    "phase_chain": {
      "$ref": "#/$defs/prediction_phase"
    },
    "canonical_crosswalk_inventory": {
      "$ref": "#/$defs/crosswalk_inventory"
    },
    "cohort_candidate_inventory": {
      "$ref": "#/$defs/candidate_inventory"
    },
    "simulator_artifacts": {
      "$ref": "#/$defs/simulator_artifacts"
    },
    "expected_row_inventory": {
      "$ref": "#/$defs/row_inventory"
    },
    "cycles_prediction": {
      "$ref": "#/$defs/cycles_prediction"
    },
    "model_seal_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "contract_mode": {
      "const": "FIXTURE_ONLY"
    },
    "production_eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason_codes"
      ],
      "properties": {
        "status": {
          "const": "UNAVAILABLE"
        },
        "reason_codes": {
          "const": [
            "COHORT_AUTHORITY_UNAVAILABLE",
            "SIMULATOR_OUTPUT_AUTHORITY_UNAVAILABLE"
          ]
        }
      }
    },
    "fixture_simulator_output_manifest": {
      "$ref": "#/$defs/output_manifest"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "safe_positive_integer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "ascii_token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9]+(?:[._-][A-Za-z0-9]+)*(?![\\s\\S])"
    },
    "evaluator_model_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_schema_version",
        "schema_version",
        "artifact_kind",
        "schema_sha256",
        "canonical_model_sha256",
        "model_seal_sha256"
      ],
      "properties": {
        "identity_schema_version": {
          "const": 1
        },
        "schema_version": {
          "const": 1
        },
        "artifact_kind": {
          "enum": [
            "EVALUATOR_PREREGISTRATION_FIXTURE",
            "EVALUATOR_LAUNCH_CROSSWALK"
          ]
        },
        "schema_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonical_model_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "model_seal_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "preregistration_reference": {
      "allOf": [
        {
          "$ref": "#/$defs/evaluator_model_identity"
        },
        {
          "properties": {
            "artifact_kind": {
              "const": "EVALUATOR_PREREGISTRATION_FIXTURE"
            }
          }
        }
      ]
    },
    "crosswalk_reference": {
      "allOf": [
        {
          "$ref": "#/$defs/evaluator_model_identity"
        },
        {
          "properties": {
            "artifact_kind": {
              "const": "EVALUATOR_LAUNCH_CROSSWALK"
            }
          }
        }
      ]
    },
    "prediction_phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chain_schema_version",
        "chain_mode",
        "chain_id_sha256",
        "phase",
        "phase_ordinal",
        "ordering_basis",
        "predecessor_receipt",
        "state_lifetime"
      ],
      "properties": {
        "chain_schema_version": {
          "const": 1
        },
        "chain_mode": {
          "const": "FIXTURE_ONLY"
        },
        "chain_id_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "phase": {
          "const": "PREDICTION_SEAL_FIXTURE"
        },
        "phase_ordinal": {
          "const": 1
        },
        "ordering_basis": {
          "const": "PHASE_ORDINAL_AND_EXACT_PREDECESSOR_HASH"
        },
        "predecessor_receipt": {
          "$ref": "#/$defs/preregistration_reference"
        },
        "state_lifetime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "preregistration_bindings",
            "prediction_bindings",
            "label_bundle_binding",
            "label_payload",
            "scoring"
          ],
          "properties": {
            "preregistration_bindings": {
              "const": "FIXTURE_SEALED_NONAUTHORITATIVE"
            },
            "prediction_bindings": {
              "const": "FIXTURE_SEALED_NONAUTHORITATIVE"
            },
            "label_bundle_binding": {
              "const": "BLOCKED_NOT_BOUND"
            },
            "label_payload": {
              "const": "ABSENT"
            },
            "scoring": {
              "const": "DISABLED"
            }
          }
        }
      }
    },
    "crosswalk_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_launch_identity_sha256",
        "crosswalk_model"
      ],
      "properties": {
        "canonical_launch_identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "crosswalk_model": {
          "$ref": "#/$defs/crosswalk_reference"
        }
      }
    },
    "crosswalk_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory_schema_version",
        "entry_count",
        "entries",
        "inventory_sha256"
      ],
      "properties": {
        "inventory_schema_version": {
          "const": 1
        },
        "entry_count": {
          "$ref": "#/$defs/safe_positive_integer"
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/crosswalk_entry"
          }
        },
        "inventory_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "candidate_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_schema_version",
        "authority_status",
        "candidate_id",
        "canonical_launch_identity_sha256",
        "candidate_record_sha256",
        "candidate_identity_sha256"
      ],
      "properties": {
        "identity_schema_version": {
          "const": 1
        },
        "candidate_id": {
          "$ref": "#/$defs/ascii_token"
        },
        "canonical_launch_identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_record_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "authority_status": {
          "const": "FIXTURE_ONLY_NONAUTHORITATIVE"
        }
      }
    },
    "candidate_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory_schema_version",
        "selection_state",
        "candidate_count",
        "candidates",
        "inventory_sha256"
      ],
      "properties": {
        "inventory_schema_version": {
          "const": 1
        },
        "selection_state": {
          "const": "FIXTURE_CANDIDATES_COMPLETE_NONAUTHORITATIVE"
        },
        "candidate_count": {
          "$ref": "#/$defs/safe_positive_integer"
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/candidate_identity"
          }
        },
        "inventory_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "simulator_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build_sha256",
        "config_sha256",
        "input_sha256",
        "output_sha256"
      ],
      "properties": {
        "build_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "config_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "input_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "output_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "row_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_schema_version",
        "authority_status",
        "row_id",
        "cohort_candidate_identity_sha256",
        "canonical_launch_identity_sha256",
        "simulator_output_row_sha256",
        "expected_row_identity_sha256"
      ],
      "properties": {
        "identity_schema_version": {
          "const": 1
        },
        "row_id": {
          "$ref": "#/$defs/ascii_token"
        },
        "cohort_candidate_identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonical_launch_identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "simulator_output_row_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "expected_row_identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "authority_status": {
          "const": "FIXTURE_ONLY_NONAUTHORITATIVE"
        }
      }
    },
    "row_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory_schema_version",
        "row_count",
        "rows",
        "inventory_sha256"
      ],
      "properties": {
        "inventory_schema_version": {
          "const": 1
        },
        "row_count": {
          "$ref": "#/$defs/safe_positive_integer"
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/row_identity"
          }
        },
        "inventory_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "cycles_prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "descriptor_id",
        "metric_id",
        "implementation_status",
        "evaluation_state",
        "outcome",
        "score_status"
      ],
      "properties": {
        "descriptor_id": {
          "const": "exec_cycles_gpc_max"
        },
        "metric_id": {
          "const": "gpc__cycles_elapsed.max"
        },
        "implementation_status": {
          "const": "required_unimplemented"
        },
        "evaluation_state": {
          "const": "pending"
        },
        "outcome": {
          "const": "unavailable"
        },
        "score_status": {
          "const": "unscored"
        }
      }
    },
    "unresolved_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status"
      ],
      "properties": {
        "name": {
          "enum": [
            "CYCLE_MAPPING",
            "CYCLE_COMPOSITION",
            "COHORT",
            "PROTOCOL_NUMERIC_SETTINGS",
            "COVERAGE",
            "TRUST",
            "OPERATOR_APPROVAL"
          ]
        },
        "status": {
          "const": "UNRESOLVED"
        }
      }
    },
    "evaluation_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "m5",
        "scientific_inputs",
        "cycles"
      ],
      "properties": {
        "mode": {
          "const": "TARGET_FREE_OFFLINE_ONLY"
        },
        "m5": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "collection_status"
          ],
          "properties": {
            "status": {
              "const": "M5_NOT_STARTED"
            },
            "collection_status": {
              "const": "M5_COLLECT_DISABLED"
            }
          }
        },
        "scientific_inputs": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "prefixItems": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "status"
              ],
              "properties": {
                "name": {
                  "const": "CYCLE_MAPPING"
                },
                "status": {
                  "const": "UNRESOLVED"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "status"
              ],
              "properties": {
                "name": {
                  "const": "CYCLE_COMPOSITION"
                },
                "status": {
                  "const": "UNRESOLVED"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "status"
              ],
              "properties": {
                "name": {
                  "const": "COHORT"
                },
                "status": {
                  "const": "UNRESOLVED"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "status"
              ],
              "properties": {
                "name": {
                  "const": "PROTOCOL_NUMERIC_SETTINGS"
                },
                "status": {
                  "const": "UNRESOLVED"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "status"
              ],
              "properties": {
                "name": {
                  "const": "COVERAGE"
                },
                "status": {
                  "const": "UNRESOLVED"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "status"
              ],
              "properties": {
                "name": {
                  "const": "TRUST"
                },
                "status": {
                  "const": "UNRESOLVED"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "status"
              ],
              "properties": {
                "name": {
                  "const": "OPERATOR_APPROVAL"
                },
                "status": {
                  "const": "UNRESOLVED"
                }
              }
            }
          ],
          "items": false
        },
        "cycles": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "metric_id",
            "implementation_status",
            "evaluation_state",
            "outcome",
            "score_status"
          ],
          "properties": {
            "metric_id": {
              "const": "gpc__cycles_elapsed.max"
            },
            "implementation_status": {
              "const": "required_unimplemented"
            },
            "evaluation_state": {
              "const": "pending"
            },
            "outcome": {
              "const": "unavailable"
            },
            "score_status": {
              "const": "unscored"
            }
          }
        }
      }
    },
    "output_manifest_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "row_sha256"
      ],
      "properties": {
        "row_id": {
          "$ref": "#/$defs/ascii_token"
        },
        "row_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "output_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_schema_version",
        "authority_status",
        "entry_count",
        "entries",
        "manifest_sha256"
      ],
      "properties": {
        "manifest_schema_version": {
          "const": 1
        },
        "authority_status": {
          "const": "FIXTURE_ONLY_NONRETAINED"
        },
        "entry_count": {
          "$ref": "#/$defs/safe_positive_integer"
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/output_manifest_entry"
          }
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}

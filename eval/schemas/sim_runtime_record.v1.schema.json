{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpu-simulator.local/eval/schemas/sim_runtime_record.v1.schema.json",
  "title": "Current simulator runtime record v1",
  "description": "Closed, sealed spawn-to-wait runtime evidence for the repository-owned sim-run executable. Raw samples remain authoritative. Runtime records never authorize labels, baseline production, or a speed-up ratio.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_sha256",
    "created_at_utc",
    "authority_role",
    "timing_protocol",
    "invocation",
    "manifest_identity",
    "host_identity",
    "workload_identity",
    "sim_result_binding",
    "accuracy_binding",
    "samples",
    "claimability",
    "outcome"
  ],
  "properties": {
    "schema_version": {
      "const": "sim_runtime_record.v1"
    },
    "record_sha256": {
      "$ref": "#/$defs/sha256",
      "description": "SHA-256 of repository-canonical JSON with this member omitted."
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "authority_role": {
      "const": "exploratory_current_simulator_runtime_only"
    },
    "timing_protocol": {
      "$ref": "#/$defs/timingProtocol"
    },
    "invocation": {
      "$ref": "#/$defs/invocation"
    },
    "manifest_identity": {
      "$ref": "#/$defs/manifestIdentity"
    },
    "host_identity": {
      "$ref": "#/$defs/hostIdentity"
    },
    "workload_identity": {
      "$ref": "#/$defs/workloadIdentity"
    },
    "sim_result_binding": {
      "oneOf": [
        {
          "$ref": "#/$defs/boundResult"
        },
        {
          "$ref": "#/$defs/unavailableResult"
        }
      ]
    },
    "accuracy_binding": {
      "oneOf": [
        {
          "$ref": "#/$defs/boundAccuracy"
        },
        {
          "$ref": "#/$defs/unavailableAccuracy"
        }
      ]
    },
    "samples": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/runtimeSample"
      }
    },
    "claimability": {
      "$ref": "#/$defs/claimability"
    },
    "outcome": {
      "oneOf": [
        {
          "$ref": "#/$defs/measuredOutcome"
        },
        {
          "$ref": "#/$defs/noisyOutcome"
        },
        {
          "$ref": "#/$defs/failedOutcome"
        }
      ]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonemptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "absolutePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "u64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "positiveU64": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "nonnegativeNumber": {
      "type": "number",
      "minimum": 0
    },
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/absolutePath"
        },
        "size_bytes": {
          "$ref": "#/$defs/positiveU64"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "timingProtocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timing_boundary_id",
        "clock",
        "warmup_repeat_count",
        "initial_timed_repeat_count",
        "additional_repeat_count_on_noise",
        "coefficient_of_variation_threshold",
        "warm_page_cache_policy",
        "background_load_observation",
        "build_timing_role",
        "timeout_ns"
      ],
      "properties": {
        "timing_boundary_id": {
          "const": "external_monotonic_immediately_before_spawn_to_wait4_return.v1"
        },
        "clock": {
          "const": "time.monotonic_ns"
        },
        "warmup_repeat_count": {
          "const": 1
        },
        "initial_timed_repeat_count": {
          "const": 5
        },
        "additional_repeat_count_on_noise": {
          "const": 4
        },
        "coefficient_of_variation_threshold": {
          "const": 0.05
        },
        "warm_page_cache_policy": {
          "const": "one_warmup_then_natural_warm_cache_no_drop.v1"
        },
        "background_load_observation": {
          "const": "os_getloadavg_immediately_before_each_spawn.v1"
        },
        "build_timing_role": {
          "const": "release_build_completed_before_timing"
        },
        "timeout_ns": {
          "$ref": "#/$defs/positiveU64"
        }
      }
    },
    "environmentEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "maxLength": 128
        },
        "value": {
          "type": "string",
          "maxLength": 4096
        }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binary",
        "binary_policy",
        "executable_transport",
        "manifest_transport",
        "argv",
        "environment",
        "environment_sha256",
        "working_directory",
        "affinity_cpus"
      ],
      "properties": {
        "binary": {
          "$ref": "#/$defs/fileIdentity"
        },
        "binary_policy": {
          "const": "repository_release_sim_run_only"
        },
        "executable_transport": {
          "const": "proc_self_fd_retained_release_inode.v1"
        },
        "manifest_transport": {
          "const": "inherited_retained_manifest_and_evidence_base_fds.v1"
        },
        "argv": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/nonemptyString"
          }
        },
        "environment": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/environmentEntry"
          }
        },
        "environment_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "working_directory": {
          "$ref": "#/$defs/absolutePath"
        },
        "affinity_cpus": {
          "type": "array",
          "minItems": 1,
          "maxItems": 65536,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "manifestIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "canonical_sha256",
        "schema_version",
        "scope"
      ],
      "properties": {
        "file": {
          "$ref": "#/$defs/fileIdentity"
        },
        "canonical_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "schema_version": {
          "const": 2
        },
        "scope": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "availableString": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "value"
      ],
      "properties": {
        "status": {
          "const": "available"
        },
        "value": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "availableU64": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "value"
      ],
      "properties": {
        "status": {
          "const": "available"
        },
        "value": {
          "$ref": "#/$defs/positiveU64"
        }
      }
    },
    "unavailableValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "const": "unavailable"
        },
        "reason": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "optionalString": {
      "oneOf": [
        {
          "$ref": "#/$defs/availableString"
        },
        {
          "$ref": "#/$defs/unavailableValue"
        }
      ]
    },
    "optionalU64": {
      "oneOf": [
        {
          "$ref": "#/$defs/availableU64"
        },
        {
          "$ref": "#/$defs/unavailableValue"
        }
      ]
    },
    "targetGpuIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sku",
        "sm_arch",
        "device_architecture",
        "driver_version"
      ],
      "properties": {
        "sku": {
          "$ref": "#/$defs/optionalString"
        },
        "sm_arch": {
          "$ref": "#/$defs/optionalString"
        },
        "device_architecture": {
          "$ref": "#/$defs/optionalString"
        },
        "driver_version": {
          "$ref": "#/$defs/optionalString"
        }
      }
    },
    "hostIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_fingerprint_sha256",
        "hostname_sha256",
        "cpu_model",
        "physical_core_count",
        "logical_core_count",
        "memory_bytes",
        "os_name",
        "kernel_release",
        "machine",
        "affinity_cpus",
        "cpu_governor",
        "target_gpu"
      ],
      "properties": {
        "host_fingerprint_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "hostname_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "cpu_model": {
          "$ref": "#/$defs/optionalString"
        },
        "physical_core_count": {
          "$ref": "#/$defs/optionalU64"
        },
        "logical_core_count": {
          "$ref": "#/$defs/optionalU64"
        },
        "memory_bytes": {
          "$ref": "#/$defs/optionalU64"
        },
        "os_name": {
          "$ref": "#/$defs/availableString"
        },
        "kernel_release": {
          "$ref": "#/$defs/availableString"
        },
        "machine": {
          "$ref": "#/$defs/availableString"
        },
        "affinity_cpus": {
          "type": "array",
          "minItems": 1,
          "maxItems": 65536,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "cpu_governor": {
          "$ref": "#/$defs/optionalString"
        },
        "target_gpu": {
          "$ref": "#/$defs/targetGpuIdentity"
        }
      }
    },
    "availableTrace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "value"
      ],
      "properties": {
        "status": {
          "const": "available"
        },
        "value": {
          "$ref": "https://gpu-simulator.local/sim/run/schema/sim_result.v2.schema.json#/$defs/traceIdentity"
        }
      }
    },
    "availableConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "identity",
        "resolved"
      ],
      "properties": {
        "status": {
          "const": "available"
        },
        "identity": {
          "$ref": "https://gpu-simulator.local/sim/run/schema/sim_result.v2.schema.json#/$defs/configurationIdentity"
        },
        "resolved": {
          "$ref": "https://gpu-simulator.local/sim/run/schema/sim_result.v2.schema.json#/$defs/resolvedConfiguration"
        }
      }
    },
    "workloadIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workload_ids",
        "workload_family",
        "input_digest",
        "launch_set_sha256",
        "launch_count",
        "launch_keys",
        "trace",
        "configuration"
      ],
      "properties": {
        "workload_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonemptyString"
          }
        },
        "workload_family": {
          "$ref": "#/$defs/optionalString"
        },
        "input_digest": {
          "$ref": "#/$defs/sha256"
        },
        "launch_set_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "launch_count": {
          "$ref": "#/$defs/positiveU64"
        },
        "launch_keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "$ref": "https://gpu-simulator.local/eval/schemas/launch_key.v1.schema.json"
          }
        },
        "trace": {
          "oneOf": [
            {
              "$ref": "#/$defs/availableTrace"
            },
            {
              "$ref": "#/$defs/unavailableValue"
            }
          ]
        },
        "configuration": {
          "oneOf": [
            {
              "$ref": "#/$defs/availableConfiguration"
            },
            {
              "$ref": "#/$defs/unavailableValue"
            }
          ]
        }
      }
    },
    "availableInternalTimings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "value",
        "role"
      ],
      "properties": {
        "status": {
          "const": "available"
        },
        "value": {
          "$ref": "https://gpu-simulator.local/sim/run/schema/sim_result.v2.schema.json#/$defs/internalPhaseTimings"
        },
        "role": {
          "const": "diagnostic_only_never_replaces_external_runtime"
        }
      }
    },
    "selectedReplayCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "record_count",
        "instruction_count"
      ],
      "properties": {
        "basis": {
          "const": "aggregate_exact_instructions_with_checked_issue_record_equality.v1"
        },
        "record_count": {
          "$ref": "#/$defs/positiveU64"
        },
        "instruction_count": {
          "$ref": "#/$defs/positiveU64"
        }
      }
    },
    "boundResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "file_sha256",
        "result_sha256",
        "build_identity",
        "trace_identity",
        "selected_replay_counts",
        "arch_card_identity",
        "configuration_identity",
        "resolved_configuration",
        "internal_phase_timings_ns"
      ],
      "properties": {
        "status": {
          "const": "bound"
        },
        "file_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "result_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "build_identity": {
          "$ref": "https://gpu-simulator.local/sim/run/schema/sim_result.v2.schema.json#/$defs/buildIdentity"
        },
        "trace_identity": {
          "$ref": "https://gpu-simulator.local/sim/run/schema/sim_result.v2.schema.json#/$defs/traceIdentity"
        },
        "selected_replay_counts": {
          "$ref": "#/$defs/selectedReplayCounts"
        },
        "arch_card_identity": {
          "$ref": "https://gpu-simulator.local/sim/run/schema/sim_result.v2.schema.json#/$defs/archCardIdentity"
        },
        "configuration_identity": {
          "$ref": "https://gpu-simulator.local/sim/run/schema/sim_result.v2.schema.json#/$defs/configurationIdentity"
        },
        "resolved_configuration": {
          "$ref": "https://gpu-simulator.local/sim/run/schema/sim_result.v2.schema.json#/$defs/resolvedConfiguration"
        },
        "internal_phase_timings_ns": {
          "oneOf": [
            {
              "$ref": "#/$defs/availableInternalTimings"
            },
            {
              "$ref": "#/$defs/unavailableValue"
            }
          ]
        }
      }
    },
    "unavailableResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "const": "unavailable"
        },
        "reason": {
          "enum": [
            "no_successful_result",
            "result_contract_invalid",
            "result_identity_mismatch",
            "nondeterministic_result"
          ]
        }
      }
    },
    "boundAccuracy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "report_id",
        "report_sha256",
        "file_sha256"
      ],
      "properties": {
        "status": {
          "const": "bound"
        },
        "report_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "report_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "file_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "unavailableAccuracy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "const": "unavailable"
        },
        "reason": {
          "const": "production_matched_label_crosswalk_authority_unavailable"
        }
      }
    },
    "loadAverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "one_minute",
        "five_minutes",
        "fifteen_minutes"
      ],
      "properties": {
        "one_minute": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "five_minutes": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "fifteen_minutes": {
          "$ref": "#/$defs/nonnegativeNumber"
        }
      }
    },
    "termination": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "exit_code"
          ],
          "properties": {
            "kind": {
              "const": "exit"
            },
            "exit_code": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "signal"
          ],
          "properties": {
            "kind": {
              "const": "signal"
            },
            "signal": {
              "type": "integer",
              "minimum": 1,
              "maximum": 255
            }
          }
        }
      ]
    },
    "streamArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "size_bytes",
        "sha256",
        "capture_complete"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "size_bytes": {
          "$ref": "#/$defs/u64"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "capture_complete": {
          "type": "boolean"
        }
      }
    },
    "runtimeSample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_index",
        "kind",
        "timed_repeat_index",
        "background_load",
        "monotonic_start_ns",
        "monotonic_stop_ns",
        "wall_time_ns",
        "user_cpu_ns",
        "system_cpu_ns",
        "peak_rss_kib",
        "termination",
        "timed_out",
        "stdout",
        "stderr"
      ],
      "properties": {
        "sample_index": {
          "$ref": "#/$defs/u64"
        },
        "kind": {
          "enum": [
            "warmup",
            "timed"
          ]
        },
        "timed_repeat_index": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/u64"
            }
          ]
        },
        "background_load": {
          "$ref": "#/$defs/loadAverage"
        },
        "monotonic_start_ns": {
          "$ref": "#/$defs/u64"
        },
        "monotonic_stop_ns": {
          "$ref": "#/$defs/u64"
        },
        "wall_time_ns": {
          "$ref": "#/$defs/positiveU64"
        },
        "user_cpu_ns": {
          "$ref": "#/$defs/u64"
        },
        "system_cpu_ns": {
          "$ref": "#/$defs/u64"
        },
        "peak_rss_kib": {
          "$ref": "#/$defs/u64"
        },
        "termination": {
          "$ref": "#/$defs/termination"
        },
        "timed_out": {
          "type": "boolean"
        },
        "stdout": {
          "$ref": "#/$defs/streamArtifact"
        },
        "stderr": {
          "$ref": "#/$defs/streamArtifact"
        }
      }
    },
    "runtimeSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timed_repeat_count",
        "minimum_wall_time_ns",
        "median_wall_time_ns",
        "median_absolute_deviation_ns",
        "mean_wall_time_ns",
        "sample_standard_deviation_ns",
        "coefficient_of_variation",
        "throughput_basis",
        "records_per_second",
        "instructions_per_second"
      ],
      "properties": {
        "timed_repeat_count": {
          "type": "integer",
          "enum": [
            5,
            9
          ]
        },
        "minimum_wall_time_ns": {
          "$ref": "#/$defs/positiveU64"
        },
        "median_wall_time_ns": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "median_absolute_deviation_ns": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "mean_wall_time_ns": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "sample_standard_deviation_ns": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "coefficient_of_variation": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "throughput_basis": {
          "const": "selected_replay_count_divided_by_median_external_wall_time"
        },
        "records_per_second": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "instructions_per_second": {
          "$ref": "#/$defs/nonnegativeNumber"
        }
      }
    },
    "claimability": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "basis"
          ],
          "properties": {
            "status": {
              "const": "claimable"
            },
            "basis": {
              "const": "clean_committed_release_and_admitted_workload_tier"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
              "const": "unclaimable"
            },
            "reason": {
              "enum": [
                "DIRTY_BUILD_UNCLAIMABLE",
                "WORKLOAD_TIER_AUTHORITY_UNAVAILABLE",
                "SYNTHETIC_FIXTURE"
              ]
            }
          }
        }
      ]
    },
    "measuredOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "summary"
      ],
      "properties": {
        "status": {
          "const": "MEASURED"
        },
        "summary": {
          "$ref": "#/$defs/runtimeSummary"
        }
      }
    },
    "noisyOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "summary"
      ],
      "properties": {
        "status": {
          "const": "RUNTIME_NOISY"
        },
        "summary": {
          "$ref": "#/$defs/runtimeSummary"
        }
      }
    },
    "failedOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "detail",
        "summary"
      ],
      "properties": {
        "status": {
          "enum": [
            "RUNTIME_EXECUTION_FAILED",
            "NONDETERMINISTIC_RESULT"
          ]
        },
        "detail": {
          "$ref": "#/$defs/nonemptyString"
        },
        "failure_code": {
          "type": "string",
          "pattern": "^(?:RUNTIME_[A-Z0-9_]+|NONDETERMINISTIC_RESULT)$",
          "minLength": 1,
          "maxLength": 128
        },
        "summary": {
          "type": "null"
        }
      }
    }
  }
}

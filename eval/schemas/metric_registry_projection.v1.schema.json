{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpu-simulator.local/eval/schemas/metric_registry_projection.v1.schema.json",
  "title": "Exact retained 7+1 metric registry projection v1",
  "description": "Closed byte-authenticated projection of selected fields from the canonical registry. Row content and order are verified against the pinned source bytes by eval.contracts.validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "projection_sha256",
    "source_registry_version",
    "source_registry_sha256",
    "source_label_schema_version",
    "repeatability_thresholds",
    "metrics"
  ],
  "properties": {
    "schema_version": {
      "const": "metric_registry_projection.v1"
    },
    "projection_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_registry_version": {
      "const": 2
    },
    "source_registry_sha256": {
      "const": "95d90f8c4fffd9376b8d785047a9e02ecafc81ed43da6081985958c2b9dec62d"
    },
    "source_label_schema_version": {
      "const": 5
    },
    "repeatability_thresholds": {
      "$ref": "#/$defs/thresholds"
    },
    "metrics": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/metricRow"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableNumber": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "number"
        }
      ]
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stddev_abs",
        "coefficient_of_variation",
        "relative_tolerance"
      ],
      "properties": {
        "stddev_abs": {
          "const": 0.03
        },
        "coefficient_of_variation": {
          "const": 0.05
        },
        "relative_tolerance": {
          "const": 0.05
        }
      }
    },
    "perArchAvailability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sm_86",
        "sm_120"
      ],
      "properties": {
        "sm_86": {
          "const": "available"
        },
        "sm_120": {
          "const": "sm_120_deferred_no_live_evidence"
        }
      }
    },
    "metricRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "ncu_metric",
        "unit",
        "family",
        "metric_class",
        "carrier",
        "valid_min",
        "valid_max",
        "parser_transform",
        "aggregation",
        "repeatability_rule",
        "nullable",
        "deployability",
        "availability",
        "per_arch_availability",
        "model_io_role"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "ncu_metric": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "enum": [
            "count",
            "pct",
            "cycles"
          ]
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "metric_class": {
          "type": "string",
          "minLength": 1
        },
        "carrier": {
          "enum": [
            "unit_tagged_metric",
            "flat_field"
          ]
        },
        "valid_min": {
          "type": "number"
        },
        "valid_max": {
          "$ref": "#/$defs/nullableNumber"
        },
        "parser_transform": {
          "enum": [
            "identity_nonneg",
            "percent_to_fraction"
          ]
        },
        "aggregation": {
          "enum": [
            "mean_nonneg",
            "mean_fraction"
          ]
        },
        "repeatability_rule": {
          "enum": [
            "stddev_abs",
            "coefficient_of_variation",
            "relative_tolerance"
          ]
        },
        "nullable": {
          "type": "boolean"
        },
        "deployability": {
          "const": "label_only"
        },
        "availability": {
          "const": "available"
        },
        "per_arch_availability": {
          "$ref": "#/$defs/perArchAvailability"
        },
        "model_io_role": {
          "const": "target"
        }
      }
    }
  }
}

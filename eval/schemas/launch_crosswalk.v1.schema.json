{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpu-simulator.invalid/eval/schemas/launch_crosswalk.v1.schema.json",
  "title": "Explicitly fixture-only launch inventory and crosswalk contracts v1",
  "oneOf": [
    {
      "$ref": "#/$defs/crosswalk"
    },
    {
      "$ref": "#/$defs/inventory"
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "safe_nonnegative_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "safe_positive_integer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "safe_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}(?![\\s\\S])"
    },
    "namespace": {
      "enum": [
        "CANONICAL",
        "NCU",
        "NVBIT",
        "SIMULATOR"
      ]
    },
    "decimal": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:0|[1-9][0-9]*)(?![\\s\\S])"
    },
    "snapshot_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device",
        "inode",
        "mode",
        "link_count",
        "size_bytes",
        "mtime_ns",
        "ctime_ns"
      ],
      "properties": {
        "device": {
          "$ref": "#/$defs/decimal"
        },
        "inode": {
          "$ref": "#/$defs/decimal"
        },
        "mode": {
          "$ref": "#/$defs/decimal"
        },
        "link_count": {
          "const": "1"
        },
        "size_bytes": {
          "$ref": "#/$defs/decimal"
        },
        "mtime_ns": {
          "$ref": "#/$defs/decimal"
        },
        "ctime_ns": {
          "$ref": "#/$defs/decimal"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acquisition",
        "payload_sha256",
        "size_bytes",
        "metadata",
        "snapshot_identity_sha256"
      ],
      "properties": {
        "acquisition": {
          "const": "FIXTURE_CALLER_BYTES_V1"
        },
        "payload_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "$ref": "#/$defs/safe_nonnegative_integer"
        },
        "metadata": {
          "$ref": "#/$defs/snapshot_metadata"
        },
        "snapshot_identity_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "artifact_kind",
        "artifact_sha256",
        "snapshot"
      ],
      "properties": {
        "namespace": {
          "$ref": "#/$defs/namespace"
        },
        "artifact_kind": {
          "enum": [
            "CANONICAL_LAUNCH_SOURCE",
            "NCU_LAUNCH_SOURCE",
            "NVBIT_LAUNCH_SOURCE",
            "SIMULATOR_LAUNCH_SOURCE"
          ]
        },
        "artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "snapshot": {
          "$ref": "#/$defs/snapshot"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "CANONICAL"
              }
            }
          },
          "then": {
            "properties": {
              "artifact_kind": {
                "const": "CANONICAL_LAUNCH_SOURCE"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "NCU"
              }
            }
          },
          "then": {
            "properties": {
              "artifact_kind": {
                "const": "NCU_LAUNCH_SOURCE"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "NVBIT"
              }
            }
          },
          "then": {
            "properties": {
              "artifact_kind": {
                "const": "NVBIT_LAUNCH_SOURCE"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "SIMULATOR"
              }
            }
          },
          "then": {
            "properties": {
              "artifact_kind": {
                "const": "SIMULATOR_LAUNCH_SOURCE"
              }
            }
          }
        }
      ]
    },
    "dimension": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/safe_positive_integer"
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kernel_name",
        "grid_dim",
        "block_dim"
      ],
      "properties": {
        "kernel_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_.$@?<>-]+(?![\\s\\S])"
        },
        "grid_dim": {
          "$ref": "#/$defs/dimension"
        },
        "block_dim": {
          "$ref": "#/$defs/dimension"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "source_artifact_kind",
        "source_artifact_sha256",
        "source_snapshot_identity_sha256",
        "launch_ordinal",
        "launch_role",
        "qualified_launch_sha256"
      ],
      "properties": {
        "namespace": {
          "$ref": "#/$defs/namespace"
        },
        "source_artifact_kind": {
          "enum": [
            "CANONICAL_LAUNCH_SOURCE",
            "NCU_LAUNCH_SOURCE",
            "NVBIT_LAUNCH_SOURCE",
            "SIMULATOR_LAUNCH_SOURCE"
          ]
        },
        "source_artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_snapshot_identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "launch_ordinal": {
          "$ref": "#/$defs/safe_nonnegative_integer"
        },
        "launch_role": {
          "$ref": "#/$defs/safe_id"
        },
        "qualified_launch_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "CANONICAL"
              }
            }
          },
          "then": {
            "properties": {
              "source_artifact_kind": {
                "const": "CANONICAL_LAUNCH_SOURCE"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "NCU"
              }
            }
          },
          "then": {
            "properties": {
              "source_artifact_kind": {
                "const": "NCU_LAUNCH_SOURCE"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "NVBIT"
              }
            }
          },
          "then": {
            "properties": {
              "source_artifact_kind": {
                "const": "NVBIT_LAUNCH_SOURCE"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "SIMULATOR"
              }
            }
          },
          "then": {
            "properties": {
              "source_artifact_kind": {
                "const": "SIMULATOR_LAUNCH_SOURCE"
              }
            }
          }
        }
      ]
    },
    "launch_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "signature"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "signature": {
          "$ref": "#/$defs/signature"
        }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "artifact_kind",
        "schema_sha256",
        "contract_mode",
        "parser_authority",
        "namespace",
        "source",
        "fixture_source_model",
        "candidate_count",
        "qualified_candidate_ids",
        "candidate_records",
        "model_seal_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "artifact_kind": {
          "const": "EVALUATOR_LAUNCH_INVENTORY"
        },
        "schema_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "namespace": {
          "$ref": "#/$defs/namespace"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "candidate_count": {
          "$ref": "#/$defs/safe_nonnegative_integer"
        },
        "qualified_candidate_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "candidate_records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/launch_record"
          }
        },
        "model_seal_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "contract_mode": {
          "const": "FIXTURE_ONLY"
        },
        "parser_authority": {
          "$ref": "#/$defs/parser_authority"
        },
        "fixture_source_model": {
          "$ref": "#/$defs/fixture_source_model"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "CANONICAL"
              }
            }
          },
          "then": {
            "properties": {
              "source": {
                "properties": {
                  "namespace": {
                    "const": "CANONICAL"
                  }
                }
              },
              "candidate_records": {
                "items": {
                  "properties": {
                    "identity": {
                      "properties": {
                        "namespace": {
                          "const": "CANONICAL"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "NCU"
              }
            }
          },
          "then": {
            "properties": {
              "source": {
                "properties": {
                  "namespace": {
                    "const": "NCU"
                  }
                }
              },
              "candidate_records": {
                "items": {
                  "properties": {
                    "identity": {
                      "properties": {
                        "namespace": {
                          "const": "NCU"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "NVBIT"
              }
            }
          },
          "then": {
            "properties": {
              "source": {
                "properties": {
                  "namespace": {
                    "const": "NVBIT"
                  }
                }
              },
              "candidate_records": {
                "items": {
                  "properties": {
                    "identity": {
                      "properties": {
                        "namespace": {
                          "const": "NVBIT"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "SIMULATOR"
              }
            }
          },
          "then": {
            "properties": {
              "source": {
                "properties": {
                  "namespace": {
                    "const": "SIMULATOR"
                  }
                }
              },
              "candidate_records": {
                "items": {
                  "properties": {
                    "identity": {
                      "properties": {
                        "namespace": {
                          "const": "SIMULATOR"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "role_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mapping_kind",
        "canonical_role",
        "source_role"
      ],
      "properties": {
        "mapping_kind": {
          "const": "EXACT_DECLARED_ROLE_MAPPING"
        },
        "canonical_role": {
          "$ref": "#/$defs/safe_id"
        },
        "source_role": {
          "$ref": "#/$defs/safe_id"
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_version",
        "binding_kind",
        "namespace",
        "inventory_model_seal_sha256",
        "source_artifact_kind",
        "source_artifact_sha256",
        "source_snapshot_identity_sha256",
        "launch_ordinal",
        "launch_role",
        "qualified_launch_sha256",
        "canonical_qualified_launch_sha256",
        "canonical_signature_sha256",
        "role_mapping",
        "authority_status",
        "binding_authority_sha256",
        "model_seal_sha256"
      ],
      "properties": {
        "binding_version": {
          "const": 1
        },
        "binding_kind": {
          "const": "INDEPENDENT_INVENTORY_ORDINAL_ROLE"
        },
        "namespace": {
          "enum": [
            "NCU",
            "NVBIT",
            "SIMULATOR"
          ]
        },
        "inventory_model_seal_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_artifact_kind": {
          "enum": [
            "NCU_LAUNCH_SOURCE",
            "NVBIT_LAUNCH_SOURCE",
            "SIMULATOR_LAUNCH_SOURCE"
          ]
        },
        "source_artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_snapshot_identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "launch_ordinal": {
          "$ref": "#/$defs/safe_nonnegative_integer"
        },
        "launch_role": {
          "$ref": "#/$defs/safe_id"
        },
        "qualified_launch_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonical_qualified_launch_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonical_signature_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "role_mapping": {
          "$ref": "#/$defs/role_mapping"
        },
        "binding_authority_sha256": {
          "const": "c9a091fc4900bf0503936fd10656cc664843a172f83c1fe4b3debdc29d04e144"
        },
        "model_seal_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "authority_status": {
          "const": "FIXTURE_ONLY_NON_AUTHORITATIVE"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "NCU"
              }
            }
          },
          "then": {
            "properties": {
              "source_artifact_kind": {
                "const": "NCU_LAUNCH_SOURCE"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "NVBIT"
              }
            }
          },
          "then": {
            "properties": {
              "source_artifact_kind": {
                "const": "NVBIT_LAUNCH_SOURCE"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "SIMULATOR"
              }
            }
          },
          "then": {
            "properties": {
              "source_artifact_kind": {
                "const": "SIMULATOR_LAUNCH_SOURCE"
              }
            }
          }
        }
      ]
    },
    "rejected_reason": {
      "enum": [
        "CANONICAL_INVENTORY_CANDIDATE_SET_MISMATCH",
        "NCU_INVENTORY_CANDIDATE_SET_MISMATCH",
        "NCU_BINDING_NO_MATCH",
        "NCU_BINDING_NOT_UNIQUE",
        "NCU_BINDING_CONTEXT_MISMATCH",
        "NVBIT_INVENTORY_CANDIDATE_SET_MISMATCH",
        "NVBIT_BINDING_NO_MATCH",
        "NVBIT_BINDING_NOT_UNIQUE",
        "NVBIT_BINDING_CONTEXT_MISMATCH",
        "SIMULATOR_INVENTORY_CANDIDATE_SET_MISMATCH",
        "SIMULATOR_BINDING_NO_MATCH",
        "SIMULATOR_BINDING_NOT_UNIQUE",
        "SIMULATOR_BINDING_CONTEXT_MISMATCH"
      ]
    },
    "unavailable_reason": {
      "enum": [
        "FIXTURE_ONLY_CANONICAL_SELECTION",
        "NCU_SIGNATURE_UNAVAILABLE",
        "NCU_BINDING_AUTHORITY_UNAVAILABLE",
        "FIXTURE_ONLY_NCU_BINDING",
        "NVBIT_SIGNATURE_UNAVAILABLE",
        "NVBIT_BINDING_AUTHORITY_UNAVAILABLE",
        "FIXTURE_ONLY_NVBIT_BINDING",
        "SIMULATOR_SIGNATURE_UNAVAILABLE",
        "SIMULATOR_BINDING_AUTHORITY_UNAVAILABLE",
        "FIXTURE_ONLY_SIMULATOR_BINDING"
      ]
    },
    "outcome": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason_codes"
          ],
          "properties": {
            "status": {
              "const": "REJECTED"
            },
            "reason_codes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/rejected_reason"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason_codes"
          ],
          "properties": {
            "status": {
              "const": "UNAVAILABLE"
            },
            "reason_codes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/unavailable_reason"
              }
            }
          }
        }
      ]
    },
    "canonical_selection_outcome": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason_codes"
          ],
          "properties": {
            "status": {
              "const": "REJECTED"
            },
            "reason_codes": {
              "const": [
                "CANONICAL_INVENTORY_CANDIDATE_SET_MISMATCH"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason_codes"
          ],
          "properties": {
            "status": {
              "const": "UNAVAILABLE"
            },
            "reason_codes": {
              "const": [
                "FIXTURE_ONLY_CANONICAL_SELECTION"
              ]
            }
          }
        }
      ]
    },
    "ncu_selection_outcome": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason_codes"
          ],
          "properties": {
            "status": {
              "const": "REJECTED"
            },
            "reason_codes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "NCU_INVENTORY_CANDIDATE_SET_MISMATCH",
                  "NCU_BINDING_NO_MATCH",
                  "NCU_BINDING_NOT_UNIQUE",
                  "NCU_BINDING_CONTEXT_MISMATCH"
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason_codes"
          ],
          "properties": {
            "status": {
              "const": "UNAVAILABLE"
            },
            "reason_codes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "NCU_SIGNATURE_UNAVAILABLE",
                  "NCU_BINDING_AUTHORITY_UNAVAILABLE",
                  "FIXTURE_ONLY_NCU_BINDING"
                ]
              }
            }
          }
        }
      ]
    },
    "nvbit_selection_outcome": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason_codes"
          ],
          "properties": {
            "status": {
              "const": "REJECTED"
            },
            "reason_codes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "NVBIT_INVENTORY_CANDIDATE_SET_MISMATCH",
                  "NVBIT_BINDING_NO_MATCH",
                  "NVBIT_BINDING_NOT_UNIQUE",
                  "NVBIT_BINDING_CONTEXT_MISMATCH"
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason_codes"
          ],
          "properties": {
            "status": {
              "const": "UNAVAILABLE"
            },
            "reason_codes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "NVBIT_SIGNATURE_UNAVAILABLE",
                  "NVBIT_BINDING_AUTHORITY_UNAVAILABLE",
                  "FIXTURE_ONLY_NVBIT_BINDING"
                ]
              }
            }
          }
        }
      ]
    },
    "simulator_selection_outcome": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason_codes"
          ],
          "properties": {
            "status": {
              "const": "REJECTED"
            },
            "reason_codes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "SIMULATOR_INVENTORY_CANDIDATE_SET_MISMATCH",
                  "SIMULATOR_BINDING_NO_MATCH",
                  "SIMULATOR_BINDING_NOT_UNIQUE",
                  "SIMULATOR_BINDING_CONTEXT_MISMATCH"
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason_codes"
          ],
          "properties": {
            "status": {
              "const": "UNAVAILABLE"
            },
            "reason_codes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "SIMULATOR_SIGNATURE_UNAVAILABLE",
                  "SIMULATOR_BINDING_AUTHORITY_UNAVAILABLE",
                  "FIXTURE_ONLY_SIMULATOR_BINDING"
                ]
              }
            }
          }
        }
      ]
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "inventory",
        "supplied_candidates",
        "name_dimension_match_count",
        "independent_binding",
        "selected_launch",
        "outcome"
      ],
      "properties": {
        "namespace": {
          "$ref": "#/$defs/namespace"
        },
        "inventory": {
          "$ref": "#/$defs/inventory"
        },
        "supplied_candidates": {
          "type": "array",
          "items": {

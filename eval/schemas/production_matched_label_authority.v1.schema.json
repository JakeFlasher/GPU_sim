{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpu-simulator.local/eval/schemas/production_matched_label_authority.v1.schema.json",
  "title": "Detached production matched-label authority v1",
  "description": "Detached, externally pinned authority for exact canonical matched_labels.v1 bytes. The authority is authenticated before the label payload is opened and binds the retained NCU label set, its production crosswalk, governing schemas and registry, builder bytes, architecture, and the external producer content manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authority_sha256",
    "authority_role",
    "matched_labels",
    "source_label_identity",
    "crosswalk_identity",
    "schemas",
    "registry_identity",
    "builder_identity",
    "architecture",
    "producer_content_manifest"
  ],
  "properties": {
    "schema_version": {
      "const": "production_matched_label_authority.v1"
    },
    "authority_sha256": {
      "$ref": "#/$defs/sha256",
      "description": "SHA-256 of canonical JSON with this member omitted."
    },
    "authority_role": {
      "const": "detached_production_matched_label_authority"
    },
    "matched_labels": {
      "$ref": "#/$defs/matchedLabelsIdentity"
    },
    "source_label_identity": {
      "$ref": "#/$defs/sourceLabelIdentity"
    },
    "crosswalk_identity": {
      "$ref": "#/$defs/crosswalkIdentity"
    },
    "schemas": {
      "$ref": "#/$defs/schemaIdentities"
    },
    "registry_identity": {
      "$ref": "#/$defs/registryIdentity"
    },
    "builder_identity": {
      "$ref": "#/$defs/builderIdentity"
    },
    "architecture": {
      "$ref": "#/$defs/architecture"
    },
    "producer_content_manifest": {
      "$ref": "#/$defs/contentManifestIdentity"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonemptyString": {
      "type": "string",
      "minLength": 1
    },
    "positiveU64": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "matchedLabelsIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "file_sha256",
        "size_bytes",
        "canonical_seal_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "matched_labels.v1"
        },
        "file_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "canonical_seal_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "sourceLabelIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label_set_id",
        "label_set_sha256",
        "label_schema_version",
        "label_schema_sha256",
        "source_manifest_id",
        "source_manifest_sha256",
        "expected_repeat_count",
        "authority_role"
      ],
      "properties": {
        "label_set_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "label_set_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "label_schema_version": {
          "const": 5
        },
        "label_schema_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_manifest_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "source_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "expected_repeat_count": {
          "$ref": "#/$defs/positiveU64"
        },
        "authority_role": {
          "const": "independent_retained_ncu_label_source"
        }
      }
    },
    "crosswalkIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "crosswalk_id",
        "crosswalk_file_sha256",
        "crosswalk_model_seal_sha256",
        "crosswalk_version",
        "authority_role"
      ],
      "properties": {
        "crosswalk_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "crosswalk_file_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "crosswalk_model_seal_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "crosswalk_version": {
          "const": 2
        },
        "authority_role": {
          "const": "verified_production_bijection_not_result_authorized"
        }
      }
    },
    "schemaIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "schema_sha256"
      ],
      "properties": {
        "schema_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "schema_version": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "$ref": "#/$defs/nonemptyString"
            }
          ]
        },
        "schema_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "schemaIdentities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "matched_labels",
        "production_ncu_repeat_manifest",
        "source_label",
        "ncu_launch_inventory",
        "ncu_launch_metrics"
      ],
      "properties": {
        "authority": {
          "$ref": "#/$defs/schemaIdentity"
        },
        "matched_labels": {
          "$ref": "#/$defs/schemaIdentity"
        },
        "production_ncu_repeat_manifest": {
          "$ref": "#/$defs/schemaIdentity"
        },
        "source_label": {
          "$ref": "#/$defs/schemaIdentity"
        },
        "ncu_launch_inventory": {
          "$ref": "#/$defs/schemaIdentity"
        },
        "ncu_launch_metrics": {
          "$ref": "#/$defs/schemaIdentity"
        }
      }
    },
    "registryIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projection_id",
        "projection_sha256",
        "source_registry_version",
        "source_registry_sha256",
        "source_label_schema_version",
        "metric_keys"
      ],
      "properties": {
        "projection_id": {
          "const": "metric_registry.7plus1.v1"
        },
        "projection_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_registry_version": {
          "const": 2
        },
        "source_registry_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_label_schema_version": {
          "const": 5
        },
        "metric_keys": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "smsp_inst_executed_sum",
              "traffic_gmem_ld_sectors",
              "traffic_gmem_st_sectors",
              "traffic_dram_read_sectors",
              "cache_hit_rate_l1tex_read_sector",
              "cache_hit_rate_l1tex_sector",
              "cache_hit_rate_l2_sector",
              "exec_cycles_gpc_max"
            ]
          }
        }
      }
    },
    "builderIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "builder_id",
        "builder_version",
        "builder_sha256"
      ],
      "properties": {
        "builder_id": {
          "const": "eval.production_labels.v1"
        },
        "builder_version": {
          "const": 1
        },
        "builder_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binary_architecture",
        "gpu_sku"
      ],
      "properties": {
        "binary_architecture": {
          "const": "sm_86"
        },
        "gpu_sku": {
          "const": "rtx_3090_ti"
        }
      }
    },
    "contentManifestIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_id",
        "content_manifest_sha256",
        "authority_role"
      ],
      "properties": {
        "manifest_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "content_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "authority_role": {
          "const": "external_producer_content_manifest_anchor"
        }
      }
    }
  }
}

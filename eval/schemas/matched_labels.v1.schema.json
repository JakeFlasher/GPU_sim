{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpu-simulator.local/eval/schemas/matched_labels.v1.schema.json",
  "title": "Independently matched simulator label input v1",
  "description": "Closed evaluator input for independently admitted v5 labels and an independently sealed exact crosswalk. No simulator result identity is an authority for these rows. Cohort launch-key fields become claimable only through this artifact; replay-visible fields still must match authenticated trace evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "matched_labels_sha256",
    "source_label_identity",
    "crosswalk_identity",
    "architecture",
    "launches"
  ],
  "properties": {
    "schema_version": {
      "const": "matched_labels.v1"
    },
    "matched_labels_sha256": {
      "$ref": "#/$defs/sha256",
      "description": "SHA-256 of repository-canonical JSON with this member omitted."
    },
    "source_label_identity": {
      "$ref": "#/$defs/sourceLabelIdentity"
    },
    "crosswalk_identity": {
      "$ref": "#/$defs/crosswalkIdentity"
    },
    "architecture": {
      "$ref": "#/$defs/architecture"
    },
    "launches": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/matchedLaunch"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonemptyString": {
      "type": "string",
      "minLength": 1
    },
    "nonnegativeNumber": {
      "type": "number",
      "minimum": 0
    },
    "positiveU64": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "sourceLabelIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label_set_id",
        "label_set_sha256",
        "label_schema_version",
        "label_schema_sha256",
        "source_manifest_id",
        "source_manifest_sha256",
        "authority_role"
      ],
      "properties": {
        "label_set_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "label_set_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "label_schema_version": {
          "const": 5
        },
        "label_schema_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_manifest_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "source_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "authority_role": {
          "const": "independent_label_source_not_result_derived"
        }
      }
    },
    "crosswalkIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "crosswalk_id",
        "crosswalk_sha256",
        "crosswalk_version",
        "authority_role"
      ],
      "properties": {
        "crosswalk_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "crosswalk_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "crosswalk_version": {
          "$ref": "#/$defs/positiveU64"
        },
        "authority_role": {
          "const": "independently_matched_not_result_authorized"
        }
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binary_architecture",
        "gpu_sku"
      ],
      "properties": {
        "binary_architecture": {
          "const": "sm_86"
        },
        "gpu_sku": {
          "const": "rtx_3090_ti"
        }
      }
    },
    "availableLabelValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "value"
      ],
      "properties": {
        "status": {
          "const": "available"
        },
        "value": {
          "$ref": "#/$defs/nonnegativeNumber"
        }
      }
    },
    "unavailableLabelValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "value",
        "reason"
      ],
      "properties": {
        "status": {
          "const": "unavailable"
        },
        "value": {
          "type": "null"
        },
        "reason": {
          "enum": [
            "source_null",
            "metric_not_collected",
            "typed_exclusion"
          ]
        }
      }
    },
    "labelValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/availableLabelValue"
        },
        {
          "$ref": "#/$defs/unavailableLabelValue"
        }
      ]
    },
    "availableDispersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "rule",
        "scalar"
      ],
      "properties": {
        "status": {
          "const": "available"
        },
        "rule": {
          "enum": [
            "stddev_abs",
            "coefficient_of_variation",
            "relative_tolerance"
          ]
        },
        "scalar": {
          "$ref": "#/$defs/nonnegativeNumber"
        }
      },
      "description": "Actual v5 dispersion scalar under its declared rule; it is not renamed or reconstructed as a different statistic."
    },
    "unavailableDispersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "rule",
        "reason"
      ],
      "properties": {
        "status": {
          "const": "unavailable"
        },
        "rule": {
          "enum": [
            "stddev_abs",
            "coefficient_of_variation",
            "relative_tolerance"
          ]
        },
        "reason": {
          "enum": [
            "source_dispersion_null",
            "rule_scalar_unavailable"
          ]
        }
      }
    },
    "dispersion": {
      "oneOf": [
        {
          "$ref": "#/$defs/availableDispersion"
        },
        {
          "$ref": "#/$defs/unavailableDispersion"
        }
      ]
    },
    "repeatMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repeat_count",
        "aggregation",
        "dispersion"
      ],
      "properties": {
        "repeat_count": {
          "$ref": "#/$defs/positiveU64"
        },
        "aggregation": {
          "enum": [
            "mean_nonneg",
            "mean_fraction"
          ]
        },
        "dispersion": {
          "$ref": "#/$defs/dispersion"
        }
      },
      "description": "Retains only the source repeat count, aggregation, and actual declared dispersion rule/scalar or typed unavailability."
    },
    "metricKey": {
      "enum": [
        "smsp_inst_executed_sum",
        "traffic_gmem_ld_sectors",
        "traffic_gmem_st_sectors",
        "traffic_dram_read_sectors",
        "cache_hit_rate_l1tex_read_sector",
        "cache_hit_rate_l1tex_sector",
        "cache_hit_rate_l2_sector",
        "exec_cycles_gpc_max"
      ]
    },
    "unitTaggedMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_key",
        "ncu_metric",
        "unit",
        "outcome",
        "repeat_metadata"
      ],
      "properties": {
        "metric_key": {
          "$ref": "#/$defs/metricKey"
        },
        "ncu_metric": {
          "$ref": "#/$defs/nonemptyString"
        },
        "unit": {
          "enum": [
            "count",
            "pct",
            "cycles"
          ]
        },
        "outcome": {
          "$ref": "#/$defs/labelValue"
        },
        "repeat_metadata": {
          "$ref": "#/$defs/repeatMetadata"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "metric_key": {
                "const": "smsp_inst_executed_sum"
              }
            },
            "required": [
              "metric_key"
            ]
          },
          "then": {
            "properties": {
              "ncu_metric": {
                "const": "smsp__inst_executed.sum"
              },
              "unit": {
                "const": "count"
              },
              "outcome": {
                "if": {
                  "properties": {
                    "status": {
                      "const": "available"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "properties": {
                    "value": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              },
              "repeat_metadata": {
                "properties": {
                  "aggregation": {
                    "const": "mean_nonneg"
                  },
                  "dispersion": {
                    "properties": {
                      "rule": {
                        "const": "relative_tolerance"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric_key": {
                "const": "traffic_gmem_ld_sectors"
              }
            },
            "required": [
              "metric_key"
            ]
          },
          "then": {
            "properties": {
              "ncu_metric": {
                "const": "l1tex__t_sectors_pipe_lsu_mem_global_op_ld.sum"
              },
              "unit": {
                "const": "count"
              },
              "outcome": {
                "if": {
                  "properties": {
                    "status": {
                      "const": "available"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "properties": {
                    "value": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              },
              "repeat_metadata": {
                "properties": {
                  "aggregation": {
                    "const": "mean_nonneg"
                  },
                  "dispersion": {
                    "properties": {
                      "rule": {
                        "const": "relative_tolerance"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric_key": {
                "const": "traffic_gmem_st_sectors"
              }
            },
            "required": [
              "metric_key"
            ]
          },
          "then": {
            "properties": {
              "ncu_metric": {
                "const": "l1tex__t_sectors_pipe_lsu_mem_global_op_st.sum"
              },
              "unit": {
                "const": "count"
              },
              "outcome": {
                "if": {
                  "properties": {
                    "status": {
                      "const": "available"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "properties": {
                    "value": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              },
              "repeat_metadata": {
                "properties": {
                  "aggregation": {
                    "const": "mean_nonneg"
                  },
                  "dispersion": {
                    "properties": {
                      "rule": {
                        "const": "relative_tolerance"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric_key": {
                "const": "traffic_dram_read_sectors"
              }
            },
            "required": [
              "metric_key"
            ]
          },
          "then": {
            "properties": {
              "ncu_metric": {
                "const": "dram__sectors_read.sum"
              },
              "unit": {
                "const": "count"
              },
              "outcome": {
                "if": {
                  "properties": {
                    "status": {
                      "const": "available"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "properties": {
                    "value": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              },
              "repeat_metadata": {
                "properties": {
                  "aggregation": {
                    "const": "mean_nonneg"
                  },
                  "dispersion": {
                    "properties": {
                      "rule": {
                        "const": "relative_tolerance"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric_key": {
                "const": "cache_hit_rate_l1tex_read_sector"
              }
            },
            "required": [
              "metric_key"
            ]
          },
          "then": {
            "properties": {
              "ncu_metric": {
                "const": "l1tex__t_sector_pipe_lsu_mem_global_op_ld_hit_rate.pct"
              },
              "unit": {
                "const": "pct"
              },
              "outcome": {
                "if": {
                  "properties": {
                    "status": {
                      "const": "available"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "properties": {
                    "value": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                }
              },
              "repeat_metadata": {
                "properties": {
                  "aggregation": {
                    "const": "mean_fraction"
                  },
                  "dispersion": {
                    "properties": {
                      "rule": {
                        "const": "stddev_abs"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric_key": {
                "const": "cache_hit_rate_l1tex_sector"
              }
            },
            "required": [
              "metric_key"
            ]
          },
          "then": {
            "properties": {
              "ncu_metric": {
                "const": "l1tex__t_sector_hit_rate.pct"
              },
              "unit": {
                "const": "pct"
              },
              "outcome": {
                "if": {
                  "properties": {
                    "status": {
                      "const": "available"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "properties": {
                    "value": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                }
              },
              "repeat_metadata": {
                "properties": {
                  "aggregation": {
                    "const": "mean_fraction"
                  },
                  "dispersion": {
                    "properties": {
                      "rule": {
                        "const": "stddev_abs"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric_key": {
                "const": "cache_hit_rate_l2_sector"
              }
            },
            "required": [
              "metric_key"
            ]
          },
          "then": {
            "properties": {
              "ncu_metric": {
                "const": "lts__t_sector_hit_rate.pct"
              },
              "unit": {
                "const": "pct"
              },
              "outcome": {
                "if": {
                  "properties": {
                    "status": {
                      "const": "available"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "properties": {
                    "value": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                }
              },
              "repeat_metadata": {
                "properties": {
                  "aggregation": {
                    "const": "mean_fraction"
                  },
                  "dispersion": {
                    "properties": {
                      "rule": {
                        "const": "stddev_abs"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric_key": {
                "const": "exec_cycles_gpc_max"
              }
            },
            "required": [
              "metric_key"
            ]
          },
          "then": {
            "properties": {
              "ncu_metric": {
                "const": "gpc__cycles_elapsed.max"
              },
              "unit": {
                "const": "cycles"
              },
              "outcome": {
                "if": {
                  "properties": {
                    "status": {
                      "const": "available"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "properties": {
                    "value": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              },
              "repeat_metadata": {
                "properties": {
                  "aggregation": {
                    "const": "mean_nonneg"
                  },
                  "dispersion": {
                    "properties": {
                      "rule": {
                        "const": "coefficient_of_variation"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "matchedLaunch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "launch_key",
        "kernel_family",
        "metrics"
      ],
      "properties": {
        "launch_key": {
          "$ref": "https://gpu-simulator.local/eval/schemas/launch_key.v1.schema.json"
        },
        "kernel_family": {
          "$ref": "#/$defs/nonemptyString"
        },
        "metrics": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/unitTaggedMetric"
          }
        }
      }
    }
  }
}

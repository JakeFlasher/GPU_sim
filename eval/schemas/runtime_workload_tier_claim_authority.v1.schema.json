{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpu-simulator.local/eval/schemas/runtime_workload_tier_claim_authority.v1.schema.json",
  "title": "Detached runtime and workload-tier claim authority v1",
  "description": "Post-result runtime claim authority. The exploratory runtime record remains unchanged; accuracy is linked only after result sealing through detached evaluator evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_sha256",
    "claim_sha256",
    "created_at_utc",
    "authority_role",
    "contract_mode",
    "retained_evidence_generation",
    "runtime_record_binding",
    "source_authority",
    "workload_execution_authority",
    "content_manifest_anchor",
    "result_binding",
    "accuracy_binding",
    "derived_binding",
    "claimability"
  ],
  "properties": {
    "schema_version": {"const": "runtime_workload_tier_claim_authority.v1"},
    "schema_sha256": {"$ref": "#/$defs/sha256"},
    "claim_sha256": {"$ref": "#/$defs/sha256"},
    "created_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "authority_role": {"const": "detached_post_result_runtime_claim_authority"},
    "contract_mode": {
      "enum": ["TARGET_FREE_PRODUCTION", "FIXTURE_ONLY_NON_AUTHORITATIVE"]
    },
    "retained_evidence_generation": {"$ref": "#/$defs/evidenceGeneration"},
    "runtime_record_binding": {"$ref": "#/$defs/runtimeRecordBinding"},
    "source_authority": {
      "oneOf": [
        {"$ref": "#/$defs/boundSourceAuthority"},
        {"$ref": "#/$defs/unavailableEvidence"}
      ]
    },
    "workload_execution_authority": {
      "oneOf": [
        {"$ref": "#/$defs/boundWorkloadAuthority"},
        {"$ref": "#/$defs/unavailableEvidence"}
      ]
    },
    "content_manifest_anchor": {
      "oneOf": [
        {"$ref": "#/$defs/boundContentManifest"},
        {"$ref": "#/$defs/unavailableEvidence"}
      ]
    },
    "result_binding": {
      "oneOf": [
        {"$ref": "#/$defs/boundResult"},
        {"$ref": "#/$defs/unavailableEvidence"}
      ]
    },
    "accuracy_binding": {
      "oneOf": [
        {"$ref": "#/$defs/boundAccuracy"},
        {"$ref": "#/$defs/unavailableEvidence"}
      ]
    },
    "derived_binding": {
      "oneOf": [
        {"$ref": "#/$defs/derivedBinding"},
        {"$ref": "#/$defs/unavailableEvidence"}
      ]
    },
    "claimability": {"$ref": "#/$defs/claimability"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonempty": {"type": "string", "minLength": 1, "maxLength": 4096},
    "safeId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"},
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size_bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^/", "maxLength": 4096},
        "size_bytes": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "unavailableEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": {"const": "unavailable"},
        "reason": {"$ref": "#/$defs/safeId"}
      }
    },
    "evidenceGenerationFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size_bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "size_bytes": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evidenceGeneration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path", "content_manifest_sha256", "filesystem_generation_sha256",
        "file_count", "directory_count", "total_file_bytes", "files"
      ],
      "properties": {
        "path": {"type": "string", "pattern": "^/", "maxLength": 4096},
        "content_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "filesystem_generation_sha256": {"$ref": "#/$defs/sha256"},
        "file_count": {"type": "integer", "minimum": 1, "maximum": 64},
        "directory_count": {"type": "integer", "minimum": 1, "maximum": 2},
        "total_file_bytes": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
        "files": {
          "type": "array", "minItems": 1, "maxItems": 64,
          "items": {"$ref": "#/$defs/evidenceGenerationFile"}
        }
      }
    },
    "boundSourceAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "file", "authority_sha256", "source_git_commit", "contract_mode"
      ],
      "properties": {
        "status": {"const": "bound"},
        "file": {"$ref": "#/$defs/fileIdentity"},
        "authority_sha256": {"$ref": "#/$defs/sha256"},
        "source_git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "contract_mode": {
          "enum": ["TARGET_FREE_PRODUCTION", "FIXTURE_ONLY_NON_AUTHORITATIVE"]
        }
      }
    },
    "runtimeRecordBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "file", "record_sha256", "outcome_status"],
      "properties": {
        "status": {"const": "bound"},
        "file": {"$ref": "#/$defs/fileIdentity"},
        "record_sha256": {"$ref": "#/$defs/sha256"},
        "outcome_status": {
          "enum": ["MEASURED", "RUNTIME_NOISY", "RUNTIME_EXECUTION_FAILED", "NONDETERMINISTIC_RESULT"]
        }
      }
    },
    "boundWorkloadAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "file", "model_seal_sha256", "workload_id",
        "matched_execution_id", "contract_mode"
      ],
      "properties": {
        "status": {"const": "bound"},
        "file": {"$ref": "#/$defs/fileIdentity"},
        "model_seal_sha256": {"$ref": "#/$defs/sha256"},
        "workload_id": {"$ref": "#/$defs/nonempty"},
        "matched_execution_id": {"$ref": "#/$defs/nonempty"},
        "contract_mode": {
          "enum": ["TARGET_FREE_PRODUCTION", "FIXTURE_ONLY_V2_NON_AUTHORITATIVE"]
        }
      }
    },
    "tierAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier_id", "admission_status", "classification",
        "workload_execution_authority_model_seal_sha256",
        "manifest_canonical_sha256", "trace_identity_sha256",
        "launch_set_sha256", "architecture_identity_sha256",
        "configuration_identity_sha256"
      ],
      "properties": {
        "tier_id": {"enum": ["T-mid", "T-big"]},
        "admission_status": {"enum": ["admitted", "unadmitted"]},
        "classification": {"enum": ["production", "fixture"]},
        "workload_execution_authority_model_seal_sha256": {"$ref": "#/$defs/sha256"},
        "manifest_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "trace_identity_sha256": {"$ref": "#/$defs/sha256"},
        "launch_set_sha256": {"$ref": "#/$defs/sha256"},
        "architecture_identity_sha256": {"$ref": "#/$defs/sha256"},
        "configuration_identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "boundContentManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "file", "manifest_id", "manifest_sha256",
        "external_file_sha256", "workload_tier_authority"
      ],
      "properties": {
        "status": {"const": "bound"},
        "file": {"$ref": "#/$defs/fileIdentity"},
        "manifest_id": {"$ref": "#/$defs/safeId"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "external_file_sha256": {"$ref": "#/$defs/sha256"},
        "workload_tier_authority": {"$ref": "#/$defs/tierAuthority"}
      }
    },
    "boundResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "file_sha256", "result_sha256"],
      "properties": {
        "status": {"const": "bound"},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "result_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "boundAccuracy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "evaluator_authority_file", "evaluator_authority_id",
        "evaluator_authority_sha256", "report_file", "report_id",
        "report_sha256"
      ],
      "properties": {
        "status": {"const": "bound"},
        "evaluator_authority_file": {"$ref": "#/$defs/fileIdentity"},
        "evaluator_authority_id": {"$ref": "#/$defs/safeId"},
        "evaluator_authority_sha256": {"$ref": "#/$defs/sha256"},
        "report_file": {"$ref": "#/$defs/fileIdentity"},
        "report_id": {"$ref": "#/$defs/nonempty"},
        "report_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "derivedBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "manifest_canonical_sha256", "trace_identity_sha256",
        "launch_set_sha256", "architecture_identity_sha256",
        "configuration_identity_sha256", "binary_sha256", "workload_id",
        "matched_execution_id", "binary_architecture", "gpu_sku"
      ],
      "properties": {
        "status": {"const": "bound"},
        "manifest_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "trace_identity_sha256": {"$ref": "#/$defs/sha256"},
        "launch_set_sha256": {"$ref": "#/$defs/sha256"},
        "architecture_identity_sha256": {"$ref": "#/$defs/sha256"},
        "configuration_identity_sha256": {"$ref": "#/$defs/sha256"},
        "binary_sha256": {"$ref": "#/$defs/sha256"},
        "workload_id": {"$ref": "#/$defs/nonempty"},
        "matched_execution_id": {"$ref": "#/$defs/nonempty"},
        "binary_architecture": {"$ref": "#/$defs/safeId"},
        "gpu_sku": {"$ref": "#/$defs/safeId"}
      }
    },
    "claimability": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "basis"],
          "properties": {
            "status": {"const": "claimable"},
            "basis": {"const": "clean_committed_release_measured_admitted_tier_sealed_result_and_accuracy_v1"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": {"const": "unclaimable"},
            "reason": {
              "enum": [
                "SYNTHETIC_FIXTURE", "DIRTY_BUILD_UNCLAIMABLE",
                "RUNTIME_NOISY", "RUNTIME_TIMEOUT", "RUNTIME_EXECUTION_FAILED",
                "NONDETERMINISTIC_RESULT", "RUNTIME_PROTOCOL_PARTIAL",
                "WORKLOAD_EXECUTION_AUTHORITY_UNAVAILABLE",
                "SOURCE_AUTHORITY_UNAVAILABLE",
                "CONTENT_MANIFEST_AUTHORITY_UNAVAILABLE",
                "EVALUATOR_AUTHORITY_UNAVAILABLE", "ACCURACY_REPORT_UNAVAILABLE",
                "WORKLOAD_TIER_UNADMITTED", "WORKLOAD_TIER_FIXTURE",
                "FIXTURE_ONLY_NON_AUTHORITATIVE"
              ]
            }
          }
        }
      ]
    }
  }
}

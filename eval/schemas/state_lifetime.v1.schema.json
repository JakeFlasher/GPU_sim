{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpu-simulator.invalid/eval/schemas/state_lifetime.v1.schema.json",
  "title": "Explicitly fixture-only state evidence and classification contracts v1",
  "oneOf": [
    {
      "$ref": "#/$defs/classification"
    },
    {
      "$ref": "#/$defs/evidence_payload"
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "safe_nonnegative_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "safe_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}(?![\\s\\S])"
    },
    "decimal": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:0|[1-9][0-9]*)(?![\\s\\S])"
    },
    "snapshot_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device",
        "inode",
        "mode",
        "link_count",
        "size_bytes",
        "mtime_ns",
        "ctime_ns"
      ],
      "properties": {
        "device": {
          "$ref": "#/$defs/decimal"
        },
        "inode": {
          "$ref": "#/$defs/decimal"
        },
        "mode": {
          "$ref": "#/$defs/decimal"
        },
        "link_count": {
          "const": "1"
        },
        "size_bytes": {
          "$ref": "#/$defs/decimal"
        },
        "mtime_ns": {
          "$ref": "#/$defs/decimal"
        },
        "ctime_ns": {
          "$ref": "#/$defs/decimal"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acquisition",
        "payload_sha256",
        "size_bytes",
        "metadata",
        "snapshot_identity_sha256"
      ],
      "properties": {
        "acquisition": {
          "enum": [
            "PINNED_REGULAR_NOFOLLOW_V1",
            "FIXTURE_CALLER_BYTES_V1"
          ]
        },
        "payload_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "$ref": "#/$defs/safe_nonnegative_integer"
        },
        "metadata": {
          "$ref": "#/$defs/snapshot_metadata"
        },
        "snapshot_identity_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "selected_ids": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical",
        "ncu",
        "nvbit",
        "simulator"
      ],
      "properties": {
        "canonical": {
          "$ref": "#/$defs/sha256"
        },
        "ncu": {
          "$ref": "#/$defs/sha256"
        },
        "nvbit": {
          "$ref": "#/$defs/sha256"
        },
        "simulator": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "evidence_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_record_id",
        "evidence_basis",
        "state_origin",
        "cache_condition",
        "launch_scope",
        "execution_relation",
        "isolation_state",
        "stream_scope",
        "process_scope",
        "device_scope",
        "evidence_authority_status",
        "evidence_authority_sha256",
        "crosswalk_model_seal_sha256",
        "selected_qualified_launch_ids",
        "record_identity_sha256"
      ],
      "properties": {
        "evidence_record_id": {
          "$ref": "#/$defs/safe_id"
        },
        "evidence_basis": {
          "enum": [
            "EXACT",
            "INFERRED",
            "UNKNOWN"
          ]
        },
        "state_origin": {
          "enum": [
            "FRESH",
            "PERSISTENT",
            "UNKNOWN"
          ]
        },
        "cache_condition": {
          "enum": [
            "COLD",
            "EVICTED",
            "WARM",
            "UNKNOWN"
          ]
        },
        "launch_scope": {
          "enum": [
            "SINGLE_LAUNCH",
            "MULTI_LAUNCH",
            "UNKNOWN"
          ]
        },
        "execution_relation": {
          "enum": [
            "INDEPENDENT",
            "DEPENDENT",
            "CONCURRENT",
            "UNKNOWN"
          ]
        },
        "isolation_state": {
          "enum": [
            "ISOLATED",
            "NON_ISOLATED",
            "UNKNOWN"
          ]
        },
        "stream_scope": {
          "enum": [
            "SINGLE_STREAM",
            "MULTI_STREAM",
            "UNKNOWN"
          ]
        },
        "process_scope": {
          "enum": [
            "SINGLE_PROCESS",
            "MULTI_PROCESS",
            "UNKNOWN"
          ]
        },
        "device_scope": {
          "enum": [
            "SINGLE_DEVICE",
            "MULTI_DEVICE",
            "UNKNOWN"
          ]
        },
        "crosswalk_model_seal_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "selected_qualified_launch_ids": {
          "$ref": "#/$defs/selected_ids"
        },
        "record_identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "evidence_authority_status": {
          "const": "FIXTURE_ONLY_CALLER_ASSERTIONS"
        },
        "evidence_authority_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "evidence_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "artifact_kind",
        "schema_sha256",
        "contract_mode",
        "evidence_authority",
        "records",
        "model_seal_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "artifact_kind": {
          "const": "EVALUATOR_STATE_LIFETIME_EVIDENCE"
        },
        "schema_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "records": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidence_record"
          }
        },
        "model_seal_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "contract_mode": {
          "const": "FIXTURE_ONLY"
        },
        "evidence_authority": {
          "$ref": "#/$defs/evidence_authority"
        }
      }
    },
    "evidence_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload_snapshot",
        "payload_model_seal_sha256",
        "evidence_record_id",
        "record_identity_sha256",
        "crosswalk_model_seal_sha256",
        "selected_qualified_launch_ids"
      ],
      "properties": {
        "payload_snapshot": {
          "$ref": "#/$defs/snapshot"
        },
        "payload_model_seal_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "evidence_record_id": {
          "$ref": "#/$defs/safe_id"
        },
        "record_identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "crosswalk_model_seal_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "selected_qualified_launch_ids": {
          "$ref": "#/$defs/selected_ids"
        }
      }
    },
    "rejected_reason": {
      "enum": [
        "WARM_STATE_REJECTED",
        "PERSISTENT_STATE_REJECTED",
        "CONCURRENT_EXECUTION_REJECTED",
        "DEPENDENT_EXECUTION_REJECTED",
        "NON_ISOLATED_EXECUTION_REJECTED",
        "MULTI_LAUNCH_REJECTED",
        "MULTI_STREAM_REJECTED",
        "MULTI_PROCESS_REJECTED",
        "MULTI_DEVICE_REJECTED"
      ]
    },
    "unavailable_reason": {
      "enum": [
        "EXACT_EVIDENCE_UNAVAILABLE",
        "FRESH_STATE_UNAVAILABLE",
        "EVICTED_IS_NOT_EXACT_COLD",
        "COLD_STATE_UNAVAILABLE",
        "SINGLE_LAUNCH_UNAVAILABLE",
        "INDEPENDENCE_UNAVAILABLE",
        "ISOLATION_UNAVAILABLE",
        "SINGLE_STREAM_UNAVAILABLE",
        "SINGLE_PROCESS_UNAVAILABLE",
        "SINGLE_DEVICE_UNAVAILABLE",
        "FIXTURE_ONLY_STATE_EVIDENCE",
        "CROSSWALK_UNAVAILABLE",
        "EXACT_EVIDENCE_PAYLOAD_UNAVAILABLE",
        "EVIDENCE_SCHEMA_UNAVAILABLE",
        "EVIDENCE_PAYLOAD_INVALID",
        "EVIDENCE_RECORD_UNAVAILABLE",
        "EVIDENCE_CROSSWALK_BINDING_UNAVAILABLE"
      ]
    },
    "outcome": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason_codes"
          ],
          "properties": {
            "status": {
              "const": "REJECTED"
            },
            "reason_codes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/rejected_reason"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason_codes"
          ],
          "properties": {
            "status": {
              "const": "UNAVAILABLE"
            },
            "reason_codes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/unavailable_reason"
              }
            }
          }
        }
      ]
    },
    "unresolved_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status"
      ],
      "properties": {
        "name": {
          "enum": [
            "CYCLE_MAPPING",
            "CYCLE_COMPOSITION",
            "COHORT",
            "PROTOCOL_NUMERIC_SETTINGS",
            "COVERAGE",
            "TRUST",
            "OPERATOR_APPROVAL"
          ]
        },
        "status": {
          "const": "UNRESOLVED"
        }
      }
    },
    "evaluation_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "m5",
        "scientific_inputs",
        "cycles"
      ],
      "properties": {
        "mode": {
          "const": "TARGET_FREE_OFFLINE_ONLY"
        },
        "m5": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "collection_status"
          ],
          "properties": {
            "status": {
              "const": "M5_NOT_STARTED"
            },
            "collection_status": {
              "const": "M5_COLLECT_DISABLED"
            }
          }
        },
        "scientific_inputs": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "prefixItems": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "status"
              ],
              "properties": {
                "name": {
                  "const": "CYCLE_MAPPING"
                },
                "status": {
                  "const": "UNRESOLVED"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "status"
              ],
              "properties": {
                "name": {
                  "const": "CYCLE_COMPOSITION"
                },
                "status": {
                  "const": "UNRESOLVED"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "status"
              ],
              "properties": {
                "name": {
                  "const": "COHORT"
                },
                "status": {
                  "const": "UNRESOLVED"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "status"
              ],
              "properties": {
                "name": {
                  "const": "PROTOCOL_NUMERIC_SETTINGS"
                },
                "status": {
                  "const": "UNRESOLVED"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "status"
              ],
              "properties": {
                "name": {
                  "const": "COVERAGE"
                },
                "status": {
                  "const": "UNRESOLVED"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "status"
              ],
              "properties": {
                "name": {
                  "const": "TRUST"
                },
                "status": {
                  "const": "UNRESOLVED"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "status"
              ],
              "properties": {
                "name": {
                  "const": "OPERATOR_APPROVAL"
                },
                "status": {
                  "const": "UNRESOLVED"
                }
              }
            }
          ],
          "items": false
        },
        "cycles": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "metric_id",
            "implementation_status",
            "evaluation_state",
            "outcome",
            "score_status"
          ],
          "properties": {
            "metric_id": {
              "const": "gpc__cycles_elapsed.max"
            },
            "implementation_status": {
              "const": "required_unimplemented"
            },
            "evaluation_state": {
              "const": "pending"
            },
            "outcome": {
              "const": "unavailable"
            },
            "score_status": {
              "const": "unscored"
            }
          }
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "artifact_kind",
        "schema_sha256",
        "contract_mode",
        "evaluation_boundary",
        "evidence_source",
        "evidence",
        "outcome",
        "model_seal_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "artifact_kind": {
          "const": "EVALUATOR_STATE_LIFETIME_CLASSIFICATION"
        },
        "schema_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "evaluation_boundary": {
          "$ref": "#/$defs/evaluation_boundary"
        },
        "evidence_source": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/evidence_source"
            }
          ]
        },
        "evidence": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/evidence_record"
            }
          ]
        },
        "outcome": {
          "$ref": "#/$defs/outcome"
        },
        "model_seal_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "contract_mode": {
          "const": "FIXTURE_ONLY"
        }
      }
    },
    "evidence_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "authority_id",
        "derivation",
        "authority_sha256"
      ],
      "properties": {
        "status": {
          "const": "FIXTURE_ONLY_CALLER_ASSERTIONS"
        },
        "authority_id": {
          "const": "FIXTURE_STATE_LIFETIME_ASSERTIONS_V1"
        },
        "derivation": {
          "const": "CALLER_ENUM_ASSERTIONS_NOT_PRODUCTION_EVIDENCE"
        },
        "authority_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpu-simulator.invalid/eval/schemas/preregistration_receipt.v1.schema.json",
  "title": "Explicitly fixture-only preregistration blocker v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "schema_sha256",
    "contract_mode",
    "production_eligibility",
    "evaluation_boundary",
    "phase_chain",
    "unvalidated_artifact_fixtures",
    "fixture_candidate_inventory",
    "authority_slots",
    "model_seal_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact_kind": {
      "const": "EVALUATOR_PREREGISTRATION_FIXTURE"
    },
    "schema_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "contract_mode": {
      "const": "FIXTURE_ONLY"
    },
    "production_eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason_codes"
      ],
      "properties": {
        "status": {
          "const": "UNAVAILABLE"
        },
        "reason_codes": {
          "const": [
            "TARGET_FREE_ARTIFACT_AUTHORITY_UNAVAILABLE",
            "ANCESTRY_REVIEW_AUTHORITY_UNAVAILABLE"
          ]
        }
      }
    },
    "evaluation_boundary": {
      "$ref": "#/$defs/evaluation_boundary"
    },
    "phase_chain": {
      "$ref": "#/$defs/preregistration_phase"
    },
    "unvalidated_artifact_fixtures": {
      "$ref": "#/$defs/unvalidated_artifact_fixtures"
    },
    "fixture_candidate_inventory": {
      "$ref": "#/$defs/candidate_inventory"
    },
    "authority_slots": {
      "$ref": "#/$defs/authority_slots"
    },
    "model_seal_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "safe_positive_integer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "ascii_token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9]+(?:[._-][A-Za-z0-9]+)*(?![\\s\\S])"
    },
    "artifact_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_schema_version",
        "artifact_kind",
        "artifact_schema_version",
        "artifact_id",
        "artifact_sha256",
        "authority_status"
      ],
      "properties": {
        "identity_schema_version": {
          "const": 1
        },
        "artifact_kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Z][A-Z0-9_]{0,127}(?![\\s\\S])"
        },
        "artifact_schema_version": {
          "const": 1
        },
        "artifact_id": {
          "$ref": "#/$defs/ascii_token"
        },
        "artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "authority_status": {
          "const": "FIXTURE_ONLY_OPAQUE_UNVALIDATED"
        }
      }
    },
    "method_identity": {
      "allOf": [
        {
          "$ref": "#/$defs/artifact_identity"
        },
        {
          "properties": {
            "artifact_kind": {
              "const": "FIXTURE_UNVALIDATED_EVALUATION_METHOD"
            }
          }
        }
      ]
    },
    "source_identity": {
      "allOf": [
        {
          "$ref": "#/$defs/artifact_identity"
        },
        {
          "properties": {
            "artifact_kind": {
              "const": "FIXTURE_UNVALIDATED_SOURCE_INVENTORY"
            }
          }
        }
      ]
    },
    "ancestry_identity": {
      "allOf": [
        {
          "$ref": "#/$defs/artifact_identity"
        },
        {
          "properties": {
            "artifact_kind": {
              "const": "FIXTURE_UNVALIDATED_ANCESTRY_AUDIT"
            }
          }
        }
      ]
    },
    "authority_slots": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authority",
            "status"
          ],
          "properties": {
            "authority": {
              "const": "REVIEWER_ACCEPTANCE"
            },
            "status": {
              "const": "UNRESOLVED"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authority",
            "status"
          ],
          "properties": {
            "authority": {
              "const": "OPERATOR_APPROVAL"
            },
            "status": {
              "const": "UNRESOLVED"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authority",
            "status"
          ],
          "properties": {
            "authority": {
              "const": "TRUST_ACCEPTANCE"
            },
            "status": {
              "const": "UNRESOLVED"
            }
          }
        }
      ],
      "items": false
    },
    "preregistration_phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chain_schema_version",
        "chain_mode",
        "chain_id_sha256",
        "phase",
        "phase_ordinal",
        "ordering_basis",
        "predecessor_receipt",
        "state_lifetime"
      ],
      "properties": {
        "chain_schema_version": {
          "const": 1
        },
        "chain_mode": {
          "const": "FIXTURE_ONLY"
        },
        "chain_id_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "phase": {
          "const": "PREREGISTRATION_FIXTURE"
        },
        "phase_ordinal": {
          "const": 0
        },
        "ordering_basis": {
          "const": "PHASE_ORDINAL_AND_EXACT_PREDECESSOR_HASH"
        },
        "predecessor_receipt": {
          "type": "null"
        },
        "state_lifetime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "preregistration_bindings",
            "prediction_bindings",
            "label_bundle_binding",
            "label_payload",
            "scoring"
          ],
          "properties": {
            "preregistration_bindings": {
              "const": "FIXTURE_SEALED_NONAUTHORITATIVE"
            },
            "prediction_bindings": {
              "const": "NOT_CREATED"
            },
            "label_bundle_binding": {
              "const": "BLOCKED_NOT_BOUND"
            },
            "label_payload": {
              "const": "ABSENT"
            },
            "scoring": {
              "const": "DISABLED"
            }
          }
        }
      }
    },
    "unresolved_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status"
      ],
      "properties": {
        "name": {
          "enum": [
            "CYCLE_MAPPING",
            "CYCLE_COMPOSITION",
            "COHORT",
            "PROTOCOL_NUMERIC_SETTINGS",
            "COVERAGE",
            "TRUST",
            "OPERATOR_APPROVAL"
          ]
        },
        "status": {
          "const": "UNRESOLVED"
        }
      }
    },
    "evaluation_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "m5",
        "scientific_inputs",
        "cycles"
      ],
      "properties": {
        "mode": {
          "const": "TARGET_FREE_OFFLINE_ONLY"
        },
        "m5": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "collection_status"
          ],
          "properties": {
            "status": {
              "const": "M5_NOT_STARTED"
            },
            "collection_status": {
              "const": "M5_COLLECT_DISABLED"
            }
          }
        },
        "scientific_inputs": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "prefixItems": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "status"
              ],
              "properties": {
                "name": {
                  "const": "CYCLE_MAPPING"
                },
                "status": {
                  "const": "UNRESOLVED"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "status"
              ],
              "properties": {
                "name": {
                  "const": "CYCLE_COMPOSITION"
                },
                "status": {
                  "const": "UNRESOLVED"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "status"
              ],
              "properties": {
                "name": {
                  "const": "COHORT"
                },
                "status": {
                  "const": "UNRESOLVED"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "status"
              ],
              "properties": {
                "name": {
                  "const": "PROTOCOL_NUMERIC_SETTINGS"
                },
                "status": {
                  "const": "UNRESOLVED"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "status"
              ],
              "properties": {
                "name": {
                  "const": "COVERAGE"
                },
                "status": {
                  "const": "UNRESOLVED"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "status"
              ],
              "properties": {
                "name": {
                  "const": "TRUST"
                },
                "status": {
                  "const": "UNRESOLVED"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "status"
              ],
              "properties": {
                "name": {
                  "const": "OPERATOR_APPROVAL"
                },
                "status": {
                  "const": "UNRESOLVED"
                }
              }
            }
          ],
          "items": false
        },
        "cycles": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "metric_id",
            "implementation_status",
            "evaluation_state",
            "outcome",
            "score_status"
          ],
          "properties": {
            "metric_id": {
              "const": "gpc__cycles_elapsed.max"
            },
            "implementation_status": {
              "const": "required_unimplemented"
            },
            "evaluation_state": {
              "const": "pending"
            },
            "outcome": {
              "const": "unavailable"
            },
            "score_status": {
              "const": "unscored"
            }
          }
        }
      }
    },
    "unvalidated_artifact_fixtures": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_free_method",
        "source_inventory",
        "ancestry_audit"
      ],
      "properties": {
        "target_free_method": {
          "$ref": "#/$defs/method_identity"
        },
        "source_inventory": {
          "$ref": "#/$defs/source_identity"
        },
        "ancestry_audit": {
          "$ref": "#/$defs/ancestry_identity"
        }
      }
    },
    "candidate_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_schema_version",
        "authority_status",
        "candidate_id",
        "canonical_launch_identity_sha256",
        "candidate_record_sha256",
        "candidate_identity_sha256"
      ],
      "properties": {
        "identity_schema_version": {
          "const": 1
        },
        "authority_status": {
          "const": "FIXTURE_ONLY_NONAUTHORITATIVE"
        },
        "candidate_id": {
          "$ref": "#/$defs/ascii_token"
        },
        "canonical_launch_identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_record_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_identity_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "candidate_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory_schema_version",
        "selection_state",
        "candidate_count",
        "candidates",
        "inventory_sha256"
      ],
      "properties": {
        "inventory_schema_version": {
          "const": 1
        },
        "selection_state": {
          "const": "FIXTURE_CANDIDATES_COMPLETE_NONAUTHORITATIVE"
        },
        "candidate_count": {
          "$ref": "#/$defs/safe_positive_integer"
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/candidate_identity"
          }
        },
        "inventory_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}

CUDA_BIN ?= /usr/local/cuda-13.2/bin
NVCC ?= $(CUDA_BIN)/nvcc
NVCC_FLAGS ?= -std=c++17 -O3 -arch=sm_86 -lineinfo -Xptxas=-v

.PHONY: all clean

all: async_source_line_ownership

async_source_line_ownership: async_source_line_ownership.cu
	$(NVCC) $(NVCC_FLAGS) -o $@ $<

clean:
	rm -f async_source_line_ownership

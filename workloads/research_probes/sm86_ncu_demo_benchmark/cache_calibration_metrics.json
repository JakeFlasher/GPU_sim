{
  "schema_version": 1,
  "metric_schema_id": "sm86_cache_calibration_metrics_v1",
  "metrics": [
    {
      "id": "gpc_elapsed_cycles",
      "ncu_metric": "gpc__cycles_elapsed.max",
      "simulator_source": "launch.timing.terminal_modeled_event_time",
      "unit": "cycles",
      "error": "ape_when_ncu_positive",
      "report_name": "terminal_lower_bound_mape_pct",
      "simulator_role": "diagnostic_lower_bound_when_frontier_incomplete",
      "aggregate": "launch_weighted_mean_ape"
    },
    {
      "id": "sm_active_cycles",
      "ncu_metric": "sm__cycles_active.max",
      "simulator_source": "launch.timing.diagnostic_last_issue_cycles",
      "unit": "cycles",
      "error": "ape_when_ncu_positive",
      "report_name": "issue_frontier_mape_pct",
      "simulator_role": "issue_only_diagnostic",
      "aggregate": "launch_weighted_mean_ape"
    },
    {
      "id": "gpu_kernel_duration",
      "ncu_metric": "gpu__time_duration.sum",
      "simulator_source": null,
      "unit": "nanoseconds",
      "error": "not_scored_used_for_execution_cost_ratio",
      "aggregate": "sum_per_workload"
    },
    {
      "id": "instructions",
      "ncu_metric": "smsp__inst_executed.sum",
      "simulator_source": "launch.counters.instructions_issued",
      "unit": "count",
      "error": "ape_when_ncu_positive",
      "aggregate": "launch_weighted_mean_ape",
      "counter_mape_member": true
    },
    {
      "id": "global_load_sectors",
      "ncu_metric": "l1tex__t_sectors_pipe_lsu_mem_global_op_ld.sum",
      "simulator_source": "metric_predictions.global_load_sectors",
      "unit": "sectors_32b",
      "error": "ape_when_ncu_positive_else_exact_zero_match_only",
      "aggregate": "launch_weighted_mean_ape",
      "counter_mape_member": true
    },
    {
      "id": "global_store_sectors",
      "ncu_metric": "l1tex__t_sectors_pipe_lsu_mem_global_op_st.sum",
      "simulator_source": "metric_predictions.global_store_sectors",
      "unit": "sectors_32b",
      "error": "ape_when_ncu_positive_else_exact_zero_match_only",
      "aggregate": "launch_weighted_mean_ape",
      "counter_mape_member": true
    },
    {
      "id": "l1_read_hit_rate",
      "ncu_metric": "l1tex__t_sector_pipe_lsu_mem_global_op_ld_hit_rate.pct",
      "ncu_sources": [
        "l1tex__t_sectors_pipe_lsu_mem_global_op_ld_lookup_hit.sum",
        "l1tex__t_sectors_pipe_lsu_mem_global_op_ld_lookup_miss.sum"
      ],
      "ncu_formula": "100 * hit_sectors / (hit_sectors + miss_sectors)",
      "simulator_source": "metric_predictions.l1_read_hit_rate_pct",
      "unit": "percent",
      "error": "mape_when_ncu_positive_and_absolute_percentage_point_error",
      "aggregate": "covered_launch_mean",
      "hit_rate_member": true
    },
    {
      "id": "l1_unified_hit_rate",
      "ncu_metric": "l1tex__t_sector_hit_rate.pct",
      "ncu_sources": [
        "l1tex__t_sectors_lookup_hit.sum",
        "l1tex__t_sectors_lookup_miss.sum"
      ],
      "ncu_formula": "100 * hit_sectors / (hit_sectors + miss_sectors)",
      "simulator_source": "metric_predictions.l1_unified_hit_rate_pct",
      "unit": "percent",
      "error": "mape_when_ncu_positive_and_absolute_percentage_point_error",
      "aggregate": "covered_launch_mean",
      "hit_rate_member": true
    },
    {
      "id": "l2_unified_hit_rate",
      "ncu_metric": "lts__t_sector_hit_rate.pct",
      "ncu_sources": [
        "lts__t_sectors_srcunit_tex_lookup_hit.sum",
        "lts__t_sectors_srcunit_tex_lookup_miss.sum"
      ],
      "ncu_formula": "100 * hit_sectors / (hit_sectors + miss_sectors)",
      "ncu_scope": "L1TEX-origin L2 sectors only",
      "simulator_source": "metric_predictions.l2_unified_hit_rate_pct",
      "unit": "percent",
      "error": "mape_when_ncu_positive_and_absolute_percentage_point_error",
      "aggregate": "covered_launch_mean",
      "hit_rate_member": true
    },
    {
      "id": "dram_read_sectors",
      "ncu_metric": "dram__sectors_read.sum",
      "simulator_source": "launch.counters.dram.read_sectors",
      "unit": "sectors_32b",
      "error": "ape_when_ncu_positive_else_exact_zero_match_only",
      "aggregate": "launch_weighted_mean_ape",
      "counter_mape_member": true
    }
  ],
  "timing_ratios": [
    {
      "id": "gpu_execution_over_simulator_wall",
      "numerator": "sum(gpu__time_duration.sum) * 1e-9",
      "denominator": "simulator_process_wall_seconds",
      "interpretation": "raw GPU execution per simulator wall; normally below one",
      "never_label_as": "speedup_without_ratio_name"
    },
    {
      "id": "ncu_profile_wall_over_simulator_wall",
      "numerator": "ncu_process_wall_seconds",
      "denominator": "simulator_process_wall_seconds",
      "interpretation": "tool-cost ratio including NCU replay overhead",
      "never_label_as": "hardware_speedup"
    }
  ],
  "aggregation": {
    "workload_mape": "arithmetic mean of comparable per-launch APE values",
    "total_mape": "arithmetic mean over all comparable launches, explicitly launch weighted",
    "counter_mape": "mean APE over covered counter_mape_member metric-launch pairs",
    "hit_rate_mape": "mean relative error only where NCU percent is positive",
    "hit_rate_mae_pp": "mean absolute simulator-minus-NCU percentage-point error over covered launches",
    "zero_denominator": "MAPE unavailable; report exact-zero match or absolute error only",
    "missing_metric": "unavailable with coverage count; never impute zero"
  }
}

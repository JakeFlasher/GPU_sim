.version 9.2
.target sm_86
.address_size 64

.visible .entry imc_kernel(
 .param .u64 imc_out,
 .param .u32 imc_iters,
 .param .u32 imc_a,
 .param .u32 imc_b,
 .param .u32 imc_c,
 .param .u32 imc_d
)
.maxntid 32,1,1
{
 .reg .pred %p<2>;
 .reg .b32 %r<10>;
 .reg .b64 %rd<8>;
 ld.param.u64 %rd0,[imc_out];
 ld.param.u32 %r0,[imc_iters];
 mov.u32 %r1,%tid.x;
 mov.u32 %r2,%r1;
 mov.u32 %r3,0;
 bar.sync 0;
 mov.u64 %rd1,%clock64;
 mov.u32 %r4,0;
$L:
 .pragma "nounroll";
 // Parameter loads are deliberately inside the loop.  ptxas lowers them to
 // SASS IADD3/CBANK operands while keeping the accumulator in registers.
 ld.param.u32 %r5,[imc_a];
 add.s32 %r3,%r3,%r5;
 ld.param.u32 %r5,[imc_b];
 add.s32 %r3,%r3,%r5;
 ld.param.u32 %r5,[imc_c];
 add.s32 %r3,%r3,%r5;
 ld.param.u32 %r5,[imc_d];
 add.s32 %r3,%r3,%r5;
 add.s32 %r4,%r4,1;
 setp.lt.s32 %p0,%r4,%r0;
 @%p0 bra $L;
 mov.u64 %rd2,%clock64;
 cvta.to.global.u64 %rd3, %rd0;
 mov.u32 %r6,%ctaid.x;
 mad.lo.u32 %r7,%r6,32,%r1;
 mul.wide.u32 %rd4,%r7,24;
 add.u64 %rd5,%rd3,%rd4;
 st.global.u64 [%rd5],%rd1;
 st.global.u64 [%rd5+8],%rd2;
 st.global.u32 [%rd5+16],%r3;
 ret;
}

.version 8.0
.target sm_86
.address_size 64
.visible .entry value_kernel(.param .u64 input, .param .u64 output, .param .u32 delta) {
.reg .u64 %rd<5>;
.reg .u32 %r<5>;
.reg .pred %p;
ld.param.u64 %rd0, [input];
ld.param.u64 %rd1, [output];
ld.param.u32 %r3, [delta];
mov.u32 %r0, %tid.x;
mul.wide.u32 %rd2, %r0, 4;
add.u64 %rd3, %rd0, %rd2;
add.u64 %rd4, %rd1, %rd2;
ld.global.u32 %r1, [%rd3];
setp.lt.u32 %p, %r1, %r3;
@%p add.u32 %r2, %r1, %r3;
@!%p sub.u32 %r2, %r1, %r3;
st.global.u32 [%rd4], %r2;
ret;
}

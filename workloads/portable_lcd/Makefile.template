# Per-slug Makefile template for portable_lcd kernels.
#
# Copy this file to workloads/portable_lcd/<new_slug>/Makefile, then
# replace TARGET with the slug name. The kernel source lives at
# <new_slug>/<new_slug>.cu and the runner at <new_slug>/main.cu;
# both are compiled into a single binary <new_slug>_run.
#
# The ARCH_GATE alias `lcd` expands to the full LCD base-arch set
# (sm_86 + sm_90 + sm_120) plus a compute_80 PTX fallback. Per the
# LCD discipline, architecture-conditional variants (sm_90a /
# sm_120a / sm_120f) are FORBIDDEN; declaring any of those tokens
# triggers a make-time error from common.mk.

ARCH_GATE = lcd
include ../common.mk

TARGET = REPLACE_WITH_SLUG_NAME
SRC    = $(TARGET).cu
RUN    = $(TARGET)_run

.PHONY: all clean sass run-bin
all: run-bin
run-bin: $(RUN)

$(RUN): $(SRC) main.cu
	$(NVCC) $(NVCC_COMMON) $(NVCC_ARCH_FOR_GATE) $(SRC) main.cu -o $(RUN) -lcudart

$(TARGET): $(SRC)
	$(NVCC) $(NVCC_COMMON) $(NVCC_ARCH_FOR_GATE) -c $(SRC) -o $(TARGET).o

sass: $(RUN)
	@set -e; mkdir -p sass_archive
	$(CUOBJDUMP) --dump-sass $(RUN) > sass_archive/$(TARGET).sass

clean:
	rm -f $(TARGET).o $(RUN)
	rm -rf sass_archive results traces

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "gcom_lite_scoring",
  "description": "Slug-disjoint cycle scoring + DVFS ns layer for the GCoM-lite head: recomputed LOSO/LOOCV fold rows (with the coincidence record), the directional achieved-vs-target table (honest MISS acceptable), per-cell ns intervals carrying the decomposition parameters and clock evidence (point-ns dual-gated; interval-only rows typed), and the honest deploy crosswalk; sealed-holdout labels never consumed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "arch",
    "generated_at_commit",
    "deployable_channel",
    "inputs",
    "metric_definitions",
    "holdout_containment",
    "slug_disjointness",
    "folds",
    "achieved_vs_target",
    "robustness_tables",
    "ns_layer",
    "deploy_crosswalk",
    "holdout_labels_consumed"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact_kind": {
      "const": "gcom_lite_scoring"
    },
    "arch": {
      "const": "sm_86"
    },
    "generated_at_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "deployable_channel": {
      "const": "deployable_gcom_lite_interval_no_same_slug_substitution"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gcom_artifact",
        "cohort",
        "card",
        "cohort_split",
        "legacy_cohort_floor_source"
      ],
      "properties": {
        "gcom_artifact": { "type": "string" },
        "cohort": { "type": "string" },
        "card": { "type": "string" },
        "cohort_split": { "type": "string" },
        "legacy_cohort_floor_source": { "type": "string" }
      }
    },
    "metric_definitions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "geomean_log_relative_error",
        "fold_procedure"
      ],
      "properties": {
        "geomean_log_relative_error": { "type": "string" },
        "fold_procedure": { "type": "string" }
      }
    },
    "holdout_containment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_split_source",
        "n_canonical_holdout_cells",
        "n_fit_pool_cells_cross_checked",
        "n_holdout_reserved_cells_cross_checked",
        "note"
      ],
      "properties": {
        "canonical_split_source": { "type": "string" },
        "n_canonical_holdout_cells": {
          "type": "integer",
          "minimum": 1
        },
        "n_fit_pool_cells_cross_checked": {
          "type": "integer",
          "minimum": 1
        },
        "n_holdout_reserved_cells_cross_checked": {
          "type": "integer",
          "minimum": 0
        },
        "note": { "type": "string" }
      }
    },
    "slug_disjointness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "n_folds",
        "n_distinct_slugs",
        "loso_equals_loocv",
        "note"
      ],
      "properties": {
        "n_folds": {
          "type": "integer",
          "minimum": 2
        },
        "n_distinct_slugs": {
          "type": "integer",
          "minimum": 2
        },
        "loso_equals_loocv": {
          "type": "boolean"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "folds": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "held_out_slug",
          "shape_point",
          "n_train",
          "held_out_predicted_cycles",
          "label_cycles",
          "log_ratio",
          "abs_log_ratio"
        ],
        "properties": {
          "held_out_slug": {
            "type": "string"
          },
          "shape_point": {
            "type": "string"
          },
          "n_train": {
            "type": "integer",
            "minimum": 1
          },
          "held_out_predicted_cycles": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "label_cycles": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "log_ratio": {
            "type": "number"
          },
          "abs_log_ratio": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "achieved_vs_target": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate",
          "target",
          "achieved",
          "met"
        ],
        "properties": {
          "gate": {
            "type": "string"
          },
          "target": {
            "type": "number"
          },
          "achieved": {
            "type": [
              "number",
              "null"
            ]
          },
          "met": {
            "type": [
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "robustness_tables": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "loso_equals_loocv",
        "coincidence_note",
        "surfaces"
      ],
      "properties": {
        "loso_equals_loocv": {
          "type": "boolean"
        },
        "coincidence_note": {
          "type": "string",
          "minLength": 1
        },
        "surfaces": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "procedure",
              "fold_count",
              "distinct_held_out_slug_count",
              "train_sizes",
              "geomean_log_relative_error",
              "target",
              "stretch_target",
              "met",
              "met_stretch"
            ],
            "properties": {
              "procedure": {
                "enum": [
                  "leave_one_slug_out",
                  "leave_one_cell_out"
                ]
              },
              "fold_count": {
                "type": "integer",
                "minimum": 2
              },
              "distinct_held_out_slug_count": {
                "type": "integer",
                "minimum": 2
              },
              "train_sizes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "geomean_log_relative_error": {
                "type": "number",
                "minimum": 0
              },
              "target": {
                "type": "number"
              },
              "stretch_target": {
                "type": "number"
              },
              "met": {
                "type": "boolean"
              },
              "met_stretch": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "ns_layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "noise_floor_ns",
        "noise_floor_provenance",
        "point_ns_floor_exceeds_all_intervals",
        "point_ns_impossible_note",
        "core_clock_band_mhz",
        "core_clock_band_evidence",
        "plausibility_window_mhz",
        "n_point_ns_claims",
        "point_ns_note"
      ],
      "properties": {
        "noise_floor_ns": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "noise_floor_provenance": {
          "type": "string",
          "minLength": 1
        },
        "point_ns_floor_exceeds_all_intervals": {
          "type": "boolean"
        },
        "point_ns_impossible_note": {
          "type": "string",
          "minLength": 1
        },
        "core_clock_band_mhz": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "core_clock_band_evidence": {
          "type": "array",
          "minItems": 1
        },
        "plausibility_window_mhz": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2
        },
        "n_point_ns_claims": {
          "const": 0
        },
        "point_ns_note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "deploy_crosswalk": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slug",
          "shape_point",
          "status",
          "full_fit_predicted_cycles",
          "prediction_channel",
          "ns",
          "loso_held_out_predicted_cycles",
          "label_cycles",
          "duration_label_ns",
          "interval_contains_duration_label"
        ],
        "properties": {
          "slug": {
            "type": "string"
          },
          "shape_point": {
            "type": "string"
          },
          "status": {
            "enum": [
              "modeled_fit_pool",
              "modeled_holdout_reserved"
            ]
          },
          "full_fit_predicted_cycles": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "prediction_channel": {
            "const": "deployable_gcom_lite_interval_no_same_slug_substitution"
          },
          "ns": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "interval_ns",
              "decomposition",
              "point_ns",
              "point_ns_basis",
              "ns_claim"
            ],
            "properties": {
              "interval_ns": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "decomposition": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "t0_ns",
                  "t0_note",
                  "alpha_memory_cycles",
                  "beta_compute_stall_cycles",
                  "bottleneck",
                  "bottleneck_cycles",
                  "form",
                  "f_core_band_mhz",
                  "f_core_evidence",
                  "f_mem_binding",
                  "f_mem_note"
                ],
                "properties": {
                  "t0_ns": { "type": "number" },
                  "t0_note": { "type": "string" },
                  "alpha_memory_cycles": {
                    "type": "number",
                    "minimum": 0
                  },
                  "beta_compute_stall_cycles": {
                    "type": "number",
                    "minimum": 0
                  },
                  "bottleneck": {
                    "enum": ["memory", "compute_stall"]
                  },
                  "bottleneck_cycles": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "form": { "type": "string" },
                  "f_core_band_mhz": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "f_core_evidence": { "type": "string" },
                  "f_mem_binding": { "type": "string" },
                  "f_mem_note": { "type": "string" }
                }
              },
              "point_ns": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "point_ns_basis": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "ns_claim": {
                "enum": [
                  "interval_only",
                  "point_and_interval"
                ]
              },
              "interval_only_reason": {
                "type": "string"
              }
            }
          },
          "loso_held_out_predicted_cycles": {
            "type": [
              "number",
              "null"
            ]
          },
          "label_cycles": {
            "type": [
              "number",
              "null"
            ]
          },
          "duration_label_ns": {
            "type": [
              "number",
              "null"
            ]
          },
          "interval_contains_duration_label": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "holdout_labels_consumed": {
      "const": false
    }
  }
}

#!/usr/bin/env bash
# simbench_bw_validation — repo-local executable wrapper for the
# non-root measurement validation metric framework + schema-check CLI.
#
# Dispatches to workloads/simbench_bw/compute_validation_metric.py::main
# while preserving exit codes and forwarding all argv unchanged. The
# wrapper is the literal command name the non-root measurement contract documents
# ("simbench_bw_validation --schema-check --all"); place this script's
# parent dir on $PATH (e.g. `export PATH=$REPO/workloads/simbench_bw:$PATH`)
# so the literal command resolves at any shell working directory.
set -euo pipefail

WRAPPER_DIR="$(cd "$(dirname "$0")" && pwd)"
PYTHON_BIN="${SIMBENCH_BW_PYTHON:-python3}"

exec "$PYTHON_BIN" "$WRAPPER_DIR/compute_validation_metric.py" "$@"

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simbench_bw/schemas/simbench_build_witness.schema.json",
  "title": "sm_86 SimBench build witness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "witness_id", "arch", "source_commit",
    "roster_sha256", "common_mk_sha256", "protocol_pins_sha256",
    "build_executed", "smoke_executed", "toolchain", "integrity",
    "rows", "pass", "witness_seal_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "witness_id": {"const": "sm86_simbench_build_witness_v1"},
    "arch": {"const": "sm_86"},
    "generated_at_utc": {"type": "string"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "roster_sha256": {"$ref": "#/$defs/sha256"},
    "common_mk_sha256": {"$ref": "#/$defs/sha256"},
    "protocol_pins_sha256": {"$ref": "#/$defs/sha256"},
    "build_executed": {"const": true},
    "smoke_executed": {"const": true},
    "toolchain": {"type": "object"},
    "integrity": {
      "type": "object",
      "required": ["expected_rows", "actual_rows", "unique_slugs", "all_rows_runnable"],
      "properties": {
        "expected_rows": {"const": 31},
        "actual_rows": {"const": 31},
        "unique_slugs": {"const": true},
        "all_rows_runnable": {"const": true}
      }
    },
    "rows": {
      "type": "array",
      "minItems": 31,
      "maxItems": 31,
      "items": {"$ref": "#/$defs/row"}
    },
    "pass": {"const": true},
    "witness_seal_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repoRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*//)(?!.*/$)(?!\\.\\.?(?:/|$))(?!.*(?:/\\.\\.?)(?:/|$))[^\\u0000-\\u001f\\u007f]+$"
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug", "level", "status", "problems", "build_command",
        "build_returncode", "build_transcript_sha256", "build_transcript_bytes",
        "build_inputs", "build_input_set_sha256", "shape_file",
        "shape_file_sha256", "shape_point", "shape", "shape_binding_kind",
        "app_args", "binary", "binary_sha256", "binary_bytes",
        "binary_executable", "cuobjdump_returncode",
        "cuobjdump_transcript_sha256", "cubins", "sm86_cubin_present",
        "ldd_returncode", "ldd_transcript_sha256", "resolved_libraries",
        "missing_libraries", "smoke", "row_seal_sha256"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_]*$"
        },
        "level": {"type": "string", "enum": ["l1", "l2", "l3", "l4"]},
        "status": {"const": "runnable"},
        "problems": {"type": "array", "maxItems": 0},
        "build_command": {
          "type": "array", "minItems": 4,
          "items": {"type": "string", "minLength": 1}
        },
        "build_returncode": {"const": 0},
        "build_transcript_sha256": {"$ref": "#/$defs/sha256"},
        "build_transcript_bytes": {"type": "integer", "minimum": 1},
        "build_inputs": {
          "type": "object", "minProperties": 4,
          "propertyNames": {"$ref": "#/$defs/repoRelativePath"},
          "additionalProperties": {"$ref": "#/$defs/sha256"}
        },
        "build_input_set_sha256": {"$ref": "#/$defs/sha256"},
        "shape_file": {"$ref": "#/$defs/repoRelativePath"},
        "shape_file_sha256": {"$ref": "#/$defs/sha256"},
        "shape_point": {"type": "string", "minLength": 1},
        "shape": {"type": "object"},
        "shape_binding_kind": {
          "type": "string",
          "enum": ["generic_shape_point", "legacy_timing_alias", "legacy_correctness_alias"]
        },
        "app_args": {
          "type": "array", "minItems": 3,
          "items": {"type": "string"}
        },
        "binary": {"$ref": "#/$defs/repoRelativePath"},
        "binary_sha256": {"$ref": "#/$defs/sha256"},
        "binary_bytes": {"type": "integer", "minimum": 1},
        "binary_executable": {"const": true},
        "cuobjdump_returncode": {"const": 0},
        "cuobjdump_transcript_sha256": {"$ref": "#/$defs/sha256"},
        "cubins": {
          "type": "array", "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "sm86_cubin_present": {"const": true},
        "ldd_returncode": {"const": 0},
        "ldd_transcript_sha256": {"$ref": "#/$defs/sha256"},
        "resolved_libraries": {"type": "array"},
        "missing_libraries": {"type": "array", "maxItems": 0},
        "smoke": {
          "type": "object",
          "required": ["executed", "returncode", "contract_ok", "output_sha256", "output_bytes"],
          "properties": {
            "executed": {"const": true},
            "returncode": {"const": 0},
            "contract_ok": {"const": true},
            "output_sha256": {"$ref": "#/$defs/sha256"},
            "output_bytes": {"type": "integer", "minimum": 1}
          }
        },
        "row_seal_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}

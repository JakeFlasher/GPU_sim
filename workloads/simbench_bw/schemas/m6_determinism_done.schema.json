{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simbench_bw/schemas/m6_determinism_done.schema.json",
  "title": "M6 determinism completion seal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_kind", "status", "generated_at_utc",
    "schedule", "journal", "analysis", "schemas", "source_identity_sha256",
    "config_identity_sha256", "metric_identity_sha256", "m4_identity_sha256",
    "m4_status", "counts", "accounting_identity_holds", "denominator_identity_holds",
    "taxonomy", "collect_implementation", "done_sha256"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "artifact_kind": {"type": "string", "const": "m6_determinism_done"},
    "status": {"type": "string", "const": "done"},
    "m6_state": {"type": "string", "const": "M6_DONE"},
    "m7_state": {"type": "string", "enum": ["M7_BLOCKED", "M6_M7_HANDOFF_CANDIDATE", "M7_DONE"]},
    "m6_m7_handoff_candidate": {"const": false},
    "simulator_scoreability": {"type": "string", "enum": ["UNAVAILABLE_REQUIRED_CYCLES", "SCOREABLE"]},
    "publication_verdict": {"type": "string", "enum": ["NOT_EVALUATED", "PASS", "FLOOR_ONLY", "FAIL"]},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "schedule": {"$ref": "#/$defs/artifact"},
    "journal": {"$ref": "#/$defs/artifact"},
    "analysis": {"$ref": "#/$defs/analysisArtifact"},
    "schemas": {
      "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true,
      "items": {"$ref": "#/$defs/schemaArtifact"}
    },
    "inventory": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "entries", "inventory_sha256"],
      "properties": {
        "schema_version": {"type": "integer", "const": 1},
        "entries": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/inventoryEntry"}},
        "inventory_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "source_identity_sha256": {"$ref": "#/$defs/sha256"},
    "config_identity_sha256": {"$ref": "#/$defs/sha256"},
    "metric_identity_sha256": {"$ref": "#/$defs/sha256"},
    "m4_identity_sha256": {"$ref": "#/$defs/sha256"},
    "m4_status": {"type": "string", "const": "complete"},
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["runnable_cells", "configs", "tier1_slots", "triggered_cells", "tier2_slots", "total_slots", "raw_rows_collected", "classified_raw_rows", "excluded_typed_raw_rows", "not_collected_typed_rows"],
      "properties": {
        "runnable_cells": {"type": "integer", "const": 122},
        "configs": {"type": "integer", "const": 6},
        "tier1_slots": {"type": "integer", "const": 8540},
        "triggered_cells": {"type": "integer", "minimum": 0, "maximum": 122},
        "tier2_slots": {"type": "integer", "minimum": 0, "maximum": 1220, "multipleOf": 10},
        "total_slots": {"type": "integer", "minimum": 8540, "maximum": 9760},
        "raw_rows_collected": {"type": "integer", "minimum": 0},
        "classified_raw_rows": {"type": "integer", "minimum": 0},
        "excluded_typed_raw_rows": {"type": "integer", "minimum": 0},
        "not_collected_typed_rows": {"type": "integer", "minimum": 0}
      }
    },
    "accounting_identity_holds": {"const": true},
    "denominator_identity_holds": {"const": true},
    "taxonomy": {"const": ["vendor_defect", "insufficient_evidence", "multimodal", "deterministic", "quasi_stable", "clock_noise", "noisy", "unstable"]},
    "collect_implementation": {"type": "string", "const": "disabled_offline_source"},
    "done_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_sha256", "size_bytes"],
      "properties": {
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "analysisArtifact": {
      "type": "object", "additionalProperties": false,
      "required": ["relative_path", "artifact_sha256", "size_bytes"],
      "properties": {
        "relative_path": {"type": "string", "const": "determinism_study.json"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "inventoryEntry": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "path", "sha256", "size_bytes"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "schemaArtifact": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "schema_id": {"type": "string", "enum": ["m4_binding", "schedule", "observation_journal", "analysis", "done"]},
        "path": {"type": "string", "pattern": "^workloads/simbench_bw/schemas/m6_"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}

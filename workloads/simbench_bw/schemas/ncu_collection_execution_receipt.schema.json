{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simbench_bw/schemas/ncu_collection_execution_receipt.schema.json",
  "title": "NCU collection execution receipt",
  "description": "Supervisor-authored process-integrity receipt for one descriptor-bound NCU collection. Fresh producers bind the additive LABEL_DRIVER_GPU_INDEX field to the singleton host index 0; pre-field v1 documents remain schema-readable but cannot satisfy current external environment bindings. This does not attest the later Details export or campaign DONE semantic closure.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "trust_scope",
    "status",
    "supervision",
    "preflight_sha256",
    "ncu_identity",
    "command",
    "command_sha256",
    "environment",
    "environment_sha256",
    "working_directory",
    "exit_status",
    "artifacts",
    "launch_observation_sha256",
    "receipt_seal_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "ncu_collection_execution_receipt_v1"},
    "trust_scope": {"const": "capture_process_integrity_only_unsigned"},
    "status": {"const": "pass"},
    "supervision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_mode",
        "ncu_binding",
        "command_derivation",
        "residual_process_policy"
      ],
      "properties": {
        "execution_mode": {"const": "bounded_supervised_child_v1"},
        "ncu_binding": {"const": "retained_descriptor_singleton_argv_v1"},
        "command_derivation": {
          "const": "insert_authorized_ncu_proc_path_option_before_target_separator_v1"
        },
        "residual_process_policy": {"const": "kill_process_group_before_return_v1"}
      }
    },
    "preflight_sha256": {"$ref": "#/$defs/sha256"},
    "ncu_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolved_path", "executable_sha256", "version_line"],
      "properties": {
        "resolved_path": {"$ref": "#/$defs/absolute_path"},
        "executable_sha256": {"$ref": "#/$defs/sha256"},
        "version_line": {
          "type": "string",
          "minLength": 9,
          "maxLength": 4096,
          "pattern": "^Version[ ]+\\S(?:.*\\S)?$"
        }
      }
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "string",
        "maxLength": 131071,
        "pattern": "^[^\\u0000]*$"
      }
    },
    "command_sha256": {"$ref": "#/$defs/sha256"},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "LANG",
        "LANGUAGE",
        "LC_ALL",
        "PATH",
        "PWD",
        "PYTHONNOUSERSITE",
        "LABEL_DRIVER_PRESERVE_FAILED_EVIDENCE"
      ],
      "properties": {
        "LANG": {"const": "C"},
        "LANGUAGE": {"const": "C"},
        "LC_ALL": {"const": "C"},
        "PATH": {"const": "/usr/local/cuda-13.2/bin:/usr/bin:/bin"},
        "PWD": {"$ref": "#/$defs/absolute_path"},
        "PYTHONNOUSERSITE": {"const": "1"},
        "LABEL_DRIVER_GPU_INDEX": {"const": "0"},
        "LABEL_DRIVER_PRESERVE_FAILED_EVIDENCE": {"const": "1"},
        "CC": {"$ref": "#/$defs/environment_value"},
        "CUDAHOSTCXX": {"$ref": "#/$defs/environment_value"},
        "CUDA_HOME": {"$ref": "#/$defs/environment_value"},
        "CUTLASS_DIR": {"$ref": "#/$defs/environment_value"},
        "CXX": {"$ref": "#/$defs/environment_value"},
        "FLASHINFER_TRACE_DIR": {"$ref": "#/$defs/environment_value"},
        "HOME": {"$ref": "#/$defs/environment_value"},
        "NVCC_CCBIN": {"$ref": "#/$defs/environment_value"},
        "PYTORCH_ALLOC_CONF": {"$ref": "#/$defs/environment_value"},
        "SOL_EXECBENCH_CAPTURE_REQUEST": {"$ref": "#/$defs/environment_value"},
        "TMPDIR": {"$ref": "#/$defs/environment_value"},
        "XDG_CACHE_HOME": {"$ref": "#/$defs/environment_value"},
        "XDG_CONFIG_HOME": {"$ref": "#/$defs/environment_value"}
      }
    },
    "environment_sha256": {"$ref": "#/$defs/sha256"},
    "working_directory": {"$ref": "#/$defs/absolute_path"},
    "exit_status": {"const": 0},
    "artifacts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"$ref": "#/$defs/ncu_report"},
        {"$ref": "#/$defs/label_run_manifest"},
        {"$ref": "#/$defs/ncu_launch_observation"},
        {"$ref": "#/$defs/label_capture_manifest"}
      ],
      "items": false
    },
    "launch_observation_sha256": {"$ref": "#/$defs/sha256"},
    "receipt_seal_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "absolute_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "anyOf": [
        {"const": "/"},
        {
          "pattern": "^/(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*[\\u0000\\r\\n]).+$"
        }
      ]
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*[\\u0000\\r\\n]).+$"
    },
    "environment_value": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "relative_path", "sha256", "size_bytes"],
      "properties": {
        "role": {"type": "string"},
        "relative_path": {"$ref": "#/$defs/relative_path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "ncu_report": {
      "allOf": [
        {"$ref": "#/$defs/artifact"},
        {"type": "object", "properties": {"role": {"const": "ncu_report"}}}
      ]
    },
    "label_run_manifest": {
      "allOf": [
        {"$ref": "#/$defs/artifact"},
        {"type": "object", "properties": {"role": {"const": "label_run_manifest"}}}
      ]
    },
    "ncu_launch_observation": {
      "allOf": [
        {"$ref": "#/$defs/artifact"},
        {"type": "object", "properties": {"role": {"const": "ncu_launch_observation"}}}
      ]
    },
    "label_capture_manifest": {
      "allOf": [
        {"$ref": "#/$defs/artifact"},
        {"type": "object", "properties": {"role": {"const": "label_capture_manifest"}}}
      ]
    }
  }
}

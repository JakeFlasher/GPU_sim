      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "entry_id", "entry_type", "created_at_utc", "rlcr_session_id", "rlcr_dir",
        "campaign_round", "chunk_id", "cell_id", "reason_code", "runner_refusal_code", "original_head",
        "original_matrix_file_sha256", "original_matrix_seal_sha256", "original_preflight_sha256",
        "original_admission_run_id", "original_session_id", "replacement_head", "source_journal_path",
        "archive_path", "inventory_file", "inventory_sha256", "no_gpu_attestation",
        "pinned_source_definition_sha256", "staged_definition_sha256", "staged_module_sha256",
        "defect_summary", "adjudication_ref", "operator_flag", "supersedes", "reconstruction_records", "authority"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "entry_id": {"$ref": "#/$defs/entry_id"},
        "entry_type": {"const": "preparation_failure_archive"},
        "created_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
        "rlcr_session_id": {"type": "string", "minLength": 1},
        "rlcr_dir": {"$ref": "#/$defs/absolute_path"},
        "campaign_round": {"const": 28},
        "chunk_id": {"const": "sol_execbench-000-bootstrap"},
        "cell_id": {"const": "sol_execbench__problem_070_mamba2_fused_intra_chunk_diagonal_computation"},
        "reason_code": {"const": "STAGE_SEMANTIC_VALIDATION_FAILED"},
        "runner_refusal_code": {"const": "sol_stage_source_mismatch"},
        "original_head": {"const": "9b8e0e403ec0fc2acc2fcf40dbe3feb31572475a"},

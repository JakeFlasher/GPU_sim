        "original_session_id": {"type": "string", "minLength": 1},
        "replacement_head": {"$ref": "#/$defs/git_sha"},
        "source_journal_path": {"$ref": "#/$defs/absolute_path"},
        "archive_path": {"$ref": "#/$defs/absolute_path"},
        "inventory_file": {"$ref": "#/$defs/absolute_path"},
        "inventory_sha256": {"$ref": "#/$defs/sha256"},
        "no_gpu_attestation": {"$ref": "#/$defs/no_gpu_attestation_contemporaneous"},
        "pinned_source_definition_sha256": {"$ref": "#/$defs/sha256"},
        "staged_definition_sha256": {"$ref": "#/$defs/sha256"},
        "staged_module_sha256": {"$ref": "#/$defs/sha256"},
        "defect_summary": {"const": "comparator lacked absent≡null for optional fields"},
        "adjudication_ref": {"$ref": "#/$defs/absolute_path"},
        "operator_flag": {"$ref": "#/$defs/operator_flag"}
      }
    },

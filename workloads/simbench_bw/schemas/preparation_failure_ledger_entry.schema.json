{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "preparation_failure_ledger_entry.schema.json",
  "title": "Round-28 pre-GPU preparation-failure archive ledger entry",
  "oneOf": [
    {"$ref": "#/$defs/contemporaneous_entry"},
    {"$ref": "#/$defs/reconstructed_entry"}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "absolute_path": {"type": "string", "pattern": "^/"},
    "entry_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "operator_flag": {
      "enum": [
        "--archive-preparation-failure",
        "--archive-preparation-failure --override-preparation-attempt-limit"
      ]
    },
    "evidence_base": {
      "type": "object",
      "required": ["evidence_path", "sha256"],
      "properties": {
        "evidence_path": {"$ref": "#/$defs/absolute_path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "no_gpu_attestation_contemporaneous": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "journal_state",
        "prepare_stdout",
        "prepare_stderr",
        "forbidden_artifact_scan",
        "runner_refusal",
        "phase_log",
        "problem_packager_execute",
        "gpu_process_observation"
      ],
      "properties": {
        "journal_state": {
          "allOf": [{"$ref": "#/$defs/evidence_base"}],
          "unevaluatedProperties": false,
          "required": ["state", "journal_complete_present"],
          "properties": {
            "state": {"const": "capture_started"},
            "journal_complete_present": {"const": false}
          }
        },
        "prepare_stdout": {
          "allOf": [{"$ref": "#/$defs/evidence_base"}],
          "unevaluatedProperties": false,
          "required": ["contains_only_validated_prepare_manifest"],
          "properties": {"contains_only_validated_prepare_manifest": {"const": true}}
        },
        "prepare_stderr": {
          "allOf": [{"$ref": "#/$defs/evidence_base"}],
          "unevaluatedProperties": false,
          "required": ["empty"],
          "properties": {"empty": {"const": true}}
        },
        "forbidden_artifact_scan": {
          "allOf": [{"$ref": "#/$defs/evidence_base"}],
          "unevaluatedProperties": false,
          "required": ["checked_patterns", "matches", "scanned_file_count"],
          "properties": {
            "checked_patterns": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "matches": {"const": []},
            "scanned_file_count": {"type": "integer", "minimum": 1}
          }
        },
        "runner_refusal": {
          "allOf": [{"$ref": "#/$defs/evidence_base"}],
          "unevaluatedProperties": false,
          "required": ["runner_refusal_code", "refused_at_utc"],
          "properties": {
            "runner_refusal_code": {"const": "sol_stage_source_mismatch"},
            "refused_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"}
          }
        },
        "phase_log": {
          "allOf": [{"$ref": "#/$defs/evidence_base"}],
          "unevaluatedProperties": false,
          "required": ["last_phase", "post_prepare_phases"],
          "properties": {
            "last_phase": {"const": "prepare_validate"},
            "post_prepare_phases": {"const": []}
          }
        },
        "problem_packager_execute": {
          "allOf": [{"$ref": "#/$defs/evidence_base"}],
          "unevaluatedProperties": false,
          "required": ["source_head", "function", "citation", "writes_driver_and_returns_command_without_execution"],
          "properties": {
            "source_head": {"$ref": "#/$defs/git_sha"},
            "function": {"const": "ProblemPackager.execute"},
            "citation": {"type": "string", "minLength": 1},
            "writes_driver_and_returns_command_without_execution": {"const": true}
          }
        },
        "gpu_process_observation": {
          "allOf": [{"$ref": "#/$defs/evidence_base"}],
          "unevaluatedProperties": false,
          "required": ["remaining_gpu_processes"],
          "properties": {"remaining_gpu_processes": {"const": []}}
        }
      }
    },
    "journal_forensic_absence_scan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "forbidden_artifact_scan",
        "journal_complete_present",
        "prepare_stderr_sha256",
        "prepare_stderr_empty",
        "inventory_files",
        "inventory_bytes",
        "inventory_domain_sha256"
      ],
      "properties": {
        "forbidden_artifact_scan": {"const": []},
        "journal_complete_present": {"const": false},
        "prepare_stderr_sha256": {
          "const": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
        },
        "prepare_stderr_empty": {"const": true},
        "inventory_files": {"const": 22},
        "inventory_bytes": {"const": 3855797},
        "inventory_domain_sha256": {
          "const": "ff0ace5cc769431efd55d01eb28d7d6aef10300cb00e5722e703306e0d821a36"
        }
      }
    },
    "no_gpu_attestation_reconstructed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "record_version",
        "amendment_id",
        "cell",
        "chunk",
        "attestation",
        "certifying_elements",
        "journal_forensic_absence_scan",
        "non_certifying_elements",
        "late_observation_reference",
        "reproduction_reference",
        "campaign_rows",
        "capture_supersession_attempts_consumed"
      ],
      "properties": {
        "record_type": {"const": "preparation_failure_no_gpu_attestation"},
        "record_version": {"const": 2},
        "amendment_id": {"const": "ANNEX_C_AMEND_R28_PREP070_RECON_V2"},
        "cell": {"const": "sol_execbench__problem_070_mamba2_fused_intra_chunk_diagonal_computation"},
        "chunk": {"const": "sol_execbench-000-bootstrap"},
        "attestation": {
          "const": "No GPU execution occurred in the historical problem-070 preparation attempt; the attempt terminated at pre-GPU staged-definition semantic validation."
        },
        "certifying_elements": {
          "const": [
            "annex_c_adjudication",
            "deterministic_legacy_9b8e0e40_normalized_definition_comparator_over_sealed_bytes",
            "journal_forensic_absence_scan"
          ]
        },
        "journal_forensic_absence_scan": {"$ref": "#/$defs/journal_forensic_absence_scan"},
        "non_certifying_elements": {"const": ["gpu_process_observation_late"]},
        "late_observation_reference": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "sha256", "certifying"],
          "properties": {
            "file": {"const": "gpu_process_observation_late.json"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "certifying": {"const": false}
          }
        },
        "reproduction_reference": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "sha256"],
          "properties": {
            "file": {"const": "legacy_comparator_reproduction.json"},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "campaign_rows": {"const": 0},
        "capture_supersession_attempts_consumed": {"const": 0}
      },
      "not": {
        "properties": {
          "certifying_elements": {
            "contains": {"const": "deterministic_v1_comparator_over_sealed_bytes"}
          }
        },
        "required": ["certifying_elements"]
      }
    },
    "reconstruction_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "reconstruction_records": {
      "type": "array",
      "prefixItems": [
        {
          "allOf": [
            {"$ref": "#/$defs/reconstruction_record"},
            {"properties": {"path": {"const": "chunk_context/reconstructed/legacy_comparator_reproduction.json"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/reconstruction_record"},
            {"properties": {"path": {"const": "chunk_context/reconstructed/runner_refusal_reconstruction.json"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/reconstruction_record"},
            {"properties": {"path": {"const": "chunk_context/reconstructed/phase_reconstruction.json"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/reconstruction_record"},
            {"properties": {"path": {"const": "chunk_context/reconstructed/gpu_process_observation_late.json"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/reconstruction_record"},
            {"properties": {"path": {"const": "chunk_context/reconstructed/preparation_failure_no_gpu_attestation_v2.json"}}}
          ]
        }
      ],
      "items": false,
      "minItems": 5,
      "maxItems": 5
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amendment_id",
        "supersession_status",
        "corrected_adjudication_sha256",
        "superseded_adjudication_sha256",
        "correction_id",
        "correction_adjudication_sha256"
      ],
      "properties": {
        "amendment_id": {"const": "ANNEX_C_AMEND_R28_PREP070_RECON_V2"},
        "supersession_status": {"const": "superseded_by_v2"},
        "corrected_adjudication_sha256": {"$ref": "#/$defs/sha256"},
        "superseded_adjudication_sha256": {"$ref": "#/$defs/sha256"},
        "correction_id": {"const": "R28_PREP070_RECON_V2_CORR1"},
        "correction_adjudication_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "contemporaneous_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "entry_id", "entry_type", "created_at_utc", "rlcr_session_id", "rlcr_dir",

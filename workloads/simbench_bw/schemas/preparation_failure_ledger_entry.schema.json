        "original_session_id": {"const": "f10de1cc-612e-43e3-b51f-ce1c9985e281"},
        "replacement_head": {"$ref": "#/$defs/git_sha"},
        "source_journal_path": {"$ref": "#/$defs/absolute_path"},
        "archive_path": {"$ref": "#/$defs/absolute_path"},
        "inventory_file": {"$ref": "#/$defs/absolute_path"},

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simbench_bw/schemas/nvbit_external_tracer_build_receipt.schema.json",
  "title": "External NVBit tracer build receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_manifest",
    "source_identity",
    "tools",
    "tool_inventory_sha256",
    "protobuf",
    "invocation",
    "output_authority",
    "artifact_validation",
    "process",
    "contract",
    "model_seal_sha256"
  ],
  "properties": {
    "schema_version": {"const": "nvbit_external_tracer_build_receipt.v4"},
    "source_manifest": {"$ref": "#/$defs/sealed_file"},
    "source_identity": {"$ref": "#/$defs/source_identity"},
    "tools": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "prefixItems": [
        {"$ref": "#/$defs/git_tool"},
        {"$ref": "#/$defs/bash_tool"},
        {"$ref": "#/$defs/make_tool"},
        {"$ref": "#/$defs/nvcc_tool"},
        {"$ref": "#/$defs/ptxas_tool"},
        {"$ref": "#/$defs/cuobjdump_tool"},
        {"$ref": "#/$defs/host_cxx_tool"},
        {"$ref": "#/$defs/protoc_tool"},
        {"$ref": "#/$defs/pkg_config_tool"}
      ],
      "items": false
    },
    "tool_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "protobuf": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prefix",
        "protoc_version",
        "libprotobuf_version",
        "inventory_sha256",
        "file_count",
        "total_size_bytes"
      ],
      "properties": {
        "prefix": {"$ref": "#/$defs/make_safe_absolute_path"},
        "protoc_version": {"const": "34.1"},
        "libprotobuf_version": {"const": "34.1.0"},
        "inventory_sha256": {"$ref": "#/$defs/sha256"},
        "file_count": {"type": "integer", "minimum": 1, "maximum": 16384},
        "total_size_bytes": {"type": "integer", "minimum": 1, "maximum": 2147483648}
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_execution", "argv", "cwd", "environment"],
      "properties": {
        "tool_execution": {"const": "retained_descriptor_aliases_with_nvcc_argv0.v2"},
        "argv": {
          "type": "array",
          "minItems": 21,
          "maxItems": 21,
          "prefixItems": [
            {"type": "string", "pattern": "^/tmp/[A-Za-z0-9._+-]+/\\.task630-tool-bin/make$"},
            {"const": "-C"},
            {"type": "string", "pattern": "^/tmp/[A-Za-z0-9._+-]+/tools/nvbit_tracer$"},
            {"const": "all"},
            {"const": "ARCH=sm_86"},
            {"const": "NVBIT_TEMPCOPY_BUILD_OK=1"},
            {"type": "string", "pattern": "^SHELL=/tmp/[A-Za-z0-9._+-]+/\\.task630-tool-bin/bash$"},
            {"type": "string", "pattern": "^MAKE=/tmp/[A-Za-z0-9._+-]+/\\.task630-tool-bin/make$"},
            {"type": "string", "pattern": "^NVCC=/tmp/[A-Za-z0-9._+-]+/\\.task630-tool-bin/bash /tmp/[A-Za-z0-9._+-]+/\\.task630-tool-bin/nvcc-launcher -ccbin=/tmp/[A-Za-z0-9._+-]+/\\.task630-tool-bin/g\\+\\+-14 -D_FORCE_INLINES -I/[A-Za-z0-9._+/-]+/include$"},
            {"type": "string", "pattern": "^PTXAS=/tmp/[A-Za-z0-9._+-]+/\\.task630-tool-bin/ptxas$"},
            {"type": "string", "pattern": "^CXX=/tmp/[A-Za-z0-9._+-]+/\\.task630-tool-bin/g\\+\\+-14$"},
            {"type": "string", "pattern": "^NVCC_CCBIN=/tmp/[A-Za-z0-9._+-]+/\\.task630-tool-bin/g\\+\\+-14$"},
            {"type": "string", "pattern": "^PROTOC=/tmp/[A-Za-z0-9._+-]+/\\.task630-tool-bin/protoc$"},
            {"type": "string", "pattern": "^PKG_CONFIG=/tmp/[A-Za-z0-9._+-]+/\\.task630-tool-bin/pkg-config$"},
            {"const": "PKG_CONFIG_FLAGS=--define-prefix"},
            {"type": "string", "pattern": "^PB_PREFIX=/[A-Za-z0-9._+/-]+$"},
            {"type": "string", "pattern": "^OBJECTS=[A-Za-z0-9._/-]+(?: [A-Za-z0-9._/-]+)*$"},
            {"type": "string", "pattern": "^OBJ=[A-Za-z0-9._/-]+(?: [A-Za-z0-9._/-]+)*$"},
            {"type": "string", "pattern": "^PROTO_FILES=[A-Za-z0-9._/-]+(?: [A-Za-z0-9._/-]+)*$"},
            {"type": "string", "pattern": "^TRACES_ENHANCED_OBJ=[A-Za-z0-9._/-]+(?: [A-Za-z0-9._/-]+)*$"},
            {"type": "string", "pattern": "^TRACES_ENHANCED_PROTOCOL_BUFFER_OBJ=[A-Za-z0-9._/-]+(?: [A-Za-z0-9._/-]+)*$"}
          ],
          "items": false
        },
        "cwd": {"type": "string", "pattern": "^/tmp/[A-Za-z0-9._+-]+/tools/nvbit_tracer$"},
        "environment": {
          "type": "array",
          "minItems": 20,
          "maxItems": 20,
          "prefixItems": [
            {"$ref": "#/$defs/env_arch"},
            {"$ref": "#/$defs/env_cplus_include_path"},
            {"$ref": "#/$defs/env_cuda_install_path"},
            {"$ref": "#/$defs/env_cxx"},
            {"$ref": "#/$defs/env_git_config_global"},
            {"$ref": "#/$defs/env_git_config_nosystem"},
            {"$ref": "#/$defs/env_home"},
            {"$ref": "#/$defs/env_lang"},
            {"$ref": "#/$defs/env_lc_all"},
            {"$ref": "#/$defs/env_ld_library_path"},
            {"$ref": "#/$defs/env_nvbit_tempcopy"},
            {"$ref": "#/$defs/env_nvcc_ccbin"},
            {"$ref": "#/$defs/env_path"},
            {"$ref": "#/$defs/env_pb_prefix"},
            {"$ref": "#/$defs/env_pkg_config"},
            {"$ref": "#/$defs/env_pkg_config_libdir"},
            {"$ref": "#/$defs/env_pkg_config_path"},
            {"$ref": "#/$defs/env_protoc"},
            {"$ref": "#/$defs/env_shell"},
            {"$ref": "#/$defs/env_tz"}
          ],
          "items": false
        }
      }
    },
    "output_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "expected_sha256"],
      "properties": {
        "kind": {"enum": ["candidate_observed_sha256.v1", "independent_reviewed_candidate_sha256.v1"]},
        "expected_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifact_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["elf", "cuda"],
      "properties": {
        "elf": {
          "type": "object",
          "additionalProperties": false,
          "required": ["class", "data", "type", "machine", "cuda_fatbin_section", "needed_libraries"],
          "properties": {
            "class": {"const": "ELF64"},
            "data": {"const": "little_endian"},
            "type": {"const": "ET_DYN"},
            "machine": {"const": "EM_X86_64"},
            "cuda_fatbin_section": {"const": ".nv_fatbin"},
            "needed_libraries": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "uniqueItems": true,
              "contains": {"const": "libcuda.so.1"},
              "minContains": 1,
              "maxContains": 1,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
              }
            }
          }
        },
        "cuda": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inspector", "architectures", "cubin_count", "stdout", "stderr"],
          "properties": {
            "inspector": {"const": "cuobjdump_13.2_list_elf.v1"},
            "architectures": {"const": ["sm_86"]},
            "cubin_count": {"type": "integer", "minimum": 1, "maximum": 4096},
            "stdout": {"$ref": "#/$defs/raw_stream"},
            "stderr": {"$ref": "#/$defs/raw_stream"}
          }
        }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["returncode", "timeout_seconds", "stdout", "stderr"],
      "properties": {
        "returncode": {"const": 0},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "stdout": {"$ref": "#/$defs/raw_stream"},
        "stderr": {"$ref": "#/$defs/raw_stream"}
      }
    },
    "contract": {"$ref": "#/$defs/contract"},
    "model_seal_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "absolute_path": {
      "type": "string",
      "minLength": 2,
      "maxLength": 8192,
      "pattern": "^/(?!.*[\\u0000-\\u001f\\u007f])"
    },
    "make_safe_absolute_path": {
      "type": "string",
      "minLength": 2,
      "maxLength": 8192,
      "pattern": "^/[A-Za-z0-9._+/-]+$"
    },
    "sealed_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "size_bytes", "model_seal_sha256"],
      "properties": {
        "name": {"const": "source_manifest.json"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1, "maximum": 536870912},
        "model_seal_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head_commit_sha1", "head_tree_sha1", "inventory_sha256"],
      "properties": {
        "head_commit_sha1": {"$ref": "#/$defs/sha1"},
        "head_tree_sha1": {"$ref": "#/$defs/sha1"},
        "inventory_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "tool_base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "sha256", "size_bytes"],
      "properties": {
        "role": {"type": "string"},
        "path": {"$ref": "#/$defs/make_safe_absolute_path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1, "maximum": 536870912}
      }
    },
    "git_tool": {"$ref": "#/$defs/tool_base", "properties": {"role": {"const": "git"}}},
    "bash_tool": {"$ref": "#/$defs/tool_base", "properties": {"role": {"const": "bash"}}},
    "make_tool": {"$ref": "#/$defs/tool_base", "properties": {"role": {"const": "make"}}},
    "nvcc_tool": {"$ref": "#/$defs/tool_base", "properties": {"role": {"const": "nvcc"}}},
    "ptxas_tool": {"$ref": "#/$defs/tool_base", "properties": {"role": {"const": "ptxas"}}},
    "cuobjdump_tool": {"$ref": "#/$defs/tool_base", "properties": {"role": {"const": "cuobjdump"}}},
    "host_cxx_tool": {"$ref": "#/$defs/tool_base", "properties": {"role": {"const": "host_cxx"}}},
    "protoc_tool": {"$ref": "#/$defs/tool_base", "properties": {"role": {"const": "protoc"}}},
    "pkg_config_tool": {"$ref": "#/$defs/tool_base", "properties": {"role": {"const": "pkg_config"}}},
    "environment_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$", "maxLength": 64},
        "value": {"type": "string", "maxLength": 16384, "not": {"pattern": "/proc/self/fd/"}}
      }
    },
    "env_arch": {"$ref": "#/$defs/environment_entry", "properties": {"name": {"const": "ARCH"}, "value": {"const": "sm_86"}}},
    "env_cplus_include_path": {"$ref": "#/$defs/environment_entry", "properties": {"name": {"const": "CPLUS_INCLUDE_PATH"}, "value": {"pattern": "^/[A-Za-z0-9._+/-]+/include$"}}},
    "env_cuda_install_path": {"$ref": "#/$defs/environment_entry", "properties": {"name": {"const": "CUDA_INSTALL_PATH"}, "value": {"$ref": "#/$defs/make_safe_absolute_path"}}},
    "env_cxx": {"$ref": "#/$defs/environment_entry", "properties": {"name": {"const": "CXX"}, "value": {"pattern": "^/tmp/[A-Za-z0-9._+-]+/\\.task630-tool-bin/g\\+\\+-14$"}}},
    "env_git_config_global": {"$ref": "#/$defs/environment_entry", "properties": {"name": {"const": "GIT_CONFIG_GLOBAL"}, "value": {"const": "/dev/null"}}},
    "env_git_config_nosystem": {"$ref": "#/$defs/environment_entry", "properties": {"name": {"const": "GIT_CONFIG_NOSYSTEM"}, "value": {"const": "1"}}},
    "env_home": {"$ref": "#/$defs/environment_entry", "properties": {"name": {"const": "HOME"}, "value": {"const": "/nonexistent"}}},
    "env_lang": {"$ref": "#/$defs/environment_entry", "properties": {"name": {"const": "LANG"}, "value": {"const": "C"}}},
    "env_lc_all": {"$ref": "#/$defs/environment_entry", "properties": {"name": {"const": "LC_ALL"}, "value": {"const": "C"}}},
    "env_ld_library_path": {"$ref": "#/$defs/environment_entry", "properties": {"name": {"const": "LD_LIBRARY_PATH"}, "value": {"pattern": "^/[A-Za-z0-9._+/-]+/lib$"}}},
    "env_nvbit_tempcopy": {"$ref": "#/$defs/environment_entry", "properties": {"name": {"const": "NVBIT_TEMPCOPY_BUILD_OK"}, "value": {"const": "1"}}},
    "env_nvcc_ccbin": {"$ref": "#/$defs/environment_entry", "properties": {"name": {"const": "NVCC_CCBIN"}, "value": {"pattern": "^/tmp/[A-Za-z0-9._+-]+/\\.task630-tool-bin/g\\+\\+-14$"}}},
    "env_path": {"$ref": "#/$defs/environment_entry", "properties": {"name": {"const": "PATH"}, "value": {"pattern": "^/tmp/[A-Za-z0-9._+-]+/\\.task630-tool-bin:/usr/bin:/bin$"}}},
    "env_pb_prefix": {"$ref": "#/$defs/environment_entry", "properties": {"name": {"const": "PB_PREFIX"}, "value": {"$ref": "#/$defs/make_safe_absolute_path"}}},
    "env_pkg_config": {"$ref": "#/$defs/environment_entry", "properties": {"name": {"const": "PKG_CONFIG"}, "value": {"pattern": "^/tmp/[A-Za-z0-9._+-]+/\\.task630-tool-bin/pkg-config$"}}},
    "env_pkg_config_libdir": {"$ref": "#/$defs/environment_entry", "properties": {"name": {"const": "PKG_CONFIG_LIBDIR"}, "value": {"pattern": "^/[A-Za-z0-9._+/-]+/lib/pkgconfig:/[A-Za-z0-9._+/-]+/share/pkgconfig$"}}},
    "env_pkg_config_path": {"$ref": "#/$defs/environment_entry", "properties": {"name": {"const": "PKG_CONFIG_PATH"}, "value": {"const": ""}}},
    "env_protoc": {"$ref": "#/$defs/environment_entry", "properties": {"name": {"const": "PROTOC"}, "value": {"pattern": "^/tmp/[A-Za-z0-9._+-]+/\\.task630-tool-bin/protoc$"}}},
    "env_shell": {"$ref": "#/$defs/environment_entry", "properties": {"name": {"const": "SHELL"}, "value": {"pattern": "^/tmp/[A-Za-z0-9._+-]+/\\.task630-tool-bin/bash$"}}},
    "env_tz": {"$ref": "#/$defs/environment_entry", "properties": {"name": {"const": "TZ"}, "value": {"const": "UTC"}}},
    "raw_stream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "size_bytes"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0, "maximum": 67108864}
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architecture", "nvbit_release", "binary_contract", "binary_version", "trace_contract", "supported_trace_schema_versions"],
      "properties": {
        "architecture": {"const": "sm_86"},
        "nvbit_release": {"const": "NVBit1.8"},
        "binary_contract": {"const": "binary86"},
        "binary_version": {"const": 86},
        "trace_contract": {"const": "sm86_addr_carry_shmem_split_v2"},
        "supported_trace_schema_versions": {"const": [1, 2, 3, 6, 8]}
      }
    }
  }
}

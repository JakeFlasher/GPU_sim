{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simbench_bw/schemas/sol_representative_execution_matrix.schema.json",
  "title": "Clean-HEAD SOL representative execution matrix",
  "description": "A 216-row execution authority derived from the frozen exhaustive matrix and the minimum-footprint representative selection. It is additive and cannot replace the exhaustive authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_id", "execution_profile", "arch", "sku",
    "source_commit", "authority_source_commit", "source_matrix",
    "representative_selection", "authority_input_pins", "carry_forward_proof",
    "representative_capture_contract", "launch_completeness_contract",
    "timeout_contract", "aggregate_retention_contract", "input_pins", "canonical_matrix",
    "canonical_authority", "runnability_authority",
    "supplemental_budget_policy", "reduced_proxy_authority", "claim_policy",
    "chunk_policy", "counts", "architecture_exclusions", "variants", "rows",
    "chunks", "matrix_seal_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_id": {"const": "sm86_sol_representative_execution_matrix_live_v1"},
    "execution_profile": {"const": "representative_trace_ncu_control_typed_v1"},
    "arch": {"const": "sm_86"},
    "sku": {"const": "rtx_3090_ti"},
    "source_commit": {"$ref": "#/$defs/commit"},
    "authority_source_commit": {"$ref": "#/$defs/commit"},
    "source_matrix": {"$ref": "#/$defs/matrixPin"},
    "representative_selection": {"$ref": "#/$defs/selectionPin"},
    "authority_input_pins": {"type": "object"},
    "carry_forward_proof": {"$ref": "#/$defs/carryForward"},
    "representative_capture_contract": {"$ref": "#/$defs/captureContract"},
    "launch_completeness_contract": {"$ref": "#/$defs/launchContract"},
    "timeout_contract": {"$ref": "#/$defs/timeoutContract"},
    "aggregate_retention_contract": {"$ref": "#/$defs/aggregateRetention"},
    "input_pins": {"type": "object"},
    "canonical_matrix": {"type": "object"},
    "canonical_authority": {"type": "object"},
    "runnability_authority": {"type": "object"},
    "supplemental_budget_policy": {"type": "object"},
    "reduced_proxy_authority": {"type": "object"},
    "claim_policy": {"type": "object"},
    "chunk_policy": {"$ref": "#/$defs/chunkPolicy"},
    "counts": {"$ref": "#/$defs/counts"},
    "architecture_exclusions": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/exclusion"}
    },
    "variants": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/variant"}
    },
    "rows": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/row"}
    },
    "chunks": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/chunk"}
    },
    "matrix_seal_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "repoPath": {
      "type": "string", "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "matrixPin": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "sha256", "matrix_seal_sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "matrix_seal_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "selectionPin": {
      "type": "object", "additionalProperties": false,
      "required": [
        "name", "sha256", "matrix_seal_sha256", "selection_identity_sha256"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "matrix_seal_sha256": {"$ref": "#/$defs/sha256"},
        "selection_identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "semanticInput": {
      "type": "object", "additionalProperties": false,
      "required": [
        "path", "role", "disposition", "declared_sha256",
        "authority_blob", "execution_blob"
      ],
      "properties": {
        "path": {"$ref": "#/$defs/repoPath"},
        "role": {"const": "selected_semantic_or_config_input"},
        "disposition": {"const": "byte_identical_carry_forward"},
        "declared_sha256": {"$ref": "#/$defs/sha256"},
        "authority_blob": {"$ref": "#/$defs/commit"},
        "execution_blob": {"$ref": "#/$defs/commit"}
      }
    },
    "executionTool": {
      "type": "object", "additionalProperties": false,
      "required": [
        "path", "role", "disposition", "authority_blob",
        "authority_sha256", "execution_blob", "execution_sha256"
      ],
      "properties": {
        "path": {"$ref": "#/$defs/repoPath"},
        "role": {"const": "execution_tool"},
        "disposition": {"enum": [
          "byte_identical_carry_forward", "deliberately_updated_and_repinned",
          "deliberately_added_and_repinned"
        ]},
        "authority_blob": {"anyOf": [{"$ref": "#/$defs/commit"}, {"type": "null"}]},
        "authority_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "execution_blob": {"$ref": "#/$defs/commit"},
        "execution_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "runtimeInput": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "name", "sha256", "verification"],
      "properties": {
        "kind": {"enum": [
          "runtime_executable", "retained_reduced_workload",
          "retained_reduced_definition",
          "native_workload_behind_reduced_proxy",
          "native_definition_behind_reduced_proxy",
          "sol_benchmark_workload", "sol_benchmark_definition",
          "sol_benchmark_tree"
        ]},
        "name": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "verification": {"const": "exact_runtime_or_retained_owner_hash"}
      }
    },
    "carryForward": {
      "type": "object", "additionalProperties": false,
      "required": [
        "authority_commit", "execution_commit", "semantic_inputs",
        "execution_tools", "external_runtime_inputs", "proof_sha256"
      ],
      "properties": {
        "authority_commit": {"$ref": "#/$defs/commit"},
        "execution_commit": {"$ref": "#/$defs/commit"},
        "semantic_inputs": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/semanticInput"}
        },
        "execution_tools": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/executionTool"}
        },
        "external_runtime_inputs": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/runtimeInput"}
        },
        "proof_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "captureContract": {
      "type": "object", "additionalProperties": false,
      "required": [
        "nvbit_trace", "ncu_profile", "launch_scope", "dynamic_launch_scope",
        "partial_trace_allowed", "admission_required_layers",
        "control_outcome_required", "control_outcome_policy",
        "allowed_control_outcomes", "allowed_typed_unavailable_reason",
        "control_unavailability_invalidates_trace_ncu"
      ],
      "properties": {
        "nvbit_trace": {"const": "full_unsampled"},
        "ncu_profile": {"const": "full_unsampled_cycles_only_binding"},
        "launch_scope": {"const": "all_in_profiler_roi"},
        "dynamic_launch_scope": {"const": "all_inventory_launches"},
        "partial_trace_allowed": {"const": false},
        "admission_required_layers": {"const": ["nvbit_trace", "ncu_profile"]},
        "control_outcome_required": {"const": true},
        "control_outcome_policy": {"const": "complete_or_closed_typed_unavailable_nonblocking"},
        "allowed_control_outcomes": {"const": [
          "complete", "typed_unavailable_no_stable_static_module"
        ]},
        "allowed_typed_unavailable_reason": {"const": "origin_unresolved"},
        "control_unavailability_invalidates_trace_ncu": {"const": false}
      }
    },
    "launchContract": {
      "type": "object", "additionalProperties": false,
      "required": [
        "inventory_policy", "launch_scope", "trace_requirement",
        "ncu_label_requirement", "control_requirement", "admission_policy"
      ],
      "properties": {
        "inventory_policy": {"const": "requires_inventory_before_capture"},
        "launch_scope": {"const": "all_in_profiler_roi"},
        "trace_requirement": {"const": "every_inventory_launch_complete"},
        "ncu_label_requirement": {"const": "every_inventory_launch_complete_cycles_only_binding"},
        "control_requirement": {"const": "complete_or_origin_unresolved_typed_unavailable"},
        "admission_policy": {"const": "trace_and_ncu_complete_control_typed_nonblocking"}
      }
    },
    "timeoutContract": {
      "type": "object", "additionalProperties": false,
      "required": [
        "ceiling_seconds", "derivation", "failure_disposition",
        "sampling_policy", "partial_trace_allowed"
      ],
      "properties": {
        "ceiling_seconds": {"const": 900},
        "derivation": {"const": "min(source_max_wall_time_s, ceiling_seconds)"},
        "failure_disposition": {"const": "typed_measured_infeasibility_for_trace_proxy_planning"},
        "sampling_policy": {"const": "off"},
        "partial_trace_allowed": {"const": false}
      }
    },
    "aggregateRetention": {
      "type": "object", "additionalProperties": false,
      "required": [
        "selected_max_trace_bytes_sum", "metadata_margin_gib",
        "required_retention_budget_gib", "runtime_requirement",
        "raw_staging_and_free_space_checks_unchanged"
      ],
      "properties": {
        "selected_max_trace_bytes_sum": {"type": "integer", "minimum": 1},
        "metadata_margin_gib": {"const": 8},
        "required_retention_budget_gib": {"type": "integer", "minimum": 9},
        "runtime_requirement": {"const": "external_aggregate_budget_at_least_required_retention"},
        "raw_staging_and_free_space_checks_unchanged": {"const": true}
      }
    },
    "chunkPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["rows_per_chunk", "cohort_pure", "order", "pilot_contract"],
      "properties": {
        "rows_per_chunk": {"const": 16},
        "cohort_pure": {"const": true},
        "order": {"const": "interleaved_cohort_waves_native_reduced_partial"},
        "pilot_contract": {"const": "first_three_chunks_cover_native_reduced_partial"}
      }
    },
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": [
        "problems", "variants", "rows", "chunks", "native_variants",
        "partial_native_variants", "reduced_variants", "native_rows",
        "partial_native_rows", "reduced_proxy_rows",
        "application_coverage_anchors", "native_comparison_companions",
        "architecture_inapplicable_problems", "architecture_inapplicable_rows"
      ],
      "properties": {
        "problems": {"type": "integer", "minimum": 1},
        "variants": {"type": "integer", "minimum": 1},
        "rows": {"type": "integer", "minimum": 1},
        "chunks": {"type": "integer", "minimum": 1},
        "native_variants": {"type": "integer", "minimum": 0},
        "partial_native_variants": {"type": "integer", "minimum": 0},
        "reduced_variants": {"type": "integer", "minimum": 0},
        "native_rows": {"type": "integer", "minimum": 0},
        "partial_native_rows": {"type": "integer", "minimum": 0},
        "reduced_proxy_rows": {"type": "integer", "minimum": 0},
        "application_coverage_anchors": {"type": "integer", "minimum": 1},
        "native_comparison_companions": {"type": "integer", "minimum": 0},
        "architecture_inapplicable_problems": {"type": "integer", "minimum": 0},
        "architecture_inapplicable_rows": {"type": "integer", "minimum": 0}
      }
    },
    "exclusion": {
      "type": "object", "additionalProperties": false,
      "required": [
        "slug", "category", "reason", "source_workload_rows",
        "inventory_problem_sha256"
      ],
      "properties": {
        "slug": {"type": "string", "minLength": 1},
        "category": {"enum": ["FIB", "L1", "L2", "Quant"]},
        "reason": {"enum": ["fp8_e4m3_contract", "nvfp4_e2m1_contract"]},
        "source_workload_rows": {"type": "integer", "minimum": 1},
        "inventory_problem_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "variant": {
      "type": "object", "additionalProperties": false,
      "required": [
        "slug", "category", "launch_scope", "launch_completeness_contract",
        "source_launch_completeness_contract", "workload_scope", "variant_id",
        "cohort", "claim_scope", "native_predictive", "native_shape",
        "problem_level_runnable", "source_workload_file",
        "source_workload_file_sha256", "source_workload_count",
        "definition_file", "definition_file_sha256", "solution_file",
        "solution_file_sha256", "adapter_contract", "adapter_contract_sha256",
        "capture_target", "native_env_hash", "invocation", "trace_budget",
        "source_trace_budget", "control_bits",
        "authority_variant_contract_sha256",
        "authority_supplemental_cell_contract_sha256",
        "execution_receipt_sha256", "supplemental_cell_contract_sha256",
        "variant_contract_sha256"
      ],
      "properties": {
        "slug": {"type": "string", "minLength": 1},
        "category": {"enum": ["FIB", "L1", "L2", "Quant"]},
        "launch_scope": {"const": "all_in_profiler_roi"},
        "launch_completeness_contract": {"$ref": "#/$defs/launchContract"},
        "source_launch_completeness_contract": {"type": "object"},
        "workload_scope": {"enum": ["native", "reduced_representative"]},
        "variant_id": {"type": "string", "minLength": 1},
        "cohort": {"enum": ["native", "partial_native_row", "reduced_proxy"]},
        "claim_scope": {"enum": [
          "native_workload_row", "partial_native_workload_row_only",
          "reduced_proxy_bundle_only"
        ]},
        "native_predictive": {"type": "boolean"},
        "native_shape": {"type": "boolean"},
        "problem_level_runnable": {"type": "boolean"},
        "source_workload_file": {"type": "string", "minLength": 1},
        "source_workload_file_sha256": {"$ref": "#/$defs/sha256"},
        "source_workload_count": {"type": "integer", "minimum": 1},
        "definition_file": {"type": "string", "minLength": 1},
        "definition_file_sha256": {"$ref": "#/$defs/sha256"},
        "solution_file": {"type": "string", "minLength": 1},
        "solution_file_sha256": {"$ref": "#/$defs/sha256"},
        "adapter_contract": {"type": "object"},
        "adapter_contract_sha256": {"$ref": "#/$defs/sha256"},
        "capture_target": {"type": "object"},
        "native_env_hash": {"$ref": "#/$defs/sha256"},
        "invocation": {"type": "object"},
        "trace_budget": {"$ref": "#/$defs/representativeBudget"},
        "source_trace_budget": {"type": "object"},
        "control_bits": {"type": "object"},
        "runnability_evidence": {"type": "object"},
        "selected_diagnostic_sha256": {"$ref": "#/$defs/sha256"},
        "reduced_provenance": {"type": "object"},
        "authority_variant_contract_sha256": {"$ref": "#/$defs/sha256"},
        "authority_supplemental_cell_contract_sha256": {"$ref": "#/$defs/sha256"},
        "execution_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "supplemental_cell_contract_sha256": {"$ref": "#/$defs/sha256"},
        "variant_contract_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "representativeBudget": {
      "type": "object", "additionalProperties": false,
      "required": [
        "status", "policy_path", "policy_sha256", "trace_budgets_path",
        "trace_budgets_sha256", "explicit_slug_budget_sha256", "derivation",
        "max_trace_bytes", "max_wall_time_s", "source_max_wall_time_s",
        "source_max_trace_bytes",
        "sampling_policy", "breach_disposition", "partial_trace_allowed",
        "timeout_disposition", "trace_limit_disposition"
      ],
      "properties": {
        "status": {"const": "declared"},
        "policy_path": {"type": "string", "minLength": 1},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "trace_budgets_path": {"type": "string", "minLength": 1},
        "trace_budgets_sha256": {"$ref": "#/$defs/sha256"},
        "explicit_slug_budget_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "derivation": {"const": "representative_min_source_and_900s_ceiling"},
        "max_trace_bytes": {"type": "integer", "minimum": 1, "maximum": 1073741824},
        "max_wall_time_s": {"type": "integer", "minimum": 1, "maximum": 900},
        "source_max_trace_bytes": {"type": "integer", "minimum": 1},
        "source_max_wall_time_s": {"type": "integer", "minimum": 1},
        "sampling_policy": {"const": "off"},
        "breach_disposition": {"const": "hard_refusal_preserve_complete_trace"},
        "partial_trace_allowed": {"const": false},
        "timeout_disposition": {"const": "typed_measured_infeasibility_for_trace_proxy_planning"},
        "trace_limit_disposition": {"const": "typed_measured_infeasibility_for_trace_proxy_planning"}
      }
    },
    "row": {
      "type": "object", "additionalProperties": false,
      "required": [
        "key", "cohort", "category", "flashinfer_corpus", "launch_scope",
        "launch_completeness_contract", "claim_scope", "native_predictive",
        "native_shape", "problem_level_runnable", "variant_contract_sha256",
        "authority_variant_contract_sha256", "authority_row_contract_sha256",
        "execution_row_contract_sha256", "row_evidence_sha256",
        "source_workload_index", "source_workload_uuid", "source_axes",
        "source_row_sha256", "capture_workload_index", "capture_axes",
        "capture_row_sha256"
      ],
      "properties": {
        "key": {"$ref": "#/$defs/rowKey"},
        "cohort": {"enum": ["native", "partial_native_row", "reduced_proxy"]},
        "category": {"enum": ["FIB", "L1", "L2", "Quant"]},
        "flashinfer_corpus": {"type": ["object", "null"]},
        "launch_scope": {"const": "all_in_profiler_roi"},
        "launch_completeness_contract": {"$ref": "#/$defs/launchContract"},
        "claim_scope": {"type": "string", "minLength": 1},
        "native_predictive": {"type": "boolean"},
        "native_shape": {"type": "boolean"},
        "problem_level_runnable": {"type": "boolean"},
        "variant_contract_sha256": {"$ref": "#/$defs/sha256"},
        "authority_variant_contract_sha256": {"$ref": "#/$defs/sha256"},
        "authority_row_contract_sha256": {"$ref": "#/$defs/sha256"},
        "execution_row_contract_sha256": {"$ref": "#/$defs/sha256"},
        "row_evidence_sha256": {"$ref": "#/$defs/sha256"},
        "source_workload_index": {"type": "integer", "minimum": 0},
        "source_workload_uuid": {"type": "string", "minLength": 1},
        "source_axes": {"type": "object"},
        "source_row_sha256": {"$ref": "#/$defs/sha256"},
        "capture_workload_index": {"type": "integer", "minimum": 0},
        "capture_axes": {"type": "object"},
        "capture_row_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "rowKey": {
      "type": "object", "additionalProperties": false,
      "required": ["slug", "source_workload_uuid", "variant_id"],
      "properties": {
        "slug": {"type": "string", "minLength": 1},
        "source_workload_uuid": {"type": "string", "minLength": 1},
        "variant_id": {"type": "string", "minLength": 1}
      }
    },
    "chunk": {
      "type": "object", "additionalProperties": false,
      "required": [
        "chunk_id", "cohort", "tier", "ordinal", "row_count",
        "membership_sha256", "rows"
      ],
      "properties": {
        "chunk_id": {"type": "string", "pattern": "^sol-representative-(?:native|partial-native-row|reduced-proxy)-[0-9]{3}$"},
        "cohort": {"enum": ["native", "partial_native_row", "reduced_proxy"]},
        "tier": {"const": "representative"},
        "ordinal": {"type": "integer", "minimum": 1},
        "row_count": {"type": "integer", "minimum": 1, "maximum": 16},
        "membership_sha256": {"$ref": "#/$defs/sha256"},
        "rows": {
          "type": "array", "minItems": 1, "maxItems": 16,
          "uniqueItems": true, "items": {"$ref": "#/$defs/rowKey"}
        }
      }
    }
  }
}

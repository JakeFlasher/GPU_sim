{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simbench_bw/schemas/order_projections.schema.json",
  "title": "Schedule-Marginalized Order Projections Bundle (per-kernel-per-launch)",
  "description": "One bundle per (slug, shape_point, binary_sha256, source_commit, kernel_signature_sha256) tuple. Implements the original-plan order-projections clause: six orderings of the access stream \u2014 lane, warp-local, CTA-local, SM-local, kernel-L2, sequential-allocation \u2014 each producing a hit-rate proxy under the cache-model L2 capacity via LRU stack distance over per-touched-sector access events. The bundle carries a per-kernel `disagreement_variance` scalar across the admitted projections; when fewer than two projections admit, `disagreement_variance` lands as a typed-unavailable record. The original-plan order-projections-clause negative invariant: a bundle missing the `disagreement_variance` field fails the schema validator. Every closed branch uses `additionalProperties: false`.",
  "schema_version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_kind",
    "manifest_pairing_index",
    "device",
    "projections",
    "disagreement_variance",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "result_kind": {
      "type": "string",
      "enum": [
        "ok"
      ]
    },
    "manifest_pairing_index": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "shape_point",
        "binary_sha256",
        "source_commit",
        "kernel_signature_sha256"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "shape_point": {
          "type": "string",
          "minLength": 1
        },
        "binary_sha256": {
          "type": "string"
        },
        "source_commit": {
          "type": "string"
        },
        "kernel_signature_sha256": {
          "type": "string"
        },
        "source_commit_override_from": {
          "type": "string",
          "description": "Audit annotation: the MPI source_commit value BEFORE refresh_predictor_trace_source_commit.py overwrote it. Optional; present only when the refresh utility actually rewrote the source_commit. Distinct from the bundle's top-level source_commit_override_from (which audits the trace JSON's source_commit, not the MPI's)."
        }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_name",
        "compute_capability_major",
        "compute_capability_minor",
        "sm_count",
        "l2_cache_size_bytes"
      ],
      "properties": {
        "device_name": {
          "type": "string"
        },
        "compute_capability_major": {
          "type": "integer",
          "minimum": 0
        },
        "compute_capability_minor": {
          "type": "integer",
          "minimum": 0
        },
        "sm_count": {
          "type": "integer",
          "minimum": 0
        },
        "l2_cache_size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "projections": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/projection_record"
      }
    },
    "disagreement_variance": {
      "$ref": "#/$defs/disagreement_variance_record"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_record"
      }
    }
  },
  "$defs": {
    "projection_name": {
      "type": "string",
      "enum": [
        "lane",
        "warp_local",
        "cta_local",
        "sm_local",
        "kernel_l2",
        "sequential_allocation"
      ]
    },
    "typed_reason": {
      "type": "string",
      "enum": [
        "lane_projection_unobservable",
        "warp_local_projection_unobservable",
        "cta_local_projection_unobservable",
        "projection_unavailable_sm_local",
        "kernel_l2_projection_unobservable",
        "sequential_allocation_projection_unobservable_no_allocations_sidecar",
        "insufficient_admitted_projections"
      ]
    },
    "projection_record": {
      "oneOf": [
        {
          "title": "Admitted projection",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result_kind",
            "name",
            "provenance",
            "hit_rate_proxy",
            "access_count",
            "low_confidence"
          ],
          "properties": {
            "result_kind": {
              "const": "ok"
            },
            "name": {
              "$ref": "#/$defs/projection_name"
            },
            "provenance": {
              "type": "string",
              "minLength": 1
            },
            "hit_rate_proxy": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "access_count": {
              "type": "integer",
              "minimum": 0
            },
            "low_confidence": {
              "type": "boolean"
            }
          }
        },
        {
          "title": "Typed-unavailable projection",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result_kind",
            "name",
            "typed_reason",
            "provenance"
          ],
          "properties": {
            "result_kind": {
              "const": "typed_unavailable"
            },
            "name": {
              "$ref": "#/$defs/projection_name"
            },
            "typed_reason": {
              "$ref": "#/$defs/typed_reason"
            },
            "provenance": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "disagreement_variance_record": {
      "oneOf": [
        {
          "title": "Numeric disagreement variance",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result_kind",
            "value",
            "admitted_projection_count"
          ],
          "properties": {
            "result_kind": {
              "const": "ok"
            },
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "admitted_projection_count": {
              "type": "integer",
              "minimum": 2
            }
          }
        },
        {
          "title": "Typed-unavailable disagreement variance",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result_kind",
            "typed_reason",
            "admitted_projection_count"
          ],
          "properties": {
            "result_kind": {
              "const": "typed_unavailable"
            },
            "typed_reason": {
              "$ref": "#/$defs/typed_reason"
            },
            "admitted_projection_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      ]
    },
    "evidence_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_kind",
        "note_kind"
      ],
      "properties": {
        "result_kind": {
          "const": "info"
        },
        "note_kind": {
          "type": "string",
          "enum": [
            "order_projections_access_summary"
          ]
        },
        "total_access_events": {
          "type": "integer",
          "minimum": 0
        },
        "threadblocks_walked": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpu-simulator.invalid/schemas/m5_calibration_done.v2.schema.json",
  "title": "M5 calibration immutable DONE manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "source_commit",
    "target",
    "run_manifest",
    "result_manifest",
    "artifact_inventory",
    "analysis_authority",
    "authenticity_receipts",
    "protocol_witness",
    "fresh_pchase_card",
    "pre_ncu_candidate",
    "control_sidecars",
    "counts",
    "closure",
    "rule1_attestation",
    "controller_card_boundary",
    "publication",
    "model_seal_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "artifact_kind": {
      "const": "M5_DONE"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "run_manifest": {
      "$ref": "#/$defs/manifest_pin"
    },
    "result_manifest": {
      "$ref": "#/$defs/manifest_pin"
    },
    "artifact_inventory": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50000,
      "items": {
        "$ref": "#/$defs/inventory_entry"
      }
    },
    "analysis_authority": {
      "$ref": "#/$defs/analysis_authority"
    },
    "authenticity_receipts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "protocol_witness": {
      "$ref": "#/$defs/artifact"
    },
    "fresh_pchase_card": {
      "$ref": "#/$defs/artifact"
    },
    "pre_ncu_candidate": {
      "$ref": "#/$defs/pre_ncu_candidate"
    },
    "control_sidecars": {
      "type": "array",
      "minItems": 123,
      "maxItems": 4218,
      "items": {
        "$ref": "#/$defs/control_pin"
      }
    },
    "counts": {
      "$ref": "#/$defs/counts"
    },
    "closure": {
      "$ref": "#/$defs/closure"
    },
    "rule1_attestation": {
      "$ref": "#/$defs/rule1"
    },
    "controller_card_boundary": {
      "$ref": "#/$defs/card_boundary"
    },
    "publication": {
      "$ref": "#/$defs/publication"
    },
    "model_seal_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "safe_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"
    },
    "nonnegative_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positive_integer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "relative_path": {
      "type": "string",
      "pattern": "^(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture",
        "chip",
        "sku",
        "device_uuid_sha256"
      ],
      "properties": {
        "architecture": {
          "const": "sm_86"
        },
        "chip": {
          "const": "GA102"
        },
        "sku": {
          "const": "RTX 3090 Ti"
        },
        "device_uuid_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "relative_path",
        "sha256",
        "size_bytes",
        "media_type"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/safe_id"
        },
        "relative_path": {
          "$ref": "#/$defs/relative_path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "pre_ncu_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "artifact",
        "candidate_model_seal_sha256",
        "feature_authenticated_artifact_count",
        "ncu_attachment_phase",
        "candidate_publication"
      ],
      "properties": {
        "component_id": {
          "const": "pre_ncu_candidate"
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "candidate_model_seal_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "feature_authenticated_artifact_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        },
        "ncu_attachment_phase": {
          "const": "AFTER_IMMUTABLE_CANDIDATE_FREEZE"
        },
        "candidate_publication": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "publication_identity_id",
            "artifact",
            "publication_name",
            "verified",
            "verification_method",
            "published_sha256",
            "published_size_bytes"
          ],
          "properties": {
            "publication_identity_id": {
              "$ref": "#/$defs/safe_id"
            },
            "artifact": {
              "$ref": "#/$defs/artifact"
            },
            "publication_name": {
              "$ref": "#/$defs/safe_id"
            },
            "verified": {
              "const": true
            },
            "verification_method": {
              "const": "REHASHED_PUBLISHED_BYTES"
            },
            "published_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "published_size_bytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "manifest_pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_kind",
        "relative_path",
        "sha256",
        "size_bytes",
        "model_seal_sha256"
      ],
      "properties": {
        "artifact_kind": {
          "enum": [
            "M5_RUN",
            "M5_RESULT"
          ]
        },
        "relative_path": {
          "enum": [
            "RUN.json",
            "RESULT.json"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "$ref": "#/$defs/positive_integer"
        },
        "model_seal_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "binding": {
      "enum": [
        "IDENTITY",
        "EVIDENCE_CURVE",
        "EVIDENCE_CONTROL",
        "EVIDENCE_CONFOUND",
        "EVIDENCE_COMPOSITION",
        "NCU_CROSS_CHECK",
        "NCU_VERDICT",
        "RAW_SAMPLE_SERIES",
        "READOUT_PRODUCER",
        "QUANTITY_DECISION",
        "PROTOCOL_STATE_WITNESS",
        "CONTROL_PC_JOIN_WITNESS",
        "CONTROL_INVENTORY",
        "CONTROL_SIDECAR",
        "PCHASE_FRESH_CARD",
        "PRE_NCU_CANDIDATE",
        "AUTHENTICATED_INPUT",
        "AUTHORITY_RECEIPT"
      ]
    },
    "inventory_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "relative_path",
        "sha256",
        "size_bytes",
        "media_type",
        "bindings"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/safe_id"
        },
        "relative_path": {
          "$ref": "#/$defs/relative_path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "bindings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/binding"
          }
        }
      }
    },
    "analysis_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_id",
        "public_key_sha256",
        "receipt_domain"
      ],
      "properties": {
        "identity_id": {
          "const": "m5-analysis-authority"
        },
        "public_key_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "receipt_domain": {
          "const": "M5_AUTHORITY_RECEIPT_V1"
        }
      }
    },
    "control_pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage_class",
        "cell_id",
        "artifact_id",
        "relative_path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "coverage_class": {
          "enum": [
            "CANONICAL_ROSTER",
            "CALIBRATION_BINARIES"
          ]
        },
        "cell_id": {
          "$ref": "#/$defs/safe_id"
        },
        "artifact_id": {
          "$ref": "#/$defs/safe_id"
        },
        "relative_path": {
          "$ref": "#/$defs/relative_path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "$ref": "#/$defs/nonnegative_integer"
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_quantity_count",
        "measured_quantity_count",
        "typed_gap_quantity_count",
        "result_quantity_count",
        "unique_artifact_count",
        "raw_sample_series_count",
        "pre_ncu_authenticated_artifact_count",
        "authenticated_artifact_count",
        "authority_receipt_count",
        "canonical_control_sidecar_count",
        "calibration_control_sidecar_count",
        "control_sidecar_count"
      ],
      "properties": {
        "required_quantity_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "measured_quantity_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 512
        },
        "typed_gap_quantity_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 512
        },
        "result_quantity_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "unique_artifact_count": {
          "$ref": "#/$defs/positive_integer"
        },
        "raw_sample_series_count": {
          "type": "integer",
          "minimum": 2,
          "maximum": 8192
        },
        "pre_ncu_authenticated_artifact_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        },
        "authenticated_artifact_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        },
        "authority_receipt_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        },
        "canonical_control_sidecar_count": {
          "const": 122
        },
        "calibration_control_sidecar_count": {
          "$ref": "#/$defs/positive_integer"
        },
        "control_sidecar_count": {
          "type": "integer",
          "minimum": 123,
          "maximum": 4218
        }
      }
    },
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_equals_measured_plus_typed_gap",
        "required_equals_result_count",
        "all_required_quantities_closed",
        "all_artifacts_hash_pinned",
        "all_authenticated_inputs_receipted",
        "protocol_state_join_closed",
        "fresh_pchase_card_closed",
        "raw_sample_lineage_closed",
        "pre_ncu_candidate_frozen_before_ncu_reads",
        "ncu_attachment_after_candidate_freeze",
        "canonical_122_control_roster_closed",
        "all_control_sidecars_hash_pinned"
      ],
      "properties": {
        "required_equals_measured_plus_typed_gap": {
          "const": true
        },
        "required_equals_result_count": {
          "const": true
        },
        "all_required_quantities_closed": {
          "const": true
        },
        "all_artifacts_hash_pinned": {
          "const": true
        },
        "all_authenticated_inputs_receipted": {
          "const": true
        },
        "protocol_state_join_closed": {
          "const": true
        },
        "fresh_pchase_card_closed": {
          "const": true
        },
        "raw_sample_lineage_closed": {
          "const": true
        },
        "pre_ncu_candidate_frozen_before_ncu_reads": {
          "const": true
        },
        "ncu_attachment_after_candidate_freeze": {
          "const": true
        },
        "canonical_122_control_roster_closed": {
          "const": true
        },
        "all_control_sidecars_hash_pinned": {
          "const": true
        }
      }
    },
    "rule1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attested",
        "ncu_role",
        "ncu_feature_bytes_disjoint",
        "ncu_derived",
        "ncu_selected",
        "ncu_tuned",
        "ncu_transcribed",
        "simulator_output_used"
      ],
      "properties": {
        "attested": {
          "const": true
        },
        "ncu_role": {
          "const": "CROSS_CHECK_ONLY"
        },
        "ncu_feature_bytes_disjoint": {
          "const": true
        },
        "ncu_derived": {
          "const": false
        },
        "ncu_selected": {
          "const": false
        },
        "ncu_tuned": {
          "const": false
        },
        "ncu_transcribed": {
          "const": false
        },
        "simulator_output_used": {
          "const": false
        }
      }
    },
    "card_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attested",
        "controller_writes_architecture_cards",
        "publication_path_is_architecture_card",
        "output_mode"
      ],
      "properties": {
        "attested": {
          "const": true
        },
        "controller_writes_architecture_cards": {
          "const": false
        },
        "publication_path_is_architecture_card": {
          "const": false
        },
        "output_mode": {
          "const": "ADDITIVE_EVIDENCE_ONLY"
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transaction_protocol",
        "deterministic_stage",
        "no_replace_rename",
        "exact_idempotent_resume",
        "read_only_files",
        "read_only_directories",
        "relocation_safe",
        "verify_rehashes_bytes",
        "verify_uses_pinned_schemas",
        "partial_recovery_scope"
      ],
      "properties": {
        "transaction_protocol": {
          "const": "O_EXCL_O_NOFOLLOW_FSYNC_RENAME_NOREPLACE_V1"
        },
        "deterministic_stage": {
          "const": true
        },
        "no_replace_rename": {
          "const": true
        },
        "exact_idempotent_resume": {
          "const": true
        },
        "read_only_files": {
          "const": true
        },
        "read_only_directories": {
          "const": true
        },
        "relocation_safe": {
          "const": true
        },
        "verify_rehashes_bytes": {
          "const": true
        },
        "verify_uses_pinned_schemas": {
          "const": true
        },
        "partial_recovery_scope": {
          "const": "EXACT_COMPLETE_ONLY_PRESERVE_INCOMPLETE"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simbench_bw/schemas/m6_recovery_receipt.schema.json",
  "title": "M6 exact staging recovery receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_kind", "tool_id", "created_at_utc",
    "decision", "schedule_sha256", "journal_sha256", "analysis_sha256",
    "staging_root", "inventory", "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "artifact_kind": {"type": "string", "const": "m6_recovery_receipt"},
    "tool_id": {"type": "string", "minLength": 1},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "decision": {"type": "string", "enum": ["EXACT_PREFIX_COMPLETE", "EXACT_PREFIX_PARTIAL", "CONTRADICTORY", "UNAUTHORIZED"]},
    "schedule_sha256": {"$ref": "#/$defs/sha256"},
    "journal_sha256": {"$ref": "#/$defs/sha256"},
    "analysis_sha256": {"$ref": "#/$defs/sha256"},
    "staging_root": {"type": "string", "minLength": 1},
    "inventory": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/inventoryEntry"}},
    "contradiction_code": {"type": ["string", "null"]},
    "published_path": {"type": ["string", "null"]},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"decision": {"const": "UNAUTHORIZED"}}, "required": ["decision"]},
      "then": {
        "properties": {
          "published_path": {"type": "null"},
          "contradiction_code": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "if": {"properties": {"decision": {"const": "CONTRADICTORY"}}, "required": ["decision"]},
      "then": {"required": ["contradiction_code"], "properties": {"published_path": {"type": "null"}}}
    },
    {
      "if": {"properties": {"decision": {"enum": ["EXACT_PREFIX_COMPLETE", "EXACT_PREFIX_PARTIAL"]}}, "required": ["decision"]},
      "then": {"required": ["published_path"], "properties": {"contradiction_code": {"type": "null"}, "published_path": {"type": "string", "minLength": 1}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "inventoryEntry": {
      "type": "object", "additionalProperties": false,
      "required": ["relative_path", "kind", "sha256", "size_bytes", "device", "inode", "mode", "nlink"],
      "properties": {
        "relative_path": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "enum": ["file", "directory"]},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "device": {"type": "integer", "minimum": 0},
        "inode": {"type": "integer", "minimum": 0},
        "mode": {"type": "integer", "minimum": 0},
        "nlink": {"type": "integer", "minimum": 1}
      }
    }
  }
}

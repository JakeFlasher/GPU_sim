{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simbench_bw/schemas/timing_accuracy_report.schema.json",
  "title": "Timing cycle accuracy report",
  "description": "Accuracy report for elapsed-cycle predictions over the long-duration timing cohort. The report uses a timing-specific join key with no cache-layer field, scores the pinned log-ratio metrics, and records publication-gate verdicts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "arch",
    "source_commit",
    "metric_target",
    "prediction_mode",
    "scored_channel",
    "demoted_channels_present",
    "prediction_model_version",
    "prediction_bundle",
    "cohort_artifact",
    "scoring_method",
    "join_key_fields",
    "forbidden_join_fields",
    "bootstrap",
    "coverage",
    "scores",
    "publication_gate",
    "result_kind",
    "typed_unavailable_reason",
    "evidence_status",
    "cells"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "artifact_kind": {"type": "string", "const": "timing_accuracy_report"},
    "arch": {"type": "string", "const": "sm_86"},
    "source_commit": {"type": "string", "minLength": 1},
    "metric_target": {"type": "string", "const": "cycles"},
    "prediction_mode": {"type": "string", "const": "leave_one_out_validation"},
    "scored_channel": {
      "type": "string",
      "const": "deployable_ridge_on_roofline_no_same_slug_substitution",
      "description": "The ONLY channel a publication verdict may score. Diagnostic channels (the demoted same-slug scaled-neighbor arm) are non-scored context."
    },
    "demoted_channels_present": {
      "type": "array",
      "items": {"const": "diagnostic_same_slug_scaled_neighbor_demoted"}
    },
    "prediction_model_version": {
      "type": "string",
      "minLength": 1,
      "not": {"const": "timing_cycle_ridge_v3_same_slug_local_residual"},
      "description": "Echo of the scored bundle's model_version; demoted same-slug-substitution versions are structurally rejected."
    },
    "prediction_bundle": {"type": "string", "minLength": 1},
    "cohort_artifact": {"type": "string", "minLength": 1},
    "scoring_method": {"type": "string", "const": "log_ratio"},
    "join_key_fields": {
      "type": "array",
      "prefixItems": [
        {"const": "slug"},
        {"const": "shape_point"},
        {"const": "arch"},
        {"const": "binary_sha256"},
        {"const": "kernel_signature_sha256"},
        {"const": "source_commit"},
        {"const": "metric_target"}
      ],
      "minItems": 7,
      "maxItems": 7
    },
    "forbidden_join_fields": {
      "type": "array",
      "prefixItems": [{"const": "cache_layer"}],
      "minItems": 1,
      "maxItems": 1
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resamples", "ci_confidence", "seed"],
      "properties": {
        "resamples": {"type": "integer", "const": 2000},
        "ci_confidence": {"type": "number", "const": 0.95},
        "seed": {"type": "integer"}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "n_scored",
        "publication_min_scored_cells",
        "smoke_min_scored_cells",
        "publication_floor_met",
        "smoke_floor_met"
      ],
      "properties": {
        "n_scored": {"type": "integer", "minimum": 0},
        "publication_min_scored_cells": {"type": "integer", "const": 10},
        "smoke_min_scored_cells": {"type": "integer", "const": 5},
        "publication_floor_met": {"type": "boolean"},
        "smoke_floor_met": {"type": "boolean"}
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "n_cells",
        "geomean_relative_error",
        "median_abs_log_relative_error",
        "bootstrap_geomean_upper_bound"
      ],
      "properties": {
        "n_cells": {"type": "integer", "minimum": 0},
        "geomean_relative_error": {"type": "number", "minimum": 0},
        "median_abs_log_relative_error": {"type": "number", "minimum": 0},
        "bootstrap_geomean_upper_bound": {"type": "number", "minimum": 0}
      }
    },
    "publication_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_scored_cells_met",
        "geomean_relative_error_met",
        "median_abs_log_relative_error_met",
        "bootstrap_geomean_upper_bound_met",
        "passes"
      ],
      "properties": {
        "min_scored_cells_met": {"type": "boolean"},
        "geomean_relative_error_met": {"type": "boolean"},
        "median_abs_log_relative_error_met": {"type": "boolean"},
        "bootstrap_geomean_upper_bound_met": {"type": "boolean"},
        "passes": {"type": "boolean"}
      }
    },
    "result_kind": {"type": "string", "enum": ["publication_pass", "typed_unavailable"]},
    "typed_unavailable_reason": {"type": ["string", "null"]},
    "evidence_status": {"type": "string", "enum": ["Offline-verified", "Verified-live-sm_86"]},
    "cells": {
      "type": "array",
      "items": {"$ref": "#/$defs/cell"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"result_kind": {"const": "publication_pass"}},
        "required": ["result_kind"]
      },
      "then": {
        "properties": {
          "scored_channel": {
            "const": "deployable_ridge_on_roofline_no_same_slug_substitution"
          },
          "publication_gate": {
            "properties": {"passes": {"const": true}},
            "required": ["passes"]
          },
          "typed_unavailable_reason": {"type": "null"}
        },
        "required": ["scored_channel", "publication_gate"]
      }
    },
    {
      "if": {
        "properties": {"result_kind": {"const": "typed_unavailable"}},
        "required": ["result_kind"]
      },
      "then": {
        "properties": {
          "typed_unavailable_reason": {"type": "string", "minLength": 1}
        }
      }
    }
  ],
  "$defs": {
    "join_key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "shape_point",
        "arch",
        "binary_sha256",
        "kernel_signature_sha256",
        "source_commit",
        "metric_target"
      ],
      "properties": {
        "slug": {"type": "string", "minLength": 1},
        "shape_point": {"type": "string", "minLength": 1},
        "arch": {"type": "string", "const": "sm_86"},
        "binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "kernel_signature_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_commit": {"type": "string", "minLength": 1},
        "metric_target": {"type": "string", "const": "cycles"}
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "shape_point",
        "arch",
        "regime",
        "join_key",
        "predicted_cycles",
        "observed_cycles",
        "signed_log_ratio"
      ],
      "properties": {
        "slug": {"type": "string", "minLength": 1},
        "shape_point": {"type": "string", "minLength": 1},
        "arch": {"type": "string", "const": "sm_86"},
        "regime": {"type": "string", "enum": ["long"]},
        "join_key": {"$ref": "#/$defs/join_key"},
        "predicted_cycles": {"type": "number", "exclusiveMinimum": 0},
        "observed_cycles": {"type": "number", "exclusiveMinimum": 0},
        "signed_log_ratio": {"type": "number"}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simbench_bw/schemas/sol_runnability.schema.json",
  "title": "sm_86 SOL-ExecBench host runnability determination",
  "description": "Emitted by tools/local_labels/sol_reconstitution.py. The empirical, native-env-stamped runnable/typed-deferred split of the in-scope SOL-ExecBench cells on THIS host under the pinned toolchain. Every non-runnable cell carries a typed status that maps into the campaign's closed exclusion vocabulary. Resumable: `probed + pending == in_scope_total`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_id", "arch", "native_env_hash",
    "in_scope_total", "probed", "pending", "summary",
    "status_to_typed_reason", "cells"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "artifact_id": {"type": "string", "const": "sm86_sol_runnability_v1"},
    "arch": {"type": "string"},
    "sku": {"type": "string"},
    "native_env_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "native_env_degraded": {"type": "boolean"},
    "in_scope_total": {"type": "integer", "minimum": 0},
    "probed": {"type": "integer", "minimum": 0},
    "pending": {"type": "integer", "minimum": 0},
    "summary": {
      "type": "object",
      "required": ["total", "runnable", "by_status"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "runnable": {"type": "integer", "minimum": 0},
        "by_status": {"type": "object"}
      }
    },
    "status_to_typed_reason": {"type": "object"},
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["slug", "category", "language", "status"],
        "properties": {
          "slug": {"type": "string"},
          "category": {"type": "string", "enum": ["L1", "L2", "FIB", "Quant"]},
          "language": {"type": "string"},
          "status": {
            "type": "string",
            "enum": [
              "runnable", "compile_failed", "correctness_failed",
              "host_capacity_oom", "eval_incomplete", "eval_error",
              "resolve_error"
            ]
          },
          "detail": {"type": ["string", "null"]},
          "expected_workloads": {"type": ["integer", "null"]},
          "returncode": {"type": ["integer", "null"]},
          "prior_done": {"type": ["boolean", "null"]},
          "prior_deferred_correctness": {"type": ["boolean", "null"]},
          "stderr_tail": {"type": ["string", "null"]}
        }
      }
    }
  }
}

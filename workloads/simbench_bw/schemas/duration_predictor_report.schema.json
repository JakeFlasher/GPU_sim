{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "sm120 wall-clock duration-predictor report",
  "description": "Terminal report for the per-kernel duration_ns predictor on the SEPARATE duration cohort (sm120_duration_cohort.json intersect duration_admitted.json), with a slug-held-out split, four declared baselines, SMAPE (primary) + MAE-with-epsilon-floor (diagnostic), a leakage check, a DVFS/no-clock-covariate check, a failure-mode decomposition, and a terminal verdict. References the accepted duration-leg engineering-closure artifact as the reason it trains on this cohort rather than the four-source roster. Empirical feature->scalar regression, not a microarchitectural model.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "report_id", "arch", "source_commit", "duration_cohort_id",
    "closure_artifact_path", "split", "cohort_cell_accounting", "features",
    "model_class", "model_class_rationale", "dependency_availability", "baselines",
    "predictor", "strongest_baseline", "scoring", "leakage_check", "dvfs_check",
    "failure_mode_decomposition", "verdict", "verdict_rationale"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "report_id": {"const": "sm120_duration_predictor_v1"},
    "arch": {"const": "sm_120"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "duration_cohort_id": {"const": "sm120_duration_v1"},
    "closure_artifact_path": {"const": "data/local_labels/sm120_tri_label_engineering_closure.json"},
    "split": {
      "type": "object", "additionalProperties": false,
      "required": ["calibration_slugs", "holdout_slugs"],
      "properties": {
        "calibration_slugs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "holdout_slugs": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "cohort_cell_accounting": {
      "type": "object", "additionalProperties": false,
      "required": ["admitted", "missing"],
      "properties": {
        "admitted": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["slug", "shape_point"], "properties": {"slug": {"type": "string"}, "shape_point": {"type": "string"}}}},
        "missing": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["slug", "shape_point"], "properties": {"slug": {"type": "string"}, "shape_point": {"type": "string"}}}}
      }
    },
    "features": {
      "type": "object", "additionalProperties": false,
      "required": ["work_proxy", "nvml_covariates", "nvbit_trace_features_available", "nvbit_unavailable_reason"],
      "properties": {
        "work_proxy": {"type": "string"},
        "nvml_covariates": {"type": "array", "items": {"type": "string"}},
        "nvbit_trace_features_available": {"type": "boolean"},
        "nvbit_unavailable_reason": {"type": "string"}
      }
    },
    "model_class": {"type": "string"},
    "model_class_rationale": {"type": "string"},
    "dependency_availability": {
      "type": "object", "additionalProperties": false,
      "required": ["numpy", "scikit-learn", "pygam", "lightgbm", "xgboost"],
      "properties": {
        "numpy": {"type": "boolean"}, "scikit-learn": {"type": "boolean"},
        "pygam": {"type": "boolean"}, "lightgbm": {"type": "boolean"}, "xgboost": {"type": "boolean"}
      }
    },
    "baselines": {
      "type": "object", "additionalProperties": false,
      "required": ["per_slug_mean", "global_median", "shape_size_only", "nvml_only"],
      "properties": {
        "per_slug_mean": {"type": "object", "additionalProperties": false,
          "required": ["held_out_smape", "held_out_mae_ns", "holdout_fallback"],
          "properties": {"held_out_smape": {"type": "number"}, "held_out_mae_ns": {"type": "number"}, "holdout_fallback": {"type": "string"}}},
        "global_median": {"type": "object", "additionalProperties": false,
          "required": ["held_out_smape", "held_out_mae_ns"],
          "properties": {"held_out_smape": {"type": "number"}, "held_out_mae_ns": {"type": "number"}}},
        "shape_size_only": {"type": "object", "additionalProperties": false,
          "required": ["held_out_smape", "held_out_mae_ns"],
          "properties": {"held_out_smape": {"type": "number"}, "held_out_mae_ns": {"type": "number"}}},
        "nvml_only": {"type": "object", "additionalProperties": false,
          "required": ["held_out_smape", "held_out_mae_ns"],
          "properties": {"held_out_smape": {"type": "number"}, "held_out_mae_ns": {"type": "number"}}}
      }
    },
    "predictor": {
      "type": "object", "additionalProperties": false,
      "required": ["held_out_smape", "held_out_mae_ns", "per_cell_predictions"],
      "properties": {
        "held_out_smape": {"type": "number"}, "held_out_mae_ns": {"type": "number"},
        "per_cell_predictions": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
          "required": ["slug", "shape_point", "true_ns", "pred_ns"],
          "properties": {"slug": {"type": "string"}, "shape_point": {"type": "string"}, "true_ns": {"type": "number"}, "pred_ns": {"type": "number"}}}}
      }
    },
    "strongest_baseline": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "held_out_smape"],
      "properties": {"name": {"enum": ["per_slug_mean", "global_median", "shape_size_only", "nvml_only"]}, "held_out_smape": {"type": "number"}}
    },
    "scoring": {
      "type": "object", "additionalProperties": false,
      "required": ["primary", "diagnostic", "epsilon_floor_ns", "min_duration_ns", "short_kernel_rule_applied", "short_kernel_note"],
      "properties": {
        "primary": {"const": "smape"},
        "diagnostic": {"const": "mae_with_epsilon_floor"},
        "epsilon_floor_ns": {"type": "number", "exclusiveMinimum": 0},
        "min_duration_ns": {"type": "number"},
        "short_kernel_rule_applied": {"type": "boolean"},
        "short_kernel_note": {"type": "string"}
      }
    },
    "leakage_check": {
      "type": "object", "additionalProperties": false,
      "required": ["holdout_slug_in_calibration", "passed"],
      "properties": {"holdout_slug_in_calibration": {"type": "boolean"}, "passed": {"const": true}}
    },
    "dvfs_check": {
      "type": "object", "additionalProperties": false,
      "required": ["sm_clock_mhz_min", "sm_clock_mhz_max", "sm_clock_span_ratio",
                   "predictor_smape_with_nvml", "predictor_smape_without_nvml",
                   "conclusion_depends_on_nvml", "dvfs_non_stationary"],
      "properties": {
        "sm_clock_mhz_min": {"type": "number"}, "sm_clock_mhz_max": {"type": "number"},
        "sm_clock_span_ratio": {"type": ["number", "null"]},
        "predictor_smape_with_nvml": {"type": "number"}, "predictor_smape_without_nvml": {"type": "number"},
        "conclusion_depends_on_nvml": {"type": "boolean"}, "dvfs_non_stationary": {"type": "boolean"}
      }
    },
    "failure_mode_decomposition": {
      "type": "object", "additionalProperties": false,
      "required": ["dvfs_non_stationarity", "feature_fidelity", "model_capacity"],
      "properties": {
        "dvfs_non_stationarity": {"type": "string"}, "feature_fidelity": {"type": "string"}, "model_capacity": {"type": "string"}
      }
    },
    "verdict": {"enum": ["research_success", "engineering_closure_refuted", "indeterminate"]},
    "verdict_rationale": {"type": "string", "minLength": 1}
  }
}

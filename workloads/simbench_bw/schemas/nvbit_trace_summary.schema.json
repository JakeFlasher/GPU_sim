{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simbench_bw/schemas/nvbit_trace_summary.schema.json",
  "title": "NVBitTraceSummary",
  "description": "Per-launch NVBit trace summary. Version 1 is retained only for historical replay and explicit diagnostic parsing. Active admitted production emits version 2, which binds the NVBit-derived instruction count to the complete admitted threadblock payload manifest and admission seal.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [1, 2],
      "description": "Version 1 is historical/diagnostic-only; version 2 is required for active admitted production."
    },
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "shape_point": {
      "type": "string",
      "minLength": 1
    },
    "repeat_index": {
      "type": "integer",
      "minimum": 0
    },
    "launch_index": {
      "type": "integer",
      "minimum": 0
    },
    "kernel_name": {
      "type": "string",
      "minLength": 1
    },
    "kernel_signature_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "inst_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Total admitted threadblock instruction count for this launch. In version 2 its source snapshot is bound by nvbit_threadblock_payload_manifest_sha256 and trace_admission_sha256."
    },
    "binary_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nvbit_trace_pb_path": {
      "type": "string",
      "minLength": 1
    },
    "nvbit_trace_pb_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nvbit_tracer_build_hash": {
      "type": "string",
      "minLength": 1
    },
    "nvbit_threadblock_payload_size_bytes": {
      "type": "integer",
      "minimum": 0,
      "description": "Aggregate raw byte size of every admitted threadblock protobuf."
    },
    "nvbit_threadblock_payload_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of the canonical path, size, and digest manifest for every admitted threadblock protobuf."
    },
    "trace_admission_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Domain-separated SHA-256 sealing all retained root, sidecar, stats, payload-manifest, counter, and per-launch summary identities."
    }
  },
  "oneOf": [
    {
      "title": "HistoricalOrDiagnosticV1",
      "required": [
        "schema_version",
        "slug",
        "shape_point",
        "repeat_index",
        "launch_index",
        "kernel_name",
        "kernel_signature_sha256",
        "inst_count",
        "binary_sha256",
        "nvbit_trace_pb_path",
        "nvbit_trace_pb_sha256",
        "nvbit_tracer_build_hash"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        }
      },
      "not": {
        "anyOf": [
          {"required": ["nvbit_threadblock_payload_size_bytes"]},
          {"required": ["nvbit_threadblock_payload_manifest_sha256"]},
          {"required": ["trace_admission_sha256"]}
        ]
      }
    },
    {
      "title": "AdmittedProductionV2",
      "required": [
        "schema_version",
        "slug",
        "shape_point",
        "repeat_index",
        "launch_index",
        "kernel_name",
        "kernel_signature_sha256",
        "inst_count",
        "binary_sha256",
        "nvbit_trace_pb_path",
        "nvbit_trace_pb_sha256",
        "nvbit_tracer_build_hash",
        "nvbit_threadblock_payload_size_bytes",
        "nvbit_threadblock_payload_manifest_sha256",
        "trace_admission_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "nvbit_tracer_build_hash": {
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simbench_bw/schemas/sol_workload_capture_matrix.schema.json",
  "title": "Additive sm_86 SOL workload-row capture matrix",
  "description": "A supplemental row-granular capture plan derived from, but never replacing or mutating, the canonical 344-cell capture matrix. Native and reduced-proxy claims are structurally distinct.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "arch",
    "sku",
    "source_commit",
    "input_pins",
    "canonical_matrix",
    "canonical_authority",
    "runnability_authority",
    "supplemental_budget_policy",
    "reduced_proxy_authority",
    "claim_policy",
    "chunk_policy",
    "counts",
    "variants",
    "rows",
    "chunks",
    "matrix_seal_sha256"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "artifact_id": {"const": "sm86_sol_workload_capture_matrix_live_v2"},
    "arch": {"const": "sm_86"},
    "sku": {"const": "rtx_3090_ti"},
    "source_commit": {
      "$ref": "#/$defs/commit",
      "description": "Clean live producer and execution HEAD shared by runnability, shrink, planning, and capture."
    },
    "input_pins": {"$ref": "#/$defs/inputPins"},
    "canonical_matrix": {"$ref": "#/$defs/canonicalMatrix"},
    "canonical_authority": {"$ref": "#/$defs/canonicalAuthority"},
    "runnability_authority": {"$ref": "#/$defs/runnabilityAuthority"},
    "supplemental_budget_policy": {"$ref": "#/$defs/budgetPolicy"},
    "reduced_proxy_authority": {"$ref": "#/$defs/reducedProxyAuthority"},
    "claim_policy": {"$ref": "#/$defs/claimPolicy"},
    "chunk_policy": {"$ref": "#/$defs/chunkPolicy"},
    "counts": {"$ref": "#/$defs/counts"},
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/variant"}
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/row"}
    },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/chunk"}
    },
    "matrix_seal_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "directChildName": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/\\\\]+$",
      "not": {"enum": [".", ".."]}
    },
    "inputPins": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sol_native_env_fingerprint"],
      "properties": {
        "sol_native_env_fingerprint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "native_env_hash"],
          "properties": {
            "path": {
              "const": "tools/local_labels/authorities/sol_native_env_fingerprint_sm86.live.v2.json"
            },
            "sha256": {"$ref": "#/$defs/sha256"},
            "native_env_hash": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "externalOwnerMarker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "owner_seal_sha256"],
      "properties": {
        "name": {"$ref": "#/$defs/directChildName"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "owner_seal_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "externalWorkloadSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "name", "sha256", "size_bytes", "owner_marker",
        "runtime_rebind"
      ],
      "properties": {
        "kind": {"const": "shrink_external_child_v1"},
        "name": {"$ref": "#/$defs/directChildName"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "owner_marker": {"$ref": "#/$defs/externalOwnerMarker"},
        "runtime_rebind": {"const": "campaign_retained_immutable_child"}
      }
    },
    "externalDefinitionSource": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind", "name", "sha256", "size_bytes", "owner_marker",
            "runtime_rebind"
          ],
          "properties": {
            "kind": {"const": "shrink_external_definition_child_v1"},
            "name": {"$ref": "#/$defs/directChildName"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "size_bytes": {"type": "integer", "minimum": 1},
            "owner_marker": {"$ref": "#/$defs/externalOwnerMarker"},
            "runtime_rebind": {
              "const": "campaign_retained_immutable_child"
            }
          }
        }
      ]
    },
    "definitionDelta": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["json_pointer", "from", "to"],
        "properties": {
          "json_pointer": {
            "type": "string", "minLength": 1, "pattern": "^/"
          },
          "from": {
            "type": ["integer", "number", "string", "boolean", "null"]
          },
          "to": {
            "type": ["integer", "number", "string", "boolean", "null"]
          }
        }
      }
    },
    "uuid": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|[0-9a-f]{32})$"
    },
    "variantId": {
      "type": "string",
      "pattern": "^(?:native|[0-9a-f]{64})$"
    },
    "rowKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "source_workload_uuid", "variant_id"],
      "properties": {
        "slug": {"type": "string", "pattern": "^problem_[0-9]{3}_.+$"},
        "source_workload_uuid": {"$ref": "#/$defs/uuid"},
        "variant_id": {"$ref": "#/$defs/variantId"}
      }
    },
    "canonicalMatrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "source_commit", "matrix_seal_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "source_commit": {
          "$ref": "#/$defs/commit",
          "description": "Historical provenance commit sealed by the frozen canonical 344-cell matrix; it need not equal the live supplemental source_commit."
        },
        "matrix_seal_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "canonicalAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "roster_id"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "roster_id": {"type": "string", "minLength": 1}
      }
    },
    "runnabilityAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path", "sha256", "owner_marker", "roster_path", "roster_sha256", "roster_rows",
        "native_env_hash", "probe_protocol_sha256", "probe_config_sha256",
        "sol_execbench_package_sha256", "data_annex_manifest_sha256",
        "flashinfer_corpus_manifest_sha256", "flashinfer_corpus_file_count",
        "flashinfer_corpus_blob_count", "flashinfer_corpus_verified",
        "resume_identity_sha256"
      ],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "owner_marker": {"$ref": "#/$defs/ownerMarker"},
        "roster_path": {"const": "tools/sol_baselines_harness/calibration/sm86_coverage_ledger_v1.toml"},
        "roster_sha256": {"$ref": "#/$defs/sha256"},
        "roster_rows": {"const": 201},
        "native_env_hash": {"$ref": "#/$defs/sha256"},
        "probe_protocol_sha256": {"$ref": "#/$defs/sha256"},
        "probe_config_sha256": {"$ref": "#/$defs/sha256"},
        "sol_execbench_package_sha256": {"$ref": "#/$defs/sha256"},
        "data_annex_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "flashinfer_corpus_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "flashinfer_corpus_file_count": {"type": "integer", "minimum": 1},
        "flashinfer_corpus_blob_count": {"type": "integer", "minimum": 1},
        "flashinfer_corpus_verified": {"const": true},
        "resume_identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "budgetPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "policy_id", "default_max_trace_bytes",
        "default_max_wall_time_s", "sampling_policy", "derivation",
        "breach_disposition", "partial_trace_allowed", "source_basis",
        "path", "sha256", "trace_budgets_path", "trace_budgets_sha256"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "policy_id": {"const": "sm86_sol_supplemental_unsampled_v1"},
        "default_max_trace_bytes": {"const": 17179869184},
        "default_max_wall_time_s": {"const": 7200},
        "sampling_policy": {"const": "off"},
        "derivation": {"const": "explicit_slug_or_policy_default_ceiling"},
        "breach_disposition": {"const": "hard_refusal_preserve_complete_trace"},
        "partial_trace_allowed": {"const": false},
        "source_basis": {"const": "supplemental_raw_staging_ceiling_full_trace_retention"},
        "path": {"const": "tools/local_labels/sol_supplemental_trace_budget_policy.v1.json"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "trace_budgets_path": {"const": "workloads/simbench_bw/trace_budgets.toml"},
        "trace_budgets_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "reducedProxyAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "owner_marker", "provenance_contract_version"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "owner_marker": {"$ref": "#/$defs/ownerMarker"},
        "provenance_contract_version": {"const": 3}
      }
    },
    "ownerMarker": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "sha256", "owner_seal_sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "owner_seal_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "claimPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "native_cohort",
        "partial_native_cohort",
        "reduced_proxy_cohort",
        "cross_cohort_aggregation",
        "canonical_344_cell_matrix_impact"
      ],
      "properties": {
        "native_cohort": {"const": "native_workload_rows_only"},
        "partial_native_cohort": {"const": "passed_native_rows_only_no_problem_level_runnability_claim"},
        "reduced_proxy_cohort": {"const": "reduced_proxy_bundles_only_not_native_predictive"},
        "cross_cohort_aggregation": {"const": "forbidden_without_explicit_stratification"},
        "canonical_344_cell_matrix_impact": {"const": "none_additive_supplement_only"}
      }
    },
    "chunkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows_per_chunk", "cohorts_may_mix", "ordering", "tier_order"],
      "properties": {
        "rows_per_chunk": {"const": 16},
        "cohorts_may_mix": {"const": false},
        "ordering": {"const": "representatives_across_all_cohorts_before_depth"},
        "tier_order": {"const": ["representative", "depth"]}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problems", "variants", "native_variants", "partial_native_variants",
        "reduced_variants", "rows", "native_rows", "partial_native_rows",
        "reduced_proxy_rows", "chunks"
      ],
      "properties": {
        "problems": {"type": "integer", "minimum": 1},
        "variants": {"type": "integer", "minimum": 1},
        "native_variants": {"type": "integer", "minimum": 0},
        "partial_native_variants": {"type": "integer", "minimum": 0},
        "reduced_variants": {"type": "integer", "minimum": 0},
        "rows": {"type": "integer", "minimum": 1},
        "native_rows": {"type": "integer", "minimum": 0},
        "partial_native_rows": {"type": "integer", "minimum": 0},
        "reduced_proxy_rows": {"type": "integer", "minimum": 0},
        "chunks": {"type": "integer", "minimum": 1}
      }
    },
    "captureTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_workload_index", "staged_workload_index",
        "selected_candidate_call_ordinal", "candidate_user_fn_calls",
        "dynamic_launch_scope", "dynamic_launch_count_source",
        "profiler_range", "setup_outside_profiler_range", "timing_methodology"
      ],
      "properties": {
        "source_workload_index": {"const": 0},
        "staged_workload_index": {"const": 0},
        "selected_candidate_call_ordinal": {"const": 0},
        "candidate_user_fn_calls": {"const": 1},
        "dynamic_launch_scope": {"const": "all_in_profiler_roi"},
        "dynamic_launch_count_source": {"const": "runtime_inventory"},
        "profiler_range": {"const": "cudaProfilerStartStop"},
        "setup_outside_profiler_range": {"const": true},
        "timing_methodology": {"const": "cuda_events"}
      }
    },
    "launchCompletenessContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory_policy", "launch_scope", "trace_requirement",
        "ncu_label_requirement", "control_requirement", "admission_policy"
      ],
      "properties": {
        "inventory_policy": {"const": "requires_inventory_before_capture"},
        "launch_scope": {"const": "all_in_profiler_roi"},
        "trace_requirement": {"const": "every_inventory_launch_complete"},
        "ncu_label_requirement": {"const": "every_inventory_launch_complete"},
        "control_requirement": {"const": "every_inventory_launch_complete"},
        "admission_policy": {"const": "all_three_layers_complete_for_exact_inventory"}
      }
    },
    "flashinferCorpusContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy", "category", "environment_variable", "injection_policy",
        "root", "data_annex_manifest_path", "data_annex_manifest_sha256",
        "filtered_manifest_sha256", "file_count", "safetensors_count"
      ],
      "properties": {
        "policy": {"const": "verified_fib_only"},
        "category": {"enum": ["L1", "L2", "FIB", "Quant"]},
        "environment_variable": {"const": "FLASHINFER_TRACE_DIR"},
        "injection_policy": {
          "enum": ["verified_absolute_root", "forbidden_remove_ambient"]
        },
        "root": {"type": ["string", "null"]},
        "data_annex_manifest_path": {
          "const": "evidence/manifests/data_annex.sha256"
        },
        "data_annex_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "filtered_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "file_count": {"type": "integer", "minimum": 1},
        "safetensors_count": {"type": "integer", "minimum": 1}
      },
      "oneOf": [
        {
          "properties": {
            "category": {"const": "FIB"},
            "injection_policy": {"const": "verified_absolute_root"},
            "root": {"const": "data/annex/flashinfer_trace"}
          }
        },
        {
          "properties": {
            "category": {"enum": ["L1", "L2", "Quant"]},
            "injection_policy": {"const": "forbidden_remove_ambient"},
            "root": {"const": null}
          }
        }
      ]
    },
    "adapterContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version", "forwarded_argv", "environment", "native_env_hash",
        "flashinfer_corpus",
        "shape_forwarded_to_target", "label_driver_bridge_status",
        "persistent_stage_status", "capture_request_environment",
        "label_driver_bridge_rule"
      ],
      "properties": {
        "contract_version": {"const": 3},
        "forwarded_argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "CUTLASS_DIR", "PATH_prepend", "CUDA_HOME", "NVCC_CCBIN",
            "CC", "CXX", "CUDAHOSTCXX"
          ],
          "properties": {
            "CUTLASS_DIR": {"const": "third_party/cutlass"},
            "PATH_prepend": {"const": "tools/sol_execbench/.venv/bin"},
            "CUDA_HOME": {"const": "/usr/local/cuda-13.2"},
            "NVCC_CCBIN": {"const": "g++-14"},
            "CC": {"const": "gcc-14"},
            "CXX": {"const": "g++-14"},
            "CUDAHOSTCXX": {"const": "g++-14"}
          }
        },
        "native_env_hash": {"$ref": "#/$defs/sha256"},
        "flashinfer_corpus": {"$ref": "#/$defs/flashinferCorpusContract"},
        "shape_forwarded_to_target": {"const": false},
        "label_driver_bridge_status": {"const": "implemented"},
        "persistent_stage_status": {"const": "implemented"},
        "capture_request_environment": {"const": "SOL_EXECBENCH_CAPTURE_REQUEST"},
        "label_driver_bridge_rule": {"type": "string", "minLength": 1}
      }
    },
    "runnabilityEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind", "source_path", "source_sha256", "cell_sha256",
        "resume_identity_sha256", "probe_protocol_sha256",
        "probe_config_sha256", "sol_execbench_package_sha256",
        "native_env_hash", "problem_status", "problem_returncode", "diagnostics_complete",
        "expected_workloads", "passed_workloads"
      ],
      "properties": {
        "source_kind": {"enum": ["current_full_correctness", "current_partial_native_row"]},
        "source_path": {
          "type": "string", "minLength": 1,
          "pattern": "^[^/\\\\]+\\.json$"
        },
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "cell_sha256": {"$ref": "#/$defs/sha256"},
        "resume_identity_sha256": {"$ref": "#/$defs/sha256"},
        "probe_protocol_sha256": {"$ref": "#/$defs/sha256"},
        "probe_config_sha256": {"$ref": "#/$defs/sha256"},
        "sol_execbench_package_sha256": {"$ref": "#/$defs/sha256"},
        "native_env_hash": {"$ref": "#/$defs/sha256"},
        "problem_status": {"type": "string", "minLength": 1},
        "problem_returncode": {"type": "integer"},
        "diagnostics_complete": {"type": "boolean"},
        "expected_workloads": {"type": "integer", "minimum": 1},
        "passed_workloads": {"type": "integer", "minimum": 1},
        "selected_source_workload_index": {"type": "integer", "minimum": 0},
        "selected_source_workload_uuid": {"$ref": "#/$defs/uuid"},
        "selected_source_axes": {"type": "object"},
        "selected_source_row_sha256": {"$ref": "#/$defs/sha256"},
        "selected_diagnostic_sha256": {"$ref": "#/$defs/sha256"}
      },
      "oneOf": [
        {
          "properties": {
            "source_kind": {"const": "current_full_correctness"},
            "problem_status": {"const": "runnable"},
            "problem_returncode": {"const": 0},
            "diagnostics_complete": {"const": true}
          },
          "not": {"anyOf": [
            {"required": ["selected_source_workload_index"]},
            {"required": ["selected_source_workload_uuid"]},
            {"required": ["selected_source_axes"]},
            {"required": ["selected_source_row_sha256"]},
            {"required": ["selected_diagnostic_sha256"]}
          ]}
        },
        {
          "required": [
            "selected_source_workload_index", "selected_source_workload_uuid",
            "selected_source_axes", "selected_source_row_sha256",
            "selected_diagnostic_sha256"
          ],
          "properties": {
            "source_kind": {"const": "current_partial_native_row"},
            "problem_status": {"not": {"const": "runnable"}}
          }
        }
      ]
    },
    "traceBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "policy_path", "policy_sha256", "trace_budgets_path",
        "trace_budgets_sha256", "explicit_slug_budget_sha256", "derivation",
        "max_trace_bytes", "max_wall_time_s", "sampling_policy",
        "breach_disposition", "partial_trace_allowed"
      ],
      "properties": {
        "status": {"const": "declared"},
        "policy_path": {"const": "tools/local_labels/sol_supplemental_trace_budget_policy.v1.json"},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "trace_budgets_path": {"const": "workloads/simbench_bw/trace_budgets.toml"},
        "trace_budgets_sha256": {"$ref": "#/$defs/sha256"},
        "explicit_slug_budget_sha256": {
          "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "derivation": {"const": "explicit_slug_or_policy_default_ceiling"},
        "max_trace_bytes": {"type": "integer", "minimum": 1},
        "max_wall_time_s": {"type": "integer", "minimum": 7200},
        "sampling_policy": {"const": "off"},
        "breach_disposition": {"const": "hard_refusal_preserve_complete_trace"},
        "partial_trace_allowed": {"const": false}
      }
    },
    "controlBits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "module_discovery", "required_outcomes", "static_rebind"],
      "properties": {
        "policy": {"const": "post_trace_module_or_typed"},
        "module_discovery": {"const": "nvbit_runtime_module_inventory"},
        "required_outcomes": {
          "const": [
            "exact_accepted_launch_runtime_binary_controls_emitted",
            "exact_accepted_launch_static_rebind_controls_emitted",
            "typed_unavailable_no_stable_static_module"
          ]
        },
        "static_rebind": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy", "toolkit_version", "allowed_code_arches", "nvcc_path",
            "nvcc_sha256", "cuobjdump_path", "cuobjdump_sha256",
            "ncu_report_binding"
          ],
          "properties": {
            "policy": {"const": "preserved_module_exact_function"},
            "toolkit_version": {"const": "V13.2"},
            "allowed_code_arches": {"const": ["sm_80", "sm_86"]},
            "nvcc_path": {"const": "/usr/local/cuda-13.2/bin/nvcc"},
            "nvcc_sha256": {"$ref": "#/$defs/sha256"},
            "cuobjdump_path": {"const": "/usr/local/cuda-13.2/bin/cuobjdump"},
            "cuobjdump_sha256": {"$ref": "#/$defs/sha256"},
            "ncu_report_binding": {"const": "raw_text_section_exactly_once"}
          }
        }
      }
    },
    "nativeLogicalWorkload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "value", "workload_scope", "benchmark_definition",
        "definition_file", "definition_file_sha256", "benchmark_dir",
        "benchmark_tree_sha256",
        "workload_file", "workload_file_sha256", "expected_workloads",
        "evaluation_evidence"
      ],
      "properties": {
        "kind": {"const": "sol_execbench_workload_set"},
        "value": {"const": "workloads"},
        "workload_scope": {"const": "native"},
        "benchmark_definition": {"type": "string", "minLength": 1},
        "definition_file": {"$ref": "#/$defs/repoPath"},
        "definition_file_sha256": {"$ref": "#/$defs/sha256"},
        "benchmark_dir": {"$ref": "#/$defs/repoPath"},
        "benchmark_tree_sha256": {"$ref": "#/$defs/sha256"},
        "workload_file": {"$ref": "#/$defs/repoPath"},
        "workload_file_sha256": {"$ref": "#/$defs/sha256"},
        "expected_workloads": {"type": "integer", "minimum": 1},
        "evaluation_evidence": {"$ref": "#/$defs/runnabilityEvidence"}
      }
    },
    "reducedEvaluationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind", "source_path", "source_sha256", "cell_sha256",
        "cohort_execution_evidence_sha256", "native_env_hash", "status",
        "returncode", "expected_workloads", "detail"
      ],
      "properties": {
        "source_kind": {"const": "current_reduced_proxy_execution"},
        "source_path": {"$ref": "#/$defs/directChildName"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "cell_sha256": {"$ref": "#/$defs/sha256"},
        "cohort_execution_evidence_sha256": {"$ref": "#/$defs/sha256"},
        "native_env_hash": {"$ref": "#/$defs/sha256"},
        "status": {"const": "runnable"},
        "returncode": {"const": 0},
        "expected_workloads": {"type": "integer", "minimum": 1},
        "detail": {"type": "string", "minLength": 1}
      }
    },
    "reducedLogicalWorkload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "value", "workload_scope", "benchmark_definition",
        "definition_file", "definition_file_sha256",
        "native_definition_file", "native_definition_file_sha256",
        "external_definition_source", "benchmark_dir",
        "benchmark_tree_sha256", "workload_file", "workload_file_sha256",
        "external_workload_source", "expected_workloads",
        "evaluation_evidence"
      ],
      "properties": {
        "kind": {"const": "sol_execbench_workload_set"},
        "value": {"const": "reduced_representative"},
        "workload_scope": {"const": "reduced_representative"},
        "benchmark_definition": {"type": "string", "minLength": 1},
        "definition_file": {"$ref": "#/$defs/repoPath"},
        "definition_file_sha256": {"$ref": "#/$defs/sha256"},
        "native_definition_file": {"$ref": "#/$defs/repoPath"},
        "native_definition_file_sha256": {"$ref": "#/$defs/sha256"},
        "external_definition_source": {
          "$ref": "#/$defs/externalDefinitionSource"
        },
        "benchmark_dir": {"$ref": "#/$defs/repoPath"},
        "benchmark_tree_sha256": {"$ref": "#/$defs/sha256"},
        "workload_file": {"$ref": "#/$defs/directChildName"},
        "workload_file_sha256": {"$ref": "#/$defs/sha256"},
        "external_workload_source": {"$ref": "#/$defs/externalWorkloadSource"},
        "expected_workloads": {"type": "integer", "minimum": 1},
        "evaluation_evidence": {"$ref": "#/$defs/reducedEvaluationEvidence"}
      }
    },
    "captureLaunchContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "label_driver_warmup_count",
        "label_effective_warmup_count", "label_launch_index",
        "label_measured_reps", "trace_candidate_call_count",
        "trace_dynamic_launch_scope", "trace_dynamic_launch_count_source"
      ],
      "properties": {
        "schema_version": {"const": 2},
        "label_driver_warmup_count": {"const": 1},
        "label_effective_warmup_count": {"const": 0},
        "label_launch_index": {"const": 0},
        "label_measured_reps": {"const": 1},
        "trace_candidate_call_count": {"const": 1},
        "trace_dynamic_launch_scope": {"const": "all_in_profiler_roi"},
        "trace_dynamic_launch_count_source": {"const": "runtime_inventory"}
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_kind", "authority_reference_path", "authority_reference_sha256",
        "executable_path", "executable_sha256", "label_app_args",
        "trace_app_args", "evaluation_cardinality_contract",
        "trace_cardinality_contract", "capture_launch_contract",
        "capture_target", "logical_workload",
        "shape_delivery", "target_processes", "adapter_contract"
      ],
      "properties": {
        "adapter_kind": {"const": "sol_execbench"},
        "authority_reference_path": {"$ref": "#/$defs/repoPath"},
        "authority_reference_sha256": {"$ref": "#/$defs/sha256"},
        "executable_path": {"const": "tools/sol_execbench/.venv/bin/sol-execbench"},
        "executable_sha256": {"$ref": "#/$defs/sha256"},
        "label_app_args": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "trace_app_args": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "evaluation_cardinality_contract": {"const": "all_effective_workloads_passed_exact"},
        "trace_cardinality_contract": {"const": "one_selected_workload_candidate_call_all_dynamic_launches_inventoried"},
        "capture_launch_contract": {"$ref": "#/$defs/captureLaunchContract"},
        "capture_target": {"$ref": "#/$defs/captureTarget"},
        "logical_workload": {"$ref": "#/$defs/nativeLogicalWorkload"},
        "shape_delivery": {"const": "adapter_consumes_logical_shape"},
        "target_processes": {"const": "all"},
        "adapter_contract": {"$ref": "#/$defs/adapterContract"}
      }
    },
    "reducedInvocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_kind", "authority_reference_path", "authority_reference_sha256",
        "executable_path", "executable_sha256", "label_app_args",
        "trace_app_args", "evaluation_cardinality_contract",
        "trace_cardinality_contract", "capture_launch_contract",
        "capture_target", "logical_workload", "shape_delivery",
        "target_processes", "adapter_contract"
      ],
      "properties": {
        "adapter_kind": {"const": "sol_execbench"},
        "authority_reference_path": {"$ref": "#/$defs/repoPath"},
        "authority_reference_sha256": {"$ref": "#/$defs/sha256"},
        "executable_path": {"const": "tools/sol_execbench/.venv/bin/sol-execbench"},
        "executable_sha256": {"$ref": "#/$defs/sha256"},
        "label_app_args": {
          "type": "array", "minItems": 7, "maxItems": 7,
          "prefixItems": [
            {"const": "--definition"}, {"$ref": "#/$defs/repoPath"},
            {"const": "--workload"}, {"$ref": "#/$defs/directChildName"},
            {"const": "--solution"}, {"$ref": "#/$defs/repoPath"},
            {"const": "--json"}
          ],
          "items": false
        },
        "trace_app_args": {
          "type": "array", "minItems": 7, "maxItems": 7,
          "prefixItems": [
            {"const": "--definition"}, {"$ref": "#/$defs/repoPath"},
            {"const": "--workload"}, {"$ref": "#/$defs/directChildName"},
            {"const": "--solution"}, {"$ref": "#/$defs/repoPath"},
            {"const": "--json"}
          ],
          "items": false
        },
        "evaluation_cardinality_contract": {"const": "all_effective_workloads_passed_exact"},
        "trace_cardinality_contract": {"const": "one_selected_workload_candidate_call_all_dynamic_launches_inventoried"},
        "capture_launch_contract": {"$ref": "#/$defs/captureLaunchContract"},
        "capture_target": {"$ref": "#/$defs/captureTarget"},
        "logical_workload": {"$ref": "#/$defs/reducedLogicalWorkload"},
        "shape_delivery": {"const": "adapter_consumes_logical_shape"},
        "target_processes": {"const": "all"},
        "adapter_contract": {"$ref": "#/$defs/adapterContract"}
      }
    },
    "reducedProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path", "source_sha256", "provenance_contract_version",
        "cell_sha256", "cohort_id", "native_workload_file",
        "native_workload_file_sha256", "native_definition_file",
        "native_definition_file_sha256", "reduced_definition_file",
        "reduced_definition_file_sha256", "definition_delta",
        "row_plan_sha256", "axes_delta"
      ],
      "properties": {
        "source_path": {
          "type": "string", "minLength": 1,
          "pattern": "^[^/\\\\]+\\.json$"
        },
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "provenance_contract_version": {"const": 3},
        "cell_sha256": {"$ref": "#/$defs/sha256"},
        "cohort_id": {"$ref": "#/$defs/sha256"},
        "native_workload_file": {"$ref": "#/$defs/repoPath"},
        "native_workload_file_sha256": {"$ref": "#/$defs/sha256"},
        "native_definition_file": {"$ref": "#/$defs/repoPath"},
        "native_definition_file_sha256": {"$ref": "#/$defs/sha256"},
        "reduced_definition_file": {"$ref": "#/$defs/repoPath"},
        "reduced_definition_file_sha256": {"$ref": "#/$defs/sha256"},
        "definition_delta": {"$ref": "#/$defs/definitionDelta"},
        "row_plan_sha256": {"$ref": "#/$defs/sha256"},
        "axes_delta": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["axis", "from", "to", "factor"],
            "properties": {
              "axis": {"type": "string", "minLength": 1},
              "from": {"type": ["integer", "number", "string", "boolean", "null"]},
              "to": {"type": ["integer", "number", "string", "boolean", "null"]},
              "factor": {"type": ["number", "null"], "exclusiveMinimum": 0}
            }
          }
        }
      },
      "anyOf": [
        {"properties": {"axes_delta": {"minItems": 1}}},
        {"properties": {"definition_delta": {"minItems": 1}}}
      ]
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug", "category", "launch_scope", "launch_completeness_contract",
        "workload_scope", "variant_id", "cohort", "claim_scope",
        "native_predictive", "native_shape", "problem_level_runnable",
        "source_workload_file",
        "source_workload_file_sha256", "source_workload_count",
        "definition_file", "definition_file_sha256", "solution_file",
        "solution_file_sha256", "adapter_contract",
        "adapter_contract_sha256", "capture_target", "native_env_hash",
        "invocation", "trace_budget", "control_bits",
        "supplemental_cell_contract_sha256", "variant_contract_sha256"
      ],
      "properties": {
        "slug": {"type": "string", "pattern": "^problem_[0-9]{3}_.+$"},
        "category": {"enum": ["L1", "L2", "FIB", "Quant"]},
        "launch_scope": {"const": "all_in_profiler_roi"},
        "launch_completeness_contract": {"$ref": "#/$defs/launchCompletenessContract"},
        "workload_scope": {"enum": ["native", "reduced_representative"]},
        "variant_id": {"$ref": "#/$defs/variantId"},
        "cohort": {"enum": ["native", "partial_native_row", "reduced_proxy"]},
        "claim_scope": {"enum": ["native_workload_row", "partial_native_workload_row_only", "reduced_proxy_bundle_only"]},
        "native_predictive": {"type": "boolean"},
        "native_shape": {"type": "boolean"},
        "problem_level_runnable": {"type": "boolean"},
        "source_workload_file": {"$ref": "#/$defs/repoPath"},
        "source_workload_file_sha256": {"$ref": "#/$defs/sha256"},
        "source_workload_count": {"type": "integer", "minimum": 1},
        "definition_file": {"$ref": "#/$defs/repoPath"},
        "definition_file_sha256": {"$ref": "#/$defs/sha256"},
        "solution_file": {"$ref": "#/$defs/repoPath"},
        "solution_file_sha256": {"$ref": "#/$defs/sha256"},
        "adapter_contract": {"$ref": "#/$defs/adapterContract"},
        "adapter_contract_sha256": {"$ref": "#/$defs/sha256"},
        "capture_target": {"$ref": "#/$defs/captureTarget"},
        "native_env_hash": {"$ref": "#/$defs/sha256"},
        "invocation": {"type": "object"},
        "trace_budget": {"type": "object"},
        "control_bits": {"$ref": "#/$defs/controlBits"},
        "runnability_evidence": {"$ref": "#/$defs/runnabilityEvidence"},
        "selected_diagnostic_sha256": {"$ref": "#/$defs/sha256"},
        "supplemental_cell_contract_sha256": {"$ref": "#/$defs/sha256"},
        "variant_contract_sha256": {"$ref": "#/$defs/sha256"},
        "reduced_provenance": {"$ref": "#/$defs/reducedProvenance"}
      },
      "oneOf": [
        {
          "required": ["runnability_evidence"],
          "properties": {
            "variant_id": {"const": "native"},
            "workload_scope": {"const": "native"},
            "cohort": {"const": "native"},
            "claim_scope": {"const": "native_workload_row"},
            "native_predictive": {"const": true},
            "native_shape": {"const": true},
            "problem_level_runnable": {"const": true},
            "invocation": {"$ref": "#/$defs/invocation"},
            "trace_budget": {"$ref": "#/$defs/traceBudget"},
            "runnability_evidence": {
              "properties": {"source_kind": {"const": "current_full_correctness"}}
            }
          },
          "not": {"anyOf": [
            {"required": ["reduced_provenance"]},
            {"required": ["selected_diagnostic_sha256"]}
          ]}
        },
        {
          "required": ["runnability_evidence", "selected_diagnostic_sha256"],
          "properties": {
            "variant_id": {"pattern": "^[0-9a-f]{64}$"},
            "workload_scope": {"const": "native"},
            "cohort": {"const": "partial_native_row"},
            "claim_scope": {"const": "partial_native_workload_row_only"},
            "native_predictive": {"const": false},
            "native_shape": {"const": true},
            "problem_level_runnable": {"const": false},
            "invocation": {"$ref": "#/$defs/invocation"},
            "trace_budget": {"$ref": "#/$defs/traceBudget"},
            "runnability_evidence": {
              "properties": {"source_kind": {"const": "current_partial_native_row"}}
            }
          },
          "not": {"required": ["reduced_provenance"]}
        },
        {
          "required": ["reduced_provenance"],
          "properties": {
            "variant_id": {"pattern": "^[0-9a-f]{64}$"},
            "workload_scope": {"const": "reduced_representative"},
            "cohort": {"const": "reduced_proxy"},
            "claim_scope": {"const": "reduced_proxy_bundle_only"},
            "native_predictive": {"const": false},
            "native_shape": {"const": false},
            "problem_level_runnable": {"const": false},
            "invocation": {"$ref": "#/$defs/reducedInvocation"},
            "trace_budget": {"$ref": "#/$defs/traceBudget"}
          }
        }
      ]
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key", "cohort", "category", "flashinfer_corpus", "launch_scope",
        "launch_completeness_contract",
        "claim_scope", "native_predictive", "native_shape",
        "problem_level_runnable", "variant_contract_sha256",
        "row_evidence_sha256", "source_workload_index",
        "source_workload_uuid", "source_axes", "source_row_sha256",
        "capture_workload_index", "capture_axes", "capture_row_sha256"
      ],
      "properties": {
        "key": {"$ref": "#/$defs/rowKey"},
        "cohort": {"enum": ["native", "partial_native_row", "reduced_proxy"]},
        "category": {"enum": ["L1", "L2", "FIB", "Quant"]},
        "flashinfer_corpus": {"$ref": "#/$defs/flashinferCorpusContract"},
        "launch_scope": {"const": "all_in_profiler_roi"},
        "launch_completeness_contract": {"$ref": "#/$defs/launchCompletenessContract"},
        "claim_scope": {"enum": ["native_workload_row", "partial_native_workload_row_only", "reduced_proxy_bundle_only"]},
        "native_predictive": {"type": "boolean"},
        "native_shape": {"type": "boolean"},
        "problem_level_runnable": {"type": "boolean"},
        "variant_contract_sha256": {"$ref": "#/$defs/sha256"},
        "row_evidence_sha256": {"$ref": "#/$defs/sha256"},
        "source_workload_index": {"type": "integer", "minimum": 0},
        "source_workload_uuid": {"$ref": "#/$defs/uuid"},
        "source_axes": {
          "type": "object",
          "additionalProperties": {"type": "integer"}
        },
        "source_row_sha256": {"$ref": "#/$defs/sha256"}
        ,
        "capture_workload_index": {"type": "integer", "minimum": 0},
        "capture_axes": {
          "type": "object",
          "additionalProperties": {"type": "integer"}
        },
        "capture_row_sha256": {"$ref": "#/$defs/sha256"}
      },
      "oneOf": [
        {
          "properties": {
            "cohort": {"const": "native"},
            "claim_scope": {"const": "native_workload_row"},
            "native_predictive": {"const": true},
            "native_shape": {"const": true},
            "problem_level_runnable": {"const": true}
          }
        },
        {
          "properties": {
            "cohort": {"const": "partial_native_row"},
            "claim_scope": {"const": "partial_native_workload_row_only"},
            "native_predictive": {"const": false},
            "native_shape": {"const": true},
            "problem_level_runnable": {"const": false}
          }
        },
        {
          "properties": {
            "cohort": {"const": "reduced_proxy"},
            "claim_scope": {"const": "reduced_proxy_bundle_only"},
            "native_predictive": {"const": false},
            "native_shape": {"const": false},
            "problem_level_runnable": {"const": false}
          }
        }
      ]
    },
    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chunk_id", "cohort", "tier", "ordinal", "row_count",
        "membership_sha256", "rows"
      ],
      "properties": {
        "chunk_id": {"type": "string", "pattern": "^sol-workload-(?:native|partial-native-row|reduced-proxy)-[0-9]{3}$"},
        "cohort": {"enum": ["native", "partial_native_row", "reduced_proxy"]},
        "tier": {"enum": ["representative", "depth"]},
        "ordinal": {"type": "integer", "minimum": 1},
        "row_count": {"type": "integer", "minimum": 1, "maximum": 16},
        "membership_sha256": {"$ref": "#/$defs/sha256"},
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/rowKey"}
        }
      }
    }
  }
}

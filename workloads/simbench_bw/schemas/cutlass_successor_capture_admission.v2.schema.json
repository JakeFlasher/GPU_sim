{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cutlass_successor_capture_admission.v2.schema.json",
  "title": "CUTLASS successor capture admission overlay",
  "description": "Closed additive overlay over the immutable 237f17c successor bundle. It records pending or capture-ready receipt joins without modifying the pinned cohort manifests.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_kind", "overlay_id", "generated_at_utc",
    "base_bundle", "receipt_root", "dispatch", "chunking", "chunks",
    "rows", "counts", "integrity", "overlay_seal_sha256"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "artifact_kind": {"const": "cutlass_successor_capture_admission_overlay"},
    "overlay_id": {"const": "cutlass_successor_capture_admission_sm86_v2"},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "base_bundle": {"$ref": "#/$defs/base_bundle"},
    "receipt_root": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "inventory_sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "inventory_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "m6_schedule_created", "typed_reason"],
      "properties": {
        "status": {"enum": ["not_admitted", "partially_admitted", "capture_ready"]},
        "m6_schedule_created": {"const": false},
        "typed_reason": {
          "enum": [
            "capture_receipts_absent", "capture_receipts_partially_ready",
            "all_successor_receipt_pairs_valid"
          ]
        }
      }
    },
    "chunking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "max_rows_per_chunk", "runnable_order", "runnable_membership_sha256"],
      "properties": {
        "policy": {"const": "capture_ready_rows_only"},
        "max_rows_per_chunk": {"const": 8},
        "runnable_order": {
          "type": "array", "maxItems": 3, "uniqueItems": true,
          "items": {"$ref": "#/$defs/row_key"}
        },
        "runnable_membership_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "chunks": {
      "type": "array", "maxItems": 1,
      "items": {"$ref": "#/$defs/chunk"}
    },
    "rows": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/pending_row"},
          {"$ref": "#/$defs/ready_row"}
        ]
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "pending", "capture_ready", "chunks"],
      "properties": {
        "total": {"const": 3},
        "pending": {"type": "integer", "minimum": 0, "maximum": 3},
        "capture_ready": {"type": "integer", "minimum": 0, "maximum": 3},
        "chunks": {"type": "integer", "minimum": 0, "maximum": 1}
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_bundle_unchanged", "unique_matrix_keys", "unique_variant_ids",
        "receipt_inventory_closed", "only_ready_rows_chunked",
        "separate_ncu_nvbit_processes"
      ],
      "properties": {
        "base_bundle_unchanged": {"const": true},
        "unique_matrix_keys": {"const": true},
        "unique_variant_ids": {"const": true},
        "receipt_inventory_closed": {"const": true},
        "only_ready_rows_chunked": {"const": true},
        "separate_ncu_nvbit_processes": {"const": true}
      }
    },
    "overlay_seal_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "row_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matrix_key", "variant_id"],
      "properties": {
        "matrix_key": {"type": "string", "pattern": "^cutlass_successor:"},
        "variant_id": {"type": "string", "pattern": "^[a-z0-9_]+_v1$"}
      }
    },
    "document_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "base_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_commit", "validation", "trace_budgets", "roster", "capture_matrix",
        "bundle_identity_sha256"
      ],
      "properties": {
        "source_commit": {"const": "237f17cd34728b31ea752062e7ea7843a3a2603a"},
        "validation": {
          "allOf": [
            {"$ref": "#/$defs/document_ref"},
            {"properties": {
              "path": {"const": "data/annex/cutlass_successor_sm86_20260723/cutlass_successor_validation_sm86_20260723.json"},
              "sha256": {"const": "2682e21a0c4874f104a0480673fb965ef2e1cb16a4d8a7ef92c34a7b476ccb0e"}
            }}
          ]
        },
        "trace_budgets": {
          "allOf": [
            {"$ref": "#/$defs/document_ref"},
            {"properties": {
              "path": {"const": "data/annex/cutlass_successor_sm86_20260723/cutlass_successor_trace_budgets_sm86_20260723.json"},
              "sha256": {"const": "374abe73648f53c5c4e249c11a84f6b0b1ab3eb8ce9e331220919a462d01f551"}
            }}
          ]
        },
        "roster": {
          "allOf": [
            {"$ref": "#/$defs/document_ref"},
            {"properties": {
              "path": {"const": "data/annex/cutlass_successor_sm86_20260723/cutlass_successor_roster_sm86_20260723.json"},
              "sha256": {"const": "210b8678c64208ea741c91cdd6ce1dce5d55bd29a169dbb0a5a9aa2274ce7185"}
            }}
          ]
        },
        "capture_matrix": {
          "allOf": [
            {"$ref": "#/$defs/document_ref"},
            {"properties": {
              "path": {"const": "data/annex/cutlass_successor_sm86_20260723/cutlass_successor_capture_matrix_sm86_20260723.json"},
              "sha256": {"const": "ec0dc06429299371ec08adf9132eb1f843d99a7ba846d0ada712b747bc7a1879"}
            }}
          ]
        },
        "bundle_identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "receipt_schema_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "schema_id", "path", "sha256", "size_bytes"],
      "properties": {
        "schema_version": {"const": 3},
        "schema_id": {"const": "cutlass_successor_capture_receipt.v3.schema.json"},
        "path": {"const": "workloads/simbench_bw/schemas/cutlass_successor_capture_receipt.v3.schema.json"},
        "sha256": {"const": "9ff5b0d86fd95b908ce05adac3f96c1ea5aac397d9fbc6b729c3c512586b8865"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "external_build_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_kind", "expected_tracer_sha256", "source_commit_sha1",
        "source_tree_sha1", "source_inventory_sha256",
        "source_manifest_sha256", "build_receipt_sha256",
        "artifact_identity_sha256"
      ],
      "properties": {
        "authority_kind": {"const": "independent_reviewed_candidate_sha256.v1"},
        "expected_tracer_sha256": {"$ref": "#/$defs/sha256"},
        "source_commit_sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_tree_sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_inventory_sha256": {"$ref": "#/$defs/sha256"},
        "source_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "build_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "retained_authority_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "sha256", "size_bytes"],
      "properties": {
        "role": {
          "enum": [
            "runtime_manifest", "external_build_source_manifest",
            "external_build_receipt", "external_build_artifact_identity"
          ]
        },
        "path": {"type": "string", "pattern": "^capture_tools/[a-z0-9_.]+$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "nvbit_tool_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_kind", "path", "sha256", "size_bytes", "runtime_manifest",
        "external_build_authority", "source_manifest", "build_receipt",
        "artifact_identity"
      ],
      "properties": {
        "identity_kind": {"const": "retained_reviewed_external_build_bundle.v1"},
        "path": {"type": "string", "pattern": "^capture_tools/[a-z0-9_]+_v1\\.nvbit_tracer_tool\\.so$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "runtime_manifest": {"$ref": "#/$defs/retained_authority_artifact"},
        "external_build_authority": {"$ref": "#/$defs/external_build_authority"},
        "source_manifest": {"$ref": "#/$defs/retained_authority_artifact"},
        "build_receipt": {"$ref": "#/$defs/retained_authority_artifact"},
        "artifact_identity": {"$ref": "#/$defs/retained_authority_artifact"}
      }
    },
    "receipt_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path", "sha256", "size_bytes", "receipt_seal_sha256",
        "schema_authority"
      ],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "receipt_seal_sha256": {"$ref": "#/$defs/sha256"},
        "schema_authority": {"$ref": "#/$defs/receipt_schema_authority"},
        "nvbit_tool": {"$ref": "#/$defs/nvbit_tool_identity"}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug", "shape_point", "binary_sha256", "source_commit",
        "kernel_signature_sha256", "arch", "ncu_metric_version"
      ],
      "properties": {
        "slug": {"type": "string", "minLength": 1},
        "shape_point": {"const": "trace_00"},
        "binary_sha256": {"$ref": "#/$defs/sha256"},
        "source_commit": {"const": "237f17cd34728b31ea752062e7ea7843a3a2603a"},
        "kernel_signature_sha256": {"$ref": "#/$defs/sha256"},
        "arch": {"const": "sm_86"},
        "ncu_metric_version": {"const": "ncu_2026.1.x"}
      }
    },
    "dimensions": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {"type": "integer", "minimum": 1}
    },
    "launch_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "launch_index", "kernel_name", "kernel_signature_sha256",
        "grid_dim", "block_dim", "launch_identity_sha256"
      ],
      "properties": {
        "launch_index": {"const": 0},
        "kernel_name": {"type": "string", "minLength": 1},
        "kernel_signature_sha256": {"$ref": "#/$defs/sha256"},
        "grid_dim": {"$ref": "#/$defs/dimensions"},
        "block_dim": {"$ref": "#/$defs/dimensions"},
        "launch_identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "process_separation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_identity_sha256", "boot_id_sha256", "ncu_process_identity_sha256",
        "nvbit_process_identity_sha256", "separate"
      ],
      "properties": {
        "host_identity_sha256": {"$ref": "#/$defs/sha256"},
        "boot_id_sha256": {"$ref": "#/$defs/sha256"},
        "ncu_process_identity_sha256": {"$ref": "#/$defs/sha256"},
        "nvbit_process_identity_sha256": {"$ref": "#/$defs/sha256"},
        "separate": {"const": true}
      }
    },
    "pending_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matrix_key", "variant_id", "status", "typed_reason", "ncu_receipt",
        "nvbit_receipt", "identity", "launch_identity", "process_separation"
      ],
      "properties": {
        "matrix_key": {"type": "string", "pattern": "^cutlass_successor:"},
        "variant_id": {"type": "string", "pattern": "^[a-z0-9_]+_v1$"},
        "status": {"const": "pending"},
        "typed_reason": {
          "enum": [
            "ncu_and_nvbit_receipts_absent", "ncu_receipt_absent",
            "nvbit_receipt_absent"
          ]
        },
        "ncu_receipt": {"oneOf": [{"$ref": "#/$defs/receipt_ref"}, {"type": "null"}]},
        "nvbit_receipt": {"oneOf": [{"$ref": "#/$defs/receipt_ref"}, {"type": "null"}]},
        "identity": {"type": "null"},
        "launch_identity": {"type": "null"},
        "process_separation": {"type": "null"}
      }
    },
    "ready_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matrix_key", "variant_id", "status", "typed_reason", "ncu_receipt",
        "nvbit_receipt", "identity", "launch_identity", "process_separation"
      ],
      "properties": {
        "matrix_key": {"type": "string", "pattern": "^cutlass_successor:"},
        "variant_id": {"type": "string", "pattern": "^[a-z0-9_]+_v1$"},
        "status": {"const": "capture_ready"},
        "typed_reason": {"const": "valid_joined_receipt_pair"},
        "ncu_receipt": {"$ref": "#/$defs/receipt_ref"},
        "nvbit_receipt": {"$ref": "#/$defs/receipt_ref"},
        "identity": {"$ref": "#/$defs/identity"},
        "launch_identity": {"$ref": "#/$defs/launch_identity"},
        "process_separation": {"$ref": "#/$defs/process_separation"}
      }
    },
    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chunk_id", "rows", "membership_sha256"],
      "properties": {
        "chunk_id": {"const": "cutlass-successor-capture-000"},
        "rows": {
          "type": "array", "minItems": 1, "maxItems": 3,
          "uniqueItems": true, "items": {"$ref": "#/$defs/row_key"}
        },
        "membership_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}

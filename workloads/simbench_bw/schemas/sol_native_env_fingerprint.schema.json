{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simbench_bw/schemas/sol_native_env_fingerprint.schema.json",
  "title": "sm_86 SOL-ExecBench native-env fingerprint",
  "description": "Emitted by tools/local_labels/sol_reconstitution.py. The build-identity fingerprint (SHA-256 over the SOL harness's ten native_env components: python/torch/nvcc/cuda-runtime/CUTLASS-tree/cudnn/package/compiler pins) that every SOL runnability determination is stamped with. Rule 1: a build identity, never an NCU metric. A degraded fingerprint (any 'unknown' component) is a fail-closed non-zero exit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "fingerprint_id", "arch", "native_env_hash",
    "components", "missing_components", "degraded"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "fingerprint_id": {"type": "string", "const": "sm86_sol_native_env_fingerprint_v1"},
    "arch": {"type": "string"},
    "sku": {"type": "string"},
    "native_env_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "components": {
      "type": "object",
      "required": [
        "python_version", "torch_version", "nvcc_version",
        "cuda_runtime_version", "cutlass_tree_hash", "cudnn_version",
        "sol_execbench_package_version", "nvcc_ccbin", "cxx_compiler",
        "c_compiler"
      ],
      "additionalProperties": {"type": "string"}
    },
    "missing_components": {"type": "array", "items": {"type": "string"}},
    "degraded": {"type": "boolean"}
  }
}

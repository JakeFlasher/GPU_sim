{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simbench_bw/schemas/sol_representative_capture_matrix.schema.json",
  "title": "216-row sm_86 SOL representative capture census",
  "description": "An additive selection authority over the full SOL workload-row matrix. Every sm_86-applicable problem has exactly one minimum-static-footprint coverage anchor; 15 OOM problems also retain one minimum-footprint partial-native comparison companion. All 216 rows require full unsampled NVBit plus cycles-only NCU. Reduced targets are explicitly non-native-predictive and cannot support native-scale claims. Architecture-inapplicable problems remain typed inventory entries.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "arch",
    "sku",
    "source_commit",
    "input_pins",
    "source_matrix_seal_sha256",
    "selection_receipt",
    "execution_boundary",
    "selection_policy",
    "capture_contract",
    "claim_policy",
    "counts",
    "by_category",
    "architecture_exclusions",
    "selections",
    "chunks",
    "matrix_seal_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_id": {"const": "sm86_sol_representative_capture_matrix_v1"},
    "arch": {"const": "sm_86"},
    "sku": {"const": "rtx_3090_ti"},
    "source_commit": {"$ref": "#/$defs/commit"},
    "input_pins": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_matrix", "coverage_inventory", "runnability", "shrink"],
      "properties": {
        "source_matrix": {"$ref": "#/$defs/ownedInput"},
        "coverage_inventory": {"$ref": "#/$defs/plainInput"},
        "runnability": {"$ref": "#/$defs/ownedInput"},
        "shrink": {"$ref": "#/$defs/ownedInput"}
      }
    },
    "source_matrix_seal_sha256": {"$ref": "#/$defs/sha256"},
    "selection_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selector_path",
        "selector_sha256",
        "schema_path",
        "schema_sha256",
        "authority_matrix_sha256",
        "authority_matrix_seal_sha256",
        "selection_identity_sha256",
        "architecture_exclusion_identity_sha256"
      ],
      "properties": {
        "selector_path": {"const": "tools/local_labels/build_sol_representative_capture_matrix.py"},
        "selector_sha256": {"$ref": "#/$defs/sha256"},
        "schema_path": {"const": "workloads/simbench_bw/schemas/sol_representative_capture_matrix.schema.json"},
        "schema_sha256": {"$ref": "#/$defs/sha256"},
        "authority_matrix_sha256": {"$ref": "#/$defs/sha256"},
        "authority_matrix_seal_sha256": {"$ref": "#/$defs/sha256"},
        "selection_identity_sha256": {"$ref": "#/$defs/sha256"},
        "architecture_exclusion_identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "execution_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_source_commit",
        "authority_matrix_sha256",
        "execution_source_commit",
        "clean_head_required",
        "carry_forward_proof_required_if_execution_commit_differs",
        "filtered_execution_matrix_status"
      ],
      "properties": {
        "authority_source_commit": {"$ref": "#/$defs/commit"},
        "authority_matrix_sha256": {"$ref": "#/$defs/sha256"},
        "execution_source_commit": {"$ref": "#/$defs/commit"},
        "clean_head_required": {"const": true},
        "carry_forward_proof_required_if_execution_commit_differs": {"const": true},
        "filtered_execution_matrix_status": {"const": "must_be_rebuilt_and_resealed_at_execution_commit"}
      }
    },
    "selection_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cardinality", "proxy_precedence", "candidate_order", "passing_evidence_required", "observed_latency_used_for_ranking"],
      "properties": {
        "cardinality": {"const": "exactly_one_application_anchor_per_sm86_applicable_problem_plus_one_partial_native_companion_when_available"},
        "proxy_precedence": {"const": "eligible_reduced_proxy_is_application_anchor_without_discarding_partial_native_companion"},
        "candidate_order": {"const": "aggregate_bits_then_peak_bits_then_aggregate_elements_then_axis_volume_then_scalar_tuple_then_source_index_then_uuid_then_variant_id"},
        "passing_evidence_required": {"const": true},
        "observed_latency_used_for_ranking": {"const": false}
      }
    },
    "capture_contract": {"$ref": "#/$defs/traceContract"},
    "claim_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture_inapplicable_is_not_native_failure",
        "modified_scale_native_predictive",
        "modified_scale_native_scale_claims_forbidden",
        "representative_matrix_is_not_full_row_coverage",
        "trace_completeness_requires_done_evidence"
      ],
      "properties": {
        "architecture_inapplicable_is_not_native_failure": {"const": true},
        "modified_scale_native_predictive": {"const": false},
        "modified_scale_native_scale_claims_forbidden": {"const": true},
        "representative_matrix_is_not_full_row_coverage": {"const": true},
        "trace_completeness_requires_done_evidence": {"const": true}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problems",
        "applicable_problems",
        "unique_applications_covered",
        "application_coverage_anchors",
        "native_comparison_companions",
        "architecture_inapplicable_problems",
        "architecture_inapplicable_rows",
        "selected_rows",
        "native_selected_rows",
        "partial_native_selected_rows",
        "reduced_proxy_selected_rows",
        "modified_scale_rows",
        "native_predictive_false_rows",
        "chunks"
      ],
      "properties": {
        "problems": {"const": 235},
        "applicable_problems": {"const": 201},
        "unique_applications_covered": {"const": 201},
        "application_coverage_anchors": {"const": 201},
        "native_comparison_companions": {"const": 15},
        "architecture_inapplicable_problems": {"const": 34},
        "architecture_inapplicable_rows": {"const": 537},
        "selected_rows": {"const": 216},
        "native_selected_rows": {"const": 178},
        "partial_native_selected_rows": {"const": 15},
        "reduced_proxy_selected_rows": {"const": 23},
        "modified_scale_rows": {"const": 23},
        "native_predictive_false_rows": {"const": 38},
        "chunks": {"const": 15}
      }
    },
    "by_category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["FIB", "L1", "L2", "Quant"],
      "properties": {
        "FIB": {"$ref": "#/$defs/categoryCounts"},
        "L1": {"$ref": "#/$defs/categoryCounts"},
        "L2": {"$ref": "#/$defs/categoryCounts"},
        "Quant": {"$ref": "#/$defs/categoryCounts"}
      }
    },
    "architecture_exclusions": {
      "type": "array",
      "minItems": 34,
      "maxItems": 34,
      "items": {"$ref": "#/$defs/exclusion"}
    },
    "selections": {
      "type": "array",
      "minItems": 216,
      "maxItems": 216,
      "items": {"$ref": "#/$defs/selection"}
    },
    "chunks": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {"$ref": "#/$defs/chunk"}
    },
    "matrix_seal_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "directChild": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/\\\\]+$",
      "not": {"enum": [".", ".."]}
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "owner_seal_sha256"],
      "properties": {
        "name": {"$ref": "#/$defs/directChild"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "owner_seal_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "plainInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256"],
      "properties": {
        "name": {"$ref": "#/$defs/directChild"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "ownedInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "owner"],
      "properties": {
        "name": {"$ref": "#/$defs/directChild"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "owner": {"$ref": "#/$defs/owner"}
      }
    },
    "category": {"enum": ["FIB", "L1", "L2", "Quant"]},
    "categoryCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected", "application_coverage_anchors", "native_comparison_companions", "architecture_inapplicable"],
      "properties": {
        "selected": {"type": "integer", "minimum": 0, "maximum": 216},
        "application_coverage_anchors": {"type": "integer", "minimum": 0, "maximum": 201},
        "native_comparison_companions": {"type": "integer", "minimum": 0, "maximum": 15},
        "architecture_inapplicable": {"type": "integer", "minimum": 0, "maximum": 34}
      }
    },
    "rowKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "source_workload_uuid", "variant_id"],
      "properties": {
        "slug": {"type": "string", "minLength": 1},
        "source_workload_uuid": {"type": "string", "minLength": 1},
        "variant_id": {"type": "string", "minLength": 1}
      }
    },
    "traceContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nvbit_trace",
        "ncu_profile",
        "launch_scope",
        "dynamic_launch_scope",
        "partial_trace_allowed",
        "admission_required_layers",
        "control_outcome_required",
        "control_outcome_policy",
        "allowed_control_outcomes",
        "allowed_typed_unavailable_reason",
        "control_unavailability_invalidates_trace_ncu"
      ],
      "properties": {
        "nvbit_trace": {"const": "full_unsampled"},
        "ncu_profile": {"const": "full_unsampled_cycles_only_binding"},
        "launch_scope": {"const": "all_in_profiler_roi"},
        "dynamic_launch_scope": {"const": "all_inventory_launches"},
        "partial_trace_allowed": {"const": false},
        "admission_required_layers": {"const": ["nvbit_trace", "ncu_profile"]},
        "control_outcome_required": {"const": true},
        "control_outcome_policy": {"const": "complete_or_closed_typed_unavailable_nonblocking"},
        "allowed_control_outcomes": {"const": ["complete", "typed_unavailable_no_stable_static_module"]},
        "allowed_typed_unavailable_reason": {"const": "origin_unresolved"},
        "control_unavailability_invalidates_trace_ncu": {"const": false}
      }
    },
    "selectionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sha256", "observed_latency_ms"],
      "properties": {
        "kind": {"enum": ["runnability_workload_diagnostic", "shrink_cohort_workload_diagnostic"]},
        "sha256": {"$ref": "#/$defs/sha256"},
        "observed_latency_ms": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "selectionRank": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aggregate_declared_tensor_bits",
        "peak_declared_tensor_bits",
        "aggregate_declared_tensor_elements",
        "resolved_axis_volume",
        "scalar_control_tuple",
        "source_workload_index",
        "source_workload_uuid",
        "variant_id"
      ],
      "properties": {
        "aggregate_declared_tensor_bits": {"type": "integer", "minimum": 0},
        "peak_declared_tensor_bits": {"type": "integer", "minimum": 0},
        "aggregate_declared_tensor_elements": {"type": "integer", "minimum": 0},
        "resolved_axis_volume": {"type": "integer", "minimum": 1},
        "scalar_control_tuple": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {"type": "string", "minLength": 1},
              {"type": "integer", "minimum": 0}
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        },
        "source_workload_index": {"type": "integer", "minimum": 0},
        "source_workload_uuid": {"type": "string", "minLength": 1},
        "variant_id": {"type": "string", "minLength": 1}
      }
    },
    "definitionFootprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "definition_path",
        "definition_sha256",
        "aggregate_declared_tensor_bits",
        "peak_declared_tensor_bits",
        "aggregate_declared_tensor_elements",
        "resolved_axis_volume",
        "scalar_control_tuple",
        "tensor_count"
      ],
      "properties": {
        "model": {"const": "declared_tensor_io_footprint_v1"},
        "definition_path": {"type": "string", "minLength": 1},
        "definition_sha256": {"$ref": "#/$defs/sha256"},
        "aggregate_declared_tensor_bits": {"type": "integer", "minimum": 0},
        "peak_declared_tensor_bits": {"type": "integer", "minimum": 0},
        "aggregate_declared_tensor_elements": {"type": "integer", "minimum": 0},
        "resolved_axis_volume": {"type": "integer", "minimum": 1},
        "scalar_control_tuple": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {"type": "string", "minLength": 1},
              {"type": "integer", "minimum": 0}
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        },
        "tensor_count": {"type": "integer", "minimum": 1}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "category",
        "selection_class",
        "selection_role",
        "source_matrix_row_key",
        "source_matrix_row_sha256",
        "source_matrix_variant_sha256",
        "selection_evidence",
        "definition_footprint",
        "selection_rank",
        "source_workload_index",
        "source_workload_uuid",
        "source_axes",
        "source_row_sha256",
        "capture_workload_index",
        "capture_axes",
        "capture_row_sha256",
        "cohort",
        "claim_scope",
        "scale_modified",
        "native_shape",
        "native_predictive",
        "native_scale_claim_eligible",
        "problem_level_native_claim_eligible",
        "trace_contract"
      ],
      "properties": {
        "slug": {"type": "string", "minLength": 1},
        "category": {"$ref": "#/$defs/category"},
        "selection_class": {"enum": ["minimum_footprint_passing_native", "minimum_footprint_passing_reduced_proxy", "minimum_footprint_passing_partial_native"]},
        "selection_role": {"enum": ["application_coverage_anchor", "native_comparison_companion"]},
        "source_matrix_row_key": {"$ref": "#/$defs/rowKey"},
        "source_matrix_row_sha256": {"$ref": "#/$defs/sha256"},
        "source_matrix_variant_sha256": {"$ref": "#/$defs/sha256"},
        "selection_evidence": {"$ref": "#/$defs/selectionEvidence"},
        "definition_footprint": {"$ref": "#/$defs/definitionFootprint"},
        "selection_rank": {"$ref": "#/$defs/selectionRank"},
        "source_workload_index": {"type": "integer", "minimum": 0},
        "source_workload_uuid": {"type": "string", "minLength": 1},
        "source_axes": {"type": "object"},
        "source_row_sha256": {"$ref": "#/$defs/sha256"},
        "capture_workload_index": {"type": "integer", "minimum": 0},
        "capture_axes": {"type": "object"},
        "capture_row_sha256": {"$ref": "#/$defs/sha256"},
        "cohort": {"enum": ["native", "reduced_proxy", "partial_native_row"]},
        "claim_scope": {"enum": ["native_workload_row", "reduced_proxy_bundle_only", "partial_native_workload_row_only"]},
        "scale_modified": {"type": "boolean"},
        "native_shape": {"type": "boolean"},
        "native_predictive": {"type": "boolean"},
        "native_scale_claim_eligible": {"type": "boolean"},
        "problem_level_native_claim_eligible": {"type": "boolean"},
        "trace_contract": {"$ref": "#/$defs/traceContract"}
      },
      "oneOf": [
        {
          "properties": {
            "selection_class": {"const": "minimum_footprint_passing_native"},
            "selection_role": {"const": "application_coverage_anchor"},
            "cohort": {"const": "native"},
            "claim_scope": {"const": "native_workload_row"},
            "scale_modified": {"const": false},
            "native_shape": {"const": true},
            "native_predictive": {"const": true},
            "native_scale_claim_eligible": {"const": true},
            "problem_level_native_claim_eligible": {"const": true},
            "selection_evidence": {
              "properties": {"kind": {"const": "runnability_workload_diagnostic"}}
            }
          }
        },
        {
          "properties": {
            "selection_class": {"const": "minimum_footprint_passing_reduced_proxy"},
            "selection_role": {"const": "application_coverage_anchor"},
            "cohort": {"const": "reduced_proxy"},
            "claim_scope": {"const": "reduced_proxy_bundle_only"},
            "scale_modified": {"const": true},
            "native_shape": {"const": false},
            "native_predictive": {"const": false},
            "native_scale_claim_eligible": {"const": false},
            "problem_level_native_claim_eligible": {"const": false},
            "selection_evidence": {
              "properties": {"kind": {"const": "shrink_cohort_workload_diagnostic"}}
            }
          }
        },
        {
          "properties": {
            "selection_class": {"const": "minimum_footprint_passing_partial_native"},
            "selection_role": {"const": "native_comparison_companion"},
            "cohort": {"const": "partial_native_row"},
            "claim_scope": {"const": "partial_native_workload_row_only"},
            "scale_modified": {"const": false},
            "native_shape": {"const": true},
            "native_predictive": {"const": false},
            "native_scale_claim_eligible": {"const": true},
            "problem_level_native_claim_eligible": {"const": false},
            "selection_evidence": {
              "properties": {"kind": {"const": "runnability_workload_diagnostic"}}
            }
          }
        }
      ]
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "category", "reason", "source_workload_rows", "inventory_problem_sha256"],
      "properties": {
        "slug": {"type": "string", "minLength": 1},
        "category": {"$ref": "#/$defs/category"},
        "reason": {"enum": ["fp8_e4m3_contract", "nvfp4_e2m1_contract"]},
        "source_workload_rows": {"type": "integer", "minimum": 1},
        "inventory_problem_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "selectionId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "source_workload_uuid", "variant_id"],
      "properties": {
        "slug": {"type": "string", "minLength": 1},
        "source_workload_uuid": {"type": "string", "minLength": 1},
        "variant_id": {"type": "string", "minLength": 1}
      }
    },
    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chunk_id", "cohort", "selection_ids"],
      "properties": {
        "chunk_id": {"type": "string", "pattern": "^sol-representative-(?:native|reduced-proxy|partial-native-row)-[0-9]{3}$"},
        "cohort": {"enum": ["native", "reduced_proxy", "partial_native_row"]},
        "selection_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {"$ref": "#/$defs/selectionId"}
        }
      }
    }
  }
}

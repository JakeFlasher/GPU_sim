{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simbench_bw/schemas/capture_roster_authority.schema.json",
  "title": "sm_86 capture roster authority",
  "description": "Emitted by tools/local_labels/build_capture_roster_authority.py. The machine-checkable enumeration of the sm_86 capture universe, partitioned into runnable / pending_build / pending_reconstitution / excluded with the accounting identity universe == runnable + pending_build + pending_reconstitution + excluded. Source rosters are sha256-pinned and the commit is stamped.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "roster_id",
    "arch",
    "source_commit",
    "source_pins",
    "counts",
    "accounting_identity_holds",
    "cells"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "roster_id": {"type": "string"},
    "arch": {"type": "string"},
    "sku": {"type": "string"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "generated_at_utc": {"type": "string"},
    "source_pins": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "counts": {
      "type": "object",
      "required": [
        "universe", "runnable", "pending_build",
        "pending_reconstitution", "pending_shrink", "excluded"
      ],
      "properties": {
        "universe": {"type": "integer", "minimum": 0},
        "runnable": {"type": "integer", "minimum": 0},
        "pending_build": {"type": "integer", "minimum": 0},
        "pending_reconstitution": {"type": "integer", "minimum": 0},
        "pending_shrink": {"type": "integer", "minimum": 0},
        "excluded": {"type": "integer", "minimum": 0},
        "by_source": {"type": "object"}
      }
    },
    "accounting_identity_holds": {"type": "boolean"},
    "integrity": {
      "type": "object",
      "properties": {
        "partition_ok": {"type": "boolean"},
        "source_counts_ok": {"type": "boolean"},
        "duplicate_slugs": {"type": "object"},
        "sol_meta_total_problems_ok": {"type": "boolean"},
        "independent_source_totals": {"type": "object"}
      }
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["roster_source", "slug", "resolution_status"],
        "properties": {
          "roster_source": {
            "type": "string",
            "enum": ["portable_lcd", "simbench_bw", "sol_execbench"]
          },
          "slug": {"type": "string"},
          "binary": {"type": ["string", "null"]},
          "app_args": {"type": ["array", "null"]},
          "shape_point": {"type": ["string", "null"]},
          "resolution_status": {
            "type": "string",
            "enum": ["runnable", "pending_build", "pending_reconstitution",
                     "pending_shrink", "excluded"]
          },
          "binary_present": {"type": "boolean"},
          "binary_available_now": {"type": "boolean"},
          "binary_sha256_matches_now": {"type": "boolean"},
          "binary_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "shape_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "shape_binding_kind": {
            "type": "string",
            "enum": ["generic_shape_point", "legacy_timing_alias", "legacy_correctness_alias"]
          },
          "build_input_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "build_witness_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "build_witness_row_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "build_witness_problems": {
            "type": "array", "items": {"type": "string"}
          },
          "category": {"type": ["string", "null"]},
          "exclusion_reason": {"type": ["string", "null"]},
          "exclusion_detail": {"type": ["string", "null"]},
          "native_env_hash": {"type": ["string", "null"]}
        },
        "allOf": [
          {
            "if": {
              "properties": {"resolution_status": {"const": "runnable"}},
              "required": ["resolution_status"]
            },
            "then": {
              "required": ["binary", "app_args", "shape_point", "binary_sha256", "binary_present"],
              "properties": {
                "binary": {"type": "string", "minLength": 1},
                "app_args": {
                  "type": "array", "minItems": 1,
                  "items": {"type": "string"}
                },
                "shape_point": {"type": "string", "minLength": 1},
                "binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "binary_present": {"const": true}
              }
            }
          },
          {
            "if": {
              "properties": {
                "roster_source": {"const": "simbench_bw"},
                "resolution_status": {"const": "runnable"}
              },
              "required": ["roster_source", "resolution_status"]
            },
            "then": {
              "required": [
                "shape_file_sha256", "shape_binding_kind", "build_input_set_sha256",
                "build_witness_sha256", "build_witness_row_sha256"
              ]
            }
          }
        ]
      }
    }
  }
}

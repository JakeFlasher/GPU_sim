{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simbench_bw/schemas/capture_roster_authority.durable.v2.schema.json",
  "title": "Durable-v2 sm_86 capture roster authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "accounting_identity_holds",
    "arch",
    "cells",
    "counts",
    "historical_authority",
    "resolution_semantics",
    "roster_id",
    "schema_version",
    "source_commit",
    "source_pins"
  ],
  "properties": {
    "accounting_identity_holds": {"const": true},
    "arch": {"const": "sm_86"},
    "cells": {
      "type": "array",
      "minItems": 344,
      "maxItems": 344,
      "items": {"$ref": "#/$defs/cell"}
    },
    "counts": {"$ref": "#/$defs/counts"},
    "historical_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "roster_id", "sha256"],
      "properties": {
        "path": {"const": "data/local_labels/campaign/capture_roster_authority_sm86.json"},
        "roster_id": {"const": "sm86_capture_roster_authority_v1"},
        "sha256": {"const": "d02c817091b0a9f06c2106c0987c59a481910afcc3b78ab1de7a7d5bd5a6b4b4"}
      }
    },
    "resolution_semantics": {"const": "durable"},
    "roster_id": {"const": "sm86_capture_roster_authority_durable_v2"},
    "schema_version": {"const": 2},
    "source_commit": {"const": "c4b76c0ae3b49378f6e3d4cabf7830dbe3eaa432"},
    "source_pins": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "portable_lcd_roster_sha256",
        "simbench_build_witness_sha256",
        "simbench_roster_sha256",
        "sol_port_scope_sha256",
        "sol_runnability_sha256",
        "witness_compat_registry_sha256"
      ],
      "properties": {
        "portable_lcd_roster_sha256": {"const": "7d075f8f07a14094e475699e3caaac9baea256b0c16b34f8fe911ac17ff6713f"},
        "simbench_build_witness_sha256": {"const": "d577b3850f5ed04c798b1475d06cd6f29e48f857c0dc5735f923157e26cc7750"},
        "simbench_roster_sha256": {"const": "d79b1c6b3f1cddb47776405abb503f7c0f8705f7da62bb28719448417ccdbd0e"},
        "sol_port_scope_sha256": {"const": "22c2792c9b100663afed77b3220944b07b4a6871b51f32fe83c71f40c227baa3"},
        "sol_runnability_sha256": {"const": "760853e5916b78ea4e233b5995f6db49d4d8942ec09d240e02f2e072ed8bbe4f"},
        "witness_compat_registry_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "universe", "runnable", "pending_build", "pending_reconstitution",
        "pending_shrink", "excluded", "by_source"
      ],
      "properties": {
        "universe": {"const": 344},
        "runnable": {"const": 122},
        "pending_build": {"const": 0},
        "pending_reconstitution": {"const": 0},
        "pending_shrink": {"const": 0},
        "excluded": {"const": 222},
        "by_source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["portable_lcd", "simbench_bw", "sol_execbench"],
          "properties": {
            "portable_lcd": {
              "type": "object",
              "additionalProperties": false,
              "required": ["runnable"],
              "properties": {"runnable": {"const": 17}}
            },
            "simbench_bw": {
              "type": "object",
              "additionalProperties": false,
              "required": ["excluded", "runnable"],
              "properties": {
                "excluded": {"const": 61},
                "runnable": {"const": 31}
              }
            },
            "sol_execbench": {
              "type": "object",
              "additionalProperties": false,
              "required": ["excluded", "runnable"],
              "properties": {
                "excluded": {"const": 161},
                "runnable": {"const": 74}
              }
            }
          }
        }
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roster_source", "slug", "resolution_status", "binary", "app_args",
        "shape_point", "binary_present"
      ],
      "properties": {
        "roster_source": {"enum": ["portable_lcd", "simbench_bw", "sol_execbench"]},
        "slug": {"type": "string", "minLength": 1},
        "resolution_status": {"enum": ["runnable", "excluded"]},
        "binary": {"type": ["string", "null"]},
        "app_args": {"type": ["array", "null"], "items": {"type": "string"}},
        "shape_point": {"type": ["string", "null"]},
        "binary_present": {"type": "boolean"},
        "binary_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "shape_file_sha256": {"$ref": "#/$defs/sha256"},
        "shape_binding_kind": {"enum": ["generic_shape_point", "legacy_timing_alias", "legacy_correctness_alias"]},
        "build_input_set_sha256": {"$ref": "#/$defs/sha256"},
        "build_witness_sha256": {"$ref": "#/$defs/sha256"},
        "build_witness_row_sha256": {"$ref": "#/$defs/sha256"},
        "category": {"type": ["string", "null"]},
        "exclusion_reason": {
          "type": ["string", "null"],
          "enum": [
            null, "arch_gate", "semantic_mismatch", "trace_unsupported",
            "repeatability_failed", "correctness_failed",
            "calibration_inconclusive", "host_capacity_deferred"
          ]
        },
        "exclusion_detail": {"type": ["string", "null"]},
        "native_env_hash": {"type": "string", "minLength": 1}
      },
      "oneOf": [
        {"$ref": "#/$defs/portableRunnable"},
        {"$ref": "#/$defs/simbenchRunnable"},
        {"$ref": "#/$defs/simbenchExcluded"},
        {"$ref": "#/$defs/solRunnable"},
        {"$ref": "#/$defs/solExcluded"}
      ]
    },
    "portableRunnable": {
      "properties": {
        "roster_source": {"const": "portable_lcd"},
        "resolution_status": {"const": "runnable"},
        "binary": {"type": "string", "minLength": 1},
        "app_args": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "shape_point": {"type": "string", "minLength": 1},
        "binary_present": {"const": true},
        "binary_sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["binary_sha256"],
      "not": {"anyOf": [
        {"required": ["shape_file_sha256"]}, {"required": ["shape_binding_kind"]},
        {"required": ["build_input_set_sha256"]}, {"required": ["build_witness_sha256"]},
        {"required": ["build_witness_row_sha256"]}, {"required": ["category"]},
        {"required": ["exclusion_reason"]}, {"required": ["exclusion_detail"]},
        {"required": ["native_env_hash"]}
      ]}
    },
    "simbenchRunnable": {
      "properties": {
        "roster_source": {"const": "simbench_bw"},
        "resolution_status": {"const": "runnable"},
        "binary": {"type": "string", "minLength": 1},
        "app_args": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "shape_point": {"type": "string", "minLength": 1},
        "binary_present": {"const": true},
        "binary_sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": [
        "binary_sha256", "shape_file_sha256", "shape_binding_kind",
        "build_input_set_sha256", "build_witness_sha256",
        "build_witness_row_sha256"
      ],
      "not": {"anyOf": [
        {"required": ["category"]}, {"required": ["exclusion_reason"]},
        {"required": ["exclusion_detail"]}, {"required": ["native_env_hash"]}
      ]}
    },
    "simbenchExcluded": {
      "properties": {
        "roster_source": {"const": "simbench_bw"},
        "resolution_status": {"const": "excluded"},
        "binary": {"const": null}, "app_args": {"const": null},
        "shape_point": {"const": null}, "binary_present": {"const": false},
        "exclusion_reason": {
          "enum": [
            "arch_gate", "semantic_mismatch", "trace_unsupported",
            "repeatability_failed", "correctness_failed",
            "calibration_inconclusive", "host_capacity_deferred"
          ]
        }
      },
      "required": ["exclusion_reason", "exclusion_detail"],
      "not": {"anyOf": [
        {"required": ["binary_sha256"]}, {"required": ["shape_file_sha256"]},
        {"required": ["shape_binding_kind"]}, {"required": ["build_input_set_sha256"]},
        {"required": ["build_witness_sha256"]}, {"required": ["build_witness_row_sha256"]},
        {"required": ["category"]}, {"required": ["native_env_hash"]}
      ]}
    },
    "solRunnable": {
      "properties": {
        "roster_source": {"const": "sol_execbench"},
        "resolution_status": {"const": "runnable"},
        "binary": {"type": "string", "minLength": 1},
        "app_args": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "shape_point": {"type": "string", "minLength": 1},
        "binary_present": {"const": true}, "binary_sha256": {"const": null},
        "category": {"type": "string", "minLength": 1},
        "native_env_hash": {"type": "string", "minLength": 1}
      },
      "required": ["category", "binary_sha256", "native_env_hash"],
      "not": {"anyOf": [
        {"required": ["shape_file_sha256"]}, {"required": ["shape_binding_kind"]},
        {"required": ["build_input_set_sha256"]}, {"required": ["build_witness_sha256"]},
        {"required": ["build_witness_row_sha256"]}, {"required": ["exclusion_reason"]},
        {"required": ["exclusion_detail"]}
      ]}
    },
    "solExcluded": {
      "properties": {
        "roster_source": {"const": "sol_execbench"},
        "resolution_status": {"const": "excluded"},
        "binary": {"const": null}, "app_args": {"const": null},
        "shape_point": {"const": null}, "binary_present": {"const": false},
        "category": {"type": ["string", "null"]},
        "exclusion_reason": {
          "enum": [
            "arch_gate", "semantic_mismatch", "trace_unsupported",
            "repeatability_failed", "correctness_failed",
            "calibration_inconclusive", "host_capacity_deferred"
          ]
        }
      },
      "required": ["category", "exclusion_reason", "exclusion_detail"],
      "not": {"anyOf": [
        {"required": ["binary_sha256"]}, {"required": ["shape_file_sha256"]},
        {"required": ["shape_binding_kind"]}, {"required": ["build_input_set_sha256"]},
        {"required": ["build_witness_sha256"]}, {"required": ["build_witness_row_sha256"]}
      ]}
    }
  }
}

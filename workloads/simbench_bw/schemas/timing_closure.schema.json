{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simbench_bw/schemas/timing_closure.schema.json",
  "title": "Timing closure artifact",
  "description": "Final sm_86 timing closure state. The cycle headline may close success when the cycle gate passes. The deploy-ns leg closes only when the crosswalk allows a claim; otherwise it records a typed falsification and reports nanoseconds as clock-anchored intervals only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "arch",
    "source_commit",
    "cycle_terminal_state",
    "deploy_ns_terminal_state",
    "overall_terminal_state",
    "accuracy_report",
    "prediction_bundle",
    "crosswalk_artifact",
    "candidate_coverage_artifact",
    "cycle_accuracy",
    "deploy_ns",
    "deploy_ns_point_claimed",
    "candidate_coverage",
    "ns_intervals",
    "evidence_status"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "artifact_kind": {"type": "string", "const": "timing_closure"},
    "arch": {"type": "string", "const": "sm_86"},
    "source_commit": {"type": "string", "minLength": 1},
    "cycle_terminal_state": {"type": "string", "enum": ["research_success", "verdict_falsification"]},
    "deploy_ns_terminal_state": {"type": "string", "enum": ["research_success", "verdict_falsification"]},
    "overall_terminal_state": {"type": "string", "enum": ["research_success", "verdict_falsification"]},
    "accuracy_report": {"type": "string", "minLength": 1},
    "prediction_bundle": {"type": "string", "minLength": 1},
    "crosswalk_artifact": {"type": "string", "minLength": 1},
    "candidate_coverage_artifact": {"type": "string", "minLength": 1},
    "cycle_accuracy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scored_channel", "scores", "publication_gate", "result_kind"],
      "properties": {
        "scored_channel": {
          "type": "string",
          "const": "deployable_ridge_on_roofline_no_same_slug_substitution",
          "description": "The ONLY channel terminal states may derive from; the demoted same-slug diagnostic arm cannot drive closure."
        },
        "scores": {"type": "object"},
        "publication_gate": {
          "type": "object",
          "required": ["passes"],
          "properties": {"passes": {"type": "boolean"}},
          "additionalProperties": true
        },
        "result_kind": {"type": "string", "enum": ["publication_pass", "typed_unavailable"]}
      }
    },
    "deploy_ns": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_kind",
        "typed_reason",
        "crosswalk_claim_allowed",
        "point_result_claimed",
        "clock_uncertainty_fraction",
        "anchor_regime",
        "anchor_source",
        "sm_clock_ref_mhz"
      ],
      "properties": {
        "claim_kind": {"type": "string", "enum": ["deploy_ns_pass", "verdict_falsification"]},
        "typed_reason": {"type": ["string", "null"]},
        "crosswalk_claim_allowed": {"type": "boolean"},
        "point_result_claimed": {"type": "boolean", "const": false},
        "clock_uncertainty_fraction": {"type": "number", "exclusiveMinimum": 0},
        "anchor_regime": {"type": "string", "const": "short_burst"},
        "anchor_source": {"type": "string", "minLength": 1},
        "sm_clock_ref_mhz": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "deploy_ns_point_claimed": {"type": "boolean", "const": false},
    "candidate_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terminal_state",
        "prevents_overall_research_success",
        "typed_reason",
        "uncovered_required_families"
      ],
      "properties": {
        "terminal_state": {"type": "string", "enum": ["research_success", "verdict_falsification"]},
        "prevents_overall_research_success": {"type": "boolean"},
        "typed_reason": {"type": ["string", "null"]},
        "uncovered_required_families": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      }
    },
    "ns_intervals": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/interval"}
    },
    "evidence_status": {"type": "string", "enum": ["Offline-verified", "Verified-live-sm_86"]}
  },
  "allOf": [
    {
      "if": {"properties": {"deploy_ns_terminal_state": {"const": "verdict_falsification"}}},
      "then": {
        "properties": {
          "deploy_ns": {
            "properties": {
              "claim_kind": {"const": "verdict_falsification"},
              "crosswalk_claim_allowed": {"const": false},
              "typed_reason": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"cycle_terminal_state": {"const": "research_success"}}},
      "then": {
        "properties": {
          "cycle_accuracy": {
            "properties": {
              "scored_channel": {
                "const": "deployable_ridge_on_roofline_no_same_slug_substitution"
              },
              "publication_gate": {
                "properties": {"passes": {"const": true}}
              },
              "result_kind": {"const": "publication_pass"}
            },
            "required": ["scored_channel"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "candidate_coverage": {
            "properties": {
              "terminal_state": {"const": "verdict_falsification"},
              "prevents_overall_research_success": {"const": true}
            },
            "required": ["terminal_state", "prevents_overall_research_success"]
          }
        }
      },
      "then": {
        "properties": {
          "overall_terminal_state": {"const": "verdict_falsification"},
          "candidate_coverage": {
            "properties": {
              "typed_reason": {"type": "string", "minLength": 1},
              "uncovered_required_families": {"minItems": 1}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "shape_point",
        "regime",
        "predicted_cycles",
        "observed_ncu_ns_diagnostic",
        "lower_ns",
        "center_ns",
        "upper_ns"
      ],
      "properties": {
        "slug": {"type": "string", "minLength": 1},
        "shape_point": {"type": "string", "minLength": 1},
        "regime": {"type": "string", "enum": ["long"]},
        "predicted_cycles": {"type": "number", "exclusiveMinimum": 0},
        "observed_ncu_ns_diagnostic": {"type": "number", "exclusiveMinimum": 0},
        "lower_ns": {"type": "number", "exclusiveMinimum": 0},
        "center_ns": {"type": "number", "exclusiveMinimum": 0},
        "upper_ns": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "observation_contract",
  "description": "Per-count-metric counting-semantic contract discovered by live microfixtures. The replay-count producer implements ONLY pinned semantics; the lockstep validator refuses to score metrics without a pinned entry (closed-world, fail-closed).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "arch",
    "n_repeats",
    "geometry",
    "build",
    "fixtures",
    "metrics",
    "summary"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_kind": {"const": "observation_contract"},
    "arch": {"type": "string", "minLength": 1},
    "device": {"type": "string"},
    "driver_version": {"type": "string"},
    "ncu_version": {"type": "string"},
    "n_repeats": {"type": "integer", "minimum": 5},
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocks", "threads_per_block", "warps", "inst_unroll"],
      "properties": {
        "blocks": {"type": "integer", "minimum": 1},
        "threads_per_block": {"type": "integer", "minimum": 32},
        "warps": {"type": "integer", "minimum": 1},
        "inst_unroll": {"type": "integer", "minimum": 1}
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nvcc_arch", "source_sha256", "binary_sha256"],
      "properties": {
        "nvcc_arch": {"type": "string"},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "args", "sass_witness", "observed"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "args": {"type": "array", "items": {"type": "string"}},
          "sass_witness": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kernel", "opcode_counts"],
            "properties": {
              "kernel": {"type": "string"},
              "opcode_counts": {
                "type": "object",
                "additionalProperties": {"type": "integer", "minimum": 0}
              }
            }
          },
          "observed": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {"type": "number"}
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "enum": [
              "pinned",
              "contract_mismatch",
              "contract_underdetermined",
              "no_expressible_fixture"
            ]
          },
          "semantic": {"type": ["string", "null"]},
          "semantic_scope": {"type": "string"},
          "scope_note": {"type": "string"},
          "note": {"type": "string"},
          "included_pipes": {
            "type": "array",
            "items": {"type": "string"}
          },
          "evidence": {"type": "array"},
          "contamination_gates": {"type": "array"},
          "scope_probes": {"type": "array"},
          "observed_deltas": {"type": "array"}
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "pinned"}}},
            "then": {
              "required": ["semantic"],
              "properties": {"semantic": {"type": "string", "minLength": 1}}
            }
          }
        ]
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "n_metrics",
        "n_pinned",
        "n_no_expressible_fixture",
        "n_contract_mismatch",
        "n_contract_underdetermined"
      ],
      "properties": {
        "n_metrics": {"type": "integer", "minimum": 1},
        "n_pinned": {"type": "integer", "minimum": 0},
        "n_no_expressible_fixture": {"type": "integer", "minimum": 0},
        "n_contract_mismatch": {"type": "integer", "minimum": 0},
        "n_contract_underdetermined": {"type": "integer", "minimum": 0}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simbench_bw/schemas/ncu_launch_execution_identity.schema.json",
  "title": "NCU launch-set target execution identity v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "executable_sha256",
    "runtime_module_sha256s",
    "process_context_stream_policy",
    "identity_sha256"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "ncu_launch_set_execution_identity_v1"
    },
    "executable_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "runtime_module_sha256s": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2147483646,
      "items": {
        "$ref": "#/$defs/sha256"
      }
    },
    "process_context_stream_policy": {
      "type": "string",
      "const": "report_local_first_occurrence_equivalence_v1"
    },
    "identity_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simbench_bw/schemas/sharing_locality.schema.json",
  "title": "GPU-Shalom Sharing-Locality Bundle (per-kernel-per-launch)",
  "description": "One bundle per (slug, shape_point, binary_sha256, source_commit, kernel_signature_sha256) tuple. Implements original-plan sharing-locality clause: three GROUNDED classes computed directly from trace evidence (intra_lane, intra_warp, inter_warp_same_cta) plus four PROJECTED classes (inter_cta_same_sm, inter_cta_cross_sm, sequential_kernel, private_cold) that are NOT directly observable from a single threadblock trace. Projected classes either carry `provenance=\"projection\"` with explicit `projection_inputs`, or land as typed-unavailable with the appropriate `*_projection_required` typed reason. The original-plan sharing-locality clause negative invariant is enforced by the schema: a projected-class record cannot carry `provenance=\"grounded\"`; class_name + provenance combinations are bound by the per-record oneOf branches. Every closed branch uses `additionalProperties: false`.",
  "schema_version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_kind",
    "manifest_pairing_index",
    "device",
    "grounded",
    "projected",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "result_kind": {
      "type": "string",
      "enum": [
        "ok"
      ]
    },
    "manifest_pairing_index": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "shape_point",
        "binary_sha256",
        "source_commit",
        "kernel_signature_sha256"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "shape_point": {
          "type": "string",
          "minLength": 1
        },
        "binary_sha256": {
          "type": "string"
        },
        "source_commit": {
          "type": "string"
        },
        "kernel_signature_sha256": {
          "type": "string"
        },
        "source_commit_override_from": {
          "type": "string",
          "description": "Audit annotation: the MPI source_commit value BEFORE refresh_predictor_trace_source_commit.py overwrote it. Optional; present only when the refresh utility actually rewrote the source_commit. Distinct from the bundle's top-level source_commit_override_from (which audits the trace JSON's source_commit, not the MPI's)."
        }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_name",
        "compute_capability_major",
        "compute_capability_minor",
        "sm_count"
      ],
      "properties": {
        "device_name": {
          "type": "string"
        },
        "compute_capability_major": {
          "type": "integer",
          "minimum": 0
        },
        "compute_capability_minor": {
          "type": "integer",
          "minimum": 0
        },
        "sm_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "grounded": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/grounded_record"
      }
    },
    "projected": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/projected_record"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_record"
      }
    }
  },
  "$defs": {
    "grounded_class_name": {
      "type": "string",
      "enum": [
        "intra_lane",
        "intra_warp",
        "inter_warp_same_cta"
      ]
    },
    "projected_class_name": {
      "type": "string",
      "enum": [
        "inter_cta_same_sm",
        "inter_cta_cross_sm",
        "sequential_kernel",
        "private_cold"
      ]
    },
    "typed_reason": {
      "type": "string",
      "enum": [
        "intra_lane_unobservable",
        "intra_warp_unobservable",
        "inter_warp_same_cta_unobservable",
        "inter_cta_same_sm_projection_required",
        "inter_cta_cross_sm_projection_required",
        "sequential_kernel_projection_required",
        "private_cold_projection_required"
      ]
    },
    "grounded_record": {
      "oneOf": [
        {
          "title": "Admitted grounded class",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result_kind",
            "class_name",
            "provenance",
            "reuse_count",
            "distinct_pair_count",
            "fraction",
            "low_confidence"
          ],
          "properties": {
            "result_kind": {
              "const": "ok"
            },
            "class_name": {
              "$ref": "#/$defs/grounded_class_name"
            },
            "provenance": {
              "const": "grounded"
            },
            "reuse_count": {
              "type": "integer",
              "minimum": 0
            },
            "distinct_pair_count": {
              "type": "integer",
              "minimum": 0
            },
            "fraction": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "low_confidence": {
              "type": "boolean"
            }
          }
        },
        {
          "title": "Typed-unavailable grounded class",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result_kind",
            "class_name",
            "typed_reason",
            "provenance"
          ],
          "properties": {
            "result_kind": {
              "const": "typed_unavailable"
            },
            "class_name": {
              "$ref": "#/$defs/grounded_class_name"
            },
            "typed_reason": {
              "$ref": "#/$defs/typed_reason"
            },
            "provenance": {
              "const": "grounded"
            }
          }
        }
      ]
    },
    "projected_record": {
      "oneOf": [
        {
          "title": "Admitted projected class",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result_kind",
            "class_name",
            "provenance",
            "projection_inputs",
            "reuse_count",
            "distinct_pair_count",
            "fraction",
            "low_confidence"
          ],
          "properties": {
            "result_kind": {
              "const": "ok"
            },
            "class_name": {
              "$ref": "#/$defs/projected_class_name"
            },
            "provenance": {
              "const": "projection"
            },
            "projection_inputs": {
              "type": "object",
              "description": "Documents the projection assumptions used: e.g. an SM-residency map, a kernel-ordering trace, or a global-view scope. The schema does not constrain the shape because each projection family carries its own inputs; future round-added projections can extend this object."
            },
            "reuse_count": {
              "type": "integer",
              "minimum": 0
            },
            "distinct_pair_count": {
              "type": "integer",
              "minimum": 0
            },
            "fraction": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "low_confidence": {
              "type": "boolean"
            }
          }
        },
        {
          "title": "Typed-unavailable projected class",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result_kind",
            "class_name",
            "typed_reason",
            "provenance"
          ],
          "properties": {
            "result_kind": {
              "const": "typed_unavailable"
            },
            "class_name": {
              "$ref": "#/$defs/projected_class_name"
            },
            "typed_reason": {
              "$ref": "#/$defs/typed_reason"
            },
            "provenance": {
              "const": "projection"
            }
          }
        }
      ]
    },
    "evidence_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_kind",
        "note_kind"
      ],
      "properties": {
        "result_kind": {
          "const": "info"
        },
        "note_kind": {
          "type": "string",
          "enum": [
            "sharing_locality_pair_count_summary"
          ]
        },
        "total_pairs": {
          "type": "integer",
          "minimum": 0
        },
        "addresses_observed": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "v5 cohort staging manifest",
  "description": "Operator-facing manifest of the same-74 (= 50 admitted + 24 excluded) cohort's staging state. Each row records a cell's artifact inventory and a closed-enum suggested_operator_action. Root causes for the three actions that carry them (BUNDLE_TYPED_UNAVAILABLE, BUNDLE_NON_SCALAR, TERMINAL_TYPED_FAILURE) live in the separate action_typed_reason field; the legacy single-field colon-form (e.g., BUNDLE_TYPED_UNAVAILABLE:cache_model_underconfigured) is rejected at parse time. Summary aggregates ready_count / terminal_typed_failure_count / legacy_bundle_quarantined for the closure invariants. Produced by tools/local_labels/emit_v5_cohort_staging_manifest.py.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "source_commit",
    "cohort_size",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "source_commit": {
      "type": "string",
      "pattern": "^(unknown|[0-9a-f]{40})$",
      "description": "git rev-parse HEAD at emission time, or 'unknown' when git is unavailable."
    },
    "cohort_size": {
      "type": "integer",
      "minimum": 0
    },
    "rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "operator_notes": {
      "type": "string"
    }
  },
  "$defs": {
    "operator_action_enum": {
      "type": "string",
      "enum": [
        "READY",
        "REBUILD_BINARY_LOCAL",
        "REBUILD_TRACE_LOCAL",
        "REGENERATE_SIDECARS_LOCAL",
        "REBUILD_BUNDLE_LOCAL",
        "BUNDLE_TYPED_UNAVAILABLE",
        "BUNDLE_NON_SCALAR",
        "CROSS_HOST_SCP",
        "CROSS_HOST_SCP_SIDECARS",
        "TERMINAL_TYPED_FAILURE"
      ],
      "description": "The closed enum. The legacy colon-form value (e.g., BUNDLE_TYPED_UNAVAILABLE:cache_model_underconfigured) is not in this enum and fails schema validation; root causes live in action_typed_reason."
    },
    "row": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "arch",
        "slug",
        "shape_point",
        "predictor_bundle",
        "artifacts",
        "suggested_operator_action"
      ],
      "properties": {
        "arch": {
          "type": "string",
          "enum": ["sm_86", "sm_120"]
        },
        "slug": { "type": "string", "minLength": 1 },
        "shape_point": { "type": "string", "minLength": 1 },
        "predictor_bundle": {
          "type": "object",
          "required": ["present", "paths"],
          "properties": {
            "present": { "type": "boolean" },
            "paths": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "artifacts": {
          "type": "object",
          "required": [
            "sharing_locality",
            "hrd_profile",
            "sector_stream",
            "dynamic_trace_pb"
          ],
          "properties": {
            "sharing_locality": { "$ref": "#/$defs/artifact_state" },
            "hrd_profile": { "$ref": "#/$defs/artifact_state" },
            "sector_stream": { "$ref": "#/$defs/artifact_state" },
            "dynamic_trace_pb": { "$ref": "#/$defs/artifact_state" }
          }
        },
        "suggested_operator_action": { "$ref": "#/$defs/operator_action_enum" },
        "action_typed_reason": {
          "type": ["string", "null"],
          "description": "Root-cause token when action carries a typed reason. Required-non-null when action in {BUNDLE_TYPED_UNAVAILABLE, BUNDLE_NON_SCALAR, TERMINAL_TYPED_FAILURE}; null or absent otherwise."
        },
        "legacy_bundle_quarantined_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Per-cell stale-bundle quarantine count: number of legacy predictor bundles on disk with same (slug, shape_point) but mismatched binary_sha256 / source_commit / kernel_signature_sha256 against this cell's label identity. 0 for cells with no legacy candidates or for excluded cells."
        }
      },
      "allOf": [
        {
          "description": "Action carrying a typed reason MUST have a non-null action_typed_reason value.",
          "if": {
            "properties": {
              "suggested_operator_action": {
                "enum": [
                  "BUNDLE_TYPED_UNAVAILABLE",
                  "BUNDLE_NON_SCALAR",
                  "TERMINAL_TYPED_FAILURE"
                ]
              }
            },
            "required": ["suggested_operator_action"]
          },
          "then": {
            "required": ["action_typed_reason"],
            "properties": {
              "action_typed_reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "description": "Action without a typed reason MUST have action_typed_reason null or absent.",
          "if": {
            "properties": {
              "suggested_operator_action": {
                "enum": [
                  "READY",
                  "REBUILD_BINARY_LOCAL",
                  "REBUILD_TRACE_LOCAL",
                  "REGENERATE_SIDECARS_LOCAL",
                  "REBUILD_BUNDLE_LOCAL",
                  "CROSS_HOST_SCP",
                  "CROSS_HOST_SCP_SIDECARS"
                ]
              }
            },
            "required": ["suggested_operator_action"]
          },
          "then": {
            "properties": {
              "action_typed_reason": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "artifact_state": {
      "type": "object",
      "required": ["present"],
      "properties": {
        "present": { "type": "boolean" },
        "path": { "type": ["string", "null"] }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "by_action",
        "ready_count",
        "terminal_typed_failure_count",
        "legacy_bundle_quarantined"
      ],
      "properties": {
        "by_action": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "ready_count": { "type": "integer", "minimum": 0 },
        "terminal_typed_failure_count": { "type": "integer", "minimum": 0 },
        "legacy_bundle_quarantined": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of stale-MPI legacy bundle FILES across all admitted cells (sum of per-row legacy_bundle_quarantined_count values). A cell with 38 stale bundles contributes 38 to this total, not 1."
        }
      }
    }
  }
}

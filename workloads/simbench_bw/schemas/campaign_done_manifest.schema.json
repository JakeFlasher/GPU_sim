{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simbench_bw/schemas/campaign_done_manifest.schema.json",
  "title": "sm_86 capture chunk DONE manifest",
  "description": "Schema v2 is a non-vacuous resume seal. For Round-28+ manifests it pins one matrix seal and one capture-admission preflight for the entire chunk, records every admitted runner invocation, accounts for every member with one closed disposition, hashes the required artifacts, requires the exact SOL_DEF_EQUIV_V2 block and named native-environment evidence for SOL cells, records preparation-failure back-references, and can only represent a clean one-commit capture. Consumers must additionally call campaign_done_manifest.verify_seal() to rehash files and re-derive per-cell admission binding, capture-supersession and preparation-archive ledger closure, V2 source/staged definition SHA joins, normalized-pointer eligibility, SOL native-environment identity, AC-9 routing, and other cross-file relationships that JSON Schema cannot express. The verifier contains one exact-manifest compatibility allowlist for the sealed Round-27 portable bootstrap.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_kind",
    "chunk_id",
    "chunk_membership_sha256",
    "arch",
    "generated_at_utc",
    "command",
    "source_commit_pre",
    "source_commit_post",
    "source_head_at_seal",
    "source_commit_stable",
    "working_tree_clean",
    "protocol_version",
    "tool_versions",
    "pins_sha256",
    "roster_authority_sha256",
    "trace_budget_sha256",
    "capture_matrix_sha256",
    "matrix_seal_sha256",
    "preflight_sha256",
    "admission",
    "input_paths",
    "output_root",
    "expected_cells",
    "counts",
    "chunk_membership",
    "cell_results",
    "typed_failures"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "manifest_kind": {"type": "string", "const": "campaign_chunk_done"},
    "chunk_id": {"type": "string", "minLength": 1},
    "chunk_membership_sha256": {"$ref": "#/$defs/sha256"},
    "arch": {"type": "string", "minLength": 1},
    "generated_at_utc": {"type": ["string", "null"]},
    "command": {"type": "string", "minLength": 1},
    "source_commit_pre": {"$ref": "#/$defs/commit"},
    "source_commit_post": {"$ref": "#/$defs/commit"},
    "source_head_at_seal": {"$ref": "#/$defs/commit"},
    "source_commit_stable": {"const": true},
    "working_tree_clean": {"const": true},
    "protocol_version": {"type": "string", "minLength": 1},
    "tool_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ncu", "driver", "nvcc", "nvbit"],
      "properties": {
        "ncu": {"type": "string", "minLength": 1},
        "driver": {"type": "string", "minLength": 1},
        "nvcc": {"type": "string", "minLength": 1},
        "nvbit": {"type": "string", "minLength": 1}
      }
    },
    "pins_sha256": {"$ref": "#/$defs/sha256"},
    "roster_authority_sha256": {"$ref": "#/$defs/sha256"},
    "trace_budget_sha256": {"$ref": "#/$defs/sha256"},
    "capture_matrix_sha256": {"$ref": "#/$defs/sha256"},
    "matrix_seal_sha256": {"$ref": "#/$defs/sha256"},
    "preflight_sha256": {"$ref": "#/$defs/sha256"},
    "admission": {"$ref": "#/$defs/admission"},
    "input_paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pins", "roster_authority", "trace_budget", "capture_matrix", "preflight"
      ],
      "properties": {
        "pins": {"type": "string", "minLength": 1},
        "roster_authority": {"type": "string", "minLength": 1},
        "trace_budget": {"type": "string", "minLength": 1},
        "capture_matrix": {"type": "string", "minLength": 1},
        "preflight": {"type": "string", "minLength": 1}
      }
    },
    "output_root": {"type": "string", "minLength": 1},
    "expected_cells": {"type": "integer", "minimum": 1},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["admitted", "excluded", "failed"],
      "properties": {
        "admitted": {"type": "integer", "minimum": 0},
        "excluded": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0}
      }
    },
    "chunk_membership": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/member"}
    },
    "cell_results": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/cellResult"}
    },
    "typed_failures": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/typedFailure"}
    }
  },
  "$defs": {
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rosterSource": {
      "type": "string",
      "enum": ["portable_lcd", "simbench_bw", "sol_execbench"]
    },
    "typedReason": {
      "type": "string",
      "enum": [
        "arch_gate",
        "semantic_mismatch",
        "trace_unsupported",
        "repeatability_failed",
        "correctness_failed",
        "calibration_inconclusive",
        "host_capacity_deferred"
      ]
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preflight_generated_at_utc", "capture_invocations"],
      "properties": {
        "preflight_generated_at_utc": {"type": "string", "minLength": 1},
        "capture_invocations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["run_id", "admitted_at_utc"],
            "properties": {
              "run_id": {"type": "string", "minLength": 1},
              "admitted_at_utc": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roster_source", "slug", "authority_cell_sha256"],
      "properties": {
        "roster_source": {"$ref": "#/$defs/rosterSource"},
        "slug": {"type": "string", "minLength": 1},
        "authority_cell_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_kind", "relative_path", "sha256", "size_bytes"],
      "properties": {
        "artifact_kind": {
          "type": "string",
          "enum": [
            "label_sidecar",
            "label_run_manifest",
            "ncu_report",
            "ncu_launch_observation",
            "trace_manifest",
            "trace_root",
            "trace_stats",
            "trace_threadblock",
            "trace_auxiliary",
            "trace_route_record",
            "sol_capture_evidence",
            "control_evidence",
            "control_bits",
            "control_manifest",
            "cell_result",
            "execution_log"
          ]
        },
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "cellResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roster_source", "slug", "authority_cell_sha256", "disposition",
        "typed_reason", "detail", "capture_preflight_sha256",
        "capture_started_at_utc", "admission_run_id", "supersedes",
        "prior_preparation_failures", "prior_capture_defect_attempts",
        "definition_equivalence",
        "definition_equivalence_attestation_sha256", "artifacts"
      ],
      "properties": {
        "roster_source": {"$ref": "#/$defs/rosterSource"},
        "slug": {"type": "string", "minLength": 1},
        "authority_cell_sha256": {"$ref": "#/$defs/sha256"},
        "disposition": {
          "type": "string",
          "enum": ["admitted", "excluded", "failed"]
        },
        "typed_reason": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/typedReason"}
          ]
        },
        "detail": {"type": ["string", "null"]},
        "capture_preflight_sha256": {"$ref": "#/$defs/sha256"},
        "capture_started_at_utc": {"type": "string", "minLength": 1},
        "admission_run_id": {"type": "string", "minLength": 1},
        "supersedes": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/supersedes"}
          ]
        },
        "prior_preparation_failures": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/priorPreparationFailure"}
        },
        "prior_capture_defect_attempts": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/priorCaptureDefectAttempt"}
        },
        "definition_equivalence": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/definitionEquivalenceAttestation"}
          ]
        },
        "definition_equivalence_attestation_sha256": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/sha256"}
          ]
        },
        "artifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/artifact"},
          "contains": {
            "properties": {"artifact_kind": {"const": "cell_result"}},
            "required": ["artifact_kind"]
          },
          "minContains": 1,
          "maxContains": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"roster_source": {"const": "sol_execbench"}},
            "required": ["roster_source"]
          },
          "then": {
            "properties": {
              "definition_equivalence": {
                "$ref": "#/$defs/definitionEquivalenceAttestation"
              },
              "definition_equivalence_attestation_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          },
          "else": {
            "properties": {
              "definition_equivalence": {"type": "null"},
              "definition_equivalence_attestation_sha256": {"type": "null"}
            }
          }
        },
        {
          "if": {
            "properties": {"disposition": {"const": "admitted"}},
            "required": ["disposition"]
          },
          "then": {
            "properties": {
              "typed_reason": {"type": "null"},
              "artifacts": {
                "minItems": 11,
                "allOf": [
                  {"contains": {"properties": {"artifact_kind": {"const": "label_sidecar"}}, "required": ["artifact_kind"]}},
                  {"contains": {"properties": {"artifact_kind": {"const": "label_run_manifest"}}, "required": ["artifact_kind"]}},
                  {"contains": {"properties": {"artifact_kind": {"const": "ncu_report"}}, "required": ["artifact_kind"]}},
                  {"contains": {"properties": {"artifact_kind": {"const": "ncu_launch_observation"}}, "required": ["artifact_kind"]}, "minContains": 1, "maxContains": 1},
                  {"contains": {"properties": {"artifact_kind": {"const": "trace_manifest"}}, "required": ["artifact_kind"]}},
                  {"contains": {"properties": {"artifact_kind": {"const": "trace_root"}}, "required": ["artifact_kind"]}},
                  {"contains": {"properties": {"artifact_kind": {"const": "trace_stats"}}, "required": ["artifact_kind"]}},
                  {"contains": {"properties": {"artifact_kind": {"const": "trace_threadblock"}}, "required": ["artifact_kind"]}},
                  {"contains": {"properties": {"artifact_kind": {"const": "control_bits"}}, "required": ["artifact_kind"]}},
                  {"contains": {"properties": {"artifact_kind": {"const": "control_manifest"}}, "required": ["artifact_kind"]}},
                  {"contains": {"properties": {"artifact_kind": {"const": "cell_result"}}, "required": ["artifact_kind"]}}
                ]
              }
            }
          },
          "else": {
            "properties": {"typed_reason": {"$ref": "#/$defs/typedReason"}}
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {"const": "failed"},
              "typed_reason": {"const": "trace_unsupported"}
            },
            "required": ["disposition", "typed_reason"]
          },
          "then": {
            "properties": {
              "artifacts": {
                "minItems": 10,
                "allOf": [
                  {"contains": {"properties": {"artifact_kind": {"const": "label_sidecar"}}, "required": ["artifact_kind"]}},
                  {"contains": {"properties": {"artifact_kind": {"const": "label_run_manifest"}}, "required": ["artifact_kind"]}},
                  {"contains": {"properties": {"artifact_kind": {"const": "ncu_report"}}, "required": ["artifact_kind"]}},
                  {"contains": {"properties": {"artifact_kind": {"const": "ncu_launch_observation"}}, "required": ["artifact_kind"]}, "minContains": 1, "maxContains": 1},
                  {"contains": {"properties": {"artifact_kind": {"const": "trace_manifest"}}, "required": ["artifact_kind"]}},
                  {"contains": {"properties": {"artifact_kind": {"const": "trace_auxiliary"}}, "required": ["artifact_kind"]}},
                  {"contains": {"properties": {"artifact_kind": {"const": "trace_route_record"}}, "required": ["artifact_kind"]}},
                  {"contains": {"properties": {"artifact_kind": {"const": "control_bits"}}, "required": ["artifact_kind"]}},
                  {"contains": {"properties": {"artifact_kind": {"const": "control_manifest"}}, "required": ["artifact_kind"]}},
                  {"contains": {"properties": {"artifact_kind": {"const": "cell_result"}}, "required": ["artifact_kind"]}}
                ]
              }
            }
          }
        },
        {
          "if": {
            "allOf": [
              {
                "properties": {"roster_source": {"const": "sol_execbench"}},
                "required": ["roster_source"]
              },
              {
                "anyOf": [
                  {
                    "properties": {"disposition": {"const": "admitted"}},
                    "required": ["disposition"]
                  },
                  {
                    "properties": {
                      "disposition": {"const": "failed"},
                      "typed_reason": {"const": "trace_unsupported"}
                    },
                    "required": ["disposition", "typed_reason"]
                  }
                ]
              }
            ]
          },
          "then": {
            "properties": {
              "artifacts": {
                "contains": {
                  "properties": {
                    "artifact_kind": {"const": "sol_capture_evidence"},
                    "relative_path": {
                      "pattern": "(^|/)sol_native_env_fingerprint[.]json$"
                    }
                  },
                  "required": ["artifact_kind", "relative_path"]
                },
                "minContains": 1,
                "maxContains": 1
              }
            }
          }
        }
      ]
    },
    "supersedes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ledger_entry_id", "superseded_preflight_sha256", "superseded_path"
      ],
      "properties": {
        "ledger_entry_id": {"$ref": "#/$defs/sha256"},
        "superseded_preflight_sha256": {"$ref": "#/$defs/sha256"},
        "superseded_path": {"type": "string", "minLength": 1}
      }
    },
    "priorPreparationFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ledger_entry_id", "ledger_path", "archive_path"],
      "properties": {
        "ledger_entry_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "ledger_path": {"type": "string", "minLength": 1, "pattern": "^/"},
        "archive_path": {"type": "string", "minLength": 1, "pattern": "^/"}
      }
    },
    "priorCaptureDefectAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ledger_entry_id", "ledger_path", "archive_path", "original_head",
        "reason_code"
      ],
      "properties": {
        "ledger_entry_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "ledger_path": {"type": "string", "minLength": 1, "pattern": "^/"},
        "archive_path": {"type": "string", "minLength": 1, "pattern": "^/"},
        "original_head": {"$ref": "#/$defs/commit"},
        "reason_code": {
          "const": "CAPTURE_DRIVER_INTEGRITY_FALSE_POSITIVE_BEFORE_ROI"
        }
      }
    },
    "definitionEquivalenceAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id", "result", "source_definition_sha256",
        "staged_definition_sha256", "top_level_field_states",
        "axes_container_state", "axis_description_states"
      ],
      "oneOf": [
        {
          "required": [
            "tensor_container_states", "tensor_description_states"
          ]
        },
        {
          "not": {
            "anyOf": [
              {"required": ["tensor_container_states"]},
              {"required": ["tensor_description_states"]}
            ]
          }
        }
      ],
      "properties": {
        "rule_id": {"type": "string", "const": "SOL_DEF_EQUIV_V2"},
        "result": {"type": "string", "const": "equal"},
        "source_definition_sha256": {"$ref": "#/$defs/sha256"},
        "staged_definition_sha256": {"$ref": "#/$defs/sha256"},
        "top_level_field_states": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hf_id", "op_type", "custom_inputs_entrypoint"],
          "properties": {
            "hf_id": {"$ref": "#/$defs/topLevelDefinitionState"},
            "op_type": {"$ref": "#/$defs/topLevelDefinitionState"},
            "custom_inputs_entrypoint": {
              "$ref": "#/$defs/topLevelDefinitionState"
            }
          }
        },
        "axes_container_state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "staged"],
          "properties": {
            "source": {"$ref": "#/$defs/axesContainerState"},
            "staged": {"$ref": "#/$defs/axesContainerState"}
          }
        },
        "axis_description_states": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/axisDefinitionState"}
        },
        "tensor_container_states": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inputs", "outputs"],
          "properties": {
            "inputs": {"$ref": "#/$defs/tensorContainerState"},
            "outputs": {"$ref": "#/$defs/tensorContainerState"}
          }
        },
        "tensor_description_states": {
          "type": "object",
          "propertyNames": {
            "pattern": "^/(inputs|outputs)/([^~/]|~[01])*/description$"
          },
          "additionalProperties": {"$ref": "#/$defs/tensorDefinitionState"}
        }
      }
    },
    "definitionStateBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source", "staged", "source_normalized", "staged_normalized"
      ],
      "properties": {
        "source": {},
        "staged": {},
        "source_normalized": {"type": "boolean"},
        "staged_normalized": {"type": "boolean"}
      }
    },
    "topLevelDefinitionState": {
      "allOf": [
        {"$ref": "#/$defs/definitionStateBase"},
        {
          "type": "object",
          "properties": {
            "source": {"$ref": "#/$defs/topLevelStateValue"},
            "staged": {"$ref": "#/$defs/topLevelStateValue"}
          }
        }
      ]
    },
    "axisDefinitionState": {
      "allOf": [
        {"$ref": "#/$defs/definitionStateBase"},
        {
          "type": "object",
          "properties": {
            "source": {"$ref": "#/$defs/axisStateValue"},
            "staged": {"$ref": "#/$defs/axisStateValue"}
          }
        }
      ]
    },
    "tensorDefinitionState": {
      "allOf": [
        {"$ref": "#/$defs/definitionStateBase"},
        {
          "type": "object",
          "properties": {
            "source": {"$ref": "#/$defs/tensorStateValue"},
            "staged": {"$ref": "#/$defs/tensorStateValue"}
          }
        }
      ]
    },
    "topLevelStateValue": {
      "type": "string",
      "enum": [
        "missing", "null", "empty_string", "nonempty_string", "non_string"
      ]
    },
    "axisStateValue": {
      "type": "string",
      "enum": [
        "missing", "null", "empty_string", "nonempty_string", "non_string",
        "axis_not_object"
      ]
    },
    "tensorStateValue": {
      "type": "string",
      "enum": [
        "missing", "null", "empty_string", "nonempty_string", "non_string",
        "tensor_not_object"
      ]
    },
    "tensorContainerState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "staged"],
      "properties": {
        "source": {"$ref": "#/$defs/axesContainerState"},
        "staged": {"$ref": "#/$defs/axesContainerState"}
      }
    },
    "axesContainerState": {
      "type": "string",
      "enum": ["object", "missing", "non_object"]
    },
    "typedFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roster_source", "slug", "typed_reason", "detail"],
      "properties": {
        "roster_source": {"$ref": "#/$defs/rosterSource"},
        "slug": {"type": "string", "minLength": 1},
        "typed_reason": {"$ref": "#/$defs/typedReason"},
        "detail": {"type": ["string", "null"]}
      }
    }
  }
}

    },
    "cross_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cross_check_id",
        "instrument",
        "artifact",
        "verdict_artifact",
        "verdict",
        "fitted",
        "candidate_model_seal_sha256",
        "derived",
        "selected",
        "tuned",
        "transcribed"
      ],
      "properties": {
        "cross_check_id": {
          "$ref": "#/$defs/safe_id"
        },
        "instrument": {
          "const": "NCU"
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "verdict_artifact": {
          "$ref": "#/$defs/artifact"

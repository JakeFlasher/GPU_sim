        "verdict": {
          "enum": [
            "CONSISTENT",
            "INCONSISTENT",
            "INCONCLUSIVE",
            "NOT_APPLICABLE"
          ]
        },
        "fitted": {
          "const": false
        },
        "derived": {
          "const": false
        },
        "selected": {
          "const": false
        },
        "tuned": {
          "const": false
        },
        "transcribed": {
          "const": false
        },
        "candidate_model_seal_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "readout": {

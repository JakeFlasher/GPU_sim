{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpu-simulator.invalid/schemas/m5_calibration_result.v2.schema.json",
  "title": "M5 calibration immutable RESULT manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "run_model_seal_sha256",
    "source_commit",
    "family_execution_order",
    "family_scientific_rank",
    "quantity_results",
    "authenticity",
    "components",
    "counts",
    "model_seal_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "artifact_kind": {
      "const": "M5_RESULT"
    },
    "run_model_seal_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "family_execution_order": {
      "$ref": "#/$defs/execution_order"
    },
    "family_scientific_rank": {
      "$ref": "#/$defs/scientific_rank"
    },
    "quantity_results": {
      "type": "array",
      "minItems": 31,
      "maxItems": 31,
      "items": {
        "$ref": "#/$defs/quantity_result"
      }
    },
    "authenticity": {
      "$ref": "#/$defs/authenticity"
    },
    "components": {
      "$ref": "#/$defs/components"
    },
    "counts": {
      "$ref": "#/$defs/counts"
    },
    "model_seal_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "safe_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"
    },
    "nonnegative_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positive_integer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "relative_path": {
      "type": "string",
      "pattern": "^(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "relative_path",
        "sha256",
        "size_bytes",
        "media_type"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/safe_id"
        },
        "relative_path": {
          "$ref": "#/$defs/relative_path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "execution_order": {
      "type": "array",
      "prefixItems": [
        {
          "const": "b"
        },
        {
          "const": "a"
        },
        {
          "const": "d"
        },
        {
          "const": "f"
        },
        {
          "const": "c"
        },
        {
          "const": "e"
        }
      ],
      "items": false,
      "minItems": 6,
      "maxItems": 6
    },
    "scientific_rank": {
      "type": "array",
      "prefixItems": [
        {
          "const": "b"
        },
        {
          "const": "f"
        },
        {
          "const": "a"
        },
        {
          "const": "d"
        },
        {
          "const": "c"
        },
        {
          "const": "e"
        }
      ],
      "items": false,
      "minItems": 6,
      "maxItems": 6
    },
    "probe_producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "family_id"
      ],
      "properties": {
        "kind": {
          "const": "PROBE_FAMILY"
        },
        "family_id": {
          "enum": [
            "a",
            "b",
            "c",
            "d",
            "e",
            "f"
          ]
        }
      }
    },
    "pchase_producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "component_id"
      ],
      "properties": {
        "kind": {
          "const": "PCHASE"
        },
        "component_id": {
          "const": "pchase"
        }
      }
    },
    "conditioning": {
      "type": "object",
      "additionalProperties": false,

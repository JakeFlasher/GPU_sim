              "maximum": 1
            },
            "readout_ids": {
              "type": "array",
              "minItems": 2,
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/safe_id"
              }
            }
          }
        },
        "gap_trigger": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "contradiction_evidence": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safe_id"
          }

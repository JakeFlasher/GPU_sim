    "agreement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "explicit",
        "methodologically_independent",
        "basis",
        "tolerance_fraction",
        "observed_max_relative_delta",
        "passed",
        "readout_ids",
        "independence_witness"
      ],
      "properties": {
        "explicit": {
          "const": true
        },
        "methodologically_independent": {
          "const": true
        },
        "basis": {
          "const": "MAX_RELATIVE_DELTA"
        },
        "tolerance_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "observed_max_relative_delta": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "passed": {
          "const": true
        },
        "readout_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safe_id"
          }

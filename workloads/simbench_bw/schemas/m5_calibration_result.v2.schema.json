          "properties": {
            "witness_version": {
              "const": 1
            },
            "readout_ids": {
              "type": "array",
              "minItems": 2,
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/safe_id"
              }
            },
            "raw_ancestry_disjoint": {
              "const": true
            },
            "estimator_forms_distinct": {
              "const": true
            },
            "mechanisms_distinct": {
              "const": true
            },
            "confounder_sets_disjoint": {
              "const": true
            },
            "falsification_rule": {
              "const": "MAX_RELATIVE_DELTA_WITHIN_AGREEMENT_LIMIT"
            }
          }
        }
      }
    },
    "measured": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value",

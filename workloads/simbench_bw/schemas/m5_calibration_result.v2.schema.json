        "source_lineage_id": {
          "$ref": "#/$defs/safe_id"
        },
        "evidence_artifact_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safe_id"

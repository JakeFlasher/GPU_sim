        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "variant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "modifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        }
      }
    },
    "nonempty_artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "curve",
        "control",
        "confound",
        "composition"

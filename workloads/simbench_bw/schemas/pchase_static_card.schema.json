{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "pchase_static_card",
  "description": "Counter-free per-arch static card from the clock64 pointer-chase probe suite. Every property is either a value record (value + dispersion + n_repeats + method + covariates, with optional step-detection bracket) or a typed geometry_unresolved record carrying the raw evidence \u2014 no profiler counters, no clock locking, NVML covariates are read-only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "arch",
    "device",
    "driver_version",
    "build",
    "analysis_config",
    "counter_free_note",
    "nvml_policy",
    "properties",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact_kind": {
      "const": "pchase_static_card"
    },
    "arch": {
      "type": "string",
      "minLength": 1
    },
    "device": {
      "type": "string",
      "minLength": 1
    },
    "driver_version": {
      "type": "string",
      "minLength": 1
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nvcc_arch",
        "source_sha256",
        "binary_sha256"
      ],
      "properties": {
        "nvcc_arch": {
          "type": "string"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "binary_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "analysis_config": {
      "type": "object"
    },
    "counter_free_note": {
      "type": "string",
      "minLength": 1
    },
    "nvml_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rejected_reason_mask",
        "sw_thermal_treatment",
        "active_clock_floor_mhz"
      ],
      "properties": {
        "rejected_reason_mask": {
          "type": "string"
        },
        "sw_thermal_treatment": {
          "type": "string"
        },
        "active_clock_floor_mhz": {
          "type": "number"
        }
      }
    },
    "properties": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "enum": [
              "value",
              "typed"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "value"
                }
              }
            },
            "then": {
              "required": [
                "value",
                "unit",
                "dispersion",
                "n_repeats",
                "method",
                "covariates"
              ],
              "properties": {
                "value": {
                  "type": "number"
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                },
                "dispersion": {
                  "type": "number",
                  "minimum": 0
                },
                "n_repeats": {
                  "type": "integer",
                  "minimum": 2
                },
                "method": {
                  "type": "string",
                  "minLength": 1
                },
                "covariates": {
                  "type": "object"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "typed"
                }
              }
            },
            "then": {
              "required": [
                "typed_reason",
                "method",
                "detail"
              ],
              "properties": {
                "typed_reason": {
                  "const": "geometry_unresolved"
                },
                "method": {
                  "type": "string",
                  "minLength": 1
                },
                "detail": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "n_properties",
        "n_typed_geometry_unresolved"
      ],
      "properties": {
        "n_properties": {
          "type": "integer",
          "minimum": 1
        },
        "n_typed_geometry_unresolved": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "supplemental_evidence": {
      "type": "object",
      "description": "Raw probe evidence blocks that support typed properties without being card properties themselves (the property contract is strictly value-or-typed).",
      "additionalProperties": {
        "type": "object"
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simbench_bw/schemas/predicted_fingerprint.schema.json",
  "title": "Predicted fingerprint (closed-object, synthetic-only)",
  "description": "Closed-object schema for a predicted fingerprint emitted by the synthetic V1-V8 variant generator and consumed by the pillar4 G1-G6 gate scaffold's synthetic-data path. The closed-object discipline (`additionalProperties: false` at every level) enforces the fixture-only contract STRUCTURALLY: any artifact under `golden/synthetic_pillar4_pilot/` whose JSON content contains an unknown field is rejected with `loop_a_alt4_unknown_field`. `data_provenance` is fixed at `synthetic`. Synthetic-only success on the gate scaffold MUST NOT be cited in any identifiability claim; aggregate ledgers that combine synthetic and measured cells without per-provenance stratification are rejected with `gate_aggregate_provenance_mixed`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "slug",
    "bug_id",
    "variant_id",
    "data_provenance",
    "claim_scope",
    "predicted_fingerprint_axes",
    "mechanism_citation",
    "synthetic_predictor_provenance"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "bug_id": {
      "type": "string",
      "pattern": "^m[0-9]{1,3}$",
      "description": "Bug identifier from the pre-registered bug suite. The synthetic pilot subset covers m1 (MSHR coalescing), m2 (L1 sector model), m10 (GTO scheduler)."
    },
    "variant_id": {
      "type": "string",
      "enum": [
        "predicted_fingerprint_V1",
        "predicted_fingerprint_V2",
        "predicted_fingerprint_V3",
        "predicted_fingerprint_V4",
        "predicted_fingerprint_V5",
        "predicted_fingerprint_V6",
        "predicted_fingerprint_V7",
        "predicted_fingerprint_V8"
      ],
      "description": "Variant identifier in the V1..V8 perturbation panel."
    },
    "data_provenance": {
      "type": "string",
      "const": "synthetic",
      "description": "Provenance class. Frozen at `synthetic` for every record this schema admits."
    },
    "claim_scope": {
      "type": "string",
      "enum": ["measured_local", "methodology_transfer_only", "deferred"],
      "description": "Cross-die claim-scope label. Predicted fingerprints typically use `measured_local` when the synthetic prediction targets the local single die; `methodology_transfer_only` is used when the prediction extrapolates to a die where no measurement is collected and an explicit transfer citation is provided."
    },
    "predicted_fingerprint_axes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kernel_feature_vector_predicted",
        "phase_cycle_ledger_predicted",
        "roofline_coordinate_predicted",
        "theta_vector_predicted"
      ],
      "properties": {
        "kernel_feature_vector_predicted": {
          "type": "object",
          "additionalProperties": false,
          "required": ["axes"],
          "properties": {
            "axes": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "dynamic_divergence_profile",
                "memory_access_stride_distribution",
                "per_thread_instruction_count_distribution",
                "static_sass_mnemonic_histogram",
                "register_usage_and_predication_density",
                "smid_migration_count"
              ],
              "properties": {
                "dynamic_divergence_profile": { "$ref": "#/$defs/predicted_axis_dynamic_divergence_profile" },
                "memory_access_stride_distribution": { "$ref": "#/$defs/predicted_axis_memory_access_stride_distribution" },
                "per_thread_instruction_count_distribution": { "$ref": "#/$defs/predicted_axis_per_thread_instruction_count_distribution" },
                "static_sass_mnemonic_histogram": { "$ref": "#/$defs/predicted_axis_static_sass_mnemonic_histogram" },
                "register_usage_and_predication_density": { "$ref": "#/$defs/predicted_axis_register_usage_and_predication_density" },
                "smid_migration_count": { "$ref": "#/$defs/predicted_axis_smid_migration_count" }
              }
            }
          },
          "description": "Predicted per-kernel feature vector content. The `axes` object mirrors kernel_feature_vector.schema.json's six-axis shape; closed-object discipline applies. Each axis carries the same `claim_class` enum as the measured side so consumers can compare like-for-like."
        },
        "phase_cycle_ledger_predicted": {
          "type": "object",
          "additionalProperties": false,
          "required": ["per_phase_cycle_records"],
          "properties": {
            "per_phase_cycle_records": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["phase_id", "sm_id", "warpid_tb", "cycles"],
                "properties": {
                  "phase_id": { "type": "integer", "minimum": 0 },
                  "sm_id": { "type": "integer", "minimum": 0 },
                  "warpid_tb": { "type": "integer", "minimum": 0 },
                  "cycles": { "type": "integer", "minimum": 0 }
                }
              },
              "description": "Predicted per-(SM id, warpid_tb, phase_id) cycle records. The shape mirrors phase_cycle_ledger.schema.json's per_phase_cycle_record so the comparison metric can be computed cell-for-cell against the measured ledger."
            }
          }
        },
        "roofline_coordinate_predicted": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operational_intensity_flop_per_byte", "achieved_bandwidth_gbps"],
          "properties": {
            "operational_intensity_flop_per_byte": { "type": "number", "minimum": 0 },
            "achieved_bandwidth_gbps": { "type": "number", "minimum": 0 }
          }
        },
        "theta_vector_predicted": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "theta_compute",
            "theta_hbm_bw",
            "theta_l2_bw",
            "theta_l1_bw",
            "theta_latency_floor"
          ],
          "properties": {
            "theta_compute": { "type": "number" },
            "theta_hbm_bw": { "type": "number" },
            "theta_l2_bw": { "type": "number" },
            "theta_l1_bw": { "type": "number" },
            "theta_latency_floor": { "type": "number" }
          }
        }
      }
    },
    "mechanism_citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["per_bug_mechanism", "primary_source", "secondary_source"],
      "properties": {
        "per_bug_mechanism": {
          "type": "string",
          "minLength": 1,
          "description": "Plain-language description of the architectural mechanism this prediction perturbs (e.g. `mshr_coalescing_depth`, `l1_sector_model_hit_rate`, `gto_scheduler_priority_inversion`)."
        },
        "primary_source": {
          "type": "string",
          "minLength": 1,
          "description": "Citation for the primary measurement source (Huerta MICRO 2025)."
        },
        "secondary_source": {
          "type": "string",
          "minLength": 1,
          "description": "Citation for the secondary measurement source (Jarmusch 2025 Blackwell microbenchmark paper)."
        }
      }
    },
    "synthetic_predictor_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predictor_name", "predictor_version", "frozen_seed_ref"],
      "properties": {
        "predictor_name": {
          "type": "string",
          "enum": ["synthetic_predictor"],
          "description": "Synthetic predictor identifier."
        },
        "predictor_version": { "type": "string", "minLength": 1 },
        "frozen_seed_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Repo-relative path to the frozen `pre_registration_seeds.toml`. Predictions whose predictor seed is not sourced from the frozen registry fail the replay-checksum check."
        }
      }
    }
  },
  "$defs": {
    "claim_class_dynamic_load_bearing": { "type": "string", "const": "dynamic_load_bearing" },
    "claim_class_static_sanity_check_only": { "type": "string", "const": "static_sanity_check_only" },
    "claim_class_mixed_static_dynamic": { "type": "string", "const": "mixed_static_dynamic" },
    "claim_class_optional_if_supported": { "type": "string", "const": "optional_if_supported" },
    "predicted_axis_dynamic_divergence_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_class", "active_mask_histogram", "divergence_depth"],
      "properties": {
        "claim_class": { "$ref": "#/$defs/claim_class_dynamic_load_bearing" },
        "active_mask_histogram": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bucket_size", "buckets"],
          "properties": {
            "bucket_size": { "type": "integer", "minimum": 1, "maximum": 32 },
            "buckets": {
              "type": "array",
              "items": { "type": "number", "minimum": 0 },
              "description": "Predicted per-bucket counts. Numbers (not just integers) so a synthetic predictor can express expected fractional counts; the metric framework normalizes when comparing against measured integer histograms."
            }
          }
        },
        "divergence_depth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_depth", "mean_depth"],
          "properties": {
            "max_depth": { "type": "integer", "minimum": 0 },
            "mean_depth": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "predicted_axis_memory_access_stride_distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_class", "stride_buckets_bytes", "stride_counts"],
      "properties": {
        "claim_class": { "$ref": "#/$defs/claim_class_dynamic_load_bearing" },
        "stride_buckets_bytes": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "stride_counts": {
          "type": "array",
          "items": { "type": "number", "minimum": 0 }
        }
      }
    },
    "predicted_axis_per_thread_instruction_count_distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_class", "min_count", "max_count", "mean_count", "stddev_count"],
      "properties": {
        "claim_class": { "$ref": "#/$defs/claim_class_dynamic_load_bearing" },
        "min_count": { "type": "integer", "minimum": 0 },
        "max_count": { "type": "integer", "minimum": 0 },
        "mean_count": { "type": "number", "minimum": 0 },
        "stddev_count": { "type": "number", "minimum": 0 }
      }
    },
    "predicted_axis_static_sass_mnemonic_histogram": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_class", "static_sass_features_ref"],
      "properties": {
        "claim_class": { "$ref": "#/$defs/claim_class_static_sanity_check_only" },
        "static_sass_features_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Repo-relative path to the predicted static_sass_features.json sidecar (or to the same shared sidecar as the measured side, since the static sub-axis depends on the cubin rather than a model prediction)."
        }
      }
    },
    "predicted_axis_register_usage_and_predication_density": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_class", "register_usage", "predication_density"],
      "properties": {
        "claim_class": { "$ref": "#/$defs/claim_class_mixed_static_dynamic" },
        "register_usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["claim_class", "regs_per_thread"],
          "properties": {
            "claim_class": { "$ref": "#/$defs/claim_class_static_sanity_check_only" },
            "regs_per_thread": { "type": "integer", "minimum": 0 }
          }
        },
        "predication_density": {
          "type": "object",
          "additionalProperties": false,
          "required": ["claim_class", "predicated_instruction_fraction"],
          "properties": {
            "claim_class": { "$ref": "#/$defs/claim_class_dynamic_load_bearing" },
            "predicated_instruction_fraction": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Predicted dynamic fraction of issued instructions whose guard predicate evaluated true. Leaf name matches the measured-side `predicated_instruction_fraction` so the recursive numeric-leaf metric walker compares like-for-like."
            }
          }
        }
      }
    },
    "predicted_axis_smid_migration_count": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_class", "supported_by_predictor"],
      "properties": {
        "claim_class": { "$ref": "#/$defs/claim_class_optional_if_supported" },
        "supported_by_predictor": { "type": "boolean" },
        "migration_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}

{
  "$defs": {
    "absolutePath": {
      "pattern": "^/(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?!.*\\\\).+$",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$id": "simbench_bw/schemas/m6_live_slot_plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt_sequence": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "cell_id": {
      "minLength": 3,
      "type": "string"
    },
    "cell_identity_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "command": {
      "items": {
        "type": "string"
      },
      "minItems": 2,
      "type": "array"
    },
    "config_id": {
      "pattern": "^cfg=clock_(none|base|boost)__cache_(all|none)$",
      "type": "string"
    },
    "config_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "expires_at_utc": {
      "format": "date-time",
      "type": "string"
    },
    "fresh_process": {
      "const": true
    },
    "kind": {
      "const": "m6_live_slot_plan_v1"
    },
    "launch_selector": {
      "additionalProperties": false,
      "properties": {
        "kernel_name": {
          "minLength": 1,
          "type": "string"
        },
        "kernel_signature_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "launch_index": {
          "minimum": 0,
          "type": "integer"
        },
        "m4_launch_identity_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "launch_index",
        "kernel_name",
        "kernel_signature_sha256",
        "m4_launch_identity_sha256"
      ],
      "type": "object"
    },
    "launcher": {
      "additionalProperties": false,
      "properties": {
        "executable": {
          "$ref": "#/$defs/absolutePath"
        },
        "executable_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "mode": {
          "const": 493
        }
      },
      "required": [
        "executable",
        "executable_sha256",
        "mode"
      ],
      "type": "object"
    },
    "metric_request": {
      "additionalProperties": false,
      "properties": {
        "explicit_unit_metrics": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 53,
          "minItems": 53,
          "type": "array",
          "uniqueItems": true
        },
        "implicit_flat_metrics": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array",
          "uniqueItems": true
        },
        "metric_identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "requested_ncu_metrics": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 55,
          "minItems": 55,
          "type": "array",
          "uniqueItems": true
        },
        "selected_count": {
          "const": 55
        }
      },
      "required": [
        "selected_count",
        "metric_identity_sha256",
        "requested_ncu_metrics",
        "implicit_flat_metrics",
        "explicit_unit_metrics"
      ],
      "type": "object"
    },
    "ncu_controls": {
      "additionalProperties": false,
      "properties": {
        "cache_control": {
          "enum": [
            "all",
            "none"
          ]
        },
        "clock_control": {
          "enum": [
            "none",
            "base",
            "boost"
          ]
        },
        "filter_mode": {
          "const": "global"
        },
        "launch_count": {
          "const": 1
        },
        "launch_skip": {
          "minimum": 0,
          "type": "integer"
        },
        "profile_from_start": {
          "const": false
        },
        "replay_mode": {
          "const": "kernel"
        },
        "target_processes": {
          "const": "all"
        }
      },
      "required": [
        "target_processes",
        "filter_mode",
        "replay_mode",
        "cache_control",
        "clock_control",
        "profile_from_start",
        "launch_skip",
        "launch_count"
      ],
      "type": "object"
    },
    "ordinal": {
      "maximum": 9759,
      "minimum": 0,
      "type": "integer"
    },
    "output": {
      "additionalProperties": false,
      "properties": {
        "attempt_receipt_path": {
          "$ref": "#/$defs/absolutePath"
        },
        "attempt_root": {
          "$ref": "#/$defs/absolutePath"
        },
        "evidence_root": {
          "$ref": "#/$defs/absolutePath"
        },
        "sidecar_path": {
          "$ref": "#/$defs/absolutePath"
        }
      },
      "required": [
        "attempt_root",
        "evidence_root",
        "sidecar_path",
        "attempt_receipt_path"
      ],
      "type": "object"
    },
    "plan_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "planned_at_utc": {
      "format": "date-time",
      "type": "string"
    },
    "repeat_index": {
      "maximum": 29,
      "minimum": 0,
      "type": "integer"
    },
    "resume_epoch": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "schedule_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "schema_version": {
      "const": 1
    },
    "session_authority_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "shape": {
      "additionalProperties": false,
      "properties": {
        "application_argv": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "logical_workload_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "shape_binding": {
          "enum": [
            "application-args",
            "logical-workload"
          ]
        },
        "shape_point": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "shape_point",
        "shape_binding",
        "logical_workload_sha256",
        "application_argv"
      ],
      "type": "object"
    },
    "slot_attempt_index": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "slot_id": {
      "minLength": 16,
      "type": "string"
    },
    "slot_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "sweep_index": {
      "maximum": 29,
      "minimum": 0,
      "type": "integer"
    },
    "target": {
      "additionalProperties": false,
      "properties": {
        "argv": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "executable": {
          "$ref": "#/$defs/absolutePath"
        },
        "executable_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "roster_source": {
          "enum": [
            "portable_lcd",
            "simbench_bw",
            "sol_execbench"
          ]
        },
        "slug": {
          "minLength": 1,
          "type": "string"
        },
        "working_directory": {
          "$ref": "#/$defs/absolutePath"
        }
      },
      "required": [
        "executable",
        "executable_sha256",
        "argv",
        "working_directory",
        "roster_source",
        "slug"
      ],
      "type": "object"
    },
    "tier": {
      "enum": [
        1,
        2
      ]
    },
    "tier2_activation_sha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "kind",
    "session_authority_sha256",
    "schedule_sha256",
    "tier2_activation_sha256",
    "planned_at_utc",
    "expires_at_utc",
    "resume_epoch",
    "attempt_sequence",
    "slot_attempt_index",
    "ordinal",
    "slot_id",
    "slot_sha256",
    "tier",
    "cell_id",
    "cell_identity_sha256",
    "config_id",
    "config_sha256",
    "sweep_index",
    "repeat_index",
    "fresh_process",
    "launcher",
    "target",
    "shape",
    "launch_selector",
    "ncu_controls",
    "metric_request",
    "output",
    "command",
    "plan_sha256"
  ],
  "title": "Pure M6 live slot command plan",
  "type": "object"
}

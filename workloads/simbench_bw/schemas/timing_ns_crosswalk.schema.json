{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simbench_bw/schemas/timing_ns_crosswalk.schema.json",
  "title": "Timing deploy-ns crosswalk",
  "description": "Same-binary and same-shape crosswalk status between the deploy observable and the NCU duration reference. A validating artifact may either allow a deploy-ns claim or record a typed falsification that prevents such a claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "arch",
    "source_commit",
    "cohort_artifact",
    "reference_metric_id",
    "deploy_observable",
    "same_binary_same_shape_required",
    "dual_source_noise_floor_ns",
    "floor_relative_bound",
    "crosswalk_status",
    "claim_allowed",
    "typed_reason",
    "checked_cells"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "artifact_kind": {"type": "string", "const": "timing_deploy_ns_crosswalk"},
    "arch": {"type": "string", "const": "sm_86"},
    "source_commit": {"type": "string", "minLength": 1},
    "cohort_artifact": {"type": "string", "minLength": 1},
    "reference_metric_id": {"type": "string", "const": "gpu__time_duration.sum"},
    "deploy_observable": {"type": "string", "const": "cupti_activity_plus_cuda_event"},
    "same_binary_same_shape_required": {"type": "boolean", "const": true},
    "dual_source_noise_floor_ns": {"type": "integer", "minimum": 1},
    "floor_relative_bound": {"type": "number", "exclusiveMinimum": 0},
    "crosswalk_status": {
      "type": "string",
      "enum": [
        "agreement_pass",
        "agreement_fail",
        "dual_source_pass_rate_failed",
        "indeterminate",
        "missing_deploy_observable"
      ]
    },
    "claim_allowed": {"type": "boolean"},
    "typed_reason": {"type": ["string", "null"]},
    "checked_cells": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/cell"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"claim_allowed": {"const": false}}},
      "then": {
        "properties": {
          "crosswalk_status": {
            "enum": [
              "agreement_fail",
              "dual_source_pass_rate_failed",
              "indeterminate",
              "missing_deploy_observable"
            ]
          },
          "typed_reason": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "if": {"properties": {"claim_allowed": {"const": true}}},
      "then": {
        "properties": {
          "crosswalk_status": {"const": "agreement_pass"},
          "typed_reason": {"type": "null"},
          "checked_cells": {
            "items": {
              "properties": {
                "status": {"const": "agreement_pass"},
                "cupti_activity_duration_ns": {"type": "number", "exclusiveMinimum": 0},
                "cuda_event_duration_ns": {"type": "number", "exclusiveMinimum": 0},
                "dual_source_reconciliation_passed": {"const": true},
                "dual_source_pass_count": {"type": "integer", "minimum": 1},
                "dual_source_repeat_count": {"type": "integer", "minimum": 1},
                "dual_source_pass_rate": {"type": "number", "minimum": 0.75},
                "dual_source_pass_rate_threshold": {"type": "number", "maximum": 0.75},
                "typed_reason": {"type": "null"}
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "shape_point",
        "arch",
        "binary_sha256",
        "kernel_signature_sha256",
        "ncu_duration_ns",
        "cupti_activity_duration_ns",
        "cuda_event_duration_ns",
        "cupti_activity_sidecar",
        "cupti_vs_ncu_delta_ns",
        "cuda_event_vs_ncu_delta_ns",
        "agreement_bound_ns",
        "relative_delta_cupti_vs_ncu",
        "relative_delta_cuda_event_vs_ncu",
        "dual_source_reconciliation_passed",
        "dual_source_repeat_count",
        "dual_source_pass_count",
        "dual_source_failure_count",
        "dual_source_pass_rate",
        "dual_source_pass_rate_threshold",
        "dual_source_reconciliation_failures",
        "cupti_activity_sidecars",
        "typed_reason",
        "status"
      ],
      "properties": {
        "slug": {"type": "string", "minLength": 1},
        "shape_point": {"type": "string", "minLength": 1},
        "arch": {"type": "string", "const": "sm_86"},
        "binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "kernel_signature_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "ncu_duration_ns": {"type": "number", "exclusiveMinimum": 0},
        "cupti_activity_duration_ns": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "cuda_event_duration_ns": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "cupti_activity_sidecar": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/artifact_ref"}
          ]
        },
        "cupti_vs_ncu_delta_ns": {"type": ["number", "null"], "minimum": 0},
        "cuda_event_vs_ncu_delta_ns": {"type": ["number", "null"], "minimum": 0},
        "agreement_bound_ns": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "relative_delta_cupti_vs_ncu": {"type": ["number", "null"], "minimum": 0},
        "relative_delta_cuda_event_vs_ncu": {"type": ["number", "null"], "minimum": 0},
        "dual_source_reconciliation_passed": {"type": ["boolean", "null"]},
        "dual_source_repeat_count": {"type": "integer", "minimum": 0},
        "dual_source_pass_count": {"type": "integer", "minimum": 0},
        "dual_source_failure_count": {"type": "integer", "minimum": 0},
        "dual_source_pass_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "dual_source_pass_rate_threshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "dual_source_reconciliation_failures": {
          "type": "array",
          "items": {"$ref": "#/$defs/dual_source_failure"}
        },
        "cupti_activity_sidecars": {
          "type": "array",
          "items": {"$ref": "#/$defs/artifact_ref"}
        },
        "typed_reason": {"type": ["string", "null"]},
        "status": {
          "type": "string",
          "enum": [
            "agreement_pass",
            "agreement_fail",
            "dual_source_pass_rate_failed",
            "indeterminate",
            "missing_deploy_observable"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {"enum": ["agreement_pass", "agreement_fail", "indeterminate"]}
            }
          },
          "then": {
            "properties": {
              "cupti_activity_duration_ns": {"type": "number", "exclusiveMinimum": 0},
              "cuda_event_duration_ns": {"type": "number", "exclusiveMinimum": 0},
              "cupti_activity_sidecar": {"$ref": "#/$defs/artifact_ref"},
              "cupti_vs_ncu_delta_ns": {"type": "number", "minimum": 0},
              "cuda_event_vs_ncu_delta_ns": {"type": "number", "minimum": 0},
              "agreement_bound_ns": {"type": "number", "exclusiveMinimum": 0},
              "relative_delta_cupti_vs_ncu": {"type": "number", "minimum": 0},
              "relative_delta_cuda_event_vs_ncu": {"type": "number", "minimum": 0},
              "dual_source_reconciliation_passed": {"type": "boolean"},
              "dual_source_repeat_count": {"type": "integer", "minimum": 1},
              "cupti_activity_sidecars": {"type": "array", "minItems": 1}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "missing_deploy_observable"}}},
          "then": {
            "properties": {
              "cupti_activity_duration_ns": {"type": "null"},
              "cuda_event_duration_ns": {"type": "null"},
              "cupti_activity_sidecar": {"type": "null"},
              "cupti_vs_ncu_delta_ns": {"type": "null"},
              "cuda_event_vs_ncu_delta_ns": {"type": "null"},
              "agreement_bound_ns": {"type": "null"},
              "relative_delta_cupti_vs_ncu": {"type": "null"},
              "relative_delta_cuda_event_vs_ncu": {"type": "null"},
              "dual_source_reconciliation_passed": {"type": "null"},
              "dual_source_repeat_count": {"const": 0},
              "dual_source_pass_count": {"const": 0},
              "dual_source_failure_count": {"const": 0},
              "dual_source_pass_rate": {"const": 0.0},
              "dual_source_reconciliation_failures": {"maxItems": 0},
              "cupti_activity_sidecars": {"maxItems": 0},
              "typed_reason": {
                "type": "string",
                "const": "no_committed_same_binary_same_shape_cupti_activity_sidecar"
              }
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "agreement_pass"}}},
          "then": {
            "properties": {
              "dual_source_reconciliation_passed": {"const": true},
              "dual_source_pass_count": {"type": "integer", "minimum": 1},
              "dual_source_pass_rate": {"type": "number", "minimum": 0.75},
              "dual_source_pass_rate_threshold": {"type": "number", "maximum": 0.75},
              "typed_reason": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "dual_source_pass_rate_failed"}}},
          "then": {
            "properties": {
              "dual_source_reconciliation_passed": {"const": false},
              "dual_source_pass_rate": {"type": "number", "exclusiveMaximum": 0.75},
              "typed_reason": {
                "type": "string",
                "const": "deploy_ns_dual_source_pass_rate_failed"
              }
            }
          }
        }
      ]
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "dual_source_failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repeat_index",
        "gap_ns",
        "relative_pct",
        "reason",
        "cupti_activity_sidecar"
      ],
      "properties": {
        "repeat_index": {"type": "integer", "minimum": 0},
        "gap_ns": {"type": ["integer", "null"]},
        "relative_pct": {"type": ["number", "null"], "minimum": 0},
        "reason": {
          "type": "string",
          "enum": ["reconciliation_failed", "sidecar_missing", "sidecar_invalid"]
        },
        "cupti_activity_sidecar": {"$ref": "#/$defs/artifact_ref"}
      }
    }
  }
}

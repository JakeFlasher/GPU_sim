{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpu-simulator.invalid/schemas/m5_quantity_authority.v2.schema.json",
  "title": "M5 target-free quantity authority v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "authority_id",
    "execution_order",
    "scientific_rank",
    "quantities",
    "consumer_binding_registry",
    "gap_mapping",
    "provenance",
    "signature_ed25519"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "artifact_kind": {"const": "M5_QUANTITY_AUTHORITY"},
    "authority_id": {"const": "sm86-m5-quantity-authority-v2"},
    "execution_order": {"$ref": "#/$defs/family_order"},
    "scientific_rank": {"$ref": "#/$defs/family_order"},
    "quantities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {"$ref": "#/$defs/quantity"}
    },
    "consumer_binding_registry": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {"$ref": "#/$defs/consumer_binding"}
    },
    "gap_mapping": {"$ref": "#/$defs/gap_mapping"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ancestry_identity_id",
        "review_identity_ids",
        "operator_approval_identity_id",
        "trust_anchor_identity_id",
        "target_free"
      ],
      "properties": {
        "ancestry_identity_id": {"const": "m5-quantity-authority-ancestry"},
        "review_identity_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"}
        },
        "operator_approval_identity_id": {"const": "m5-quantity-authority-operator-approval"},
        "trust_anchor_identity_id": {"const": "m5-analysis-authority"},
        "target_free": {"const": true}
      }
    },
    "signature_ed25519": {"type": "string", "pattern": "^[0-9a-f]{128}$"}
  },
  "$defs": {
    "family": {"enum": ["a", "b", "c", "d", "e", "f"]},
    "family_order": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/family"}
    },
    "safe_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"},
    "consumer_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quantity_id", "consumer_binding", "authorized_gap_kinds", "research_gap_only"],
      "properties": {
        "quantity_id": {"$ref": "#/$defs/safe_id"},
        "consumer_binding": {"type": "string", "minLength": 1, "maxLength": 256},
        "authorized_gap_kinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {"enum": ["RANGE", "CENSORED", "MIXTURE", "UNRESOLVED_STRUCTURE", "SURFACE_GAP"]}
        },
        "research_gap_only": {"const": true}
      }
    },
    "gap_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mapping_version", "typed_gap_kinds", "consumer_rule", "ncu_selection_forbidden"],
      "properties": {
        "mapping_version": {"const": 1},
        "typed_gap_kinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {"enum": ["RANGE", "CENSORED", "MIXTURE", "UNRESOLVED_STRUCTURE", "SURFACE_GAP"]}
        },
        "consumer_rule": {"const": "RETAIN_AS_TYPED_RESEARCH_GAP"},
        "ncu_selection_forbidden": {"const": true}
      }
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quantity_id",
        "quantity_group",
        "producer",
        "consumer_binding",
        "meaning",
        "conditioning",
        "unit",
        "value_domain",
        "agreement_limit_fraction",
        "readout_contracts",
        "authorized_gap_kinds",
        "required"
      ],
      "properties": {
        "quantity_id": {"$ref": "#/$defs/safe_id"},
        "quantity_group": {"$ref": "#/$defs/safe_id"},
        "producer": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "family_id"],
              "properties": {"kind": {"const": "PROBE_FAMILY"}, "family_id": {"$ref": "#/$defs/family"}}
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "component_id"],
              "properties": {"kind": {"const": "PCHASE"}, "component_id": {"const": "pchase"}}
            }
          ]
        },
        "consumer_binding": {"type": "string", "minLength": 1, "maxLength": 256},
        "meaning": {"type": "string", "minLength": 1, "maxLength": 1024},
        "conditioning": {
          "type": "object",
          "additionalProperties": false,
          "required": ["residency", "access_class", "scope", "variant"],
          "properties": {
            "residency": {"type": "string", "minLength": 1, "maxLength": 64},
            "access_class": {"type": "string", "minLength": 1, "maxLength": 128},
            "scope": {"type": "string", "minLength": 1, "maxLength": 64},
            "variant": {"type": "string", "minLength": 1, "maxLength": 256}
          }
        },
        "unit": {"type": "string", "minLength": 1, "maxLength": 64},
        "value_domain": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "integral"],
          "properties": {
            "kind": {"enum": ["POSITIVE", "NONNEGATIVE", "PROBABILITY"]},
            "integral": {"type": "boolean"}
          }
        },
        "agreement_limit_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.5},
        "readout_contracts": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "items": {"$ref": "#/$defs/readout"}
        },
        "authorized_gap_kinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {"enum": ["RANGE", "CENSORED", "MIXTURE", "UNRESOLVED_STRUCTURE", "SURFACE_GAP"]}
        },
        "required": {"const": true}
      }
    },
    "readout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readout_id",
        "method_class",
        "instrument",
        "readout_role",
        "derivation_identity_id",
        "derivation_operation",
        "sample_operation",
        "method_contract",
        "required_evidence_roles"
      ],
      "properties": {
        "readout_id": {"$ref": "#/$defs/safe_id"},
        "method_class": {"type": "string", "minLength": 1, "maxLength": 128},
        "instrument": {"type": "string", "minLength": 1, "maxLength": 64},
        "readout_role": {"const": "VALUE"},
        "derivation_identity_id": {"$ref": "#/$defs/safe_id"},
        "derivation_operation": {"enum": ["MEDIAN", "MEAN"]},
        "sample_operation": {"const": "RATIO"},
        "method_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mechanism", "estimator_identity", "confounder_set", "control_evidence_roles", "falsification_rule"],
          "properties": {
            "mechanism": {"type": "string", "minLength": 1, "maxLength": 128},
            "estimator_identity": {"enum": ["RATIO_THEN_MEDIAN", "RATIO_THEN_MEAN"]},
            "confounder_set": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 64}},
            "control_evidence_roles": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"enum": ["curve", "control", "confound", "composition"]}},
            "falsification_rule": {"const": "MAX_RELATIVE_DELTA_WITHIN_AGREEMENT_LIMIT"}
          }
        },
        "required_evidence_roles": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"enum": ["curve", "control", "confound", "composition"]}}
      }
    }
  }
}

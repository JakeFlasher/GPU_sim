{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simbench_bw/schemas/capture_defect_ledger_entry.schema.json",
  "title": "Non-authoritative cross-HEAD capture-defect archive ledger entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "entry_id",
    "entry_type",
    "created_at_utc",
    "original_head",
    "replacement_head",
    "chunk_id",
    "cell_id",
    "original_matrix_file_sha256",
    "original_matrix_seal_sha256",
    "original_preflight_sha256",
    "original_session_id",
    "original_admission_run_id",
    "source_stage_path",
    "source_journals_path",
    "archive_path",
    "inventory_file",
    "inventory_sha256",
    "journal_inventory_sha256",
    "journal_file_count",
    "journal_total_bytes",
    "stage_inventory_sha256",
    "stage_file_count",
    "stage_total_bytes",
    "chunk_run_journal_sha256",
    "journal_start_sha256",
    "label_result_sha256",
    "eval_driver_sha256",
    "prepare_manifest_sha256",
    "selection_sha256",
    "reason_code",
    "defect_summary",
    "authoritative",
    "reusable",
    "campaign_rows",
    "operator_flag"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "entry_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "entry_type": {"const": "capture_defect_attempt_archive"},
    "created_at_utc": {"type": "string", "minLength": 1},
    "original_head": {"$ref": "#/$defs/commit"},
    "replacement_head": {"$ref": "#/$defs/commit"},
    "chunk_id": {"type": "string", "minLength": 1},
    "cell_id": {"type": "string", "minLength": 1},
    "original_matrix_file_sha256": {"$ref": "#/$defs/sha256"},
    "original_matrix_seal_sha256": {"$ref": "#/$defs/sha256"},
    "original_preflight_sha256": {"$ref": "#/$defs/sha256"},
    "original_session_id": {"type": "string", "minLength": 1},
    "original_admission_run_id": {"$ref": "#/$defs/sha256"},
    "source_stage_path": {"$ref": "#/$defs/absolutePath"},
    "source_journals_path": {"$ref": "#/$defs/absolutePath"},
    "archive_path": {"$ref": "#/$defs/absolutePath"},
    "inventory_file": {"$ref": "#/$defs/absolutePath"},
    "inventory_sha256": {"$ref": "#/$defs/sha256"},
    "journal_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "journal_file_count": {"type": "integer", "minimum": 1},
    "journal_total_bytes": {"type": "integer", "minimum": 1},
    "stage_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "stage_file_count": {"type": "integer", "minimum": 1},
    "stage_total_bytes": {"type": "integer", "minimum": 1},
    "chunk_run_journal_sha256": {"$ref": "#/$defs/sha256"},
    "journal_start_sha256": {"$ref": "#/$defs/sha256"},
    "label_result_sha256": {"$ref": "#/$defs/sha256"},
    "eval_driver_sha256": {"$ref": "#/$defs/sha256"},
    "prepare_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "selection_sha256": {"$ref": "#/$defs/sha256"},
    "reason_code": {"const": "CAPTURE_DRIVER_INTEGRITY_FALSE_POSITIVE_BEFORE_ROI"},
    "defect_summary": {
      "const": "capture mode intentionally bound time_runnable to None while the integrity snapshot still required the canonical timing function"
    },
    "authoritative": {"const": false},
    "reusable": {"const": false},
    "campaign_rows": {"const": 0},
    "operator_flag": {"const": "--archive-fixed-h3-capture-defect"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "absolutePath": {"type": "string", "pattern": "^/[^\\u0000]+$"}
  }
}

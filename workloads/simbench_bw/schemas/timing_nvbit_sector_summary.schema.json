{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simbench_bw/schemas/timing_nvbit_sector_summary.schema.json",
  "title": "Timing NVBit sector summary",
  "description": "Per-cell deploy-feature sector summary for long-duration timing prediction. The artifact is bound to the cohort cell identity, records same-binary NVBit launch trace provenance, and requires non-empty observed threadblock-proto sector evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "arch",
    "slug",
    "shape_point",
    "binary_sha256",
    "kernel_signature_sha256",
    "source_commit",
    "producer",
    "source_trace",
    "nvbit_launch_summary",
    "observed_sector_summary",
    "summarize_launch",
    "observation_basis",
    "static_inputs",
    "sector_counts",
    "sector_count_derivation",
    "theoretical_occupancy",
    "deploy_legal"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "artifact_kind": {"type": "string", "const": "timing_nvbit_sector_summary"},
    "arch": {"type": "string", "const": "sm_86"},
    "slug": {"type": "string", "minLength": 1},
    "shape_point": {"type": "string", "minLength": 1},
    "binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "kernel_signature_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_commit": {"type": "string", "minLength": 1},
    "producer": {
      "type": "string",
      "const": "nvbit_observed_summarize_launch_sector_summary_v1"
    },
    "source_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nvbit_trace_pb_path",
        "nvbit_trace_pb_sha256",
        "trace_dir",
        "capture_mode",
        "instruction_trace_mode",
        "instr_begin",
        "instr_end",
        "trace_contract_id",
        "trace_source_generation",
        "threadblock_proto_file_count",
        "threadblock_proto_set_sha256",
        "threadblock_proto_retention",
        "nvbit_launch_attempt"
      ],
      "properties": {
        "nvbit_trace_pb_path": {"type": "string", "minLength": 1},
        "nvbit_trace_pb_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "trace_dir": {"type": "string", "minLength": 1},
        "capture_mode": {
          "type": "string",
          "const": "per_cell_same_binary_same_shape_nvbit_bounded_observed_threadblock_trace"
        },
        "instruction_trace_mode": {
          "type": "string",
          "const": "bounded_observed_global_store_trace"
        },
        "instr_begin": {"type": "integer", "minimum": 0},
        "instr_end": {"type": "integer", "minimum": 0},
        "trace_contract_id": {
          "type": "string",
          "const": "sm86_addr_carry_shmem_split_v2"
        },
        "trace_source_generation": {"$ref": "#/$defs/trace_source_generation"},
        "threadblock_proto_file_count": {"type": "integer", "minimum": 1},
        "threadblock_proto_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "threadblock_proto_retention": {
          "type": "string",
          "const": "retained_raw_threadblock_protos_after_digest"
        },
        "nvbit_launch_attempt": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "attempt_seal_sha256",
            "start_path",
            "start_sha256",
            "start_seal_sha256",
            "trace_source_generation"
          ],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "attempt_seal_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "start_path": {"type": "string", "minLength": 1},
            "start_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "start_seal_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "trace_source_generation": {"$ref": "#/$defs/trace_source_generation"}
          }
        }
      }
    },
    "nvbit_launch_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "raw_kernel_name",
        "raw_kernel_signature_sha256",
        "harmonized_kernel_name",
        "harmonized_kernel_signature_sha256",
        "inst_count",
        "launch_index",
        "repeat_index",
        "stats_csv_path",
        "stats_csv_sha256",
        "trace_contract_id",
        "trace_source_generation",
        "launch_geometry",
        "instruction_trace_mode"
      ],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "raw_kernel_name": {"type": "string", "minLength": 1},
        "raw_kernel_signature_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "harmonized_kernel_name": {"type": "string", "minLength": 1},
        "harmonized_kernel_signature_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "inst_count": {"type": "integer", "minimum": 1},
        "launch_index": {"type": "integer", "minimum": 0},
        "repeat_index": {"type": "integer", "minimum": 0},
        "stats_csv_path": {"type": "string", "minLength": 1},
        "stats_csv_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "trace_contract_id": {
          "type": "string",
          "const": "sm86_addr_carry_shmem_split_v2"
        },
        "trace_source_generation": {"$ref": "#/$defs/trace_source_generation"},
        "launch_geometry": {"$ref": "#/$defs/launch_geometry"},
        "instruction_trace_mode": {
          "type": "string",
          "const": "bounded_observed_global_store_trace"
        }
      }
    },
    "observed_sector_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "artifact_kind"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "artifact_kind": {
          "type": "string",
          "const": "timing_nvbit_observed_sector_summary"
        }
      }
    },
    "summarize_launch": {"$ref": "#/$defs/summarize_launch"},
    "observation_basis": {"$ref": "#/$defs/observation_basis"},
    "static_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "static_sass_features_path",
        "static_sass_features_sha256",
        "static_work_path",
        "static_work_sha256"
      ],
      "properties": {
        "static_sass_features_path": {"type": "string", "minLength": 1},
        "static_sass_features_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "static_work_path": {"type": "string", "minLength": 1},
        "static_work_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "sector_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "global_read_32b_sectors",
        "global_write_32b_sectors",
        "total_32b_sectors",
        "total_128b_lines",
        "estimated_bytes"
      ],
      "properties": {
        "global_read_32b_sectors": {"type": "integer", "minimum": 0},
        "global_write_32b_sectors": {"type": "integer", "minimum": 1},
        "total_32b_sectors": {"type": "integer", "minimum": 1},
        "total_128b_lines": {"type": "integer", "minimum": 1},
        "estimated_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "sector_count_derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "observed_access_count",
        "observed_sector_summary_path",
        "instruction_trace_mode"
      ],
      "properties": {
        "source": {
          "type": "string",
          "const": "nvbit_observed_threadblock_proto_sector_stream"
        },
        "observed_access_count": {"type": "integer", "minimum": 1},
        "observed_sector_summary_path": {"type": "string", "minLength": 1},
        "instruction_trace_mode": {
          "type": "string",
          "const": "bounded_observed_global_store_trace"
        }
      }
    },
    "theoretical_occupancy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_blocks_per_sm",
        "active_warps_per_sm",
        "warps_per_block",
        "source"
      ],
      "properties": {
        "active_blocks_per_sm": {"type": "integer", "minimum": 1},
        "active_warps_per_sm": {"type": "integer", "minimum": 1},
        "warps_per_block": {"type": "integer", "minimum": 1},
        "source": {"type": "string", "minLength": 1}
      }
    },
    "deploy_legal": {"type": "boolean", "const": true}
  },
  "$defs": {
    "trace_source_generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "artifact_kind",
        "trace_contract_id",
        "trace_admission_sha256",
        "trace_filesystem_generation_sha256",
        "bounded_inventory",
        "source_generation_sha256"
      ],
      "properties": {
        "schema_version": {"type": "integer", "const": 1},
        "artifact_kind": {
          "type": "string",
          "const": "timing_nvbit_retained_source_generation"
        },
        "trace_contract_id": {
          "type": "string",
          "const": "sm86_addr_carry_shmem_split_v2"
        },
        "trace_admission_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "trace_filesystem_generation_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bounded_inventory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_file_count",
            "source_total_bytes",
            "max_tree_files",
            "max_tree_directories",
            "max_trace_root_bytes",
            "max_stats_bytes",
            "max_threadblock_files",
            "max_threadblock_bytes",
            "max_total_threadblock_bytes"
          ],
          "properties": {
            "source_file_count": {"type": "integer", "minimum": 3},
            "source_total_bytes": {"type": "integer", "minimum": 1},
            "max_tree_files": {"type": "integer", "minimum": 3},
            "max_tree_directories": {"type": "integer", "minimum": 1},
            "max_trace_root_bytes": {"type": "integer", "minimum": 1},
            "max_stats_bytes": {"type": "integer", "minimum": 1},
            "max_threadblock_files": {"type": "integer", "minimum": 1},
            "max_threadblock_bytes": {"type": "integer", "minimum": 1},
            "max_total_threadblock_bytes": {"type": "integer", "minimum": 1}
          }
        },
        "source_generation_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "integer_count_map": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "launch_geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kernel_name",
        "grid_x",
        "grid_y",
        "grid_z",
        "block_x",
        "block_y",
        "block_z",
        "shared_mem_static_bytes",
        "shared_mem_dynamic_bytes"
      ],
      "properties": {
        "kernel_name": {"type": "string", "minLength": 1},
        "grid_x": {"type": "integer", "minimum": 1},
        "grid_y": {"type": "integer", "minimum": 1},
        "grid_z": {"type": "integer", "minimum": 1},
        "block_x": {"type": "integer", "minimum": 1},
        "block_y": {"type": "integer", "minimum": 1},
        "block_z": {"type": "integer", "minimum": 1},
        "shared_mem_static_bytes": {"type": "integer", "minimum": 0},
        "shared_mem_dynamic_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "nullable_nonnegative_integer": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "observation_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace_contract_ok",
        "trace_contract_id",
        "trace_source_generation",
        "threadblock_proto_file_count",
        "threadblock_proto_set_sha256",
        "memory_instruction_record_count",
        "observed_access_count",
        "observed_hit_count",
        "observed_miss_count",
        "stats_total_insts",
        "stats_total_reported_insts"
      ],
      "properties": {
        "trace_contract_ok": {"type": "boolean", "const": true},
        "trace_contract_id": {
          "type": "string",
          "const": "sm86_addr_carry_shmem_split_v2"
        },
        "trace_source_generation": {"$ref": "#/$defs/trace_source_generation"},
        "threadblock_proto_file_count": {"type": "integer", "minimum": 1},
        "threadblock_proto_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "memory_instruction_record_count": {"type": "integer", "minimum": 1},
        "observed_access_count": {"type": "integer", "minimum": 1},
        "observed_hit_count": {"type": "integer", "minimum": 0},
        "observed_miss_count": {"type": "integer", "minimum": 0},
        "stats_total_insts": {"type": "integer", "minimum": 1},
        "stats_total_reported_insts": {"type": "integer", "minimum": 1}
      }
    },
    "summarize_launch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cold_count",
        "finite_miss_count",
        "unique_sector_count",
        "working_set_sector_count",
        "reuse_distance_finite_p50",
        "reuse_distance_finite_p90",
        "reuse_distance_finite_p99",
        "per_op_class_counts",
        "per_access_kind_counts",
        "load_count",
        "store_count",
        "atomic_count",
        "async_copy_count",
        "unspecified_kind_count"
      ],
      "properties": {
        "cold_count": {"type": "integer", "minimum": 0},
        "finite_miss_count": {"type": "integer", "minimum": 0},
        "unique_sector_count": {"type": "integer", "minimum": 1},
        "working_set_sector_count": {"type": "integer", "minimum": 0},
        "reuse_distance_finite_p50": {"$ref": "#/$defs/nullable_nonnegative_integer"},
        "reuse_distance_finite_p90": {"$ref": "#/$defs/nullable_nonnegative_integer"},
        "reuse_distance_finite_p99": {"$ref": "#/$defs/nullable_nonnegative_integer"},
        "per_op_class_counts": {"$ref": "#/$defs/integer_count_map"},
        "per_access_kind_counts": {"$ref": "#/$defs/integer_count_map"},
        "load_count": {"type": "integer", "minimum": 0},
        "store_count": {"type": "integer", "minimum": 1},
        "atomic_count": {"type": "integer", "minimum": 0},
        "async_copy_count": {"type": "integer", "minimum": 0},
        "unspecified_kind_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}

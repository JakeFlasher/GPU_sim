{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpu-simulator.invalid/schemas/m5_authority_ancestry_audit.v1.schema.json",
  "title": "M5 mechanical quantity-authority ancestry audit v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "audit_policy_version",
    "audit_policy_sha256",
    "audit_tool_sha256",
    "audit_schema_sha256",
    "authority_sha256",
    "source_registry_sha256",
    "source_registry_schema_sha256",
    "quarantine_catalog_sha256",
    "normalization_policy_sha256",
    "legacy_structural_fingerprints_sha256",
    "legacy_dependency_edges_sha256",
    "scientific_dependency_edges_sha256",
    "scientific_projection_sha256",
    "scientific_field_sources_sha256",
    "design_inputs",
    "checks",
    "verdict",
    "mechanical_non_revival_only",
    "semantic_review_required",
    "external_credit"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_kind": {"const": "M5_AUTHORITY_ANCESTRY_AUDIT"},
    "audit_policy_version": {"const": 1},
    "audit_policy_sha256": {"$ref": "#/$defs/sha256"},
    "audit_tool_sha256": {"$ref": "#/$defs/sha256"},
    "audit_schema_sha256": {"$ref": "#/$defs/sha256"},
    "authority_sha256": {"$ref": "#/$defs/sha256"},
    "source_registry_sha256": {"$ref": "#/$defs/sha256"},
    "source_registry_schema_sha256": {"$ref": "#/$defs/sha256"},
    "quarantine_catalog_sha256": {"$ref": "#/$defs/sha256"},
    "normalization_policy_sha256": {"$ref": "#/$defs/sha256"},
    "legacy_structural_fingerprints_sha256": {"$ref": "#/$defs/sha256"},
    "legacy_dependency_edges_sha256": {"$ref": "#/$defs/sha256"},
    "scientific_dependency_edges_sha256": {"$ref": "#/$defs/sha256"},
    "scientific_projection_sha256": {"$ref": "#/$defs/sha256"},
    "scientific_field_sources_sha256": {"$ref": "#/$defs/sha256"},
    "design_inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/design_input"}
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared_input_binding_complete",
        "scientific_field_coverage_complete",
        "source_registry_contract_validated",
        "retained_tool_execution_bound",
        "audit_policy_byte_bound",
        "exact_quarantine_digest_absent",
        "normalized_forbidden_tokens_absent",
        "variable_scientific_fields_scanned",
        "legacy_structural_fingerprints_absent",
        "legacy_dependency_edges_absent"
      ],
      "properties": {
        "declared_input_binding_complete": {"const": true},
        "scientific_field_coverage_complete": {"const": true},
        "source_registry_contract_validated": {"const": true},
        "retained_tool_execution_bound": {"const": true},
        "audit_policy_byte_bound": {"const": true},
        "exact_quarantine_digest_absent": {"const": true},
        "normalized_forbidden_tokens_absent": {"const": true},
        "variable_scientific_fields_scanned": {"const": true},
        "legacy_structural_fingerprints_absent": {"const": true},
        "legacy_dependency_edges_absent": {"const": true}
      }
    },
    "verdict": {"const": "NO_LISTED_REVIVAL_DETECTED"},
    "mechanical_non_revival_only": {"const": true},
    "semantic_review_required": {"const": true},
    "external_credit": {"const": "NONE"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "safe_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "relative_path", "sha256", "size_bytes", "media_type"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/safe_id"},
        "relative_path": {
          "type": "string",
          "pattern": "^(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "media_type": {
          "enum": ["application/json", "text/markdown", "text/plain", "text/x-cuda", "text/x-python"]
        }
      }
    },
    "design_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_id", "artifact"],
      "properties": {
        "identity_id": {"$ref": "#/$defs/safe_id"},
        "artifact": {"$ref": "#/$defs/artifact"}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simbench_bw/schemas/l4_checkpoints/prefill_then_decode_pagedkv_pipeline.schema.json",
  "title": "L4 checkpoint: prefill_then_decode_pagedkv_pipeline",
  "description": "Canonical serialized intermediate-state schema captured at the KV-cache layout boundary between the prefill phase and the decode phase. Emitted by run_suite.py --mode correctness --component-strict for the prefill_then_decode_pagedkv_pipeline row.",
  "schema_version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "slug",
    "checkpoint_name",
    "kv_block_table",
    "kv_data_blocks",
    "seq_lengths",
    "rope_cos_sin_cache"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "slug": { "type": "string", "const": "prefill_then_decode_pagedkv_pipeline" },
    "checkpoint_name": { "type": "string", "const": "prefill_to_decode_kv_boundary" },
    "kv_block_table": {
      "type": "object",
      "description": "Per-sequence block index table mapping logical positions to physical KV-cache block IDs.",
      "additionalProperties": false,
      "required": ["shape", "dtype", "digest"],
      "properties": {
        "shape": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "minItems": 2,
          "maxItems": 2,
          "description": "[num_sequences, max_blocks_per_sequence]"
        },
        "dtype": { "type": "string", "enum": ["int32", "int64"] },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of the canonical byte serialization."
        }
      }
    },
    "kv_data_blocks": {
      "type": "object",
      "description": "Flattened KV cache data tensor (all blocks concatenated). Stored as a digest because the full tensor is too large for a golden file.",
      "additionalProperties": false,
      "required": ["shape", "dtype", "digest"],
      "properties": {
        "shape": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "minItems": 4,
          "maxItems": 5,
          "description": "[num_blocks, block_size, num_kv_heads, head_dim] or [num_blocks, block_size, num_kv_heads, head_dim, kv_pair]."
        },
        "dtype": { "type": "string", "enum": ["bfloat16", "float16", "float8_e4m3", "float8_e5m2"] },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "seq_lengths": {
      "type": "object",
      "description": "Current valid length of each sequence after prefill.",
      "additionalProperties": false,
      "required": ["shape", "dtype", "values"],
      "properties": {
        "shape": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "minItems": 1,
          "maxItems": 1,
          "description": "[num_sequences]"
        },
        "dtype": { "type": "string", "enum": ["int32", "int64"] },
        "values": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 },
          "description": "Stored in full because num_sequences is small (≤ 64)."
        }
      }
    },
    "rope_cos_sin_cache": {
      "type": "object",
      "description": "Precomputed RoPE cos/sin tables used by both prefill and decode.",
      "additionalProperties": false,
      "required": ["shape", "dtype", "digest", "rope_kind"],
      "properties": {
        "shape": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "minItems": 3,
          "maxItems": 3,
          "description": "[2, max_position, head_dim] -- axis 0 splits cos vs sin."
        },
        "dtype": { "type": "string", "enum": ["bfloat16", "float16", "float32"] },
        "rope_kind": { "type": "string", "enum": ["standard", "yarn", "2d", "multimodal"] },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}

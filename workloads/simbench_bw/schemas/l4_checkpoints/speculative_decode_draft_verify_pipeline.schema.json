{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simbench_bw/schemas/l4_checkpoints/speculative_decode_draft_verify_pipeline.schema.json",
  "title": "L4 checkpoint: speculative_decode_draft_verify_pipeline",
  "description": "Canonical serialized intermediate-state schema captured at the draft-output boundary between the draft model and the verifier. Scoped strictly to draft-side boundary state; verifier-side outputs (accepted_token_count, rejection_probabilities, recompute_positions) are recorded separately as downstream result metadata in suite_results.row_result.component_health, not in this schema.",
  "schema_version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "slug",
    "checkpoint_name",
    "draft_tokens",
    "draft_logits",
    "draft_probabilities",
    "draft_attention_state_digest"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "slug": { "type": "string", "const": "speculative_decode_draft_verify_pipeline" },
    "checkpoint_name": { "type": "string", "const": "draft_to_verifier_boundary" },
    "draft_tokens": {
      "type": "object",
      "description": "Draft-model proposed tokens for each speculative step.",
      "additionalProperties": false,
      "required": ["shape", "dtype", "values"],
      "properties": {
        "shape": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "minItems": 2,
          "maxItems": 2,
          "description": "[batch, draft_length]"
        },
        "dtype": { "type": "string", "enum": ["int32", "int64"] },
        "values": {
          "type": "array",
          "description": "Full integer token IDs; batch * draft_length is small (≤ 1024).",
          "items": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "draft_logits": {
      "type": "object",
      "description": "Raw logits over vocab produced by the draft model at each speculative step.",
      "additionalProperties": false,
      "required": ["shape", "dtype", "digest"],
      "properties": {
        "shape": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "minItems": 3,
          "maxItems": 3,
          "description": "[batch, draft_length, vocab]"
        },
        "dtype": { "type": "string", "enum": ["bfloat16", "float16", "float32"] },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "draft_probabilities": {
      "type": "object",
      "description": "Softmax-normalized probabilities over vocab at each speculative step; consumed by the verifier's rejection-sampling math.",
      "additionalProperties": false,
      "required": ["shape", "dtype", "digest"],
      "properties": {
        "shape": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "minItems": 3,
          "maxItems": 3,
          "description": "[batch, draft_length, vocab]"
        },
        "dtype": { "type": "string", "enum": ["bfloat16", "float16", "float32"] },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "draft_attention_state_digest": {
      "type": "object",
      "description": "Digest of the draft model's KV-cache / attention state at the boundary. Full state is not serialized because it can be large; only the SHA-256 digest of the canonical serialization is committed.",
      "additionalProperties": false,
      "required": ["shape", "dtype", "digest"],
      "properties": {
        "shape": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "minItems": 4,
          "maxItems": 5,
          "description": "[num_layers, num_kv_heads, draft_length, head_dim] or 5-D with kv_pair axis."
        },
        "dtype": { "type": "string", "enum": ["bfloat16", "float16", "float8_e4m3"] },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cutlass_successor_capture_receipt.v3.schema.json",
  "title": "CUTLASS successor external capture receipt v3",
  "description": "Closed wrapper for one external NCU or NVBit process receipt. Version 3 retains the exact NVBit phase tool and runtime DSO manifest as hash-bound artifacts and binds provenance to that retained generation; it contains no simulator configuration.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_kind", "receipt", "receipt_seal_sha256"],
  "properties": {
    "schema_version": {"const": 3},
    "artifact_kind": {"const": "cutlass_successor_capture_receipt"},
    "receipt": {
      "oneOf": [
        {"$ref": "#/$defs/ncu_receipt"},
        {"$ref": "#/$defs/nvbit_receipt"}
      ]
    },
    "receipt_seal_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug", "shape_point", "binary_sha256", "source_commit",
        "kernel_signature_sha256", "arch", "ncu_metric_version"
      ],
      "properties": {
        "slug": {"type": "string", "pattern": "^vendor_.*_cutlass$"},
        "shape_point": {"const": "trace_00"},
        "binary_sha256": {"$ref": "#/$defs/sha256"},
        "source_commit": {"const": "237f17cd34728b31ea752062e7ea7843a3a2603a"},
        "kernel_signature_sha256": {"$ref": "#/$defs/sha256"},
        "arch": {"const": "sm_86"},
        "ncu_metric_version": {"const": "ncu_2026.1.x"}
      }
    },
    "dimensions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "integer", "minimum": 1}
    },
    "launch_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "launch_index", "kernel_name", "kernel_signature_sha256",
        "grid_dim", "block_dim", "launch_identity_sha256"
      ],
      "properties": {
        "launch_index": {"const": 0},
        "kernel_name": {"type": "string", "minLength": 1},
        "kernel_signature_sha256": {"$ref": "#/$defs/sha256"},
        "grid_dim": {"$ref": "#/$defs/dimensions"},
        "block_dim": {"$ref": "#/$defs/dimensions"},
        "launch_identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "ncu_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture_producer_sha256", "phase_tool_sha256",
        "action_executor_sha256", "containment_supervisor_sha256"
      ],
      "properties": {
        "capture_producer_sha256": {"$ref": "#/$defs/sha256"},
        "phase_tool_sha256": {"$ref": "#/$defs/sha256"},
        "action_executor_sha256": {"$ref": "#/$defs/sha256"},
        "containment_supervisor_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "nvbit_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture_producer_sha256", "phase_tool_sha256",
        "runtime_manifest_sha256", "containment_supervisor_sha256",
        "external_build_authority"
      ],
      "properties": {
        "capture_producer_sha256": {"$ref": "#/$defs/sha256"},
        "phase_tool_sha256": {"$ref": "#/$defs/sha256"},
        "runtime_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "containment_supervisor_sha256": {"$ref": "#/$defs/sha256"},
        "external_build_authority": {"$ref": "#/$defs/external_build_authority"}
      }
    },
    "external_build_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_kind", "expected_tracer_sha256", "source_commit_sha1",
        "source_tree_sha1", "source_inventory_sha256",
        "source_manifest_sha256", "build_receipt_sha256",
        "artifact_identity_sha256"
      ],
      "properties": {
        "authority_kind": {"const": "independent_reviewed_candidate_sha256.v1"},
        "expected_tracer_sha256": {"$ref": "#/$defs/sha256"},
        "source_commit_sha1": {"$ref": "#/$defs/commit"},
        "source_tree_sha1": {"$ref": "#/$defs/commit"},
        "source_inventory_sha256": {"$ref": "#/$defs/sha256"},
        "source_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "build_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "containment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "parent_cgroup_sha256", "cgroup_inode",
        "terminal_populated_zero", "leaf_removed"
      ],
      "properties": {
        "kind": {"const": "cgroup_v2_kill_v1"},
        "parent_cgroup_sha256": {"$ref": "#/$defs/sha256"},
        "cgroup_inode": {"type": "integer", "minimum": 1},
        "terminal_populated_zero": {"const": true},
        "leaf_removed": {"const": true}
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_identity_sha256", "boot_id_sha256", "pid",
        "started_at_utc", "command_sha256", "containment",
        "process_identity_sha256"
      ],
      "properties": {
        "host_identity_sha256": {"$ref": "#/$defs/sha256"},
        "boot_id_sha256": {"$ref": "#/$defs/sha256"},
        "pid": {"type": "integer", "minimum": 1},
        "started_at_utc": {"type": "string", "format": "date-time"},
        "command_sha256": {"$ref": "#/$defs/sha256"},
        "containment": {"$ref": "#/$defs/containment"},
        "process_identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "ncu_semantic_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_kind", "primary_metric", "secondary_metric",
        "primary_metric_present", "secondary_metric_present", "target_only",
        "simulator_config_present"
      ],
      "properties": {
        "semantic_kind": {"const": "ncu_metric_validation"},
        "primary_metric": {"const": "gpc__cycles_elapsed.max"},
        "secondary_metric": {"const": "gpu__time_duration.sum"},
        "primary_metric_present": {"const": true},
        "secondary_metric_present": {"const": true},
        "target_only": {"const": true},
        "simulator_config_present": {"const": false}
      }
    },
    "descriptor_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_0", "CUDA_INJECTION64_PATH", "TRACES_FOLDER"],
      "properties": {
        "command_0": {"const": "capture_target"},
        "CUDA_INJECTION64_PATH": {"const": "phase_tool"},
        "TRACES_FOLDER": {"const": "trace_root"}
      }
    },
    "nvbit_semantic_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_kind", "trace_contract_status", "dynamic_trace_role",
        "summary_role", "descriptor_bindings", "target_only",
        "simulator_config_present"
      ],
      "properties": {
        "semantic_kind": {"const": "nvbit_trace_validation"},
        "trace_contract_status": {"const": "pass"},
        "dynamic_trace_role": {"const": "dynamic_trace"},
        "summary_role": {"const": "trace_summary"},
        "descriptor_bindings": {"$ref": "#/$defs/descriptor_bindings"},
        "target_only": {"const": true},
        "simulator_config_present": {"const": false}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "sha256", "size_bytes"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "path": {"$ref": "#/$defs/relative_path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "ncu_artifact": {
      "allOf": [
        {"$ref": "#/$defs/artifact"},
        {
          "type": "object",
          "properties": {
            "role": {
              "enum": [
                "ncu_report", "label_sidecar", "label_run_manifest",
                "ncu_launch_observation", "preflight", "environment"
              ]
            }
          }
        }
      ]
    },
    "nvbit_artifact": {
      "allOf": [
        {"$ref": "#/$defs/artifact"},
        {
          "type": "object",
          "properties": {
            "role": {"enum": ["dynamic_trace", "stats", "threadblock", "trace_summary", "trace_auxiliary", "phase_tool", "runtime_manifest", "external_build_source_manifest", "external_build_receipt", "external_build_artifact_identity", "preflight", "environment"]}
          }
        }
      ]
    },
    "ncu_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture_kind", "status", "matrix_key", "variant_id", "identity",
        "launch_identity", "process", "provenance", "captured_at_utc", "preflight_path",
        "preflight_sha256", "environment_sha256", "command", "command_sha256",
        "semantic_validation", "artifacts"
      ],
      "properties": {
        "capture_kind": {"const": "ncu"},
        "status": {"const": "pass"},
        "matrix_key": {"type": "string", "pattern": "^cutlass_successor:[a-z0-9_]+_cublas:[a-z0-9_]+_cutlass$"},
        "variant_id": {"type": "string", "pattern": "^[a-z0-9_]+_v1$"},
        "identity": {"$ref": "#/$defs/identity"},
        "launch_identity": {"$ref": "#/$defs/launch_identity"},
        "process": {"$ref": "#/$defs/process"},
        "provenance": {"$ref": "#/$defs/ncu_provenance"},
        "captured_at_utc": {"type": "string", "format": "date-time"},
        "preflight_path": {"$ref": "#/$defs/relative_path"},
        "preflight_sha256": {"$ref": "#/$defs/sha256"},
        "environment_sha256": {"$ref": "#/$defs/sha256"},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "command_sha256": {"$ref": "#/$defs/sha256"},
        "semantic_validation": {"$ref": "#/$defs/ncu_semantic_validation"},
        "artifacts": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "allOf": [
            {
              "contains": {
                "type": "object",
                "required": ["role"],
                "properties": {"role": {"const": "ncu_report"}}
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": ["role"],
                "properties": {"role": {"const": "label_sidecar"}}
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": ["role"],
                "properties": {"role": {"const": "label_run_manifest"}}
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": ["role"],
                "properties": {"role": {"const": "ncu_launch_observation"}}
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": ["role"],
                "properties": {"role": {"const": "preflight"}}
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": ["role"],
                "properties": {"role": {"const": "environment"}}
              },
              "minContains": 1,
              "maxContains": 1
            }
          ],
          "items": {"$ref": "#/$defs/ncu_artifact"}
        }
      }
    },
    "nvbit_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture_kind", "status", "matrix_key", "variant_id", "identity",
        "launch_identity", "process", "provenance", "captured_at_utc", "preflight_path",
        "preflight_sha256", "environment_sha256", "command", "command_sha256",
        "semantic_validation", "artifacts"
      ],
      "properties": {
        "capture_kind": {"const": "nvbit"},
        "status": {"const": "pass"},
        "matrix_key": {"type": "string", "pattern": "^cutlass_successor:[a-z0-9_]+_cublas:[a-z0-9_]+_cutlass$"},
        "variant_id": {"type": "string", "pattern": "^[a-z0-9_]+_v1$"},
        "identity": {"$ref": "#/$defs/identity"},
        "launch_identity": {"$ref": "#/$defs/launch_identity"},
        "process": {"$ref": "#/$defs/process"},
        "provenance": {"$ref": "#/$defs/nvbit_provenance"},
        "captured_at_utc": {"type": "string", "format": "date-time"},
        "preflight_path": {"$ref": "#/$defs/relative_path"},
        "preflight_sha256": {"$ref": "#/$defs/sha256"},
        "environment_sha256": {"$ref": "#/$defs/sha256"},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "command_sha256": {"$ref": "#/$defs/sha256"},
        "semantic_validation": {"$ref": "#/$defs/nvbit_semantic_validation"},
        "artifacts": {
          "type": "array",
          "minItems": 11,
          "allOf": [
            {
              "contains": {
                "type": "object",
                "required": ["role"],
                "properties": {"role": {"const": "dynamic_trace"}}
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": ["role"],
                "properties": {"role": {"const": "stats"}}
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": ["role"],
                "properties": {"role": {"const": "threadblock"}}
              },
              "minContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": ["role"],
                "properties": {"role": {"const": "trace_summary"}}
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": ["role"],
                "properties": {"role": {"const": "phase_tool"}}
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": ["role"],
                "properties": {"role": {"const": "runtime_manifest"}}
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": ["role"],
                "properties": {"role": {"const": "external_build_source_manifest"}}
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": ["role"],
                "properties": {"role": {"const": "external_build_receipt"}}
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": ["role"],
                "properties": {"role": {"const": "external_build_artifact_identity"}}
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": ["role"],
                "properties": {"role": {"const": "preflight"}}
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": ["role"],
                "properties": {"role": {"const": "environment"}}
              },
              "minContains": 1,
              "maxContains": 1
            }
          ],
          "items": {"$ref": "#/$defs/nvbit_artifact"}
        }
      }
    }
  }
}

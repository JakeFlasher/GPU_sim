{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simbench_bw/schemas/sol_live_workload_coverage_inventory.schema.json",
  "title": "Current row-granular SOL live coverage inventory",
  "description": "Separates architecture inapplicability, full-native scheduling, partial-native row evidence, non-native reduced proxies, and exact evidence-backed unscheduled rows for all 3,957 current SOL workload rows.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_id", "arch", "sku", "source_commit",
    "claim_policy", "inputs", "counts", "schedule_state_counts",
    "by_category", "problems", "rows"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_id": {"const": "sm86_sol_live_workload_coverage_inventory_v1"},
    "arch": {"const": "sm_86"},
    "sku": {"const": "rtx_3090_ti"},
    "source_commit": {"$ref": "#/$defs/commit"},
    "claim_policy": {"$ref": "#/$defs/claimPolicy"},
    "inputs": {"$ref": "#/$defs/inputs"},
    "counts": {"$ref": "#/$defs/counts"},
    "schedule_state_counts": {"$ref": "#/$defs/stateCounts"},
    "by_category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["FIB", "L1", "L2", "Quant"],
      "properties": {
        "FIB": {"$ref": "#/$defs/categoryCounts"},
        "L1": {"$ref": "#/$defs/categoryCounts"},
        "L2": {"$ref": "#/$defs/categoryCounts"},
        "Quant": {"$ref": "#/$defs/categoryCounts"}
      }
    },
    "problems": {
      "type": "array",
      "minItems": 235,
      "maxItems": 235,
      "items": {"$ref": "#/$defs/problem"}
    },
    "rows": {
      "type": "array",
      "minItems": 3957,
      "maxItems": 3957,
      "items": {"$ref": "#/$defs/row"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "directChild": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/\\\\]+$",
      "not": {"enum": [".", ".."]}
    },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "owner_seal_sha256"],
      "properties": {
        "name": {"$ref": "#/$defs/directChild"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "owner_seal_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "externalInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "owner"],
      "properties": {
        "name": {"$ref": "#/$defs/directChild"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "owner": {"$ref": "#/$defs/owner"}
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matrix", "runnability", "shrink", "port_scope",
        "benchmark_workloads"
      ],
      "properties": {
        "matrix": {"$ref": "#/$defs/externalInput"},
        "runnability": {"$ref": "#/$defs/externalInput"},
        "shrink": {"$ref": "#/$defs/externalInput"},
        "port_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {"$ref": "#/$defs/repoPath"},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "benchmark_workloads": {
          "type": "object",
          "additionalProperties": false,
          "required": ["root", "file_count", "manifest_sha256"],
          "properties": {
            "root": {"$ref": "#/$defs/repoPath"},
            "file_count": {"const": 235},
            "manifest_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "claimPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture_inapplicable_is_not_native_failure",
        "partial_native_is_row_only", "reduced_proxy_is_not_native_predictive",
        "trace_completeness_requires_separate_done_evidence"
      ],
      "properties": {
        "architecture_inapplicable_is_not_native_failure": {"const": true},
        "partial_native_is_row_only": {"const": true},
        "reduced_proxy_is_not_native_predictive": {"const": true},
        "trace_completeness_requires_separate_done_evidence": {"const": true}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problems", "source_workload_rows",
        "architecture_inapplicable_problems", "architecture_inapplicable_rows",
        "in_scope_problems", "in_scope_rows", "matrix_schedule_rows",
        "source_rows_with_any_schedule", "source_rows_unscheduled_in_scope",
        "native_scheduled_rows", "partial_native_scheduled_rows",
        "reduced_proxy_scheduled_rows",
        "partial_native_and_reduced_proxy_scheduled_rows"
      ],
      "properties": {
        "problems": {"const": 235},
        "source_workload_rows": {"const": 3957},
        "architecture_inapplicable_problems": {"const": 34},
        "architecture_inapplicable_rows": {"const": 537},
        "in_scope_problems": {"const": 201},
        "in_scope_rows": {"const": 3420},
        "matrix_schedule_rows": {"type": "integer", "minimum": 0},
        "source_rows_with_any_schedule": {"type": "integer", "minimum": 0, "maximum": 3420},
        "source_rows_unscheduled_in_scope": {"type": "integer", "minimum": 0, "maximum": 3420},
        "native_scheduled_rows": {"type": "integer", "minimum": 0},
        "partial_native_scheduled_rows": {"type": "integer", "minimum": 0},
        "reduced_proxy_scheduled_rows": {"type": "integer", "minimum": 0},
        "partial_native_and_reduced_proxy_scheduled_rows": {"type": "integer", "minimum": 0}
      }
    },
    "state": {
      "enum": [
        "architecture_inapplicable", "in_scope_unscheduled",
        "native_scheduled", "partial_native_scheduled",
        "reduced_proxy_scheduled",
        "partial_native_and_reduced_proxy_scheduled"
      ]
    },
    "stateCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture_inapplicable", "in_scope_unscheduled",
        "native_scheduled", "partial_native_scheduled",
        "reduced_proxy_scheduled",
        "partial_native_and_reduced_proxy_scheduled"
      ],
      "properties": {
        "architecture_inapplicable": {"const": 537},
        "in_scope_unscheduled": {"type": "integer", "minimum": 0},
        "native_scheduled": {"type": "integer", "minimum": 0},
        "partial_native_scheduled": {"type": "integer", "minimum": 0},
        "reduced_proxy_scheduled": {"type": "integer", "minimum": 0},
        "partial_native_and_reduced_proxy_scheduled": {"type": "integer", "minimum": 0}
      }
    },
    "categoryCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problems", "source_workload_rows", "source_rows_with_any_schedule",
        "source_rows_unscheduled"
      ],
      "properties": {
        "problems": {"type": "integer", "minimum": 0},
        "source_workload_rows": {"type": "integer", "minimum": 0},
        "source_rows_with_any_schedule": {"type": "integer", "minimum": 0},
        "source_rows_unscheduled": {"type": "integer", "minimum": 0}
      }
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category", "slug", "architecture_reason", "runnability_status",
        "source_workload_row_count", "matrix_schedule_row_count",
        "source_rows_with_any_schedule", "source_rows_unscheduled",
        "schedule_state_counts"
      ],
      "properties": {
        "category": {"enum": ["FIB", "L1", "L2", "Quant"]},
        "slug": {"type": "string", "pattern": "^problem_[0-9]{3}_.+$"},
        "architecture_reason": {
          "type": ["string", "null"],
          "enum": [null, "fp8_e4m3_contract", "nvfp4_e2m1_contract"]
        },
        "runnability_status": {"type": ["string", "null"]},
        "source_workload_row_count": {"type": "integer", "minimum": 1},
        "matrix_schedule_row_count": {"type": "integer", "minimum": 0},
        "source_rows_with_any_schedule": {"type": "integer", "minimum": 0},
        "source_rows_unscheduled": {"type": "integer", "minimum": 0},
        "schedule_state_counts": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/state"},
          "additionalProperties": {"type": "integer", "minimum": 1}
        }
      }
    },
    "matrixRowKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "source_workload_uuid", "variant_id"],
      "properties": {
        "slug": {"type": "string", "minLength": 1},
        "source_workload_uuid": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{32}|[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})$"
        },
        "variant_id": {"type": "string", "minLength": 1}
      }
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code", "architecture_reason", "runnability_status",
        "diagnostic_present", "diagnostic_status", "shrink_classification",
        "shrink_planning_status", "shrink_correctness_result",
        "shrink_reduced_run_status", "shrink_planning_reason",
        "reason_evidence_sha256"
      ],
      "properties": {
        "code": {"enum": ["architecture_inapplicable", "no_admitted_capture_variant"]},
        "architecture_reason": {"type": ["string", "null"]},
        "runnability_status": {"type": ["string", "null"]},
        "diagnostic_present": {"type": ["boolean", "null"]},
        "diagnostic_status": {"type": ["string", "null"]},
        "shrink_classification": {"type": ["string", "null"]},
        "shrink_planning_status": {"type": ["string", "null"]},
        "shrink_correctness_result": {"type": ["string", "null"]},
        "shrink_reduced_run_status": {"type": ["string", "null"]},
        "shrink_planning_reason": {"type": ["string", "null"]},
        "reason_evidence_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category", "slug", "source_workload_index", "source_workload_uuid",
        "source_axes", "source_row_sha256", "schedule_state",
        "schedule_cohorts", "matrix_row_keys",
        "native_problem_level_runnable", "native_row_passed",
        "reduced_proxy_only", "unscheduled_reason"
      ],
      "properties": {
        "category": {"enum": ["FIB", "L1", "L2", "Quant"]},
        "slug": {"type": "string", "pattern": "^problem_[0-9]{3}_.+$"},
        "source_workload_index": {"type": "integer", "minimum": 0},
        "source_workload_uuid": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{32}|[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})$"
        },
        "source_axes": {
          "type": "object",
          "additionalProperties": {"type": "integer"}
        },
        "source_row_sha256": {"$ref": "#/$defs/sha256"},
        "schedule_state": {"$ref": "#/$defs/state"},
        "schedule_cohorts": {
          "type": "array", "uniqueItems": true, "maxItems": 2,
          "items": {"enum": ["native", "partial_native_row", "reduced_proxy"]}
        },
        "matrix_row_keys": {
          "type": "array", "uniqueItems": true, "maxItems": 2,
          "items": {"$ref": "#/$defs/matrixRowKey"}
        },
        "native_problem_level_runnable": {"type": "boolean"},
        "native_row_passed": {"type": "boolean"},
        "reduced_proxy_only": {"type": "boolean"},
        "unscheduled_reason": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/reason"}]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "schedule_state": {
                "enum": ["architecture_inapplicable", "in_scope_unscheduled"]
              }
            },
            "required": ["schedule_state"]
          },
          "then": {
            "properties": {
              "schedule_cohorts": {"maxItems": 0},
              "matrix_row_keys": {"maxItems": 0},
              "unscheduled_reason": {"$ref": "#/$defs/reason"}
            }
          },
          "else": {
            "properties": {
              "schedule_cohorts": {"minItems": 1},
              "matrix_row_keys": {"minItems": 1},
              "unscheduled_reason": {"type": "null"}
            }
          }
        }
      ]
    }
  }
}

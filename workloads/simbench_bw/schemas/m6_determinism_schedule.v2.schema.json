{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simbench_bw/schemas/m6_determinism_schedule.v2.schema.json",
  "title": "M6 determinism schedule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "schedule_id",
    "generated_at_utc",
    "seed",
    "shuffle_algorithm",
    "source_identity",
    "source_identity_sha256",
    "config_identity_sha256",
    "metric_identity_sha256",
    "m4_identity",
    "configs",
    "metrics",
    "cells",
    "policy",
    "cost_gate",
    "slots",
    "tier2_candidates",
    "counts",
    "slots_sha256",
    "tier2_candidates_sha256",
    "schedule_sha256"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "artifact_kind": {
      "type": "string",
      "const": "m6_determinism_schedule"
    },
    "schedule_id": {
      "type": "string",
      "pattern": "^m6-determinism-[0-9a-f]{16}$"
    },
    "generated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "shuffle_algorithm": {
      "type": "string",
      "const": "sha256_seeded_sweep_v1"
    },
    "source_identity": {
      "$ref": "#/$defs/sourceIdentity"
    },
    "source_identity_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "config_identity_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "metric_identity_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "m4_identity": {
      "$ref": "#/$defs/m4Identity"
    },
    "configs": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/config"
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 61,
      "maxItems": 61,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/metric"
      }
    },
    "cells": {
      "type": "array",
      "minItems": 122,
      "maxItems": 122,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/cell"
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_config_id",
        "reference_tier1_repeats",
        "other_tier1_repeats",
        "tier2_additional_reference_repeats",
        "fresh_process_per_profile",
        "adaptive_dispersion_stopping",
        "cross_day_replication",
        "trigger_codes"
      ],
      "properties": {
        "reference_config_id": {
          "type": "string",
          "const": "cfg=clock_none__cache_all"
        },
        "reference_tier1_repeats": {
          "type": "integer",
          "const": 20
        },
        "other_tier1_repeats": {
          "type": "integer",
          "const": 10
        },
        "tier2_additional_reference_repeats": {
          "type": "integer",
          "const": 10
        },
        "fresh_process_per_profile": {
          "const": true
        },
        "adaptive_dispersion_stopping": {
          "const": false
        },
        "cross_day_replication": {
          "const": false
        },
        "trigger_codes": {
          "const": [
            "boundary_proximity",
            "discrete_multiple_values",
            "modality_flag",
            "out_of_range",
            "single_point_outlier"
          ]
        }
      }
    },
    "cost_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "max_new_profiles_per_resume",
        "completed_slots_recomputed",
        "conditioned_on_dispersion"
      ],
      "properties": {
        "unit": {
          "type": "string",
          "const": "fresh_profile_process"
        },
        "max_new_profiles_per_resume": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9760
        },
        "completed_slots_recomputed": {
          "const": false
        },
        "conditioned_on_dispersion": {
          "const": false
        }
      }
    },
    "slots": {
      "type": "array",
      "minItems": 8540,
      "maxItems": 8540,
      "items": {
        "$ref": "#/$defs/slot"
      },
      "uniqueItems": true
    },
    "tier2_candidates": {
      "type": "array",
      "minItems": 1220,
      "maxItems": 1220,
      "items": {
        "$ref": "#/$defs/slot"
      },
      "uniqueItems": true
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_cells",
        "runnable_cells",
        "excluded_cells",
        "configs",
        "selected_metrics",
        "registry_metrics",
        "tier1_slots",
        "tier2_candidate_slots",
        "maximum_slots",
        "tier1_fresh_processes",
        "maximum_fresh_processes"
      ],
      "properties": {
        "canonical_cells": {
          "type": "integer",
          "const": 344
        },
        "runnable_cells": {
          "type": "integer",
          "const": 122
        },
        "excluded_cells": {
          "type": "integer",
          "const": 222
        },
        "configs": {
          "type": "integer",
          "const": 6
        },
        "selected_metrics": {
          "type": "integer",
          "const": 55
        },
        "registry_metrics": {
          "type": "integer",
          "const": 61
        },
        "tier1_slots": {
          "type": "integer",
          "const": 8540
        },
        "tier2_candidate_slots": {
          "type": "integer",
          "const": 1220
        },
        "maximum_slots": {
          "type": "integer",
          "const": 9760
        },
        "tier1_fresh_processes": {
          "type": "integer",
          "const": 8540
        },
        "maximum_fresh_processes": {
          "type": "integer",
          "const": 9760
        }
      }
    },
    "slots_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "tier2_candidates_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "schedule_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?!.*(?:^|/)\\./)(?!.*(?:/|/)$)(?!.*\\\\).+$"
    },
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "namedFileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "frozenFileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "source_commit",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "source_commit": {
          "$ref": "#/$defs/commit"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_matrix",
        "matrix_schema",
        "roster_authority",
        "matrix_input_pins",
        "frozen_metric_registry",
        "frozen_sidecar_schema",
        "metric_registry",
        "sidecar_schema",
        "availability_probe",
        "controller_source",
        "stats_source",
        "immutable_helper",
        "m6_schemas",
        "active_m6_schemas",
        "matrix_id",
        "matrix_seal_sha256",
        "matrix_source_commit",
        "roster_authority_sha256",
        "runnable_membership_sha256",
        "sidecar_schema_version",
        "registry_version",
        "label_schema_version"
      ],
      "properties": {
        "canonical_matrix": {
          "$ref": "#/$defs/fileIdentity"
        },
        "matrix_schema": {
          "$ref": "#/$defs/fileIdentity"
        },
        "roster_authority": {
          "$ref": "#/$defs/fileIdentity"
        },
        "matrix_input_pins": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/namedFileIdentity"
          }
        },
        "frozen_metric_registry": {
          "$ref": "#/$defs/frozenFileIdentity"
        },
        "frozen_sidecar_schema": {
          "$ref": "#/$defs/frozenFileIdentity"
        },
        "metric_registry": {
          "$ref": "#/$defs/fileIdentity"
        },
        "sidecar_schema": {
          "$ref": "#/$defs/fileIdentity"
        },
        "availability_probe": {
          "$ref": "#/$defs/fileIdentity"
        },
        "controller_source": {
          "$ref": "#/$defs/fileIdentity"
        },
        "stats_source": {
          "$ref": "#/$defs/fileIdentity"
        },
        "immutable_helper": {
          "$ref": "#/$defs/fileIdentity"
        },
        "m6_schemas": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/fileIdentity"
          }
        },
        "active_m6_schemas": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/fileIdentity"
          },
          "uniqueItems": true
        },
        "matrix_id": {
          "type": "string",
          "const": "sm86_reference_capture_matrix_v1"
        },
        "matrix_seal_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "matrix_source_commit": {
          "$ref": "#/$defs/commit"
        },
        "roster_authority_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "runnable_membership_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sidecar_schema_version": {
          "type": "integer",
          "const": 5
        },
        "registry_version": {
          "type": "integer",
          "const": 2
        },
        "label_schema_version": {
          "type": "integer",
          "const": 5
        }
      }
    },
    "m4Identity": {
      "oneOf": [
        {
          "$ref": "#/$defs/m4Incomplete"
        },
        {
          "$ref": "#/$defs/m4Complete"
        }
      ]
    },
    "m4Incomplete": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "archive_root",
        "matrix_seal_sha256",
        "roster_authority_sha256",
        "runnable_membership_sha256",
        "protocol_version",
        "expected_cells",
        "completed_cells",
        "chunk_done_manifests",
        "cell_launch_identities",
        "identity_sha256"
      ],
      "properties": {
        "status": {
          "type": "string",
          "const": "incomplete"
        },
        "archive_root": {
          "type": "null"
        },
        "matrix_seal_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "roster_authority_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "runnable_membership_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "protocol_version": {
          "type": "string",
          "const": "2.1"
        },
        "expected_cells": {
          "type": "integer",
          "const": 122
        },
        "completed_cells": {
          "type": "integer",
          "const": 0
        },
        "chunk_done_manifests": {
          "type": "array",
          "maxItems": 0
        },
        "cell_launch_identities": {
          "type": "array",
          "maxItems": 0
        },
        "identity_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "m4Complete": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "artifact_kind",
        "generated_at_utc",
        "status",
        "archive_root",
        "source_commit",
        "capture_matrix_sha256",
        "preflight_sha256s",
        "preflight_set_sha256",
        "matrix_seal_sha256",
        "roster_authority_sha256",
        "runnable_membership_sha256",
        "protocol_version",
        "expected_cells",
        "completed_cells",
        "chunk_done_manifests",
        "cell_launch_identities",
        "identity_sha256"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "artifact_kind": {
          "type": "string",
          "const": "m6_verified_m4_binding"
        },
        "generated_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "const": "complete"
        },
        "archive_root": {
          "type": "string",
          "pattern": "^/",
          "minLength": 2
        },
        "source_commit": {
          "$ref": "#/$defs/commit"
        },
        "capture_matrix_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "preflight_sha256s": {
          "type": "array",
          "minItems": 1,
          "maxItems": 18,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "preflight_set_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "matrix_seal_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "roster_authority_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "runnable_membership_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "active_sidecar_schema": {
          "$ref": "#/$defs/fileIdentity"
        },
        "protocol_version": {
          "type": "string",
          "const": "2.1"
        },
        "expected_cells": {
          "type": "integer",
          "const": 122
        },
        "completed_cells": {
          "type": "integer",
          "const": 122
        },
        "chunk_done_manifests": {
          "type": "array",
          "minItems": 18,
          "maxItems": 18,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/m4Chunk"
          }
        },
        "cell_launch_identities": {
          "type": "array",
          "minItems": 122,
          "maxItems": 122,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/m4Cell"
          }
        },
        "identity_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "m4Chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chunk_id",
        "membership_sha256",
        "done_path",
        "done_sha256",
        "done_size_bytes",
        "source_commit",
        "capture_matrix_sha256",
        "preflight_sha256",
        "cell_count"
      ],
      "properties": {
        "chunk_id": {
          "type": "string",
          "minLength": 1
        },
        "membership_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "done_path": {
          "$ref": "#/$defs/relativePath"
        },
        "done_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "done_size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "source_commit": {
          "$ref": "#/$defs/commit"
        },
        "capture_matrix_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "preflight_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "cell_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        }
      }
    },
    "m4Cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_id",
        "cell_identity_sha256",
        "authority_cell_sha256",
        "binary_sha256",
        "launch_set_sha256",
        "launches"
      ],
      "properties": {
        "cell_id": {
          "type": "string",
          "minLength": 3
        },
        "cell_identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "authority_cell_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "binary_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "launch_set_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "launches": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/m4Launch"
          }
        }
      }
    },
    "m4Launch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "launch_index",
        "launch_identity_sha256",
        "kernel_name",
        "kernel_signature_sha256",
        "kernel_signature_source",
        "label_sidecar_sha256",
        "label_run_manifest_sha256",
        "label_capture_manifest_sha256",
        "ncu_launch_observation_sha256",
        "ncu_observation_sha256",
        "ncu_report_sha256"
      ],
      "properties": {
        "launch_index": {
          "type": "integer",
          "minimum": 0
        },
        "launch_identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "kernel_name": {
          "type": "string",
          "minLength": 1
        },
        "kernel_signature_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "kernel_signature_source": {
          "type": "string",
          "minLength": 1
        },
        "label_sidecar_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "label_run_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "label_capture_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "ncu_launch_observation_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "ncu_observation_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "ncu_report_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config_id",
        "clock_control",
        "cache_control",
        "replay_mode",
        "target_processes",
        "filter_mode",
        "profile_from_start",
        "reference",
        "tier1_repeats",
        "fresh_process_per_profile",
        "config_sha256"
      ],
      "properties": {
        "config_id": {
          "type": "string",
          "pattern": "^cfg=clock_(none|base|boost)__cache_(all|none)$"
        },
        "clock_control": {
          "type": "string",
          "enum": [
            "none",
            "base",
            "boost"
          ]
        },
        "cache_control": {
          "type": "string",
          "enum": [
            "all",
            "none"
          ]
        },
        "replay_mode": {
          "type": "string",
          "const": "kernel"
        },
        "target_processes": {
          "type": "string",
          "const": "all"
        },
        "filter_mode": {
          "type": "string",
          "const": "global"
        },
        "profile_from_start": {
          "const": false
        },
        "reference": {
          "type": "boolean"
        },
        "tier1_repeats": {
          "type": "integer",
          "enum": [
            10,
            20
          ]
        },
        "fresh_process_per_profile": {
          "const": true
        },
        "config_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "ncu_metric",
        "unit",
        "carrier",
        "sidecar_field",
        "family",
        "metric_class",
        "parser_transform",
        "model_io_role",
        "deployability",
        "probe_linkage",
        "probe_backed",
        "statistical_domain",
        "resolution_semantics",
        "statistical_contract_sha256",
        "repeatability_rule",
        "admission_threshold",
        "valid_min",
        "valid_max",
        "absolute_resolution",
        "capture_status",
        "metric_sha256"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "ncu_metric": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "enum": [
            "pct",
            "count",
            "ns",
            "cycles"
          ]
        },
        "carrier": {
          "type": "string",
          "enum": [
            "flat_field",
            "unit_tagged_metric"
          ]
        },
        "sidecar_field": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "metric_class": {
          "type": "string",
          "minLength": 1
        },
        "parser_transform": {
          "type": "string",
          "minLength": 1
        },
        "model_io_role": {
          "type": "string",
          "enum": [
            "target",
            "input"
          ]
        },
        "deployability": {
          "type": "string",
          "minLength": 1
        },
        "probe_linkage": {
          "type": "string",
          "minLength": 1
        },
        "probe_backed": {
          "type": "boolean"
        },
        "statistical_domain": {
          "type": "string",
          "enum": [
            "continuous",
            "discrete"
          ]
        },
        "resolution_semantics": {
          "type": "string",
          "minLength": 1
        },
        "statistical_contract_sha256": {

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simbench_bw/schemas/ac4_long_duration_timing_cohort.schema.json",
  "title": "Long-duration (>= ~552 us) timing cohort (scoped, additive)",
  "description": "A SCOPED, additive timing-cohort artifact emitted by tools/local_labels/capture_long_timing_cohort.py: >= 10 sm_86 cells, ALL against ONE binary identity (one binary_sha256, one source_commit, one kernel-signature family from one kernel), each produced by running the same binary at a distinct timing shape override so only the launch geometry varies. Each cell carries the four NCU labels (gpc__cycles_elapsed.max cycles, gpu__time_duration.sum ns, l1tex__t_sector_hit_rate.pct L1, lts__t_sector_hit_rate.pct L2) gated by per-unit repeatability (cycles/ns CV<=0.05, hit-rate fractions stddev<=0.03, or the same threshold over a dominant cluster when cache-control produces isolated hit-rate mode outliers) over n_repeats repeats, and its median gpu__time_duration.sum clears floor_ns. Kept OUT of root label_admitted.json until closure (DEC-5) so the root timing-invariant and the frozen-L2 / sm_120 freeze are never perturbed. additionalProperties:false at every layer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "arch",
    "scoped",
    "merged_into_root",
    "binary_sha256",
    "binary_path",
    "regs_per_thread",
    "source_commit",
    "floor_ns",
    "n_repeats",
    "metric_ids",
    "n_cells",
    "cells"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "artifact_kind": {"type": "string", "const": "ac4_long_duration_timing_cohort"},
    "arch": {"type": "string", "const": "sm_86"},
    "scoped": {"type": "boolean", "const": true, "description": "Always true: this artifact is scoped OUT of root label_admitted.json until closure."},
    "merged_into_root": {"type": "boolean", "description": "Whether these cells have been additively merged into the root cohort. False while scoped."},
    "binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binary_path": {"type": "string", "minLength": 1},
    "regs_per_thread": {"type": "integer", "minimum": 0},
    "source_commit": {"type": "string", "minLength": 1},
    "floor_ns": {"type": "integer", "exclusiveMinimum": 0},
    "n_repeats": {"type": "integer", "minimum": 2},
    "metric_ids": {
      "type": "array",
      "minItems": 4,
      "items": {"type": "string", "minLength": 1},
      "description": "The captured NCU metric ids (cycles, ns, L1 hit rate, L2 hit rate)."
    },
    "n_cells": {"type": "integer", "minimum": 0},
    "cells": {
      "type": "array",
      "items": {"$ref": "#/$defs/cell"}
    }
  },
  "$defs": {
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "case_id",
        "shape_point",
        "arch",
        "binary_path",
        "binary_sha256",
        "kernel_signature_sha256",
        "source_commit",
        "regs_per_thread",
        "run_args",
        "launch_geometry",
        "labels",
        "feature_artifacts"
      ],
      "properties": {
        "slug": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "case_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "shape_point": {"type": "string", "minLength": 1},
        "arch": {"type": "string", "const": "sm_86"},
        "binary_path": {"type": "string", "minLength": 1},
        "binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "kernel_signature_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_commit": {"type": "string", "minLength": 1},
        "regs_per_thread": {"type": "integer", "minimum": 0},
        "run_args": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "trace_window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["instr_begin", "instr_end"],
          "properties": {
            "instr_begin": {"type": "integer", "minimum": 0},
            "instr_end": {"type": "integer", "minimum": 0}
          }
        },
        "launch_geometry": {
          "type": "object",
          "additionalProperties": true,
          "required": ["kernel_name", "grid_x", "grid_y", "grid_z", "block_x", "block_y", "block_z", "shared_mem_static_bytes", "shared_mem_dynamic_bytes"],
          "properties": {
            "kernel_name": {"type": "string", "minLength": 1},
            "grid_x": {"type": "integer", "minimum": 1},
            "grid_y": {"type": "integer", "minimum": 1},
            "grid_z": {"type": "integer", "minimum": 1},
            "block_x": {"type": "integer", "minimum": 1},
            "block_y": {"type": "integer", "minimum": 1},
            "block_z": {"type": "integer", "minimum": 1},
            "shared_mem_static_bytes": {"type": "integer", "minimum": 0},
            "shared_mem_dynamic_bytes": {"type": "integer", "minimum": 0}
          }
        },
        "feature_artifacts": {"$ref": "#/$defs/feature_artifacts"},
        "labels": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gpc__cycles_elapsed.max",
            "gpu__time_duration.sum",
            "l1tex__t_sector_hit_rate.pct",
            "lts__t_sector_hit_rate.pct"
          ],
          "properties": {
            "gpc__cycles_elapsed.max": {"$ref": "#/$defs/label"},
            "gpu__time_duration.sum": {"$ref": "#/$defs/label"},
            "l1tex__t_sector_hit_rate.pct": {"$ref": "#/$defs/label"},
            "lts__t_sector_hit_rate.pct": {"$ref": "#/$defs/label"}
          }
        }
      }
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "artifact_kind"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "artifact_kind": {"type": "string", "minLength": 1}
      }
    },
    "feature_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nvbit_sector_summary",
        "static_sass_features",
        "static_work",
        "cache_hit_predictions"
      ],
      "properties": {
        "nvbit_sector_summary": {
          "allOf": [
            {"$ref": "#/$defs/artifact_ref"},
            {"properties": {"artifact_kind": {"const": "timing_nvbit_sector_summary"}}}
          ]
        },
        "static_sass_features": {
          "allOf": [
            {"$ref": "#/$defs/artifact_ref"},
            {"properties": {"artifact_kind": {"const": "static_sass_features"}}}
          ]
        },
        "static_work": {
          "allOf": [
            {"$ref": "#/$defs/artifact_ref"},
            {"properties": {"artifact_kind": {"const": "static_work"}}}
          ]
        },
        "cache_hit_predictions": {
          "allOf": [
            {"$ref": "#/$defs/artifact_ref"},
            {"properties": {"artifact_kind": {"const": "timing_cache_hit_prediction_bundle"}}}
          ]
        }
      }
    },
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "value", "dispersion", "rule", "threshold", "n_repeats"],
      "properties": {
        "unit": {"type": "string", "enum": ["cycles", "ns", "pct"]},
        "value": {"type": "number", "minimum": 0, "description": "Median over n_repeats repeats."},
        "dispersion": {"type": "number", "minimum": 0, "description": "CV (cv rule), raw stddev-of-fraction (stddev_frac rule), or dominant-cluster stddev-of-fraction; must be <= threshold."},
        "rule": {"type": "string", "enum": ["cv", "stddev_frac", "stddev_frac_dominant_cluster"]},
        "threshold": {"type": "number", "exclusiveMinimum": 0},
        "n_repeats": {"type": "integer", "minimum": 2}
      }
    }
  }
}

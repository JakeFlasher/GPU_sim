{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpu-simulator.invalid/schemas/m5_trust_anchor_registry.v1.schema.json",
  "title": "M5 v2 public trust-anchor registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_kind", "entries"],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_kind": {"const": "M5_TRUST_ANCHOR_REGISTRY"},
    "entries": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "safe_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "review_witness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_id", "sha256"],
      "properties": {
        "identity_id": {"$ref": "#/$defs/safe_id"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchor_id",
        "authority_domain",
        "trust_anchor_identity_id",
        "quantity_authority_identity_id",
        "algorithm",
        "public_key_sha256",
        "authority_sha256",
        "ancestry_identity_id",
        "ancestry_sha256",
        "review_witnesses",
        "operator_approval_identity_id",
        "operator_approval_sha256",
        "admission_basis"
      ],
      "properties": {
        "anchor_id": {"$ref": "#/$defs/safe_id"},
        "authority_domain": {"const": "sm86_m5_rule1_quantity_authority_v2"},
        "trust_anchor_identity_id": {"const": "m5-analysis-authority"},
        "quantity_authority_identity_id": {"const": "m5-quantity-authority-v2"},
        "algorithm": {"const": "Ed25519"},
        "public_key_sha256": {"$ref": "#/$defs/sha256"},
        "authority_sha256": {"$ref": "#/$defs/sha256"},
        "ancestry_identity_id": {"const": "m5-quantity-authority-ancestry"},
        "ancestry_sha256": {"$ref": "#/$defs/sha256"},
        "review_witnesses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/review_witness"}
        },
        "operator_approval_identity_id": {"const": "m5-quantity-authority-operator-approval"},
        "operator_approval_sha256": {"$ref": "#/$defs/sha256"},
        "admission_basis": {"const": "EXPLICIT_REVIEW_AND_OPERATOR_ACCEPTANCE"}
      }
    }
  }
}

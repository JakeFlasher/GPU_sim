{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simbench_bw/schemas/ncu_launch_metrics.schema.json",
  "title": "Ordered per-launch NCU metric observations",
  "type": "array",
  "minItems": 1,
  "maxItems": 2147483646,
  "items": {
    "$ref": "#/$defs/launchMetricObservation"
  },
  "$defs": {
    "metricName": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "finiteNonnegative": {
      "type": "number",
      "minimum": 0
    },
    "diagnosticRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_label",
        "raw_value"
      ],
      "properties": {
        "metric_label": {
          "$ref": "#/$defs/metricName"
        },
        "raw_value": {
          "$ref": "#/$defs/finiteNonnegative"
        }
      }
    },
    "parserDiagnostics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ncu_sector_hit_rate_clamped_to_100": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/diagnosticRecord"
          }
        },
        "ncu_lts_pct_overcount_raw_counter_ratio_used": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/diagnosticRecord"
          }
        }
      }
    },
    "unitTaggedMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "value"
      ],
      "properties": {
        "unit": {
          "type": "string",
          "enum": [
            "pct",
            "count",
            "ns",
            "cycles"
          ]
        },
        "value": {
          "$ref": "#/$defs/finiteNonnegative"
        }
      }
    },
    "launchMetricObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_launch_ordinal",
        "report_id",
        "fraction_values",
        "unit_tagged_metrics",
        "parser_diagnostics"
      ],
      "properties": {
        "report_launch_ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483645
        },
        "report_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "fraction_values": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/metricName"
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "unit_tagged_metrics": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/metricName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/unitTaggedMetric"
          }
        },
        "parser_diagnostics": {
          "$ref": "#/$defs/parserDiagnostics"
        }
      }
    }
  }
}

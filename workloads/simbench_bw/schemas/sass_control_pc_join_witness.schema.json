{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "sass_control_pc_join_witness",
  "description": "Live PC/vpc join witness: traced NVBit instruction PCs joined per cell to the static SASS control-bit extraction (pinned parser contract, fail-closed unknown_encoding). Cells or kernels that cannot join are typed, never silently skipped.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "arch",
    "source_commit",
    "n_cells",
    "n_full_join",
    "cells"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_kind": {"const": "sass_control_pc_join_witness"},
    "arch": {"type": "string", "minLength": 1},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "n_cells": {"type": "integer", "minimum": 1},
    "n_full_join": {"type": "integer", "minimum": 0},
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identity"],
        "properties": {
          "identity": {"type": "object"},
          "status": {"enum": ["typed"]},
          "typed_reason": {"type": "string"},
          "first_launch": {"type": "string"},
          "vpc_low32_mismatches": {"type": "integer", "minimum": 0},
          "n_instruction_records": {"type": "integer", "minimum": 0},
          "functions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["function_unique_id", "kernel_name",
                           "status"],
              "properties": {
                "function_unique_id": {"type": "integer"},
                "kernel_name": {"type": "string"},
                "sass_function": {"type": "string"},
                "status": {"enum": ["joined", "typed"]},
                "typed_reason": {
                  "enum": [
                    "kernel_sass_not_in_cell_binary",
                    "kernel_function_match_ambiguous"
                  ]
                },
                "detail": {"type": "string"},
                "n_matches": {"type": "integer", "minimum": 0},
                "n_traced_pcs": {"type": "integer", "minimum": 0},
                "n_joined": {"type": "integer", "minimum": 0},
                "n_decoded": {"type": "integer", "minimum": 0},
                "missing_pcs": {"type": "array",
                                "items": {"type": "integer"}},
                "sample": {"type": ["object", "null"]}
              }
            }
          },
          "coverage": {
            "type": "object",
            "additionalProperties": false,
            "required": ["n_traced_pcs", "n_joined", "n_decoded",
                         "full_join"],
            "properties": {
              "n_traced_pcs": {"type": "integer", "minimum": 0},
              "n_joined": {"type": "integer", "minimum": 0},
              "n_decoded": {"type": "integer", "minimum": 0},
              "full_join": {"type": "boolean"}
            }
          }
        }
      }
    }
  }
}

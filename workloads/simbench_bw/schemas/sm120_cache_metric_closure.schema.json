{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "sm120_cache_metric_closure",
  "description": "Terminal closure of the sm_120 broader counter-free cache-metric prediction effort: one terminal verdict per typed-registry cache/memory target. The named L2 sector hit-rate family is evaluated on the L1-miss-filtered replay; every other target closes by success-or-honest-falsification. The cache claim is load-bearing only if the named family clears the accuracy gate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "closure_id",
    "arch",
    "registry_version",
    "verdict",
    "cache_claim_load_bearing",
    "named_target",
    "named_target_gate",
    "named_l1_target",
    "named_l1_target_gate",
    "named_target_failure_decomposition",
    "evidence_artifact_paths",
    "targets",
    "target_counts",
    "verified_live_sm120_proof",
    "source_commit"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "closure_id": {"type": "string", "const": "sm120_cache_metric_closure_v1"},
    "arch": {"type": "string", "const": "sm_120"},
    "registry_version": {"type": "string", "const": "cache_memory_registry_v1"},
    "verdict": {"type": "string", "enum": ["research_success", "engineering_closure_refuted"]},
    "cache_claim_load_bearing": {"type": "boolean"},
    "named_target": {"type": "string", "const": "lts_sector_hit_rate"},
    "named_target_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["median_abs_error", "threshold_median_abs_error", "passed", "l2_input_provenance", "n_evaluated", "l1_filter_inert", "total_l1_eligible_misses", "total_l1_hits_absorbed", "cells_with_zero_l2_input"],
      "properties": {
        "median_abs_error": {"type": "number", "minimum": 0},
        "threshold_median_abs_error": {"type": "number", "exclusiveMinimum": 0},
        "passed": {"type": "boolean"},
        "l2_input_provenance": {"type": "string", "const": "l1_miss_filtered"},
        "n_evaluated": {"type": "integer", "minimum": 1},
        "l1_filter_inert": {"type": "boolean"},
        "total_l1_eligible_misses": {"type": "integer", "minimum": 0},
        "total_l1_hits_absorbed": {"type": "integer", "minimum": 0},
        "cells_with_zero_l2_input": {"type": "integer", "minimum": 0}
      }
    },
    "named_l1_target": {"type": "string", "const": "l1tex_sector_hit_rate"},
    "named_l1_target_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label_coverage", "evaluated", "unavailable", "median_abs_error", "threshold_median_abs_error", "passed", "l1_filter_inert"],
      "properties": {
        "label_coverage": {"type": "integer", "minimum": 0},
        "evaluated": {"type": "integer", "minimum": 0},
        "unavailable": {"type": "integer", "minimum": 0},
        "median_abs_error": {"type": ["number", "null"], "minimum": 0},
        "threshold_median_abs_error": {"type": "number", "exclusiveMinimum": 0},
        "passed": {"type": "boolean"},
        "l1_filter_inert": {"type": "boolean"}
      }
    },
    "named_target_failure_decomposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dominant_failure_mode", "l1_filter_inert", "total_l1_eligible_misses", "total_l1_hits_absorbed", "cells_with_zero_l2_input", "evidence", "promotion_trigger"],
      "properties": {
        "dominant_failure_mode": {"type": "string", "const": "sm120_l1_cache_op_classification_inert"},
        "l1_filter_inert": {"type": "boolean"},
        "total_l1_eligible_misses": {"type": "integer", "minimum": 0},
        "total_l1_hits_absorbed": {"type": "integer", "minimum": 0},
        "cells_with_zero_l2_input": {"type": "integer", "minimum": 0},
        "evidence": {"type": "string", "minLength": 1},
        "promotion_trigger": {"type": "string", "minLength": 1}
      }
    },
    "evidence_artifact_paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["l1_filtered_l2_comparison", "count_feasibility_analysis", "l1l2_frozen_grain_closure", "label_admitted"],
      "properties": {
        "l1_filtered_l2_comparison": {"type": "string", "const": "data/local_labels/sm120_l1_filtered_l2_comparison.json"},
        "count_feasibility_analysis": {"type": "string", "const": "data/local_labels/count_feasibility_analysis.json"},
        "l1l2_frozen_grain_closure": {"type": "string", "const": "data/local_labels/sm120_l1l2_frozen_grain_engineering_closure.json"},
        "label_admitted": {"type": "string", "const": "data/local_labels/label_admitted.json"}
      }
    },
    "targets": {
      "type": "array",
      "minItems": 22,
      "maxItems": 22,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_id", "kind", "verdict", "basis", "evidence_key", "cross_arch_precondition"],
        "properties": {
          "target_id": {"type": "string"},
          "kind": {"type": "string", "enum": ["fraction", "count", "ratio"]},
          "verdict": {"type": "string", "enum": ["research_success", "engineering_closure_refuted"]},
          "basis": {"type": "string", "minLength": 1},
          "evidence_key": {"type": "string", "enum": ["l1_filtered_l2_comparison", "count_feasibility_analysis", "l1l2_frozen_grain_closure", "label_admitted"]},
          "cross_arch_precondition": {"type": "boolean", "const": false}
        }
      }
    },
    "target_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "research_success", "engineering_closure_refuted"],
      "properties": {
        "total": {"type": "integer", "const": 22},
        "research_success": {"type": "integer", "minimum": 0},
        "engineering_closure_refuted": {"type": "integer", "minimum": 0}
      }
    },
    "verified_live_sm120_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gpu", "compute_capability", "driver", "cuda", "ncu", "evidence_kind"],
      "properties": {
        "gpu": {"type": "string"},
        "compute_capability": {"type": "string", "const": "sm_120"},
        "driver": {"type": "string"},
        "cuda": {"type": "string"},
        "ncu": {"type": "string"},
        "evidence_kind": {"type": "string", "minLength": 1}
      }
    },
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"}
  }
}

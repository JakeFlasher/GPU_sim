{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "t1_lockstep_verdict",
  "description": "Per-(cell, metric) T1 count-replacement verdict from the NCU lockstep validator: closed verdict vocabulary, closed-identity join only, achieved-vs-target statistics with denominator floors, HARD non-vacuity floor, per-op-class coverage report, and the sealed-holdout one-touch governance record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "arch",
    "source_commit",
    "validator_config",
    "validator_config_digest",
    "emissions_artifact",
    "labels_artifact",
    "holdout_governance",
    "verdicts",
    "verdict_counts",
    "statistics",
    "non_vacuity_floor",
    "coverage_report"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_kind": {"const": "t1_lockstep_verdict"},
    "arch": {"type": "string", "minLength": 1},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "validator_config": {"type": "object"},
    "validator_config_digest": {
      "type": "string", "pattern": "^[0-9a-f]{64}$"
    },
    "emissions_artifact": {"type": "string"},
    "labels_artifact": {"type": "string"},
    "holdout_governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sealed_digest", "scope", "holdout_scoring_touches",
        "tuning_trail"
      ],
      "properties": {
        "sealed_digest": {"type": "string", "minLength": 16},
        "scope": {"type": "string", "minLength": 1},
        "holdout_scoring_touches": {"const": 1},
        "tuning_trail": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tunable_parameters", "tuned_on", "note"],
          "properties": {
            "tunable_parameters": {"const": "none"},
            "tuned_on": {"const": "none"},
            "note": {"type": "string"}
          }
        }
      }
    },
    "verdicts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "shape_point", "holdout", "ncu_metric",
                     "verdict"],
        "properties": {
          "slug": {"type": "string", "minLength": 1},
          "shape_point": {"type": "string", "minLength": 1},
          "variant_id": {"type": "string"},
          "holdout": {"type": "boolean"},
          "ncu_metric": {"type": "string", "minLength": 1},
          "verdict": {
            "enum": [
              "replacement_pass", "replacement_miss", "low_support",
              "contract_mismatch", "rollup_unsupported",
              "trace_support_insufficient", "label_count_unstable",
              "label_unavailable"
            ]
          },
          "detail": {"type": "string"},
          "produced": {"type": "number", "minimum": 0},
          "label": {"type": "number", "minimum": 0},
          "relative_error": {"type": "number", "minimum": 0}
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "verdict": {
                  "enum": ["replacement_pass", "replacement_miss"]
                }
              }
            },
            "then": {
              "required": ["produced", "label", "relative_error"]
            }
          }
        ]
      }
    },
    "verdict_counts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["per_metric", "per_op_class", "overall",
                   "achieved_vs_target"],
      "properties": {
        "per_metric": {"type": "object"},
        "per_op_class": {"type": "object"},
        "overall": {"type": "object"},
        "achieved_vs_target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["targets", "achieved", "met"],
          "properties": {
            "targets": {"type": "object"},
            "achieved": {"type": "object"},
            "met": {
              "type": "object",
              "additionalProperties": false,
              "required": ["p50", "p90", "max"],
              "properties": {
                "p50": {"type": "boolean"},
                "p90": {"type": "boolean"},
                "max": {"type": "boolean"}
              }
            }
          }
        }
      }
    },
    "non_vacuity_floor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scored_pairs", "scored_pairs_ok", "distinct_slugs",
        "distinct_slugs_ok", "families", "families_ok",
        "confirmed_metrics_with_min_cells", "confirmed_metrics_ok",
        "floor_met"
      ],
      "properties": {
        "scored_pairs": {"type": "integer", "minimum": 0},
        "scored_pairs_ok": {"type": "boolean"},
        "distinct_slugs": {"type": "integer", "minimum": 0},
        "distinct_slugs_ok": {"type": "boolean"},
        "families": {
          "type": "object",
          "additionalProperties": {"type": "boolean"}
        },
        "families_ok": {"type": "boolean"},
        "confirmed_metrics_with_min_cells": {
          "type": "array", "items": {"type": "string"}
        },
        "confirmed_metrics_ok": {"type": "boolean"},
        "floor_met": {"type": "boolean"}
      }
    },
    "coverage_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_level_producer_reasons", "scored_cells_per_metric",
        "family_evidence", "case_coverage"
      ],
      "properties": {
        "cell_level_producer_reasons": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "scored_cells_per_metric": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "family_evidence": {"type": "object"},
        "case_coverage": {"type": "object"}
      }
    }
  }
}

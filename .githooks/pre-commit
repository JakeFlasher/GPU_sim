#!/usr/bin/env bash
# Pre-commit guards:
#   1. validate the permanent standalone Fable-5 consultation protocol; and
#   2. refuse any patch under tools/nvbit_tracer/nvbit_release/.
#
# The NVBit 1.8 release tree at tools/nvbit_tracer/nvbit_release/ is
# vendored upstream. The counter-free analytics framework treats it
# as a black box: every API surface this project consumes is in
# nvbit_release/core/nvbit.h, and modifying anything under that
# directory creates a divergence from the upstream that breaks
# future NVBit version bumps (every upstream pull would have to
# manually re-apply the divergence) and silently invalidates the
# correctness contract for the launch / module callbacks the
# tracer relies on.
#
# Install:
#   git config core.hooksPath .githooks
#
# Bypass for emergency / unforeseen vendored-release patch (this bypass does
# not disable the Fable-5 protocol guard):
#   SKIP_NVBIT_RELEASE_GUARD=1 git commit ...
#
# The guard is intentionally strict-by-default; the bypass should
# be the rare exception, paired with an explicit operator decision
# documented in the commit message.
# It is a trusted-worktree consistency check, not a sandbox: the staged Python
# tests execute with the current user's privileges and must be reviewed.

set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

if [[ -x "$repo_root/.venv/bin/python" ]]; then
    protocol_python="$repo_root/.venv/bin/python"
elif command -v python3 >/dev/null 2>&1; then
    protocol_python=$(command -v python3)
else
    echo "ERROR: no Python interpreter is available for the Fable-5 protocol guard." >&2
    exit 1
fi

protocol_rel="tools/local_labels/fable5_consultation_protocol.py"
protocol_tests_rel="tools/local_labels/test_fable5_consultation_protocol.py"
protocol_template_rel="tools/local_labels/FABLE5_CONSULTATION_TEMPLATE.md.in"
agents_rel="AGENTS.md"
hook_rel=".githooks/pre-commit"
protocol_script="$repo_root/$protocol_rel"
protocol_tests="$repo_root/$protocol_tests_rel"

if [[ ! -f "$protocol_script" || ! -f "$protocol_tests" ]]; then
    echo "ERROR: the permanent Fable-5 consultation guard is missing." >&2
    exit 1
fi

# Run the protocol and tests exactly as they would exist in the resulting
# commit. This prevents an unstaged good validator from masking a staged broken
# or deleted validator. The currently executing hook remains an independent
# outer layer while these index bytes are tested.
guard_tmp=$(mktemp -d)
trap 'rm -rf "$guard_tmp"' EXIT INT TERM
for guard_path in \
    "$agents_rel" "$hook_rel" "$protocol_rel" "$protocol_tests_rel" "$protocol_template_rel"; do
    if ! git cat-file -e ":$guard_path" 2>/dev/null; then
        echo "ERROR: permanent Fable-5 guard path is absent from the staged tree: $guard_path" >&2
        exit 1
    fi
done
git show ":$protocol_rel" > "$guard_tmp/fable5_consultation_protocol.py"
git show ":$protocol_tests_rel" > "$guard_tmp/test_fable5_consultation_protocol.py"
git show ":$protocol_template_rel" > "$guard_tmp/FABLE5_CONSULTATION_TEMPLATE.md.in"
git show ":$agents_rel" > "$guard_tmp/AGENTS.md"
git show ":$hook_rel" > "$guard_tmp/pre-commit"

for required_agent_text in \
    'When a Fable-5 response contains a defect, omission, contradiction, unsafe' \
    'It must not issue another' \
    'repair every locally determinable defect, preserve the sound clauses, and' \
    'Every message sent to Fable-5 starts a new, stateless, single-message session.' \
    'Necessary file content must be embedded literally in the prompt.' \
    'Ask a separate sub-agent to independently re-scan' \
    'Only the one file created by `emit --output` is authorized for handoff.' \
    'The user—not Codex—pastes or uploads that file' \
    'browser session, or read/write platform cookies.' \
    'Decision evidence reviewed:' \
    'Review records:' \
    'check-response PROMPT RESPONSE' \
    'FABLE5_PROMPT_FILE:'; do
    if ! grep -F "$required_agent_text" "$guard_tmp/AGENTS.md" >/dev/null; then
        echo "ERROR: staged AGENTS.md weakens the permanent Fable-5 protocol: $required_agent_text" >&2
        exit 1
    fi
done
for required_hook_text in \
    'staged_protocol=' \
    'permanent Fable-5 guard path is absent from the staged tree' \
    'SKIP_NVBIT_RELEASE_GUARD=1 — skipping nvbit_release/ guard'; do
    if ! grep -F "$required_hook_text" "$guard_tmp/pre-commit" >/dev/null; then
        echo "ERROR: staged pre-commit hook weakens the permanent Fable-5 guard." >&2
        exit 1
    fi
done
if ! cmp -s "$guard_tmp/pre-commit" "$repo_root/.githooks/pre-commit"; then
    echo "ERROR: staged and executing pre-commit hook bytes differ; stage the reviewed hook exactly." >&2
    exit 1
fi
bash -n "$guard_tmp/pre-commit"
git_local_env_args=()
while IFS= read -r git_local_name; do
    if [[ -n "$git_local_name" ]]; then
        git_local_env_args+=(-u "$git_local_name")
    fi
done < <(git rev-parse --local-env-vars)
env "${git_local_env_args[@]}" \
    "$protocol_python" "$guard_tmp/test_fable5_consultation_protocol.py"
staged_protocol="$guard_tmp/fable5_consultation_protocol.py"

# Validate staged consultation artifacts by their index bytes, not potentially
# different working-tree bytes. Drafts normally stay outside the repository;
# this catches any explicitly tracked artifact following the naming contract.
fable_prompt_count=0
while IFS= read -r -d '' staged_path; do
    lower_path=${staged_path,,}
    validate_prompt=false
    case "$lower_path" in
        *fable5*prompt*.md|*fable5*prompt*.txt|*fable5*consultation*.md|*fable5*consultation*.txt)
            validate_prompt=true
            ;;
    esac
    candidate="$guard_tmp/staged-candidate"
    git show ":$staged_path" > "$candidate"
    if [[ "$staged_path" == "$protocol_template_rel" ]]; then
        validate_prompt=false
    elif [[ "$validate_prompt" == false ]] && grep '^FABLE5-CONSULTATION-V1$' "$candidate" >/dev/null; then
        validate_prompt=true
    fi
    case "$validate_prompt" in
        true)
            ((fable_prompt_count += 1))
            if ! "$protocol_python" "$staged_protocol" hook --label "$staged_path" < "$candidate"; then
                echo "ERROR: staged Fable-5 consultation is not standalone and sendable." >&2
                exit 1
            fi
            ;;
    esac
done < <(git diff --cached --name-only -z --diff-filter=ACMR)

if [[ "$fable_prompt_count" -gt 1 ]]; then
    echo "ERROR: one commit may contain at most one Fable-5 prompt artifact." >&2
    exit 1
fi

if [[ -n "${SKIP_NVBIT_RELEASE_GUARD:-}" ]]; then
    echo "WARNING: SKIP_NVBIT_RELEASE_GUARD=1 — skipping nvbit_release/ guard." >&2
else
    # Check both staged adds/modifies and staged deletes under the vendored
    # directory. The matcher only needs to know whether any staged path lives
    # under tools/nvbit_tracer/nvbit_release/.
    forbidden=$(git diff --cached --name-only --diff-filter=ACMRTUXBD \
        | grep -E '^tools/nvbit_tracer/nvbit_release/' || true)

    if [[ -n "$forbidden" ]]; then
        echo "ERROR: this commit would modify the vendored NVBit 1.8 release tree." >&2
        echo "" >&2
        echo "Forbidden staged paths:" >&2
        while IFS= read -r path; do
            echo "  $path" >&2
        done <<< "$forbidden"
        echo "" >&2
        echo "The tools/nvbit_tracer/nvbit_release/ tree is upstream-vendored and must" >&2
        echo "remain byte-for-byte unchanged. Diffs under it break future version" >&2
        echo "bumps and invalidate the correctness contract for the launch /" >&2
        echo "module callbacks the tracer relies on." >&2
        echo "" >&2
        echo "Resolution:" >&2
        echo "  - Unstage the changes:  git restore --staged tools/nvbit_tracer/nvbit_release/" >&2
        echo "  - Restore the working tree:  git restore --worktree tools/nvbit_tracer/nvbit_release/" >&2
        echo "" >&2
        echo "Emergency bypass (avoid if at all possible):" >&2
        echo "  SKIP_NVBIT_RELEASE_GUARD=1 git commit ..." >&2
        exit 1
    fi
fi

exit 0

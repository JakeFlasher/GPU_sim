{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpu-simulator.local/schemas/sm86_tail_witness_report_v1.schema.json",
  "title": "SM86 tail witness diagnostic report",
  "type": "object",
  "required": ["schema", "launch_count", "independent_tail_witness_complete_launches", "native_dispatch_eligible_launches", "rows", "interpretation"],
  "properties": {
    "schema": {"const": "sm86_tail_witness_report_v1"},
    "launch_count": {"type": "integer", "minimum": 1},
    "independent_tail_witness_complete_launches": {"type": "integer", "minimum": 0},
    "native_dispatch_eligible_launches": {"type": "integer", "minimum": 0},
    "rows": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["launch_index", "completion_status", "facts", "open_domains", "independent_tail_witness_complete", "native_dispatch_eligible"], "properties": {"launch_index": {"type": "integer", "minimum": 0}, "kernel_name": {"type": ["string", "null"]}, "completion_status": {"type": "string"}, "facts": {"type": "object", "additionalProperties": {"type": "boolean"}}, "open_domains": {"type": "array", "items": {"type": "string"}}, "independent_tail_witness_complete": {"type": "boolean"}, "native_dispatch_eligible": {"type": "boolean"}}, "additionalProperties": false}},
    "interpretation": {"const": "missing_owner_read_from_generation_fence_scope_or_hardware_completion_stays_open"}
  },
  "additionalProperties": false
}

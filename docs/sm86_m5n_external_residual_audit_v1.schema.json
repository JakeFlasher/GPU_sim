{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpu-simulator.local/schemas/sm86_m5n_external_residual_audit_v1.schema.json",
  "title": "SM86 M5-N external residual audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "phase",
    "status",
    "host_identity",
    "local_audit",
    "remaining_external_dependencies",
    "claim_boundary",
    "interpretation",
    "audit_scope_cutoff",
    "superseded_by"
  ],
  "properties": {
    "schema": {
      "const": "sm86_m5n_external_residual_audit_v1"
    },
    "phase": {
      "const": "M5-N"
    },
    "status": {
      "const": "complete_scoped_pre_m5o_residual_audit"
    },
    "host_identity": {
      "type": "object"
    },
    "local_audit": {
      "type": "object"
    },
    "remaining_external_dependencies": {
      "type": "array",
      "minItems": 1
    },
    "claim_boundary": {
      "type": "object",
      "properties": {
        "no_additional_local_sm86_seam_found": {
          "const": false
        },
        "physical_completion_claimed": {
          "const": false
        },
        "broad_accuracy_claimed": {
          "const": false
        },
        "native_hardware_scheduling_claimed": {
          "const": false
        },
        "objective_complete": {
          "const": false
        }
      },
      "required": [
        "no_additional_local_sm86_seam_found",
        "physical_completion_claimed",
        "broad_accuracy_claimed",
        "native_hardware_scheduling_claimed",
        "objective_complete"
      ]
    },
    "interpretation": {
      "type": "string",
      "minLength": 1
    },
    "audit_scope_cutoff": {
      "type": "string"
    },
    "superseded_by": {
      "type": "string"
    }
  }
}

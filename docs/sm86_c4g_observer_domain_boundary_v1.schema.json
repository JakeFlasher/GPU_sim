{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpu-simulator.local/schemas/sm86_c4g_observer_domain_boundary_v1.schema.json",
  "title": "SM86 C4-G observer domain boundary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "phase",
    "checks",
    "evidence",
    "supported_domain",
    "unsupported_or_open",
    "interpretation"
  ],
  "properties": {
    "schema": {
      "const": "sm86_c4g_observer_domain_boundary_v1"
    },
    "status": {
      "type": "string"
    },
    "phase": {
      "const": "C4-G"
    },
    "checks": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 5
    },
    "supported_domain": {
      "type": "object"
    },
    "unsupported_or_open": {
      "type": "object"
    },
    "interpretation": {
      "type": "string",
      "minLength": 1
    }
  }
}

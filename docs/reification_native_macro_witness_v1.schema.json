{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gpusim/reification_native_macro_witness_v1.schema.json",
  "title": "SM86 native macro witness v1",
  "type": "object",
  "required": [
    "schema",
    "target",
    "start_sequence",
    "spec",
    "detailed_internal_effects",
    "detailed_labels",
    "detailed_exit"
  ],
  "properties": {
    "schema": {"const": "reification_native_macro_witness_v1"},
    "target": {"type": "integer", "minimum": 0},
    "start_sequence": {"type": "integer", "minimum": 0},
    "spec": {"$ref": "#/$defs/spec"},
    "detailed_internal_effects": {
      "type": "array",
      "items": {"$ref": "#/$defs/effect"}
    },
    "detailed_labels": {
      "type": "array",
      "items": {"type": "string"}
    },
    "detailed_exit": {"type": "object"}
  },
  "additionalProperties": false,
  "$defs": {
    "spec": {
      "type": "object",
      "required": ["instruction_count", "latency_cycles", "initiation_interval_cycles", "label"],
      "properties": {
        "instruction_count": {"type": "integer", "minimum": 1},
        "latency_cycles": {"type": "integer", "minimum": 1},
        "initiation_interval_cycles": {"type": "integer", "minimum": 1},
        "label": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "effect": {
      "type": "object",
      "required": ["phase", "event"],
      "properties": {
        "phase": {"type": "integer", "minimum": 0, "maximum": 255},
        "event": {"type": "object"}
      },
      "additionalProperties": false
    }
  }
}

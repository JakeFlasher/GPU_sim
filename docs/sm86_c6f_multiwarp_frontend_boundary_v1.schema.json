{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpu-simulator.local/schemas/sm86_c6f_multiwarp_frontend_boundary_v1.schema.json",
  "title": "SM86 C6-F multi-warp front-end boundary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "phase",
    "identity",
    "probe",
    "observation",
    "decision",
    "interpretation"
  ],
  "properties": {
    "schema": {
      "const": "sm86_c6f_multiwarp_frontend_boundary_v1"
    },
    "status": {
      "type": "string"
    },
    "phase": {
      "const": "C6-F"
    },
    "identity": {
      "type": "object"
    },
    "probe": {
      "type": "object"
    },
    "observation": {
      "type": "object",
      "required": [
        "typed_entry_complete",
        "native_macro_dispatches",
        "native_macro_fallbacks",
        "footer_complete",
        "refusal_reason"
      ],
      "properties": {
        "typed_entry_complete": {
          "const": true
        },
        "native_macro_dispatches": {
          "const": 0
        },
        "native_macro_fallbacks": {
          "const": 0
        },
        "footer_complete": {
          "const": true
        }
      },
      "additionalProperties": true
    },
    "decision": {
      "type": "object",
      "required": [
        "positive_multiwarp_witness",
        "multiwarp_typed_transition_modeled",
        "exact_fallback_preserved",
        "physical_completion",
        "semantic_upper"
      ],
      "properties": {
        "positive_multiwarp_witness": {
          "const": false
        },
        "multiwarp_typed_transition_modeled": {
          "const": false
        },
        "exact_fallback_preserved": {
          "const": true
        },
        "physical_completion": {
          "const": "unknown"
        },
        "semantic_upper": {
          "const": "open"
        }
      },
      "additionalProperties": true
    },
    "interpretation": {
      "type": "string",
      "minLength": 1
    }
  }
}

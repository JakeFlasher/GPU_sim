{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gpusim/sm86_service_probe_v2.schema.json",
  "title": "SM86 independent service calibration probes v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "probes"],
  "properties": {
    "schema": {"const": "sm86_service_probe_v2"},
    "probes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/probe"}
    }
  },
  "$defs": {
    "positive": {"type": "integer", "minimum": 1},
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pool", "mode", "events", "cycles"],
      "properties": {
        "pool": {"type": "string", "minLength": 1},
        "mode": {
          "enum": [
            "dependent_latency",
            "independent_throughput",
            "queue_capacity",
            "occupancy_sweep",
            "contention_sweep"
          ]
        },
        "events": {"$ref": "#/$defs/positive"},
        "cycles": {"$ref": "#/$defs/positive"},
        "latency_cycles": {"$ref": "#/$defs/positive"},
        "capacity": {"$ref": "#/$defs/positive"},
        "queue_depth": {"$ref": "#/$defs/positive"},
        "occupancy": {"$ref": "#/$defs/positive"},
        "contenders": {"$ref": "#/$defs/positive"}
      }
    }
  }
}

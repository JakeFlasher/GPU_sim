{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpu-simulator.local/schemas/sm86_c7_research_probe_l1tex_admission_backpressure_pair_live_v1.schema.json",
  "title": "SM86 L1TEX admission control/store differential",
  "type": "object",
  "required": ["schema", "status", "host_identity", "identity", "arms", "comparison", "interpretation"],
  "properties": {
    "schema": {"const": "sm86_c7_research_probe_l1tex_admission_backpressure_pair_live_v1"},
    "status": {"type": "string", "minLength": 1},
    "host_identity": {"type": "object", "required": ["device_index", "name", "compute_capability", "driver"], "additionalProperties": true},
    "identity": {"type": "object", "required": ["source", "binary_used_for_both_arms", "shared_shape", "ncu_repeats"], "additionalProperties": true},
    "arms": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "required": ["tail", "artifact", "correct", "target_records_replayed", "simulator_lower_bound_cycles", "ncu_values", "ncu_median_cycles", "instruction_count_match"], "additionalProperties": true}},
    "comparison": {"type": "object", "required": ["hardware_delta_cycles", "simulator_lower_bound_delta_cycles", "delta_gap_cycles", "hardware_completion", "point_estimator"], "additionalProperties": true},
    "interpretation": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}

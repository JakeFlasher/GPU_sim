{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpu-simulator.local/schema/accelsim_literature_lower_bound_v1.json",
  "title": "Accel-Sim literature aggregate lower-bound manifest",
  "type": "object",
  "required": ["schema", "schema_version", "comparison_roles", "record_contract", "records", "scoring_rule", "unmatched_policy"],
  "properties": {
    "schema": {"const": "accelsim_literature_lower_bound_v1"},
    "schema_version": {"const": 1},
    "comparison_roles": {"type": "object", "required": ["local_ground_truth", "literature_reference", "executable_smoke", "ground_truth", "threshold_semantics"]},
    "record_contract": {"type": "object", "required": ["required_fields", "metric_kind_values", "comparison_status_values"]},
    "records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/record"}},
    "scoring_rule": {"type": "string", "minLength": 1},
    "unmatched_policy": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "record": {
      "type": "object",
      "required": ["id", "system", "source", "hardware", "workload_scope", "metric_kind", "metric", "endpoint", "units", "statistic", "accuracy_floor", "speed_floor", "uncertainty", "comparison_status", "target_direction", "threshold_type", "target_status", "attainment_status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "system": {"type": "string", "minLength": 1},
        "source": {"type": "object", "required": ["citation", "url", "source_locator", "source_identity_status"]},
        "hardware": {"type": "string", "minLength": 1},
        "workload_scope": {"type": "string", "minLength": 1},
        "metric_kind": {"enum": ["accuracy", "throughput", "wall_speedup"]},
        "metric": {"type": "string", "minLength": 1},
        "endpoint": {"type": "string", "minLength": 1},
        "units": {"type": "string", "minLength": 1},
        "statistic": {"type": "string", "minLength": 1},
        "accuracy_floor": {"type": ["number", "null"]},
        "speed_floor": {"type": ["number", "null"]},
        "uncertainty": {},
        "comparison_status": {"enum": ["lower_bound_reference_unmatched", "floor_comparable", "context_only"]},
        "target_direction": {"enum": ["lower_is_better", "higher_is_better"]},
        "threshold_type": {"enum": ["ceiling", "floor"]},
        "target_status": {"const": "registered"},
        "attainment_status": {"enum": ["not_evaluable_unmatched", "not_evaluable", "matched", "attained", "not_attained"]}
      }
    }
  }
}

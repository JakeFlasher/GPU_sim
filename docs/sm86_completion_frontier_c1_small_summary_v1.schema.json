{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpu-simulator.local/schemas/sm86_completion_frontier_c1_small_summary_v1.schema.json",
  "title": "SM86 C1 small tail-matrix summary",
  "type": "object",
  "required": ["schema", "status", "role", "contract", "case_count", "finite_interval_rows", "open_lower_consistent_rows", "open_rows", "rows", "interpretation", "next_cases"],
  "properties": {
    "schema": {"const": "sm86_completion_frontier_c1_small_summary_v1"},
    "status": {"const": "partial_live_matrix_complete"},
    "role": {"const": "tail_completion_development_not_fitting"},
    "contract": {"const": "docs/sm86_completion_frontier_contract_v1.json"},
    "roots": {"type": "array", "items": {"type": "string"}},
    "case_count": {"type": "integer", "minimum": 1},
    "finite_interval_rows": {"const": 0},
    "open_lower_consistent_rows": {"type": "integer", "minimum": 0},
    "open_rows": {"type": "integer", "minimum": 1},
    "rows": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["case", "status", "ncu_cycles_median", "simulator_lower_cycles", "simulator_upper_cycles", "finite_interval_covered", "open_lower_consistent", "completion"], "properties": {"case": {"type": "string"}, "status": {"const": "completed"}, "suite": {"type": ["string", "null"]}, "operation": {"type": ["string", "null"]}, "pattern": {"type": ["integer", "null"]}, "ncu_cycles_samples": {"type": "array", "minItems": 5, "items": {"type": "number"}}, "ncu_cycles_median": {"type": "number", "minimum": 0}, "simulator_lower_cycles": {"type": "integer", "minimum": 0}, "simulator_upper_cycles": {"type": ["integer", "null"], "minimum": 0}, "finite_interval_covered": {"type": ["boolean", "null"]}, "open_lower_consistent": {"type": ["boolean", "null"]}, "completion": {"type": "object", "required": ["status", "unmodeled_tails"], "additionalProperties": true}, "trace_metrics": {"type": "object"}, "ncu_dram_read_sectors": {"type": "array", "items": {"type": "number"}}, "ncu_dram_write_sectors": {"type": "array", "items": {"type": "number"}}, "domain_checks_all_repetitions": {"type": "object"}}, "additionalProperties": false}},
    "interpretation": {"type": "string", "minLength": 1},
    "next_cases": {"type": "array", "items": {"type": "string"}, "minItems": 1}
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpu-simulator.local/schemas/sm86_c7_research_probe_task_done_boundary_live_v1.schema.json",
  "title": "SM86 task-done multi-kernel live boundary probe",
  "type": "object",
  "required": ["schema", "status", "host_identity", "identity", "correctness", "trace", "simulator", "ncu", "comparison", "interpretation"],
  "properties": {
    "schema": {"const": "sm86_c7_research_probe_task_done_boundary_live_v1"},
    "status": {"type": "string", "minLength": 1},
    "host_identity": {"type": "object", "required": ["device_index", "name", "compute_capability", "driver"], "additionalProperties": true},
    "identity": {"type": "object", "required": ["binary", "control", "trace", "args", "ncu_repeats"], "additionalProperties": true},
    "correctness": {"type": "object", "required": ["correct", "trial_count"], "additionalProperties": true},
    "trace": {"type": "object", "required": ["launches", "target_records_sum"], "additionalProperties": true},
    "simulator": {"type": "object", "required": ["applicable", "launches", "records_sum"], "additionalProperties": true},
    "ncu": {"type": "object", "required": ["metric", "launch_count", "repetitions", "kernels"], "additionalProperties": true},
    "comparison": {"type": "object", "required": ["all_instruction_counts_match", "all_replay_coverage_full"], "additionalProperties": true},
    "interpretation": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}

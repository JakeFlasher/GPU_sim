{
  "schema": "sm86_ncu_accuracy_protocol_v1",
  "status": "pre_measurement_contract",
  "measurement_contract": {
    "target_metric": "gpc__cycles_elapsed.max",
    "ncu_chip": "ga102",
    "endpoint": "ncu_grid_completion_semaphore",
    "clock_domain": "gpc_cycles",
    "unit": "cycles",
    "cache_policy": "all",
    "replay_mode": "application",
    "launch_scope": "one_declared_workload_launch",
    "launch_identity": "sm86_accuracy_campaign_v1",
    "device_index": 0,
    "repetitions": 5,
    "warmup_launches": 3,
    "clock_control": "none",
    "prediction_timeout_seconds": 180,
    "ncu_timeout_seconds": 600,
    "mechanism_metrics": [
      "gpu__time_duration",
      "sm__cycles_active",
      "sm__inst_executed.sum"
    ]
  },
  "identity_requirements": {
    "architecture": "sm_86",
    "expected_gpu_name": "NVIDIA GeForce RTX 3090 Ti",
    "independent_check_required": true,
    "required_fields": [
      "gpu_name",
      "gpu_uuid",
      "compute_capability",
      "driver_version",
      "cuda_version",
      "ncu_version",
      "device_index",
      "graphics_clock_mhz",
      "memory_clock_mhz",
      "power_state"
    ],
    "mismatch_policy": "exclude_or_label_historical"
  },
  "build_requirements": [
    "simulator_git_commit",
    "simulator_binary_path_and_profile",
    "rustc_version",
    "cuda_toolkit_version",
    "nvbit_tracer_build",
    "trace_schema_version",
    "architecture_card_path",
    "pchase_card_path",
    "control_sidecar_path"
  ],
  "artifact_contract": {
    "prediction_schema": "reification_prediction_v2",
    "observation_schema": "ncu_observation_v2",
    "evaluation_schema": "reification_prediction_evaluation_v2",
    "prediction_before_observation": true,
    "ncu_values_forbidden_in_prediction": true
  },
  "split_contract": {
    "family_held_out": true,
    "no_workload_crossing": true,
    "no_family_crossing": true,
      "families": {
      "normalization": "calibration",
      "tensor_gemm": "development",
      "attention": "held_out",
      "convolution": "held_out",
      "elementwise_reduction": "held_out",
        "memory_embedding": "held_out"
      },
      "planned_expansion_families": {
        "scalar": {"split": "held_out", "case_types": ["dependent_chain", "branch", "barrier"]},
        "tensor": {"split": "held_out", "case_types": ["mma", "async_copy", "mixed_precision"]},
        "memory": {"split": "held_out", "case_types": ["read_stream", "writeback", "atomic_reduction"]},
        "synchronization": {"split": "held_out", "case_types": ["barrier", "membar", "async_wait"]},
        "mixed": {"split": "held_out", "case_types": ["compute_memory", "divergence_memory", "multi_phase"]}
      }
  },
  "scoring_contract": {
    "finite_interval_coverage": "score_only_when_upper_is_finite",
    "open_upper_policy": "report_lower_consistency_separately",
    "repetition_summary": "median_iqr_and_all_samples",
    "mechanism_counter_policy": "score_only_when_metric_scope_matches_projection"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpu-simulator.local/schemas/sm86_completion_frontier_c1r_async_control_differential_v1.schema.json",
  "title": "Matched async/control differential",
  "type": "object",
  "required": ["schema", "status", "binary", "control_case", "async_case", "delta_ncu_median_cycles", "delta_simulator_lower_cycles", "interpretation"],
  "properties": {
    "schema": {"const": "sm86_completion_frontier_c1r_async_control_differential_v1"},
    "status": {"const": "matched_control_differential_complete"},
    "binary": {"type": "string", "minLength": 1},
    "control_case": {"$ref": "#/$defs/case"},
    "async_case": {"$ref": "#/$defs/case"},
    "delta_ncu_median_cycles": {"type": "number"},
    "delta_simulator_lower_cycles": {"type": "number"},
    "interpretation": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": ["ncu_target_cycles", "ncu_median", "sim", "sim_minus_ncu_median"],
      "properties": {
        "ncu_target_cycles": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "number", "minimum": 0}},
        "ncu_median": {"type": "number", "minimum": 0},
        "sim_minus_ncu_median": {"type": "number"},
        "sim": {"type": "object", "required": ["lower", "records", "completion"], "properties": {"lower": {"type": "integer", "minimum": 0}, "records": {"type": "integer", "minimum": 1}, "completion": {"type": "object"}}, "additionalProperties": true}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpu-simulator.local/schemas/sm86_c7_research_probe_fixed_latency_reuse_live_v1.schema.json",
  "title": "SM86 fixed-latency reuse same-binary live slice",
  "type": "object",
  "required": ["schema", "status", "host_identity", "identity", "correctness", "trace", "simulator", "ncu", "comparison", "interpretation"],
  "properties": {
    "schema": {"const": "sm86_c7_research_probe_fixed_latency_reuse_live_v1"},
    "status": {"type": "string", "minLength": 1},
    "host_identity": {"type": "object", "required": ["device_index", "name", "compute_capability", "driver"], "additionalProperties": true},
    "identity": {"type": "object", "required": ["source", "binary", "binary_used_for_correctness_trace_replay_ncu", "trace", "control", "args", "ncu_repeats"], "additionalProperties": true},
    "correctness": {"type": "object", "required": ["correct", "elapsed_samples_valid", "sink_valid", "trials"], "additionalProperties": true},
    "trace": {"type": "object", "required": ["target_records_replayed", "target_coverage"], "additionalProperties": true},
    "simulator": {"type": "object", "required": ["records", "instructions_issued", "completion_frontier"], "additionalProperties": true},
    "ncu": {"type": "object", "required": ["metric", "values", "median", "instruction_count"], "additionalProperties": true},
    "comparison": {"type": "object", "required": ["instruction_count_match", "lower_bound_consistency", "hardware_completion", "point_estimator"], "additionalProperties": true},
    "interpretation": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gpusim/sm86_accuracy_campaign_v1_repetition_summary.schema.json",
  "title": "SM86 accuracy campaign repetition summary v1",
  "type": "object",
  "required": ["schema", "protocol", "collection_performed", "campaign_root", "target_metric", "rows", "all_termination_ok"],
  "properties": {
    "schema": {"const": "sm86_accuracy_campaign_v1_repetition_summary"},
    "protocol": {"const": "sm86_ncu_accuracy_protocol_v1"},
    "collection_performed": {"const": true},
    "campaign_root": {"type": "string", "minLength": 1},
    "target_metric": {"const": "gpc__cycles_elapsed.max"},
    "all_termination_ok": {"type": "boolean"},
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["workload", "repetitions", "termination_ok"],
        "properties": {
          "workload": {"type": "string", "minLength": 1},
          "termination_ok": {"type": "boolean"},
          "repetitions": {
            "type": "array",
            "minItems": 5,
            "items": {
              "type": "object",
              "required": ["rep", "returncode", "timed_out", "elapsed_seconds", "csv_returncode", "metric_value"],
              "properties": {
                "rep": {"type": "integer", "minimum": 0},
                "returncode": {"type": ["integer", "null"]},
                "timed_out": {"type": "boolean"},
                "elapsed_seconds": {"type": ["number", "null"]},
                "csv_returncode": {"type": ["integer", "null"]},
                "metric_value": {"type": ["number", "null"]}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

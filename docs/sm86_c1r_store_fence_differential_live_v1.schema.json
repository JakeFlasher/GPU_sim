{
  "$id": "https://gpu-simulator.local/schemas/sm86_c1r_store_fence_differential_live_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "arms": {
      "items": {
        "additionalProperties": true,
        "required": [
          "cell",
          "tail",
          "fence",
          "args",
          "correctness",
          "sanitizer",
          "trace",
          "simulator",
          "ncu"
        ],
        "type": "object"
      },
      "minItems": 4,
      "type": "array"
    },
    "differentials": {
      "additionalProperties": {
        "additionalProperties": true,
        "required": [
          "simulator_gpc_delta_cycles",
          "ncu_median_delta_cycles",
          "direction_matches",
          "delta_difference_cycles"
        ],
        "type": "object"
      },
      "minProperties": 4,
      "type": "object"
    },
    "host_identity": {
      "additionalProperties": true,
      "required": [
        "device_index",
        "name",
        "uuid",
        "compute_capability",
        "driver"
      ],
      "type": "object"
    },
    "identity": {
      "additionalProperties": true,
      "required": [
        "source",
        "binary",
        "trace_binary",
        "control",
        "shape",
        "ncu_metric",
        "ncu_repeats_per_arm"
      ],
      "type": "object"
    },
    "interpretation": {
      "minLength": 1,
      "type": "string"
    },
    "phase": {
      "const": "C1-R"
    },
    "reconciliation": {
      "additionalProperties": true,
      "required": [
        "all_arms_correct",
        "all_arms_sanitized",
        "all_instruction_counts_match",
        "all_replays_deterministic",
        "native_macro_dispatches",
        "store_completion_tails",
        "hardware_completion",
        "ncus_are_independent_targets"
      ],
      "type": "object"
    },
    "schema": {
      "const": "sm86_c1r_store_fence_differential_live_v1"
    },
    "status": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "status",
    "phase",
    "host_identity",
    "identity",
    "arms",
    "differentials",
    "reconciliation",
    "interpretation"
  ],
  "title": "sm86_c1r_store_fence_differential_live_v1",
  "type": "object"
}

{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://gpu-simulator.local/schemas/sm86_completion_frontier_c3_async_endpoint_differential_warp1_v1.schema.json",
  "title":"SM86 async one-warp endpoint differential",
  "type":"object",
  "required":["schema","status","identity","cases","differentials","interpretation","completion","hardware_completion"],
  "properties":{
    "schema":{"const":"sm86_completion_frontier_c3_async_endpoint_differential_warp1_v1"},
    "status":{"const":"matched_one_warp_endpoint_differential_negative_for_ncu_endpoint"},

    "cases":{"type":"object","required":["c00","c11"],"additionalProperties":{"type":"object"}},
    "differentials":{"type":"object","required":["direct_clock_c11_minus_c00","ncu_gpc_c11_minus_c00","simulator_c11_minus_c00"],"additionalProperties":true},
    "interpretation":{"type":"string","minLength":1},
    "completion":{"type":"object","additionalProperties":true},
    "hardware_completion":{"const":"not_observed"}
  },
  "additionalProperties":false
}

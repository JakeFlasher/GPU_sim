{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gpusim/sm86_accuracy_intervention_comparison_v1.schema.json",
  "title": "SM86 accuracy intervention comparison v1",
  "type": "object",
  "required": ["schema", "baseline_artifact", "prediction_before_observation", "causal_claim", "interpretation", "metrics", "rows", "contrast_summaries"],
  "properties": {
    "schema": {"const": "sm86_accuracy_intervention_comparison_v1"},
    "baseline_artifact": {"type": "string", "minLength": 1},
    "prediction_before_observation": {"const": true},
    "causal_claim": {"const": false},
    "interpretation": {"const": "observational_direction_and_metric_consistency_only"},
    "metrics": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["workload", "baseline_all_cache", "contrasts"],
        "properties": {
          "workload": {"type": "string", "minLength": 1},
          "baseline_all_cache": {"type": "object"},
          "contrasts": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "contrast_summaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "variable", "workload_count", "target_direction_counts", "mechanism_counter_directions", "mechanism_counters_available", "simulator_projection_invariant", "consistency_status", "causal_claim", "interpretation"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "variable": {"type": "string", "minLength": 1},
          "workload_count": {"type": "integer", "minimum": 1},
          "target_direction_counts": {"type": "object"},
          "mechanism_counter_directions": {"type": "object"},
          "mechanism_counters_available": {"type": "boolean"},
          "simulator_projection_invariant": {"type": "boolean"},
          "consistency_status": {"enum": ["consistent_observational_contrast", "inconsistent_refuse_causal_claim"]},
          "causal_claim": {"const": false},
          "interpretation": {"const": "observational_direction_and_metric_consistency_only"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

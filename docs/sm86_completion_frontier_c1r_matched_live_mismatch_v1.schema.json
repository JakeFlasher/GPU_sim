{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpu-simulator.local/schemas/sm86_completion_frontier_c1r_matched_live_mismatch_v1.schema.json",
  "title": "Matched C1-R live model mismatch",
  "type": "object",
  "required": ["schema", "status", "identity", "ncu_target_cycles", "ncu_median_cycles", "simulator_target_lower_cycles", "simulator_completion", "finite_interval_coverage", "open_lower_consistency"],
  "properties": {
    "schema": {"type": "string", "pattern": "^sm86_completion_frontier_c1r_(async_matched|message_device)_v1$"},
    "status": {"type": "string", "minLength": 1},
    "identity": {"type": "string", "minLength": 1},
    "ncu_target_cycles": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "number", "minimum": 0}},
    "ncu_median_cycles": {"type": "number", "minimum": 0},
    "ncu_mechanism_metrics": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "number", "minimum": 0}}},
    "simulator_target_lower_cycles": {"type": "integer", "minimum": 0},
    "simulator_target_upper_cycles": {"type": ["integer", "null"], "minimum": 0},
    "simulator_completion": {"type": "object", "required": ["status", "unmodeled_tails"], "additionalProperties": true},
    "finite_interval_coverage": {"const": null},
    "open_lower_consistency": {"type": "boolean"}
  },
  "additionalProperties": true
}

{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://gpu-simulator.local/schemas/sm86_completion_frontier_c3_source_only_live_v1.schema.json",
  "title":"SM86 source-only live completion comparison",
  "type":"object",
  "required":["schema","status","identity","launch","ncu","comparison","interpretation"],
  "properties":{
    "schema":{"const":"sm86_completion_frontier_c3_source_only_live_v1"},
    "status":{"const":"positive_model_completion_open_hardware_observation"},
    "identity":{"type":"object","additionalProperties":true},
    "launch":{"type":"object","required":["args","trace_records","simulator_lower_cycles","simulator_completion"],"additionalProperties":true},
    "ncu":{"type":"object","required":["metric","repetitions","values","median"],"properties":{"metric":{"const":"gpc__cycles_elapsed.max"},"repetitions":{"const":5},"values":{"type":"array","minItems":5,"items":{"type":"number"}},"median":{"type":"number"}},"additionalProperties":true},
    "comparison":{"type":"object","required":["point_error_cycles","point_absolute_percentage_error","semantic_upper_status","hardware_completion"],"properties":{"point_error_cycles":{"type":"number"},"point_absolute_percentage_error":{"type":"number"},"semantic_upper_status":{"type":"string"},"hardware_completion":{"const":"not_observed"}},"additionalProperties":true},
    "interpretation":{"type":"string","minLength":1}
  },
  "additionalProperties":false
}

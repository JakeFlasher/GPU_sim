{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gpusim/sm86_ncu_intervention_plan_v1.schema.json",
  "title": "SM86 NCU intervention plan v1",
  "type": "object",
  "required": ["schema", "baseline_prediction", "contrasts", "causal_claim_policy"],
  "properties": {
    "schema": {"const": "sm86_ncu_intervention_plan_v1"},
    "baseline_prediction": {"const": "docs/sm86_accuracy_campaign_v1_predictions_pre_ncu.json"},
    "contrasts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "variable", "baseline", "variant", "prediction", "workloads", "repetitions"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "variable": {"enum": ["cache_policy", "clock_control", "mechanism"]},
          "baseline": {"type": "string", "minLength": 1},
          "variant": {"type": "string", "minLength": 1},
          "prediction": {"type": "string", "minLength": 1},
          "workloads": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "repetitions": {"const": 5},
          "mechanism_metrics": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "causal_claim_policy": {"const": "observational_direction_and_metric_consistency_only_no_hidden_hardware_causality"}
  },
  "additionalProperties": false
}

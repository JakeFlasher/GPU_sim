{
  "$id": "https://gpu-simulator.local/schemas/sm86_c3b_completion_feedback_live_perturbation_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "comparisons": {
      "additionalProperties": true,
      "minProperties": 2,
      "type": "object"
    },
    "host_identity": {
      "additionalProperties": true,
      "required": [
        "device_index",
        "name",
        "uuid",
        "compute_capability",
        "driver"
      ],
      "type": "object"
    },
    "identity": {
      "additionalProperties": true,
      "required": [
        "source",
        "binary",
        "trace_binary",
        "control",
        "arch_card",
        "pchase_card",
        "replay_mode",
        "cache_scope",
        "candidate_service",
        "candidate_queue_capacity",
        "candidate_admission_latency",
        "acknowledgement_latencies"
      ],
      "type": "object"
    },
    "interpretation": {
      "minLength": 1,
      "type": "string"
    },
    "invariants": {
      "additionalProperties": true,
      "required": [
        "instruction_counts_unchanged",
        "acknowledgements_exactly_drained",
        "no_fence_sm_active_unchanged",
        "device_fence_observes_ack_latency",
        "terminal_completion_moves_by_latency",
        "tails_retained",
        "native_macro_dispatches",
        "ncu_values_used"
      ],
      "type": "object"
    },
    "phase": {
      "const": "C3-B"
    },
    "regression": {
      "additionalProperties": true,
      "required": [
        "sim_sm_feedback_tests",
        "sim_sm_replay_projection_test",
        "sim_sm_post_exit_ack_test",
        "sim_run_tests",
        "all_passed"
      ],
      "type": "object"
    },
    "rows": {
      "items": {
        "additionalProperties": true,
        "required": [
          "arm",
          "acknowledgement_latency_cycles",
          "trace",
          "control",
          "candidate",
          "records",
          "instructions_issued",
          "acknowledgements_scheduled",
          "acknowledgements_processed",
          "terminal_modeled_event_time",
          "sm_active_terminal_cycles",
          "completion_frontier"
        ],
        "type": "object"
      },
      "minItems": 4,
      "type": "array"
    },
    "schema": {
      "const": "sm86_c3b_completion_feedback_live_perturbation_v1"
    },
    "source_repairs": {
      "items": {
        "additionalProperties": true,
        "required": [
          "path",
          "change",
          "test"
        ],
        "type": "object"
      },
      "minItems": 2,
      "type": "array"
    },
    "status": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "status",
    "phase",
    "host_identity",
    "identity",
    "rows",
    "comparisons",
    "invariants",
    "interpretation"
  ],
  "title": "sm86_c3b_completion_feedback_live_perturbation_v1",
  "type": "object"
}

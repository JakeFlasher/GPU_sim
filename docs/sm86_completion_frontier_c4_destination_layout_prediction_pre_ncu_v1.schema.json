{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://gpu-simulator.local/schemas/sm86_completion_frontier_c4_destination_layout_prediction_pre_ncu_v1.schema.json",
  "title":"SM86 destination-layout severe prediction before NCU",
  "type":"object",
  "required":["schema","status","protocol","identity","calibration","target_features","prediction","interpretation"],
  "properties":{
    "schema":{"const":"sm86_completion_frontier_c4_destination_layout_prediction_pre_ncu_v1"},
    "status":{"enum":["prediction_materialized_before_severe_ncu","prediction_scored_after_severe_ncu"]},
    "protocol":{"type":"object","required":["target_ncu_values_collected","ncu_values_used_by_simulator"],"properties":{"target_ncu_values_collected":{"const":false},"ncu_values_used_by_simulator":{"const":false}},"additionalProperties":true},
    "identity":{"type":"object","additionalProperties":true},
    "calibration":{"type":"object","additionalProperties":true},
    "target_features":{"type":"object","required":["destination_wavefronts","ncu_values_not_consumed"],"properties":{"destination_wavefronts":{"type":"integer","minimum":0},"ncu_values_not_consumed":{"const":true}},"additionalProperties":true},
    "prediction":{"type":"object","required":["point_cycles","interval_lower_cycles","interval_upper_cycles","interval_role"],"properties":{"point_cycles":{"type":"number"},"interval_lower_cycles":{"type":"number"},"interval_upper_cycles":{"type":"number"},"interval_role":{"const":"empirical_observer_prediction_not_semantic_completion_upper"}},"additionalProperties":true},
    "interpretation":{"type":"string","minLength":1}
  },
  "additionalProperties":false
}

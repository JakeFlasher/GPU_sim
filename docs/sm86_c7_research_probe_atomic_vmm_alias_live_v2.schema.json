{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpu-simulator.local/schemas/sm86_c7_research_probe_atomic_vmm_alias_live_v2.schema.json",
  "title": "SM86 CUDA VMM alias native replay boundary diagnostic",
  "type": "object",
  "required": ["schema", "status", "host_identity", "identity", "correctness", "simulator", "trace", "ncu", "comparison", "vmm_boundary", "interpretation"],
  "properties": {
    "schema": {"const": "sm86_c7_research_probe_atomic_vmm_alias_live_v2"},
    "status": {"type": "string", "minLength": 1},
    "host_identity": {"type": "object", "required": ["device_index", "name", "compute_capability", "driver"], "additionalProperties": true},
    "identity": {"type": "object", "required": ["driver", "binary", "control", "trace", "args", "ncu_repeats"], "additionalProperties": true},
    "correctness": {"type": "object", "additionalProperties": true},
    "simulator": {"type": "object", "required": ["applicable", "records", "instructions_issued", "completion_frontier"], "additionalProperties": true},
    "trace": {"type": "object", "required": ["coverage", "target_records"], "additionalProperties": true},
    "ncu": {"type": "object", "required": ["metric", "values", "median", "instruction_counts"], "additionalProperties": true},
    "comparison": {"type": "object", "required": ["lower_bound_consistency", "lower_bound_cycles", "ncu_median_cycles"], "additionalProperties": true},
    "vmm_boundary": {"type": "object", "required": ["physical_alias_oracle_passed", "simulator_modeling_status", "why_not_exact"], "additionalProperties": true},
    "interpretation": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}

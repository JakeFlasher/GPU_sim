{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://gpu-simulator.local/schemas/sm86_completion_frontier_c3_async_phase_corrected_live_v1.schema.json",
  "title":"SM86 corrected async phase live result",
  "type":"object",
  "required":["schema","status","identity","direct_correctness","simulator","ncu","comparison","interpretation"],
  "properties":{
    "schema":{"const":"sm86_completion_frontier_c3_async_phase_corrected_live_v1"},
    "status":{"const":"corrected_probe_live_ncu_mismatch"},
    "identity":{"type":"object","additionalProperties":true},
    "direct_correctness":{"type":"object","required":["token_correct","correct","sum_consistent"],"properties":{"token_correct":{"const":true},"correct":{"const":true},"sum_consistent":{"const":true}},"additionalProperties":true},
    "simulator":{"type":"object","additionalProperties":true},
    "ncu":{"type":"object","required":["metric","values","median"],"properties":{"metric":{"const":"gpc__cycles_elapsed.max"},"values":{"type":"array","minItems":5,"items":{"type":"number"}},"median":{"type":"number"}},"additionalProperties":true},
    "comparison":{"type":"object","required":["point_error_cycles","point_absolute_percentage_error","hardware_completion"],"properties":{"point_error_cycles":{"type":"number"},"point_absolute_percentage_error":{"type":"number"},"hardware_completion":{"const":"not_observed"}},"additionalProperties":true},
    "interpretation":{"type":"string","minLength":1}
  },
  "additionalProperties":false
}

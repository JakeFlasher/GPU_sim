{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpu-simulator.local/schemas/sm86_c7_research_probe_fixed_latency_result_queue_width12_pair_live_v1.schema.json",
  "title": "SM86 fixed-latency result-queue held-out width-12 pair",
  "type": "object",
  "required": ["schema", "status", "host_identity", "protocol", "decoder_limit_repair", "arms", "differential", "interpretation"],
  "properties": {
    "schema": {"const": "sm86_c7_research_probe_fixed_latency_result_queue_width12_pair_live_v1"},
    "status": {"type": "string", "minLength": 1},
    "host_identity": {"type": "object", "required": ["device_index", "name", "compute_capability", "driver"], "additionalProperties": true},
    "protocol": {"type": "object", "required": ["driver", "warps", "generations", "ncu_repeats", "same_binary_contract"], "additionalProperties": true},
    "decoder_limit_repair": {"type": "object", "required": ["old_threadblock_instruction_limit", "new_threadblock_instruction_limit", "reason"], "additionalProperties": true},
    "arms": {"type": "object", "required": ["collision", "separated"], "additionalProperties": true},
    "differential": {"type": "object", "required": ["ncu_median_delta_cycles", "simulator_lower_delta_cycles", "delta_residual_cycles", "interpretation"], "additionalProperties": true},
    "interpretation": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gpusim/ncu_observation_v2.schema.json",
  "title": "Post-prediction NCU observation document v2",
  "type": "object",
  "required": ["schema", "identity_status", "target_contract", "rows"],
  "properties": {
    "schema": {"const": "ncu_observation_v2"},
    "identity_status": {"enum": ["manifest_labeled_historical", "caller_labeled_unverified", "independently_verified"]},
    "source": {"type": "string", "minLength": 1},
    "target_contract": {"$ref": "#/$defs/target_contract"},
    "rows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/row"}}
  },
  "additionalProperties": false,
  "$defs": {
    "hardware": {
      "type": "object",
      "required": ["gpu_uuid", "compute_capability", "sm_clock_mhz", "device_index"],
      "properties": {
        "gpu_uuid": {"type": "string", "minLength": 1},
        "compute_capability": {"type": "string", "minLength": 1},
        "sm_clock_mhz": {"type": "integer", "minimum": 1},
        "device_index": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "target_contract": {
      "type": "object",
      "required": ["metric", "endpoint", "clock_domain", "cache_policy", "launch_identity", "repetitions", "hardware"],
      "properties": {
        "metric": {"const": "gpc__cycles_elapsed.max"},
        "endpoint": {"type": "string", "minLength": 1},
        "clock_domain": {"type": "string", "minLength": 1},
        "cache_policy": {"type": "string", "minLength": 1},
        "launch_identity": {"type": "string", "minLength": 1},
        "repetitions": {"type": "integer", "minimum": 1},
        "hardware": {"$ref": "#/$defs/hardware"}
      },
      "additionalProperties": false
    },
    "row": {
      "type": "object",
      "required": ["workload", "value", "metric", "endpoint", "clock_domain", "hardware", "identity_status"],
      "properties": {
        "workload": {"type": "string", "minLength": 1},
        "value": {"type": "number"},
        "metric": {"const": "gpc__cycles_elapsed.max"},
        "endpoint": {"type": "string", "minLength": 1},
        "clock_domain": {"type": "string", "minLength": 1},
        "hardware": {"$ref": "#/$defs/hardware"},
        "source_binding": {"$ref": "#/$defs/source_binding"},
        "source": {"type": "string", "minLength": 1},
        "identity_status": {"enum": ["manifest_labeled_historical", "caller_labeled_unverified", "independently_verified"]}
      },
      "additionalProperties": false
    },
    "source_binding": {
      "type": "object",
      "required": ["workload", "trace", "control", "arch_card", "pchase_card", "launch_identity"],
      "properties": {
        "workload": {"type": "string", "minLength": 1},
        "trace": {"type": "string", "minLength": 1},
        "control": {"type": "string", "minLength": 1},
        "arch_card": {"type": "string", "minLength": 1},
        "pchase_card": {"type": "string", "minLength": 1},
        "launch_identity": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}

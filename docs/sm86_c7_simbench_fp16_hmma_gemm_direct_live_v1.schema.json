{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpu-simulator.local/schemas/sm86_c7_simbench_fp16_hmma_gemm_direct_live_v1.schema.json",
  "title": "SM86 SimBench FP16 HMMA direct live result",
  "type": "object",
  "required": ["schema", "status", "identity", "host_identity", "correctness", "trace", "simulator", "fast_frontier", "tail_facts", "ncu", "comparison", "interpretation"],
  "properties": {
    "schema": {"const": "sm86_c7_simbench_fp16_hmma_gemm_direct_live_v1"},
    "status": {"const": "correctness_trace_replay_ncu_complete_native_dispatch_refused"},
    "host_observation": {"type": "string"},
    "host_identity": {"type": "object", "additionalProperties": true},
    "identity": {"type": "object", "additionalProperties": true},
    "correctness": {
      "type": "object",
      "required": ["status", "correct", "mismatch_count", "max_abs_error"],
      "properties": {"status": {"const": "passed"}, "correct": {"const": true}, "mismatch_count": {"const": 0}, "max_abs_error": {"type": "number"}},
      "additionalProperties": true
    },
    "trace": {"type": "object", "additionalProperties": true},
    "simulator": {"type": "object", "additionalProperties": true},
    "fast_frontier": {"type": "object", "additionalProperties": true},
    "tail_facts": {"type": "object", "additionalProperties": true},
    "ncu": {
      "type": "object",
      "required": ["metric", "values", "median"],
      "properties": {"metric": {"const": "gpc__cycles_elapsed.max"}, "values": {"type": "array", "minItems": 5, "items": {"type": "number"}}, "median": {"type": "number"}},
      "additionalProperties": true
    },
    "comparison": {
      "type": "object",
      "required": ["native_macro_dispatches", "hardware_completion", "point_estimator", "lower_bound_consistency"],
      "properties": {"native_macro_dispatches": {"const": 0}, "hardware_completion": {"const": "not_observed"}, "point_estimator": {"const": "not_claimed"}, "absolute_percentage_error": {"const": "not_applicable_lower_bound_is_not_point"}, "lower_bound_consistency": {"type": "boolean"}},
      "additionalProperties": true
    },
    "interpretation": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}

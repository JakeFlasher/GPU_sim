{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpu-simulator.local/schemas/sm86_completion_frontier_c3_store2_holdout_v1.schema.json",
  "title": "SM86 C3 store holdout",
  "type": "object",
  "required": ["schema", "status", "identity", "prediction", "observation", "evaluation", "model_interval", "ncu_target_metric", "ncu_samples", "ncu_median_cycles", "ncu_min_cycles", "ncu_max_cycles", "raw_repetition_coverage", "median_coverage", "mean_point_ape_pct", "mechanism_metrics", "finite_upper_model_status", "interpretation"],
  "properties": {
    "schema": {"const": "sm86_completion_frontier_c3_store2_holdout_v1"},
    "status": {"const": "held_out_finite_median_but_repeat_dispersion"},
    "identity": {"type": "string"}, "prediction": {"type": "string"}, "observation": {"type": "string"}, "evaluation": {"type": "string"},
    "model_interval": {"type": "object", "required": ["lower_cycles", "upper_cycles"], "properties": {"lower_cycles": {"type": "integer", "minimum": 0}, "upper_cycles": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "ncu_target_metric": {"const": "gpc__cycles_elapsed.max"},
    "ncu_samples": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "number", "minimum": 0}},
    "ncu_median_cycles": {"type": "number", "minimum": 0}, "ncu_min_cycles": {"type": "number", "minimum": 0}, "ncu_max_cycles": {"type": "number", "minimum": 0},
    "raw_repetition_coverage": {"type": "number", "minimum": 0, "maximum": 1}, "median_coverage": {"const": true}, "mean_point_ape_pct": {"type": "number", "minimum": 0},
    "mechanism_metrics": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "number", "minimum": 0}}},
    "finite_upper_model_status": {"const": "complete_explicit_service_queues"},
    "interpretation": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}

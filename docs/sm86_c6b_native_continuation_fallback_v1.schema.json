{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpu-simulator.local/schemas/sm86_c6b_native_continuation_fallback_v1.schema.json",
  "title": "SM86 C6-B native continuation fallback",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "phase",
    "evidence",
    "reference",
    "decision",
    "interpretation"
  ],
  "properties": {
    "schema": {
      "const": "sm86_c6b_native_continuation_fallback_v1"
    },
    "status": {
      "type": "string"
    },
    "phase": {
      "const": "C6-B"
    },
    "evidence": {
      "type": "object"
    },
    "reference": {
      "type": "object",
      "required": [
        "footer_complete",
        "native_boundary_records",
        "complete_boundary_records",
        "exact_fallback_boundary_records",
        "complete_transition_pairs"
      ],
      "properties": {
        "footer_complete": {
          "const": true
        },
        "complete_boundary_records": {
          "const": 0
        },
        "exact_fallback_boundary_records": {
          "const": 33290
        },
        "complete_transition_pairs": {
          "const": 0
        }
      },
      "additionalProperties": true
    },
    "decision": {
      "type": "object",
      "required": [
        "positive_real_native_continuation_witness",
        "synthetic_witness_used",
        "native_macro_dispatches",
        "exact_fallback_preserved",
        "physical_completion",
        "semantic_upper"
      ],
      "properties": {
        "positive_real_native_continuation_witness": {
          "const": false
        },
        "synthetic_witness_used": {
          "const": false
        },
        "native_macro_dispatches": {
          "const": 0
        },
        "exact_fallback_preserved": {
          "const": true
        },
        "physical_completion": {
          "const": "unknown"
        },
        "semantic_upper": {
          "const": "open"
        }
      },
      "additionalProperties": true
    },
    "interpretation": {
      "type": "string",
      "minLength": 1
    }
  }
}

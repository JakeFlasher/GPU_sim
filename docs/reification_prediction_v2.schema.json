{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gpusim/reification_prediction_v2.schema.json",
  "title": "GPU reification prediction document v2",
  "type": "object",
  "required": ["schema", "target_contract", "rows"],
  "properties": {
    "schema": {"const": "reification_prediction_v2"},
    "intervention": {"type": "string", "minLength": 1},
    "target_contract": {"$ref": "#/$defs/target_contract"},
    "rows": {"type": "array", "items": {"$ref": "#/$defs/row"}}
  },
  "additionalProperties": false,
  "$defs": {
    "hardware": {
      "type": "object",
      "required": ["gpu_uuid", "compute_capability", "sm_clock_mhz", "device_index"],
      "properties": {
        "gpu_uuid": {"type": "string", "minLength": 1},
        "compute_capability": {"type": "string", "minLength": 1},
        "sm_clock_mhz": {"type": "integer", "minimum": 1},
        "device_index": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "target_contract": {
      "type": "object",
      "required": ["metric", "endpoint", "clock_domain", "cache_policy", "launch_identity", "repetitions", "hardware"],
      "properties": {
        "metric": {"const": "gpc__cycles_elapsed.max"},
        "endpoint": {"type": "string", "minLength": 1},
        "clock_domain": {"type": "string", "minLength": 1},
        "cache_policy": {"type": "string", "minLength": 1},
        "launch_identity": {"type": "string", "minLength": 1},
        "repetitions": {"type": "integer", "minimum": 1},
        "hardware": {"$ref": "#/$defs/hardware"}
      },
      "additionalProperties": false
    },
    "prediction": {
      "type": "object",
      "required": ["point", "lower", "upper"],
      "properties": {
        "point": {"type": "number"},
        "lower": {"type": "number"},
        "upper": {"type": ["number", "null"]}
      },
      "additionalProperties": false
    },
    "row": {
      "type": "object",
      "required": ["workload", "family", "split", "status"],
      "properties": {
        "workload": {"type": "string", "minLength": 1},
        "family": {"type": "string", "minLength": 1},
        "split": {"enum": ["calibration", "development", "held_out"]},
        "intervention": {"type": "string", "minLength": 1},
        "status": {"enum": ["predicted", "refused"]},
        "prediction": {"$ref": "#/$defs/prediction"},
        "point_basis": {"type": "string"},
        "runtime_ms": {"type": ["number", "null"]},
        "memory_bytes": {"type": ["integer", "null"]},
        "step_reduction": {"type": ["number", "null"]}
      },
      "additionalProperties": false
    }
  }
}

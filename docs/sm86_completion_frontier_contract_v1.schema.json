{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpu-simulator.local/schemas/sm86_completion_frontier_contract_v1.schema.json",
  "title": "SM86 completion frontier contract",
  "type": "object",
  "required": ["schema", "status", "architecture", "target_endpoint", "frontiers", "tail_classes", "finite_upper_requirements", "open_policy", "measurement_contract"],
  "properties": {
    "schema": {"const": "sm86_completion_frontier_contract_v1"},
    "status": {"const": "active_research_contract"},
    "architecture": {"const": "sm_86"},
    "target_endpoint": {
      "type": "object",
      "required": ["name", "metric", "clock_domain", "unit", "semantics"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "metric": {"const": "gpc__cycles_elapsed.max"},
        "clock_domain": {"const": "gpc_cycles"},
        "unit": {"const": "cycles"},
        "semantics": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "frontiers": {"type": "array", "minItems": 6, "items": {"type": "object", "required": ["name", "meaning"], "properties": {"name": {"type": "string"}, "meaning": {"type": "string"}}, "additionalProperties": false}},
    "tail_classes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "finite_upper_requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "open_policy": {"type": "object", "required": ["unknown_tail", "unknown_ownership", "unknown_order", "unknown_completion_token", "ncu_observation_without_model_upper"], "additionalProperties": {"type": "string"}},
    "measurement_contract": {
      "type": "object",
      "required": ["replay_mode", "cache_policy", "clock_control", "repetitions", "mechanism_metrics", "ncu_is_independent_target", "ncu_values_may_not_tune_same_scored_row"],
      "properties": {
        "replay_mode": {"const": "application"},
        "cache_policy": {"const": "all"},
        "clock_control": {"const": "none"},
        "repetitions": {"const": 5},
        "mechanism_metrics": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "ncu_is_independent_target": {"const": true},
        "ncu_values_may_not_tune_same_scored_row": {"const": true}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

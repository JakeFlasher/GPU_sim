{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpu-simulator.local/schemas/sm86_tail_facts_v1.schema.json",
  "title": "SM86 observed tail facts",
  "type": "object",
  "required": [
    "schema",
    "source",
    "coverage",
    "facts",
    "launches",
    "interpretation"
  ],
  "properties": {
    "schema": {
      "const": "sm86_tail_facts_v1"
    },
    "source": {
      "type": "object",
      "required": [
        "trace",
        "control",
        "extraction"
      ],
      "properties": {
        "trace": {
          "type": "string"
        },
        "control": {
          "type": "string"
        },
        "extraction": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": [
        "payload_files",
        "launches",
        "kind"
      ],
      "properties": {
        "payload_files": {
          "type": "integer",
          "minimum": 1
        },
        "launches": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "facts": {
      "type": "object",
      "required": [
        "records",
        "memory_records",
        "stores",
        "atomics",
        "reductions",
        "async_copies",
        "allocation_ids",
        "cross_sm_line_topology",
        "active_mask_missing_records",
        "predicate_mask_missing_records",
        "fence_opcodes_observed",
        "async_protocol_opcodes_observed",
        "line_generation_observed",
        "owner_read_from_observed",
        "fence_scope_semantics_closed",
        "hardware_completion_token_observed",
        "protocol_record_counts",
        "opcode_heads_observed",
        "same_warp_program_order_edges",
        "instrumentation_order_records",
        "instrumentation_order_unique",
        "instrumentation_order_strictly_unique",
        "static_opcode_records",
        "static_opcode_ambiguity_records",
        "global_event_order_observed",
        "address_operands_unknown",
        "predicated_off_memory_records",
        "address_compression_formats",
        "async_protocol_lane_facts"
      ],
      "properties": {
        "records": {
          "type": "integer"
        },
        "memory_records": {
          "type": "integer"
        },
        "stores": {
          "type": "integer"
        },
        "atomics": {
          "type": "integer"
        },
        "reductions": {
          "type": "integer"
        },
        "async_copies": {
          "type": "integer"
        },
        "allocation_ids": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "cross_sm_line_topology": {
          "type": "integer"
        },
        "active_mask_missing_records": {
          "type": "integer"
        },
        "predicate_mask_missing_records": {
          "type": "integer"
        },
        "fence_opcodes_observed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "async_protocol_opcodes_observed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "line_generation_observed": {
          "type": "boolean"
        },
        "owner_read_from_observed": {
          "type": "boolean"
        },
        "fence_scope_semantics_closed": {
          "type": "boolean"
        },
        "hardware_completion_token_observed": {
          "type": "boolean"
        },
        "protocol_record_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "opcode_heads_observed": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "same_warp_program_order_edges": {
          "type": "integer",
          "minimum": 0
        },
        "instrumentation_order_records": {
          "type": "integer",
          "minimum": 0
        },
        "instrumentation_order_unique": {
          "type": "integer",
          "minimum": 0
        },
        "instrumentation_order_strictly_unique": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "static_opcode_records": {
          "type": "integer",
          "minimum": 0
        },
        "static_opcode_ambiguity_records": {
          "type": "integer",
          "minimum": 0
        },
        "global_event_order_observed": {
          "type": "boolean"
        },
        "address_operands_unknown": {
          "type": "integer",
          "minimum": 0
        },
        "predicated_off_memory_records": {
          "type": "integer",
          "minimum": 0
        },
        "address_compression_formats": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "async_protocol_lane_facts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "additionalProperties": false
    },
    "launches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "device_id": {
            "type": "integer"
          },
          "stream_id": {
            "type": "integer"
          },
          "kernel_id": {
            "type": "integer"
          },
          "records": {
            "type": "integer",
            "minimum": 0
          },
          "memory_records": {
            "type": "integer",
            "minimum": 0
          },
          "warps": {
            "type": "integer",
            "minimum": 0
          },
          "same_warp_program_order_edges": {
            "type": "integer",
            "minimum": 0
          },
          "instrumentation_order_records": {
            "type": "integer",
            "minimum": 0
          },
          "static_opcode_records": {
            "type": "integer",
            "minimum": 0
          },
          "static_opcode_ambiguity_records": {
            "type": "integer",
            "minimum": 0
          },
          "sm_ids": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        }
      }
    },
    "interpretation": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpu-simulator.local/schemas/sm86_c7_simbench_warm_cold_pair_relaunch_direct_live_v1.schema.json",
  "title": "SM86 SimBench warm/cold pair direct live result",
  "type": "object",
  "required": ["schema", "status", "identity", "host_identity", "correctness", "trace", "simulator", "ncu", "comparison", "interpretation"],
  "properties": {
    "schema": {"const": "sm86_c7_simbench_warm_cold_pair_relaunch_direct_live_v1"},
    "status": {"const": "correctness_trace_replay_ncu_complete_native_dispatch_refused"},
    "host_observation": {"type": "string"},
    "host_identity": {"type": "object", "additionalProperties": true},
    "identity": {"type": "object", "additionalProperties": true},
    "correctness": {"type": "object", "required": ["status", "correct"], "properties": {"status": {"const": "passed"}, "correct": {"const": true}}, "additionalProperties": true},
    "trace": {"type": "object", "additionalProperties": true},
    "simulator": {"type": "object", "additionalProperties": true},
    "ncu": {"type": "object", "required": ["metric", "repeats", "launches"], "properties": {"metric": {"const": "gpc__cycles_elapsed.max"}, "repeats": {"const": 5}, "launches": {"type": "object"}}, "additionalProperties": true},
    "comparison": {"type": "object", "required": ["native_macro_dispatches", "hardware_completion", "point_estimator"], "properties": {"native_macro_dispatches": {"const": 0}, "hardware_completion": {"const": "not_observed"}, "point_estimator": {"const": "not_claimed"}}, "additionalProperties": true},
    "interpretation": {"type": "string", "minLength": 1},
    "raw_artifacts": {"type": "object", "additionalProperties": true}
  },
  "additionalProperties": false
}

{
  "$id": "https://gpu-simulator.local/schemas/sm86_m5d_claim_synchronization_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claims": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "milestone": {
            "type": "string"
          },
          "open_surface": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "supported_surface": {
            "type": "string"
          }
        },
        "required": [
          "milestone",
          "state",
          "supported_surface",
          "open_surface"
        ],
        "type": "object"
      },
      "minItems": 8,
      "type": "array"
    },
    "discipline": {
      "additionalProperties": false,
      "properties": {
        "ncu_values_used_as_model_features": {
          "type": "boolean"
        },
        "ncu_values_used_for_parameter_fitting": {
          "type": "boolean"
        },
        "semantic_tails_cleared_by_aggregate_counts": {
          "type": "boolean"
        },
        "synthetic_witness_promoted_to_native": {
          "type": "boolean"
        },
        "unfinished_mechanisms_relabelled_complete": {
          "type": "boolean"
        }
      },
      "required": [
        "ncu_values_used_as_model_features",
        "ncu_values_used_for_parameter_fitting",
        "unfinished_mechanisms_relabelled_complete",
        "synthetic_witness_promoted_to_native",
        "semantic_tails_cleared_by_aggregate_counts"
      ],
      "type": "object"
    },
    "evidence": {
      "additionalProperties": true,
      "required": [
        "m5a",
        "m5b",
        "m5c",
        "inventory"
      ],
      "type": "object"
    },
    "interpretation": {
      "minLength": 1,
      "type": "string"
    },
    "phase": {
      "const": "M5-D"
    },
    "regression": {
      "additionalProperties": true,
      "required": [
        "cargo_test_sim_run",
        "cargo_test_sim_sm",
        "pytest_semantic_and_artifact",
        "jsonschema_matching_docs",
        "git_diff_check",
        "known_unrelated_failure"
      ],
      "type": "object"
    },
    "schema": {
      "const": "sm86_m5d_claim_synchronization_v1"
    },
    "status": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "status",
    "phase",
    "claims",
    "evidence",
    "regression",
    "discipline",
    "interpretation"
  ],
  "title": "sm86_m5d_claim_synchronization_v1",
  "type": "object"
}

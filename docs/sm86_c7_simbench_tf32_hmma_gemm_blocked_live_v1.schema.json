{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpu-simulator.local/schemas/sm86_c7_simbench_tf32_hmma_gemm_blocked_live_v1.schema.json",
  "title": "SM86 SimBench TF32 HMMA blocked live result",
  "type": "object",
  "required": ["schema", "status", "identity", "host_identity", "correctness", "trace", "replay", "ncu", "comparison", "interpretation"],
  "properties": {
    "schema": {"const": "sm86_c7_simbench_tf32_hmma_gemm_blocked_live_v1"},
    "status": {"const": "correctness_trace_ncu_complete_replay_blocked_unsupported_tensor_pipeline"},
    "host_observation": {"type": "string"},
    "host_identity": {"type": "object", "additionalProperties": true},
    "identity": {"type": "object", "additionalProperties": true},
    "correctness": {
      "type": "object",
      "required": ["status", "correct", "mismatch_count"],
      "properties": {"status": {"const": "passed"}, "correct": {"const": true}, "mismatch_count": {"const": 0}},
      "additionalProperties": true
    },
    "trace": {"type": "object", "additionalProperties": true},
    "replay": {
      "type": "object",
      "required": ["status", "classification"],
      "properties": {"status": {"const": "blocked"}, "classification": {"const": "unsupported_sass_pipeline_model"}},
      "additionalProperties": true
    },
    "fast_frontier": {"type": "object", "additionalProperties": true},
    "tail_facts": {"type": "object", "additionalProperties": true},
    "ncu": {
      "type": "object",
      "required": ["metric", "values", "median"],
      "properties": {"metric": {"const": "gpc__cycles_elapsed.max"}, "values": {"type": "array", "minItems": 5, "items": {"type": "number"}}, "median": {"type": "number"}},
      "additionalProperties": true
    },
    "comparison": {
      "type": "object",
      "required": ["native_macro_dispatches", "hardware_completion", "point_estimator"],
      "properties": {"native_macro_dispatches": {"const": "not_run"}, "hardware_completion": {"const": "not_observed"}, "point_estimator": {"const": "not_claimed"}},
      "additionalProperties": true
    },
    "interpretation": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}

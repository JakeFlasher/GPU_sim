{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpu-simulator.local/schemas/sm86_c6a_native_continuation_bound_probe_v1.schema.json",
  "title": "SM86 C6-A bounded native continuation attempt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "phase",
    "attempt",
    "identity",
    "decision",
    "replay",
    "interpretation"
  ],
  "properties": {
    "schema": {
      "const": "sm86_c6a_native_continuation_bound_probe_v1"
    },
    "status": {
      "type": "string"
    },
    "phase": {
      "const": "C6-A"
    },
    "attempt": {
      "type": "object",
      "required": [
        "reference_max_records",
        "reference_lines",
        "return_code",
        "footer_present"
      ],
      "properties": {
        "reference_max_records": {
          "const": 10000
        },
        "reference_lines": {
          "const": 10000
        },
        "return_code": {
          "const": 1
        },
        "footer_present": {
          "const": false
        }
      },
      "additionalProperties": true
    },
    "identity": {
      "type": "object"
    },
    "decision": {
      "type": "object",
      "required": [
        "positive_real_native_continuation_witness",
        "complete_typed_boundaries",
        "native_macro_dispatches",
        "exact_fallback_all_records",
        "physical_completion",
        "semantic_upper"
      ],
      "properties": {
        "positive_real_native_continuation_witness": {
          "const": false
        },
        "physical_completion": {
          "const": "unknown"
        },
        "semantic_upper": {
          "const": "open"
        }
      },
      "additionalProperties": true
    },
    "replay": {
      "type": "object"
    },
    "interpretation": {
      "type": "string",
      "minLength": 1
    }
  }
}

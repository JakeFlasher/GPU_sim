{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpu-simulator.local/schemas/sm86_completion_frontier_report_v1.schema.json",
  "title": "SM86 completion frontier diagnostic report",
  "type": "object",
  "required": ["schema", "contract", "target_endpoint", "launch_count", "finite_upper_eligible_launches", "open_launches", "rows", "interpretation"],
  "properties": {
    "schema": {"const": "sm86_completion_frontier_report_v1"},
    "contract": {"const": "sm86_completion_frontier_contract_v1"},
    "target_endpoint": {"type": "object", "required": ["name", "metric", "clock_domain", "unit", "semantics"], "additionalProperties": true},
    "launch_count": {"type": "integer", "minimum": 1},
    "finite_upper_eligible_launches": {"type": "integer", "minimum": 0},
    "open_launches": {"type": "integer", "minimum": 0},
    "rows": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["launch_index", "completion_status", "modeled_lower_bound_cycles", "finite_upper_eligible", "open_dimensions", "ncu_target_is_not_used"],
        "properties": {
          "launch_index": {"type": "integer", "minimum": 0},
          "kernel_name": {"type": ["string", "null"]},
          "completion_status": {"type": "string", "minLength": 1},
          "modeled_lower_bound_cycles": {"type": "integer", "minimum": 0},
          "gpc_observation_lower_bound_cycles": {"type": ["integer", "null"], "minimum": 0},
          "gpc_observation_cycles": {"type": ["integer", "null"], "minimum": 0},
          "finite_upper_eligible": {"type": "boolean"},
          "open_dimensions": {"type": "array", "items": {"type": "string"}},
          "ncu_target_is_not_used": {"const": true}
        },
        "additionalProperties": false
      }
    },
    "interpretation": {"const": "diagnostic_model_frontier_only_ncu_values_not_consumed"}
  },
  "additionalProperties": false
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "trace_sampling.schema.json",
  "title": "trace_sampling sidecar (closed schema)",
  "description": "One per budget-breaching cell. additionalProperties:false at every level. Wave reconstruction is on launch_index (the simulator has no start-order); segment->block_ids membership is explicit so the estimator + reader guards are re-derivable from the dumped trace. The reader cross-checks shape.original_grid against the launch record and records.captured against records_seen.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cell_id", "kernel", "method", "reason", "shape", "gates", "records", "tracer", "hashes"],
  "allOf": [
    {
      "if": {"required": ["method"], "properties": {"method": {"const": "wave_segment_stratified_subset"}}},
      "then": {
        "required": ["wave_model", "segments", "selected_segment_ids", "certainty_segments", "force_include_blocks", "per_sm_slot_map", "strata", "selection_reconciliation", "selection_budget", "selection_auxiliary", "rng", "estimator", "label_pairing", "bytes"],
        "properties": {
          "hashes": {"required": ["selected_block_ids_sha256", "decompressed_payload_sha256", "sidecar_sha256"]},
          "tracer": {
            "properties": {
              "version": {"const": 5},
              "stats_pass_version": {"const": 2}
            }
          },
          "rng": {
            "properties": {
              "algo": {"const": "pcg64"}
            }
          }
        }
      }
    },
    {
      "if": {"required": ["method"], "properties": {"method": {"const": "lossless_compressed_full"}}},
      "then": {
        "required": ["bytes", "label_pairing"],
        "properties": {
          "label_pairing": {"const": "full_shape_label"},
          "hashes": {"required": ["selected_block_ids_sha256", "decompressed_payload_sha256"]}
        }
      }
    },
    {
      "if": {"required": ["method"], "properties": {"method": {"const": "reduced_shape_matched_label"}}},
      "then": {
        "required": ["label_pairing", "shape"],
        "properties": {
          "label_pairing": {"const": "matched_reduced_shape_label"},
          "shape": {
            "required": ["reduced_shape_variant"],
            "properties": {"reduced_shape_variant": {"type": "string", "enum": ["grid_stride_footprint_preserving", "dataset_shrunk"]}}
          }
        }
      }
    },
    {
      "if": {"required": ["method"], "properties": {"method": {"const": "unavailable"}}},
      "then": {"not": {"required": ["estimator"]}}
    }
  ],
  "properties": {
    "schema_version": {"const": 2},
    "cell_id": {"type": "string", "minLength": 1},
    "kernel": {
      "type": "object", "additionalProperties": false,
      "required": ["mangled_name", "args_hash"],
      "properties": {
        "mangled_name": {"type": "string", "minLength": 1},
        "args_hash": {"type": "string", "minLength": 1}
      }
    },
    "method": {
      "type": "string",
      "enum": ["none", "lossless_compressed_full", "wave_segment_stratified_subset", "reduced_shape_matched_label", "temporal_window", "unavailable"]
    },
    "reason": {"type": "string", "enum": ["byte_budget", "walltime_budget", "gate_forced", "not_breaching"]},
    "shape": {
      "type": "object", "additionalProperties": false,
      "required": ["original_grid", "original_block", "captured_grid", "captured_block"],
      "properties": {
        "original_grid": {"$ref": "#/$defs/dim3"},
        "original_block": {"$ref": "#/$defs/dim3"},
        "captured_grid": {"$ref": "#/$defs/dim3"},
        "captured_block": {"$ref": "#/$defs/dim3"},
        "reduced_shape_variant": {"type": ["string", "null"], "enum": ["grid_stride_footprint_preserving", "dataset_shrunk", null]}
      }
    },
    "gates": {
      "type": "object", "additionalProperties": false,
      "required": ["coop", "wave_count", "n_measured_waves", "tail_measured_waves", "atomic_density", "hotline_share", "skew_top1pct_share", "gini", "per_sm_block_count_cv", "n_phases", "skew_heavy_block_count", "certainty_bytes", "max_trace_bytes", "certainty_budget_exceeded", "verdict"],
      "properties": {
        "coop": {"type": "boolean"},
        "wave_count": {"type": "integer", "minimum": 0},
        "n_measured_waves": {"type": "integer", "minimum": 0},
        "tail_measured_waves": {"type": "integer", "minimum": 0},
        "atomic_density": {"type": "number", "minimum": 0},
        "hotline_share": {"type": "number", "minimum": 0},
        "skew_top1pct_share": {"type": "number", "minimum": 0},
        "gini": {"type": "number", "minimum": 0},
        "per_sm_block_count_cv": {"type": "number", "minimum": 0},
        "n_phases": {"type": "integer", "minimum": 1},
        "skew_heavy_block_count": {"type": "integer", "minimum": 0},
        "certainty_bytes": {"type": ["integer", "null"], "minimum": 0},
        "max_trace_bytes": {"type": ["integer", "null"], "minimum": 1},
        "certainty_budget_exceeded": {"type": "boolean"},
        "verdict": {"type": "string", "enum": ["subset_admissible", "coop_forbid", "wave_forbid", "tail_measurement_forbid", "atomic_forbid", "skew_to_reduced_shape", "certainty_budget_to_reduced_shape", "homogeneity_to_reduced_shape"]}
      }
    },
    "wave_model": {
      "type": "object", "additionalProperties": false,
      "required": ["reconstruction", "per_sm_resident_blocks", "n_waves", "segment_len", "ghost_depth"],
      "properties": {
        "reconstruction": {"const": "launch_index"},
        "per_sm_resident_blocks": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["sm_id", "resident_blocks"],
            "properties": {
              "sm_id": {"type": "integer", "minimum": 0},
              "resident_blocks": {"type": "integer", "minimum": 1}
            }
          }
        },
        "n_waves": {"type": "integer", "minimum": 0},
        "segment_len": {"type": "integer", "minimum": 1},
        "ghost_depth": {"type": "integer", "minimum": 0}
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "block_ids"],
        "properties": {
          "id": {"type": "integer", "minimum": 0},
          "block_ids": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 1, "uniqueItems": true}
        }
      }
    },
    "per_sm_slot_map": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["sm_id", "block_ids"],
        "properties": {
          "sm_id": {"type": "integer", "minimum": 0},
          "block_ids": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 1, "uniqueItems": true}
        }
      }
    },
    "strata": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "phase_id", "launch_tercile", "segment_ids", "N_h", "n_h", "pi", "sector_stddev", "neyman_weight"],
        "properties": {
          "id": {"type": "integer", "minimum": 0},
          "phase_id": {"type": "integer", "minimum": 0},
          "launch_tercile": {"type": "integer", "enum": [0, 1, 2]},
          "segment_ids": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 2, "uniqueItems": true},
          "N_h": {"type": "integer", "minimum": 1},
          "n_h": {"type": "integer", "minimum": 2},
          "pi": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
          "sector_stddev": {"type": "number", "minimum": 0},
          "neyman_weight": {"type": "number", "minimum": 0}
        }
      }
    },
    "selected_segment_ids": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 1, "uniqueItems": true},
    "certainty_segments": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 1, "uniqueItems": true},
    "force_include_blocks": {"type": "array", "items": {"type": "integer", "minimum": 0}, "uniqueItems": true},
    "selection_reconciliation": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "attempts", "max_attempts", "capture_stats_sha256"],
      "properties": {
        "status": {"const": "fixed_point"},
        "attempts": {"type": "integer", "minimum": 1},
        "max_attempts": {"type": "integer", "minimum": 1},
        "capture_stats_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "selection_budget": {
      "type": "object", "additionalProperties": false,
      "required": ["max_trace_bytes", "basis", "certainty_fraction_numerator", "certainty_fraction_denominator", "certainty_bytes"],
      "properties": {
        "max_trace_bytes": {"type": "integer", "minimum": 1},
        "basis": {"const": "raw_threadblock_pb"},
        "certainty_fraction_numerator": {"const": 2},
        "certainty_fraction_denominator": {"const": 5},
        "certainty_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "selection_auxiliary": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "sector_bytes", "scope", "expected_full", "selected"],
      "properties": {
        "name": {"const": "l2_sector_transactions_32b"},
        "sector_bytes": {"const": 32},
        "scope": {"const": "pass2_all_blocks"},
        "expected_full": {"type": "integer", "minimum": 0},
        "selected": {"type": "integer", "minimum": 0}
      }
    },
    "rng": {
      "type": "object", "additionalProperties": false,
      "required": ["algo", "seed"],
      "properties": {"algo": {"type": "string"}, "seed": {"type": "integer"}}
    },
    "estimator": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "targets", "not_recoverable", "convergence"],
      "properties": {
        "mode": {"type": "string", "enum": ["literal_partial_replay", "weighted_full_shape_estimate", "matched_reduced_shape"]},
        "form": {"type": "string"},
        "ci": {
          "type": "object", "additionalProperties": false,
          "properties": {"method": {"type": "string"}, "B": {"type": "integer", "minimum": 1}, "alpha": {"type": "number"}}
        },
        "targets": {"type": "array", "items": {"type": "string"}},
        "not_recoverable": {"type": "array", "items": {"type": "string"}},
        "convergence": {
          "type": "object", "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": {"type": "string", "enum": ["converged", "budget_limited_wide_ci", "unavailable"]},
            "per_target": {"type": "object"}
          }
        }
      }
    },
    "label_pairing": {"type": "string", "enum": ["full_shape_label", "matched_reduced_shape_label", "no_comparable_label"]},
    "tracer": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "features", "stats_pass_version"],
      "properties": {
        "version": {"type": "integer", "minimum": 1},
        "features": {
          "type": "object", "additionalProperties": false,
          "required": ["atomic_addr", "ldgsts_addr"],
          "properties": {"atomic_addr": {"type": "boolean"}, "ldgsts_addr": {"type": "boolean"}}
        },
        "stats_pass_version": {"type": "integer", "minimum": 1}
      }
    },
    "bytes": {
      "type": "object", "additionalProperties": false,
      "required": ["raw", "compressed", "codec"],
      "properties": {
        "raw": {"type": "integer", "minimum": 0},
        "compressed": {"type": "integer", "minimum": 0},
        "codec": {"type": "string"},
        "level": {"type": "integer"},
        "long": {"type": "integer"},
        "dict_id": {"type": ["integer", "null"]}
      }
    },
    "records": {
      "type": "object", "additionalProperties": false,
      "required": ["expected_full", "captured"],
      "properties": {
        "expected_full": {"type": "integer", "minimum": 0},
        "captured": {"type": "integer", "minimum": 0}
      }
    },
    "hashes": {
      "type": "object", "additionalProperties": false,
      "required": ["selected_block_ids_sha256", "sidecar_sha256"],
      "properties": {
        "selected_block_ids_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "decompressed_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "per_block_raw_sha256_manifest": {"type": "string"},
        "sidecar_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "$defs": {
    "dim3": {
      "type": "object", "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": {"type": "integer", "minimum": 1},
        "y": {"type": "integer", "minimum": 1},
        "z": {"type": "integer", "minimum": 1}
      }
    }
  }
}

//
// Blackwell sm_100a tensor-memory load (LDT) offline SASS witness source.
//
// This synthetic PTX uses the `tcgen05.ld.sync.aligned.32x32b.x1` instruction
// (one of the simplest tensor-memory load variants in the sm_100a ISA) so
// that a downstream `cuobjdump --dump-sass` / `nvdisasm` pass produces SASS
// containing the `LDT` mnemonic. The corresponding SASS witness is
// committed as `tcgen05_ldt_witness.cuobjdump.txt` and
// `tcgen05_ldt_witness.nvdisasm.txt` in this fixture directory.
//
// This file is OFFLINE evidence per plan AC-T5.1: it proves the classifier
// + opcode mapping in `tools/nvbit_tracer/isa_def/blackwell_opcode.h` +
// `tools/nvbit_tracer/tracer_tool/memory_op_class.h` recognizes a real
// compiler-generated `LDT` mnemonic, NOT a synthetic-only string.
//
// Build invocation (offline; CUDA 13.x+ supports sm_100a target):
//
//   ptxas -arch=sm_100a tcgen05_ldt_witness.ptx -o tcgen05_ldt_witness.cubin
//   cuobjdump --dump-sass tcgen05_ldt_witness.cubin \
//       > tcgen05_ldt_witness.cuobjdump.txt
//   nvdisasm tcgen05_ldt_witness.cubin \
//       > tcgen05_ldt_witness.nvdisasm.txt
//
// The PTX below uses the .32x32b shape modifier + .x1 count modifier which
// is the minimum valid shape for tcgen05.ld on sm_100a.
//

.version 8.6
.target sm_100a
.address_size 64

.visible .entry tcgen05_ldt_witness_kernel(
    .param .u32 src_tmem_addr,
    .param .u64 dst_global_addr
)
{
    .reg .b32   %r<2>;
    .reg .b32   %taddr;
    .reg .b64   %rd<2>;

    ld.param.u32 %taddr, [src_tmem_addr];
    ld.param.u64 %rd1, [dst_global_addr];

    // tcgen05.ld.sync.aligned.32x32b.x1 : load one tile from
    // tensor memory. The `.sync.aligned` modifiers are required
    // by the sm_100a ISA; `.32x32b` is the shape modifier (32
    // rows × 32 bits each); `.x1` selects the single-tile
    // variant. The source operand is a TMEM address (uint32,
    // since TMEM is at most 4MB). Lowers to a single LDT SASS
    // instruction with `.SYNC.ALIGNED` qualifiers.
    tcgen05.ld.sync.aligned.32x32b.x1 {%r0}, [%taddr];

    st.global.u32 [%rd1], %r0;

    ret;
}

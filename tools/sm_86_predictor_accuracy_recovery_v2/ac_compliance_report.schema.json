{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ac_compliance_report",
  "description": "Final compliance + residual-reconciliation report for the sm_86 NCU-replacement loop: the per-criterion status list, the documented residual baseline (zero net-new), the AC-wide battery-check manifest, the optional-experiment-isolation statement, and the sha256 binding to the operator evidence-status table.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "arch",
    "generated_at_commit",
    "n_criteria",
    "criteria",
    "residual_baseline",
    "battery_checks",
    "optional_experiment_isolation",
    "evidence_table_path",
    "evidence_table_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "artifact_kind": { "const": "ac_compliance_report" },
    "arch": { "const": "sm_86" },
    "generated_at_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "n_criteria": { "const": 10 },
    "criteria": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion",
          "title",
          "status",
          "typing",
          "evidence",
          "limitation"
        ],
        "properties": {
          "criterion": { "type": "integer", "minimum": 1, "maximum": 10 },
          "title": { "type": "string", "minLength": 1 },
          "status": { "enum": ["met", "partial"] },
          "typing": {
            "enum": ["offline-verified", "verified-live-sm_86"]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "limitation": { "type": "string" }
        }
      }
    },
    "residual_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n_failures", "n_skips", "net_new", "failures"],
      "properties": {
        "n_failures": { "type": "integer", "minimum": 0 },
        "n_skips": { "type": "integer", "minimum": 0 },
        "net_new": { "const": 0 },
        "failures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "func", "category", "reason"],
            "properties": {
              "file": { "type": "string", "minLength": 1 },
              "func": { "type": "string", "minLength": 1 },
              "param": { "type": "string" },
              "category": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "battery_checks": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check", "target_test", "expectation"],
        "properties": {
          "check": { "type": "string", "minLength": 1 },
          "target_test": { "type": "string", "minLength": 1 },
          "expectation": { "type": "string", "minLength": 1 }
        }
      }
    },
    "optional_experiment_isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "evidence", "scored_outputs"],
      "properties": {
        "statement": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 },
        "scored_outputs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evidence_table_path": { "type": "string", "minLength": 1 },
    "evidence_table_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}

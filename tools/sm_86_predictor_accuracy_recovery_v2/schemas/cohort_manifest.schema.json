{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cohort_manifest.schema.json",
  "title": "sm_86 cohort manifest",
  "description": "Strict schema for the sm_86 submission-track cohort manifest. JSON Schema enforces: non-empty cells, required fields, enums, admission_status/exclusion_typed_reason consistency, hash/path patterns, and additionalProperties=false except replacement_history items. The validator at validate_cohort_manifest.py enforces programmatically after jsonschema.validate(): uniqueness of each cell's (slug, shape_point), admitted_cell_count matching admitted cells, and attempted_cell_count matching len(cells).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "frozen_at_commit",
    "attempted_cell_count",
    "admitted_cell_count",
    "replacement_history",
    "cells"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "frozen_at_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "attempted_cell_count": {
      "type": "integer",
      "minimum": 0
    },
    "admitted_cell_count": {
      "type": "integer",
      "minimum": 0
    },
    "replacement_history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/replacement_history_item"
      }
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/cell"
      }
    }
  },
  "$defs": {
    "sha256_hex_64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit_hex_40": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "family_bucket": {
      "type": "string",
      "enum": [
        "dl_primitives",
        "gemm_family",
        "attention_conv",
        "memory_stress",
        "irregular_hostile",
        "vendor_baselines"
      ]
    },
    "split_assignment": {
      "type": "string",
      "enum": [
        "calibration",
        "validation",
        "holdout"
      ]
    },
    "admission_status": {
      "type": "string",
      "enum": [
        "admitted",
        "attempted_excluded"
      ]
    },
    "arch": {
      "type": "string",
      "enum": [
        "sm_86",
        "sm_120"
      ]
    },
    "device": {
      "$ref": "#/$defs/non_empty_string"
    },
    "exclusion_typed_reason": {
      "type": "string",
      "enum": [
        "trace_budget_exceeded",
        "ncu_repeatability_fail",
        "build_fail",
        "typed_unavailable_emit",
        "trace_missing",
        "label_missing",
        "none_admitted"
      ]
    },
    "identity_tuple": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "shape_point",
        "arch",
        "device",
        "binary_sha256",
        "kernel_signature_sha256",
        "source_commit"
      ],
      "properties": {
        "slug": {
          "$ref": "#/$defs/non_empty_string"
        },
        "shape_point": {
          "$ref": "#/$defs/non_empty_string"
        },
        "arch": {
          "$ref": "#/$defs/arch"
        },
        "device": {
          "$ref": "#/$defs/device"
        },
        "binary_sha256": {
          "$ref": "#/$defs/sha256_hex_64"
        },
        "kernel_signature_sha256": {
          "$ref": "#/$defs/sha256_hex_64"
        },
        "source_commit": {
          "$ref": "#/$defs/commit_hex_40"
        },
        "register_cap": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional register-cap build-variant axis value. Purely additive: NOT in 'required'; base cells omit it. Present only for build-variant cells and paired with variant_id. Mirrors local_label_admitted.schema.json's register_cap; no schema_version bump (additive per the CLAUDE.md wire-extension policy)."
        },
        "variant_id": {
          "type": "string",
          "pattern": "^register_cap_(0|[1-9][0-9]*)$",
          "description": "Optional canonical build-variant identity (e.g. register_cap_64). Purely additive: NOT in 'required'; base cells omit it. Widens the cohort cell identity from (slug, shape_point) to (slug, shape_point, variant_id) so sibling build variants are distinct admitted cells. Paired with register_cap; mirrors local_label_admitted.schema.json's variant_id."
        }
      }
    },
    "replacement_history_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestamp",
        "sweep_id",
        "old_identity_tuple",
        "new_identity_tuple",
        "reason",
        "old_admission_status",
        "new_admission_status"
      ],
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "sweep_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "old_identity_tuple": {
          "$ref": "#/$defs/identity_tuple"
        },
        "new_identity_tuple": {
          "$ref": "#/$defs/identity_tuple"
        },
        "reason": {
          "$ref": "#/$defs/exclusion_typed_reason"
        },
        "old_admission_status": {
          "type": "string",
          "enum": ["admitted", "attempted_excluded"]
        },
        "new_admission_status": {
          "type": "string",
          "enum": ["admitted", "attempted_excluded"]
        }
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "shape_point",
        "arch",
        "device",
        "family_bucket",
        "split_assignment",
        "expected_trace_path",
        "expected_label_path",
        "admission_status",
        "exclusion_typed_reason",
        "identity_tuple"
      ],
      "properties": {
        "slug": {
          "$ref": "#/$defs/non_empty_string"
        },
        "shape_point": {
          "$ref": "#/$defs/non_empty_string"
        },
        "arch": {
          "$ref": "#/$defs/arch"
        },
        "device": {
          "$ref": "#/$defs/device"
        },
        "family_bucket": {
          "$ref": "#/$defs/family_bucket"
        },
        "split_assignment": {
          "$ref": "#/$defs/split_assignment"
        },
        "expected_trace_path": {
          "type": "string",
          "pattern": "^workloads/simbench_bw/results/.+"
        },
        "expected_label_path": {
          "type": "string",
          "pattern": "^(data/local_labels/|data/.+labels/).+"
        },
        "admission_status": {
          "$ref": "#/$defs/admission_status"
        },
        "exclusion_typed_reason": {
          "type": ["string", "null"],
          "enum": [
            "trace_budget_exceeded",
            "ncu_repeatability_fail",
            "build_fail",
            "typed_unavailable_emit",
            "trace_missing",
            "label_missing",
            "none_admitted",
            null
          ]
        },
        "register_cap": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional register-cap build-variant axis value (additive; base cells omit it; paired with variant_id)."
        },
        "variant_id": {
          "type": "string",
          "pattern": "^register_cap_(0|[1-9][0-9]*)$",
          "description": "Optional canonical build-variant identity (additive; base cells omit it; paired with register_cap). Widens the cohort cell identity so sibling build variants are distinct admitted cells."
        },
        "identity_tuple": {
          "$ref": "#/$defs/identity_tuple"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "admission_status": {"const": "admitted"}
            },
            "required": ["admission_status"]
          },
          "then": {
            "properties": {
              "exclusion_typed_reason": {"type": "null"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "admission_status": {"const": "attempted_excluded"}
            },
            "required": ["admission_status"]
          },
          "then": {
            "properties": {
              "exclusion_typed_reason": {
                "$ref": "#/$defs/exclusion_typed_reason"
              }
            }
          }
        }
      ]
    }
  }
}

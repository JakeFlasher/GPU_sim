{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cache_replay_sampled_fidelity.schema.json",
  "title": "Sampled-vs-full fidelity artifact for the calibrated cache-replay predictor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_commit",
    "top_level_admission_scope",
    "arches",
    "set_sample_modulus",
    "bootstrap_resamples",
    "bootstrap_seed",
    "full_cohort_median_absolute_error",
    "sampled_cohort_median_absolute_error",
    "full_ac4_verdict",
    "sampled_ac4_verdict",
    "ac4_verdict_preserved",
    "fidelity_gate",
    "per_cell"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "source_commit": {"type": "string"},
    "top_level_admission_scope": {"const": "target_arch=sm_120"},
    "arches": {
      "type": "array",
      "items": {"const": "sm_120"},
      "minItems": 1
    },
    "set_sample_modulus": {"type": "integer", "minimum": 1},
    "bootstrap_resamples": {"type": "integer", "minimum": 1},
    "bootstrap_seed": {"type": "integer"},
    "full_cohort_median_absolute_error": {"type": "number", "minimum": 0.0},
    "sampled_cohort_median_absolute_error": {"type": "number", "minimum": 0.0},
    "full_ac4_verdict": {"$ref": "#/$defs/accuracy_gate_verdict"},
    "sampled_ac4_verdict": {"$ref": "#/$defs/accuracy_gate_verdict"},
    "ac4_verdict_preserved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["geomean", "holdout_geomean", "median", "per_bucket_p90"],
      "properties": {
        "geomean": {"type": "boolean"},
        "holdout_geomean": {"type": "boolean"},
        "median": {"type": "boolean"},
        "per_bucket_p90": {"type": "boolean"}
      }
    },
    "fidelity_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "abs_delta_bar",
        "ac4_verdict_preserved",
        "max_abs_delta",
        "max_record_fraction_bar",
        "max_sampled_record_fraction",
        "min_cells_within_bar",
        "n_cells",
        "n_over_abs_delta_bar",
        "n_within_abs_delta_bar",
        "passed"
      ],
      "properties": {
        "abs_delta_bar": {"type": "number", "minimum": 0.0},
        "ac4_verdict_preserved": {"type": "boolean"},
        "max_abs_delta": {"type": "number", "minimum": 0.0},
        "max_record_fraction_bar": {"type": "number", "exclusiveMinimum": 0.0, "maximum": 1.0},
        "max_sampled_record_fraction": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "min_cells_within_bar": {"type": "integer", "minimum": 0},
        "n_cells": {"type": "integer", "minimum": 0},
        "n_over_abs_delta_bar": {"type": "integer", "minimum": 0},
        "n_within_abs_delta_bar": {"type": "integer", "minimum": 0},
        "passed": {"type": "boolean"}
      }
    },
    "per_cell": {
      "type": "array",
      "items": {"$ref": "#/$defs/per_cell_record"}
    }
  },
  "$defs": {
    "accuracy_gate_verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criteria", "per_bucket_p90", "per_bucket_passed", "passed"],
      "properties": {
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "passed", "threshold", "value"],
            "properties": {
              "name": {"type": "string"},
              "passed": {"type": "boolean"},
              "threshold": {"type": "number"},
              "value": {"type": "number"}
            }
          }
        },
        "per_bucket_p90": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["bucket", "evaluated", "n", "p90_absolute_error", "passed", "threshold"],
            "properties": {
              "bucket": {"type": "string"},
              "evaluated": {"type": "boolean"},
              "n": {"type": "integer", "minimum": 0},
              "p90_absolute_error": {"type": "number", "minimum": 0.0},
              "passed": {"type": "boolean"},
              "threshold": {"type": "number", "minimum": 0.0}
            }
          }
        },
        "per_bucket_passed": {"type": "boolean"},
        "passed": {"type": "boolean"}
      }
    },
    "per_cell_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "abs_delta",
        "bootstrap_ci",
        "cell_id",
        "full_hit_ratio",
        "sampled_hit_ratio",
        "sampled_record_fraction",
        "sampled_records",
        "wilson_ci"
      ],
      "properties": {
        "abs_delta": {"type": "number", "minimum": 0.0},
        "bootstrap_ci": {"$ref": "#/$defs/ci_band"},
        "cell_id": {"type": "string"},
        "full_hit_ratio": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "sampled_hit_ratio": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "sampled_record_fraction": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "sampled_records": {"type": "integer", "minimum": 0},
        "wilson_ci": {"$ref": "#/$defs/ci_band"}
      }
    },
    "ci_band": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ci_high", "ci_low"],
      "properties": {
        "ci_high": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "ci_low": {"type": "number", "minimum": 0.0, "maximum": 1.0}
      }
    }
  }
}

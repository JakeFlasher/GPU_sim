{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cache_replay_result.schema.json",
  "title": "Per-cell cache-only trace-replay L2 result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "predicted_hit_ratio",
    "hits",
    "total_accesses",
    "miss_breakdown",
    "uncertainty_interval",
    "cache_parameters"
  ],
  "properties": {
    "predicted_hit_ratio": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "hits": {"type": "integer", "minimum": 0},
    "total_accesses": {"type": "integer", "minimum": 0},
    "miss_breakdown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cold", "conflict", "capacity", "total"],
      "properties": {
        "cold": {"type": "integer", "minimum": 0},
        "conflict": {"type": "integer", "minimum": 0},
        "capacity": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0}
      }
    },
    "uncertainty_interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "ci_low", "ci_high"],
      "properties": {
        "method": {"type": "string"},
        "ci_low": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "ci_high": {"type": "number", "minimum": 0.0, "maximum": 1.0}
      }
    },
    "cache_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capacity_bytes",
        "effective_capacity_bytes",
        "capacity_scale",
        "sector_bytes",
        "line_bytes",
        "sectors_per_line",
        "num_slices",
        "slice_hash_id",
        "associativity",
        "replacement_policy",
        "prefetch",
        "num_sets_per_slice",
        "total_lines"
      ],
      "properties": {
        "capacity_bytes": {"type": "integer", "minimum": 1},
        "effective_capacity_bytes": {"type": "integer", "minimum": 1},
        "capacity_scale": {"type": "number", "exclusiveMinimum": 0.0},
        "sector_bytes": {"const": 32},
        "line_bytes": {"const": 128},
        "sectors_per_line": {"const": 4},
        "num_slices": {"type": "integer", "minimum": 1},
        "slice_hash_id": {"type": "string"},
        "associativity": {"type": "integer", "minimum": 1},
        "replacement_policy": {"enum": ["LRU", "SRRIP", "BIP"]},
        "prefetch": {"enum": ["off", "next_line"]},
        "num_sets_per_slice": {"type": "integer", "minimum": 1},
        "total_lines": {"type": "integer", "minimum": 1}
      }
    },
    "join_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "shape_point", "arch", "family_bucket", "cache_layer"],
      "properties": {
        "slug": {"type": "string"},
        "shape_point": {"type": "string"},
        "arch": {"const": "sm_120"},
        "family_bucket": {
          "enum": ["tensor_compute", "activation_norm", "memory_stress", "other"]
        },
        "cache_layer": {"enum": ["L2", "L1TEX"]}
      }
    },
    "ground_truth_hit_ratio": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "calibrated_hit_ratio": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "trace_stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n_accesses", "n_global", "n_local", "n_excluded_op_class"],
      "properties": {
        "n_accesses": {"type": "integer", "minimum": 0},
        "n_global": {"type": "integer", "minimum": 0},
        "n_local": {"type": "integer", "minimum": 0},
        "n_excluded_op_class": {"type": "integer", "minimum": 0},
        "n_launches": {"type": "integer", "minimum": 0},
        "n_threadblocks": {"type": "integer", "minimum": 0}
      }
    }
  }
}

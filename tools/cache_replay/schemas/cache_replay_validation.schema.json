{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cache_replay_validation.schema.json",
  "title": "Advisory robustness artifact for the calibrated cache-replay predictor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_commit",
    "advisory",
    "gates_closure",
    "top_level_admission_scope",
    "arches",
    "seed",
    "cohort_size",
    "n_slugs",
    "family_bucket_counts",
    "selected_config",
    "stratified_split",
    "loocv",
    "loso",
    "bootstrap_ci",
    "per_cell_stability",
    "advisory_thresholds",
    "note"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "source_commit": {"type": "string"},
    "advisory": {"const": true},
    "gates_closure": {"const": false},
    "top_level_admission_scope": {"const": "target_arch=sm_120"},
    "arches": {
      "type": "array",
      "items": {"const": "sm_120"},
      "minItems": 1
    },
    "seed": {"type": "integer"},
    "cohort_size": {"type": "integer", "minimum": 1},
    "n_slugs": {"type": "integer", "minimum": 1},
    "family_bucket_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tensor_compute", "activation_norm", "memory_stress", "other"],
      "properties": {
        "tensor_compute": {"type": "integer", "minimum": 0},
        "activation_norm": {"type": "integer", "minimum": 0},
        "memory_stress": {"type": "integer", "minimum": 0},
        "other": {"type": "integer", "minimum": 0}
      }
    },
    "selected_config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capacity_bytes",
        "effective_capacity_bytes",
        "capacity_scale",
        "sector_bytes",
        "line_bytes",
        "sectors_per_line",
        "num_slices",
        "slice_hash_id",
        "associativity",
        "replacement_policy",
        "prefetch",
        "num_sets_per_slice",
        "total_lines"
      ],
      "properties": {
        "capacity_bytes": {"type": "integer", "minimum": 1},
        "effective_capacity_bytes": {"type": "integer", "minimum": 1},
        "capacity_scale": {"type": "number", "exclusiveMinimum": 0.0},
        "sector_bytes": {"const": 32},
        "line_bytes": {"const": 128},
        "sectors_per_line": {"const": 4},
        "num_slices": {"type": "integer", "minimum": 1},
        "slice_hash_id": {"type": "string"},
        "associativity": {"type": "integer", "minimum": 1},
        "replacement_policy": {"enum": ["LRU", "SRRIP", "BIP"]},
        "prefetch": {"enum": ["off", "next_line"]},
        "num_sets_per_slice": {"type": "integer", "minimum": 1},
        "total_lines": {"type": "integer", "minimum": 1}
      }
    },
    "stratified_split": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed",
        "holdout_cell_count",
        "calibration_cell_count",
        "holdout_cell_ids",
        "holdout_geomean_relative_error",
        "holdout_median_absolute_error"
      ],
      "properties": {
        "seed": {"type": "integer"},
        "holdout_cell_count": {"type": "integer", "minimum": 0},
        "calibration_cell_count": {"type": "integer", "minimum": 0},
        "holdout_cell_ids": {
          "type": "array",
          "items": {"type": "string"}
        },
        "holdout_geomean_relative_error": {"type": "number", "minimum": 0.0},
        "holdout_median_absolute_error": {"type": "number", "minimum": 0.0}
      }
    },
    "loocv": {"$ref": "#/$defs/cv_block"},
    "loso": {"$ref": "#/$defs/cv_block"},
    "bootstrap_ci": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "geomean",
        "ci_low",
        "ci_high",
        "n_resamples",
        "percentile",
        "seed"
      ],
      "properties": {
        "geomean": {"type": "number", "minimum": 0.0},
        "ci_low": {"type": "number", "minimum": 0.0},
        "ci_high": {"type": "number", "minimum": 0.0},
        "n_resamples": {"type": "integer", "minimum": 1},
        "percentile": {"type": "number", "exclusiveMinimum": 0.0, "maximum": 100.0},
        "seed": {"type": "integer"}
      }
    },
    "per_cell_stability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_cells_stable",
        "n_cells",
        "n_unstable",
        "grid_is_inert",
        "per_cell_stable",
        "reason"
      ],
      "properties": {
        "all_cells_stable": {"type": "boolean"},
        "n_cells": {"type": "integer", "minimum": 0},
        "n_unstable": {"type": "integer", "minimum": 0},
        "grid_is_inert": {"type": "boolean"},
        "per_cell_stable": {
          "type": "object",
          "additionalProperties": {"type": "boolean"}
        },
        "reason": {"type": "string"}
      }
    },
    "advisory_thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loocv_vs_holdout_gap", "per_slug_loso_headline_change"],
      "properties": {
        "loocv_vs_holdout_gap": {"$ref": "#/$defs/advisory_threshold"},
        "per_slug_loso_headline_change": {"$ref": "#/$defs/advisory_threshold"}
      }
    },
    "note": {"type": "string"}
  },
  "$defs": {
    "cv_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n", "median_absolute_error", "geomean_relative_error"],
      "properties": {
        "n": {"type": "integer", "minimum": 0},
        "median_absolute_error": {"type": "number", "minimum": 0.0},
        "geomean_relative_error": {"type": "number", "minimum": 0.0}
      }
    },
    "advisory_threshold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "advisory_max", "within_advisory_band"],
      "properties": {
        "value": {"type": "number", "minimum": 0.0},
        "advisory_max": {"type": "number", "minimum": 0.0},
        "within_advisory_band": {"type": "boolean"}
      }
    }
  }
}

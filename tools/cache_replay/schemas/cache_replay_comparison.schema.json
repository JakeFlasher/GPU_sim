{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cache_replay_comparison.schema.json",
  "title": "Per-cell baseline comparison artifact for the calibrated cache-replay predictor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "aggregate_metrics",
    "algorithm_version",
    "arches",
    "cohort_size",
    "family_bucket_counts",
    "grid_config_medabs",
    "grid_provenance",
    "holdout_cell_count",
    "holdout_geomean",
    "inert_grid_evidence",
    "l2_capacity_provenance",
    "per_family_bucket_p90_calibrated",
    "replay_vs_rdh_baseline_beat_fraction",
    "replay_vs_rdh_baseline_joint_admit_count",
    "replay_vs_v5_beat_fraction",
    "replay_vs_v5_joint_admit_count",
    "residual_provenance",
    "result_kind",
    "rows",
    "schema_version",
    "source_commit",
    "top_level_admission_scope"
  ],
  "properties": {
    "aggregate_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "always_hit_prediction",
        "cohort_mean_prediction",
        "nugteren_prediction",
        "replay_calibrated_prediction",
        "replay_prediction",
        "uncalibrated_walker_prediction",
        "v4_platt_prediction",
        "v5_prediction"
      ],
      "properties": {
        "always_hit_prediction": {"$ref": "#/$defs/metric_block"},
        "cohort_mean_prediction": {"$ref": "#/$defs/metric_block"},
        "nugteren_prediction": {"$ref": "#/$defs/metric_block"},
        "replay_calibrated_prediction": {"$ref": "#/$defs/metric_block"},
        "replay_prediction": {"$ref": "#/$defs/metric_block"},
        "uncalibrated_walker_prediction": {"$ref": "#/$defs/metric_block"},
        "v4_platt_prediction": {"$ref": "#/$defs/metric_block"},
        "v5_prediction": {"$ref": "#/$defs/metric_block"}
      }
    },
    "algorithm_version": {"type": "string"},
    "arches": {
      "type": "array",
      "items": {"const": "sm_120"},
      "minItems": 1
    },
    "cohort_size": {"const": 30},
    "family_bucket_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activation_norm", "memory_stress", "other", "tensor_compute"],
      "properties": {
        "activation_norm": {"type": "integer", "minimum": 0},
        "memory_stress": {"type": "integer", "minimum": 0},
        "other": {"type": "integer", "minimum": 0},
        "tensor_compute": {"type": "integer", "minimum": 0}
      }
    },
    "grid_config_medabs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fully_associative_single_slice",
        "max",
        "min",
        "most_set_associative"
      ],
      "properties": {
        "fully_associative_single_slice": {"type": "number", "minimum": 0.0},
        "max": {"type": "number", "minimum": 0.0},
        "min": {"type": "number", "minimum": 0.0},
        "most_set_associative": {"type": "number", "minimum": 0.0}
      }
    },
    "grid_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "best_config",
        "best_cv_score",
        "cv_seed",
        "evaluated_config_signatures",
        "grid_size",
        "grid_size_cap",
        "n_candidates_evaluated",
        "primary_metric",
        "selected_config",
        "selected_cv_score",
        "simpler_within_2pct_tie_break_applied",
        "simpler_within_fraction",
        "stage_one_winner",
        "stage_two_anchor"
      ],
      "properties": {
        "best_config": {"$ref": "#/$defs/cache_config"},
        "best_cv_score": {"type": "number", "minimum": 0.0},
        "cv_seed": {"type": "integer"},
        "evaluated_config_signatures": {
          "type": "array",
          "items": {"$ref": "#/$defs/config_signature"}
        },
        "grid_size": {"type": "integer", "minimum": 0},
        "grid_size_cap": {"type": "integer", "minimum": 0},
        "n_candidates_evaluated": {"type": "integer", "minimum": 0},
        "primary_metric": {"type": "string"},
        "selected_config": {"$ref": "#/$defs/cache_config"},
        "selected_cv_score": {"type": "number", "minimum": 0.0},
        "simpler_within_2pct_tie_break_applied": {"type": "boolean"},
        "simpler_within_fraction": {"type": "number", "minimum": 0.0},
        "stage_one_winner": {"$ref": "#/$defs/cache_config"},
        "stage_two_anchor": {"$ref": "#/$defs/cache_config"}
      }
    },
    "holdout_cell_count": {"type": "integer", "minimum": 0},
    "holdout_geomean": {"type": "number", "minimum": 0.0},
    "inert_grid_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_grid_prediction_spread", "note"],
      "properties": {
        "max_grid_prediction_spread": {"type": "number", "minimum": 0.0},
        "note": {"type": "string"}
      }
    },
    "l2_capacity_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capacity_bytes",
        "capacity_source",
        "compute_capability",
        "geometry_source",
        "line_size_bytes",
        "num_l2_slices_source",
        "resolver",
        "resolver_evidence",
        "sector_size_bytes"
      ],
      "properties": {
        "capacity_bytes": {"type": "integer", "minimum": 1},
        "capacity_source": {"type": "string"},
        "compute_capability": {"type": "string"},
        "geometry_source": {"type": "string"},
        "line_size_bytes": {"type": "integer", "minimum": 1},
        "num_l2_slices_source": {"type": "string"},
        "resolver": {"type": "string"},
        "resolver_evidence": {"type": "array"},
        "sector_size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "per_family_bucket_p90_calibrated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activation_norm", "memory_stress", "other", "tensor_compute"],
      "properties": {
        "activation_norm": {"$ref": "#/$defs/p90_block"},
        "memory_stress": {"$ref": "#/$defs/p90_block"},
        "other": {"$ref": "#/$defs/p90_block"},
        "tensor_compute": {"$ref": "#/$defs/p90_block"}
      }
    },
    "replay_vs_rdh_baseline_beat_fraction": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "replay_vs_rdh_baseline_joint_admit_count": {"type": "integer", "minimum": 0},
    "replay_vs_v5_beat_fraction": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "replay_vs_v5_joint_admit_count": {"type": "integer", "minimum": 0},
    "residual_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature",
        "free_dimensions",
        "increasing",
        "n_train",
        "residual_kind"
      ],
      "properties": {
        "feature": {"type": "string"},
        "free_dimensions": {"type": "integer", "minimum": 0},
        "increasing": {"type": "boolean"},
        "n_train": {"type": "integer", "minimum": 0},
        "residual_kind": {"type": "string"}
      }
    },
    "result_kind": {"type": "string"},
    "rows": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "items": {"$ref": "#/$defs/row"}
    },
    "schema_version": {"const": 1},
    "source_commit": {"type": "string"},
    "top_level_admission_scope": {"const": "target_arch=sm_120"}
  },
  "$defs": {
    "metric_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["geomean_relative_error", "median_absolute_error", "n"],
      "properties": {
        "geomean_relative_error": {"type": "number", "minimum": 0.0},
        "median_absolute_error": {"type": "number", "minimum": 0.0},
        "n": {"type": "integer", "minimum": 0}
      }
    },
    "p90_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n", "p90_absolute_error"],
      "properties": {
        "n": {"type": "integer", "minimum": 0},
        "p90_absolute_error": {"type": "number", "minimum": 0.0}
      }
    },
    "cache_config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "associativity",
        "capacity_bytes",
        "capacity_scale",
        "effective_capacity_bytes",
        "line_bytes",
        "num_sets_per_slice",
        "num_slices",
        "prefetch",
        "replacement_policy",
        "sector_bytes",
        "sectors_per_line",
        "slice_hash_id",
        "total_lines"
      ],
      "properties": {
        "associativity": {"type": "integer", "minimum": 1},
        "capacity_bytes": {"type": "integer", "minimum": 1},
        "capacity_scale": {"type": "number", "exclusiveMinimum": 0.0},
        "effective_capacity_bytes": {"type": "integer", "minimum": 1},
        "line_bytes": {"type": "integer", "minimum": 1},
        "num_sets_per_slice": {"type": "integer", "minimum": 1},
        "num_slices": {"type": "integer", "minimum": 1},
        "prefetch": {"type": "string"},
        "replacement_policy": {"type": "string"},
        "sector_bytes": {"type": "integer", "minimum": 1},
        "sectors_per_line": {"type": "integer", "minimum": 1},
        "slice_hash_id": {"type": "string"},
        "total_lines": {"type": "integer", "minimum": 1}
      }
    },
    "config_signature": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {"type": "number", "exclusiveMinimum": 0.0},
        {"type": "integer", "minimum": 1},
        {"type": "string"},
        {"type": "integer", "minimum": 1},
        {"type": "string"}
      ],
      "items": false
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "always_hit_prediction",
        "arch",
        "cohort_mean_prediction",
        "family_bucket",
        "label",
        "nugteren_prediction",
        "replay_calibrated_prediction",
        "replay_prediction",
        "shape_point",
        "slug",
        "split",
        "uncalibrated_walker_prediction",
        "v4_platt_prediction",
        "v5_prediction"
      ],
      "properties": {
        "always_hit_prediction": {"type": "number"},
        "arch": {"const": "sm_120"},
        "cohort_mean_prediction": {"type": "number"},
        "family_bucket": {
          "enum": ["activation_norm", "memory_stress", "other", "tensor_compute"]
        },
        "label": {"type": "number"},
        "nugteren_prediction": {"type": "number"},
        "replay_calibrated_prediction": {"type": "number"},
        "replay_prediction": {"type": "number"},
        "shape_point": {"type": "string"},
        "slug": {"type": "string"},
        "split": {"enum": ["calibration", "holdout"]},
        "uncalibrated_walker_prediction": {"type": "number"},
        "v4_platt_prediction": {"type": "number"},
        "v5_prediction": {"type": "number"}
      }
    }
  }
}

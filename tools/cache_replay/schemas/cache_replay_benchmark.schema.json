{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cache_replay_benchmark.schema.json",
  "title": "sm_120 cache-replay throughput benchmark surface",
  "description": "Closed schema for the sector-cache-replay throughput benchmark artifact. The replay-rate denominator is replay wall time only; NVBit trace collection time is reported separately as a string sentinel and is NOT folded into the replay rate. When the benchmark is a gating run (gating == true) it must cover the full cohort of 30 cells; a non-gating subset run is admitted with fewer cells.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_commit",
    "gating",
    "passed",
    "cohort_size",
    "n_cells_benchmarked",
    "n_accesses_benchmarked",
    "cpu_model",
    "fenwick_sectors_per_sec",
    "fenwick_wall_time_s",
    "replay_sectors_per_sec",
    "replay_wall_time_s",
    "input_bytes_per_sec",
    "speedup_vs_fenwick",
    "speedup_bar",
    "hundred_million_bar",
    "nvbit_trace_collection_time",
    "separation_note",
    "l2_capacity_provenance",
    "per_cell"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "source_commit": {"type": "string"},
    "gating": {"type": "boolean"},
    "passed": {"type": "boolean"},
    "cohort_size": {"type": "integer", "minimum": 0},
    "n_cells_benchmarked": {"type": "integer", "minimum": 0},
    "n_accesses_benchmarked": {"type": "integer", "minimum": 0},
    "cpu_model": {"type": "string"},
    "fenwick_sectors_per_sec": {"type": "number", "exclusiveMinimum": 0.0},
    "fenwick_wall_time_s": {"type": "number", "exclusiveMinimum": 0.0},
    "replay_sectors_per_sec": {"type": "number", "exclusiveMinimum": 0.0},
    "replay_wall_time_s": {"type": "number", "exclusiveMinimum": 0.0},
    "input_bytes_per_sec": {"type": "number", "exclusiveMinimum": 0.0},
    "speedup_vs_fenwick": {"type": "number", "minimum": 0.0},
    "speedup_bar": {"type": "number", "exclusiveMinimum": 0.0},
    "hundred_million_bar": {"type": "integer", "minimum": 0},
    "nvbit_trace_collection_time": {
      "type": "string",
      "description": "Sentinel string indicating trace collection time is reported separately. MUST be a string, never a number; folding trace collection time into the replay rate is forbidden."
    },
    "separation_note": {"type": "string"},
    "l2_capacity_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capacity_bytes",
        "capacity_source",
        "compute_capability",
        "geometry_source",
        "line_size_bytes",
        "num_l2_slices_source",
        "resolver",
        "resolver_evidence",
        "sector_size_bytes"
      ],
      "properties": {
        "capacity_bytes": {"type": "integer", "minimum": 1},
        "capacity_source": {"type": "string"},
        "compute_capability": {"type": "string"},
        "geometry_source": {"type": "string"},
        "line_size_bytes": {"type": "integer", "minimum": 1},
        "num_l2_slices_source": {"type": "string"},
        "resolver": {"type": "string"},
        "resolver_evidence": {
          "type": "array",
          "items": {"type": "string"}
        },
        "sector_size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "per_cell": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cell_id",
          "fenwick_sectors_per_sec",
          "n_accesses",
          "replay_sectors_per_sec"
        ],
        "properties": {
          "cell_id": {"type": "string"},
          "fenwick_sectors_per_sec": {"type": "number", "exclusiveMinimum": 0.0},
          "n_accesses": {"type": "integer", "minimum": 0},
          "replay_sectors_per_sec": {"type": "number", "exclusiveMinimum": 0.0}
        }
      }
    }
  },
  "if": {
    "properties": {"gating": {"const": true}},
    "required": ["gating"]
  },
  "then": {
    "properties": {
      "cohort_size": {"const": 30},
      "n_cells_benchmarked": {"const": 30},
      "per_cell": {"minItems": 30, "maxItems": 30}
    }
  }
}
